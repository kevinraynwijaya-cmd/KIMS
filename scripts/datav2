local order=0

local function add(obj)
    order=order+1
    obj.LayoutOrder=order
    return obj
end

local function section(value)
    local t=add(text(content,value,15,C.cyan))
    t.Font=Enum.Font.GothamBold
    t.Size=UDim2.new(1,-7,0,29)
end

local function card(value,color)
    local t=add(new("TextLabel",content,{
        Size=UDim2.new(1,-7,0,53),
        BackgroundColor3=C.card,
        BorderSizePixel=0,
        Text="  "..tostring(value),
        TextColor3=color or C.muted,
        TextSize=12,
        Font=Enum.Font.Gotham,
        TextXAlignment=Enum.TextXAlignment.Left,
        TextWrapped=true
    }))
    round(t,8)
    return t
end

local function button(value,callback,color)
    local b=add(new("TextButton",content,{
        Size=UDim2.new(1,-7,0,42),
        BackgroundColor3=color or C.purple,
        BorderSizePixel=0,
        Text=value,
        TextColor3=C.white,
        Font=Enum.Font.GothamBold,
        TextSize=12
    }))
    round(b,8)

    b.Activated:Connect(function()
        local ok,err=pcall(callback)
        if not ok then log("ACTION ERROR: "..tostring(err),C.orange) end
    end)
    return b
end

local function missing(value)
    local b=button(
        "🔒 "..value.."  |  NO ENGINE",
        function()
            log(value.." has no engine",C.orange)
        end,
        C.orange
    )
    b.TextColor3=C.bg
end

local function toggle(value,key,callback)
    local box=add(new("Frame",content,{
        Size=UDim2.new(1,-7,0,47),
        BackgroundColor3=C.card,
        BorderSizePixel=0
    }))
    round(box,8)

    local name=text(box,value,12,C.white)
    name.Position=UDim2.fromOffset(12,6)
    name.Size=UDim2.new(1,-100,0,34)

    local switch=new("TextButton",box,{
        Position=UDim2.new(1,-79,0.5,-14),
        Size=UDim2.fromOffset(67,28),
        Font=Enum.Font.GothamBold,
        TextSize=12,
        TextColor3=C.white,
        BorderSizePixel=0
    })
    round(switch,7)

    local function draw()
        local on=CONFIG[key]
        switch.Text=on and "ON" or "OFF"
        switch.BackgroundColor3=on and C.purple or C.bg
    end

    draw()

    switch.Activated:Connect(function()
        local requested=not CONFIG[key]

        local ok,result=pcall(callback or function(v)
            updateConfig(key,v)
            return true
        end,requested)

        if not ok or result==false then
            log(ok and "Action rejected" or tostring(result),C.orange)
        else
            if CONFIG[key]~=requested then
                updateConfig(key,requested)
            end
        end

        draw()
    end)
end

local function numberInput(value,key,min,max)
    local box=add(new("Frame",content,{
        Size=UDim2.new(1,-7,0,47),
        BackgroundColor3=C.card,
        BorderSizePixel=0
    }))
    round(box,8)

    local t=text(box,value,12,C.white)
    t.Position=UDim2.fromOffset(12,6)
    t.Size=UDim2.new(1,-127,0,34)

    local input=new("TextBox",box,{
        Position=UDim2.new(1,-107,0,7),
        Size=UDim2.fromOffset(94,33),
        BackgroundColor3=C.bg,
        TextColor3=C.white,
        Text=tostring(CONFIG[key]),
        Font=Enum.Font.Gotham,
        TextSize=13,
        ClearTextOnFocus=false
    })
    round(input,6)

    input.FocusLost:Connect(function()
        local n=tonumber(input.Text)

        if n and n>=min and n<=max then
            updateConfig(key,n)
        else
            input.Text=tostring(CONFIG[key])
            log("Invalid value: "..value,C.orange)
        end
    end)
end

local function dropdown(title,options,key)
    local current=CONFIG[key] or options[1]
    local opened=false

    local box=add(new("Frame",content,{
        Size=UDim2.new(1,-7,0,45),
        BackgroundTransparency=1,
        ClipsDescendants=true
    }))

    local pick=new("TextButton",box,{
        Size=UDim2.new(1,0,0,42),
        BackgroundColor3=C.card,
        BorderSizePixel=0,
        TextColor3=C.white,
        TextSize=12,
        Font=Enum.Font.GothamBold,
        Text=title..": "..current.."  ▼"
    })
    round(pick,8)

    local choices=new("Frame",box,{
        Position=UDim2.fromOffset(0,44),
        Size=UDim2.new(1,0,0,#options*33),
        BackgroundTransparency=1,
        Visible=false
    })

    local function expand(v)
        opened=v
        choices.Visible=v
        box.Size=UDim2.new(
            1,-7,0,
            v and (46+#options*33) or 45
        )
    end

    for i,option in ipairs(options) do
        local b=new("TextButton",choices,{
            Position=UDim2.fromOffset(0,(i-1)*33),
            Size=UDim2.new(1,0,0,31),
            BackgroundColor3=C.panel,
            BorderSizePixel=0,
            TextColor3=C.white,
            Text=option,
            Font=Enum.Font.Gotham,
            TextSize=12
        })
        round(b,6)

        b.Activated:Connect(function()
            current=option
            pick.Text=title..": "..current.."  ▼"
            updateConfig(key,current)
            expand(false)
        end)
    end

    pick.Activated:Connect(function()
        expand(not opened)
    end)
end

-- =====================================================
-- GPU SAVER
-- =====================================================

local gpuCover
local oldFog
local oldShadows
local oldQuality

local function gpuOff()
    if gpuCover then
        gpuCover:Destroy()
        gpuCover=nil
    end

    pcall(function()
        if oldFog then Lighting.FogEnd=oldFog end
        if oldShadows~=nil then
            Lighting.GlobalShadows=oldShadows
        end
        if oldQuality then
            settings().Rendering.QualityLevel=oldQuality
        end
        if setfpscap then setfpscap(0) end
    end)

    CONFIG.GPUSaver=false
    saveConfig()
end

local function gpuOn()
    if gpuCover then return end

    pcall(function()
        oldFog=Lighting.FogEnd
        oldShadows=Lighting.GlobalShadows
        oldQuality=settings().Rendering.QualityLevel

        Lighting.FogEnd=1
        Lighting.GlobalShadows=false
        settings().Rendering.QualityLevel=
            Enum.QualityLevel.Level01

        if setfpscap then setfpscap(8) end
    end)

    gpuCover=new("Frame",gui,{
        Size=UDim2.fromScale(1,1),
        BackgroundColor3=Color3.fromRGB(9,8,17),
        BorderSizePixel=0,
        ZIndex=100
    })

    local message=text(
        gpuCover,"KIMS GPU SAVER\nACTIVE",25,C.cyan
    )
    message.Position=UDim2.fromScale(0.2,0.30)
    message.Size=UDim2.fromScale(0.6,0.23)
    message.TextXAlignment=Enum.TextXAlignment.Center
    message.Font=Enum.Font.GothamBold
    message.ZIndex=101

    local restore=new("TextButton",gpuCover,{
        AnchorPoint=Vector2.new(0.5,0),
        Position=UDim2.fromScale(0.5,0.62),
        Size=UDim2.fromOffset(220,45),
        BackgroundColor3=C.purple,
        TextColor3=C.white,
        Text="RESTORE DISPLAY",
        Font=Enum.Font.GothamBold,
        TextSize=14,
        ZIndex=101
    })
    round(restore,8)

    restore.Activated:Connect(function()
        gpuOff()
        log("GPU Saver disabled")
    end)
end

-- =====================================================
-- SIDEBAR
-- =====================================================

local pages={
    {"Main","⌂ Main",true},
    {"Favorite","★ Favorite",true},
    {"Teleport","◆ Teleport",true},
    {"Shop","▣ Shop",false},
    {"Automation","⚡ Automation",true},
    {"Trade","⇄ Trade",false},
    {"Webhook","◈ Webhook",false},
    {"Stats","▥ Stats",false}
}

local active="Main"
local navButtons={}

for index,entry in ipairs(pages) do
    local name,display,ready=entry[1],entry[2],entry[3]

    local b=new("TextButton",nav,{
        LayoutOrder=index,
        Size=UDim2.new(1,-2,0,42),
        BackgroundColor3=C.card,
        BorderSizePixel=0,
        Text=display,
        TextColor3=ready and C.white or C.orange,
        Font=Enum.Font.GothamBold,
        TextSize=12,
        TextXAlignment=Enum.TextXAlignment.Left
    })
    round(b,8)

    new("UIPadding",b,{
        PaddingLeft=UDim.new(0,12)
    })

    navButtons[name]={button=b,ready=ready}

    b.Activated:Connect(function()
        active=name
        if render then render() end
    end)
end

search:GetPropertyChangedSignal("Text"):Connect(function()
    local query=string.lower(search.Text)
    for name,data in pairs(navButtons) do
        data.button.Visible=
            string.find(string.lower(name),query,1,true)~=nil
    end
end)

-- =====================================================
-- PAGE CONTENT
-- =====================================================

local function clearContent()
    for _,child in ipairs(content:GetChildren()) do
        if child~=layout then child:Destroy() end
    end
    order=0
    content.CanvasPosition=Vector2.new(0,0)
end

local function buildPage()
    clearContent()

    for name,data in pairs(navButtons) do
        local selected=name==active
        data.button.BackgroundColor3=
            selected and C.purple or C.card
        data.button.TextColor3=
            selected and C.white or
            (data.ready and C.white or C.orange)
    end

    pageTitle.Text=active
    pageInfo.Text=data and "" or
        "KIMS FISH IT • ENGINE TEST V1.2"

    if active=="Main" then
        section("KIMS ENGINE DASHBOARD")

        card("Username: "..LP.Name)
        card("Display Name: "..LP.DisplayName)
        card("User ID: "..tostring(LP.UserId))

        card("Auto Fish: "..(
            fishing and "RUNNING" or "STOPPED"
        ),fishing and C.green or C.muted)

        card("Remotes detected: "..remoteCount.."/8",
            remoteCount>=4 and C.cyan or C.orange)

        section("QUICK CONTROLS")

        button("▶ START AUTO FISH",function()
            startFishing()
        end)

        button("■ STOP AUTO FISH",function()
            stopFishing()
        end,C.card)

        button("SCAN ENGINE AGAIN",function()
            scanEngine()
            render()
        end,C.card)

        section("ENGINE DIAGNOSTICS")

        for _,key in ipairs({
            "equip","charge","minigame","fishing",
            "sell","favorite","unequip","cancel"
        }) do
            local found=events[key]~=nil
            card(key:upper()..": "..(
                found and "FOUND" or "MISSING"
            ),found and C.green or C.orange)
        end

    elseif active=="Favorite" then
        section("AUTO FAVORITE")

        toggle("Auto Favorite Fish","AutoFavorite")

        dropdown(
            "Favorite Rarity",
            {"Mythic","Secret"},
            "FavoriteRarity"
        )

        button("★ FAVORITE FISH NOW",function()
            task.spawn(function()
                local ok,result=favoriteNow()
                log(ok and
                    ("Favorite requests sent: "..result)
                    or tostring(result),
                    ok and C.cyan or C.orange)
            end)
        end)

        card("Favorites require PlayerData, ItemUtility and the FavoriteItem remote.")

    elseif active=="Teleport" then
        section("TELEPORT TO ISLAND")

        local names={}
        for name in pairs(LOCATIONS) do
            table.insert(names,name)
        end
        table.sort(names)

        dropdown(
            "Select Island",names,"TeleportLocation"
        )

        button("◆ TELEPORT",function()
            local ok,err=teleport(CONFIG.TeleportLocation)
            log(ok and
                ("Local teleport requested: "..
                    CONFIG.TeleportLocation)
                or tostring(err),
                ok and C.cyan or C.orange)
        end)

        section("ADDITIONAL TELEPORT")
        missing("Teleport to Player")
        missing("Saved Location")
        missing("Event Teleport")

    elseif active=="Automation" then
        section("AUTO FISHING")

        toggle("Auto Fish","AutoFish",function(v)
            if v then return startFishing() end
            stopFishing()
            return true
        end)

        toggle("Blatant Mode","BlatantMode")
        toggle("Auto Catch","AutoCatch")

        numberInput("Fish Delay (s)","FishDelay",0.1,10)
        numberInput("Catch Delay (s)","CatchDelay",0.1,10)

        section("AUTO SELL")
        toggle("Auto Sell","AutoSell",function(v)
            if v and not events.sell then
                log("Sell remote missing",C.orange)
                return false
            end
            updateConfig("AutoSell",v)
            return true
        end)

        numberInput("Sell Delay (s)","SellDelay",10,300)

        button("SELL ALL NOW",function()
            task.spawn(function()
                local ok,result=sellAll()
                log(ok and
                    "Sell request sent; verify inventory"
                    or tostring(result),
                    ok and C.cyan or C.orange)
            end)
        end)

        section("PERFORMANCE")
        toggle("GPU Saver","GPUSaver",function(v)
            CONFIG.GPUSaver=v
            if v then gpuOn() else gpuOff() end
            saveConfig()
            return true
        end)

        card("Anti-AFK is initialized automatically.")

    elseif active=="Shop" then
        section("SHOP SYSTEM")
        card("No shop backend in supplied engine.",C.orange)
        missing("Auto Buy Rod")
        missing("Auto Buy Bait")
        missing("Shop Inventory")

    elseif active=="Trade" then
        section("TRADE SYSTEM")
        card("No trade backend in supplied engine.",C.orange)
        missing("Trade to Player")
        missing("Auto Accept")
        missing("Trade Inventory")

    elseif active=="Webhook" then
        section("WEBHOOK SYSTEM")
        card("No webhook backend in supplied engine.",C.orange)
        missing("Discord Webhook")
        missing("Rare Fish Notification")
        missing("Account Stats Report")

    elseif active=="Stats" then
        section("KIMS ACCOUNT STATS")

        card("Inventory reader available if Replion is loaded.")

        button("CHECK INVENTORY",function()
            task.spawn(function()
                local items,err=getItems()
                log(items and
                    ("Inventory items: "..#items)
                    or tostring(err),
                    items and C.cyan or C.orange)
            end)
        end)

        missing("Account Level")
        missing("Coins / Balance")
        missing("Total Fish Caught")
        missing("Session Statistics")
        missing("Rare Fish Counter")
    end
end

render=function()
    local ok,err=pcall(buildPage)

    if not ok then
        warn("[KIMS UI ERROR] "..tostring(err))
        clearContent()
        pageTitle.Text="UI ERROR"
        card(tostring(err),C.orange)
        log("UI ERROR: "..tostring(err),C.orange)
    end
end

-- =====================================================
-- START UI BEFORE INITIALIZING ENGINE
-- =====================================================

render()
log("KIMS UI V1.2 loaded in PlayerGui",C.green)

-- =====================================================
-- ENGINE INITIALIZATION / BACKGROUND TASKS
-- =====================================================

task.spawn(function()
    for attempt=1,12 do
        if not alive then return end

        scanEngine()
        if fishingReady() then
            log("Fishing remotes detected",C.green)
            return
        end

        task.wait(1)
    end
end)

task.spawn(function()
    local shared=RS:FindFirstChild("Shared")
    local packages=RS:FindFirstChild("Packages")

    local itemModule=shared and
        shared:FindFirstChild("ItemUtility")

    local replionModule=packages and
        packages:FindFirstChild("Replion")

    if itemModule then
        local ok,result=pcall(require,itemModule)
        if ok then itemUtility=result end
    end

    if replionModule then
        local ok,replion=pcall(require,replionModule)

        if ok and replion and replion.Client then
            local dataOk,result=pcall(function()
                return replion.Client:WaitReplion("Data")
            end)

            if dataOk and alive then
                playerData=result
                log("PlayerData ready",C.green)
            end
        end
    end
end)

track(LP.Idled:Connect(function()
    if not alive then return end
    pcall(function()
        VirtualUser:CaptureController()
        VirtualUser:ClickButton2(Vector2.new())
    end)
end))

task.spawn(function()
    while alive do
        task.wait(math.max(0.15,CONFIG.CatchDelay))
        if CONFIG.AutoCatch and not fishing and
            events.fishing then
            fire("fishing")
        end
    end
end)

task.spawn(function()
    local elapsed=0
    while alive do
        task.wait(1)

        if CONFIG.AutoSell then
            elapsed=elapsed+1
            if elapsed>=CONFIG.SellDelay then
                elapsed=0
                local ok,err=sellAll()
                if not ok then
                    log("Auto Sell: "..tostring(err),C.orange)
                end
            end
        else
            elapsed=0
        end
    end
end)

task.spawn(function()
    while alive do
        task.wait(10)

        if CONFIG.AutoFavorite then
            local ok,result=favoriteNow()
            if not ok then
                log("Auto Favorite: "..tostring(result),C.orange)
            end
        end
    end
end)

ENV.KIMS_STOP=function()
    alive=false
    fishing=false
    fishToken=fishToken+1

    for _,c in ipairs(connections) do
        pcall(function() c:Disconnect() end)
    end

    gpuOff()

    if gui then gui:Destroy() end
end

print("===================================")
print("KIMS FISH IT V1.2")
print("UI: PlayerGui")
print("ENGINE: UNVERIFIED")
print("===================================")
