-- Responsive desktop / small-window Android layout.
local mobileLayout = false
resizeWindow = function()
    if not active then return end
    local currentCamera = workspace.CurrentCamera or camera
    local viewport = (currentCamera and currentCamera.ViewportSize) or Vector2.new(900, 600)
    if viewport.X < 100 or viewport.Y < 100 then
        viewport = Vector2.new(900, 600)
    end

    local scale = state.uiScale
    windowScale.Scale = scale
    local w = math.floor(math.min(920, (viewport.X - 18) / scale))
    local h = math.floor(math.min(570, (viewport.Y - 26) / scale))
    window.Size = UDim2.fromOffset(math.max(260, w), math.max(260, h))
    local mobile = viewport.X < 750
    mobileLayout = mobile
    previewTag.Visible = not mobile
    hubName.Visible = viewport.X >= 490
    if mobile then
        nav.Position = UDim2.fromOffset(0, 0)
        nav.Size = UDim2.new(1, 0, 0, 46)
        nav.ScrollingDirection = Enum.ScrollingDirection.X
        nav.AutomaticCanvasSize = Enum.AutomaticSize.X
        navLayout.FillDirection = Enum.FillDirection.Horizontal
        content.Position = UDim2.fromOffset(0, 54)
        content.Size = UDim2.new(1, 0, 1, -54)
        for _, button in pairs(navButtons) do
            button.Size = UDim2.fromOffset(122, 31)
            button.TextSize = 11
        end
        footerTime.Visible = false
        footerStatus.Size = UDim2.new(1, -20, 1, 0)
    else
        nav.Position = UDim2.fromOffset(0, 0)
        nav.Size = UDim2.new(0, 161, 1, 0)
        nav.ScrollingDirection = Enum.ScrollingDirection.Y
        nav.AutomaticCanvasSize = Enum.AutomaticSize.Y
        navLayout.FillDirection = Enum.FillDirection.Vertical
        content.Position = UDim2.fromOffset(172, 0)
        content.Size = UDim2.new(1, -172, 1, 0)
        for _, button in pairs(navButtons) do
            button.Size = UDim2.new(1, 0, 0, 39)
            button.TextSize = 12
        end
        footerTime.Visible = true
        footerStatus.Size = UDim2.new(0.65, -12, 1, 0)
    end
end

-- Drag support for desktop mouse and mobile touch. Launcher tap remains clickable.
local function makeDraggable(handle, target)
    handle.Active = true
    local dragging = false
    local dragInput = nil
    local startPos, startGuiPos
    track(handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or
           input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragInput = input
            startPos = input.Position
            startGuiPos = target.Position
            local ended
            ended = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    dragInput = nil
                    ended:Disconnect()
                end
            end)
        end
    end))
    track(UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input == dragInput then
            local delta = input.Position - startPos
            target.Position = UDim2.new(
                startGuiPos.X.Scale, startGuiPos.X.Offset + delta.X,
                startGuiPos.Y.Scale, startGuiPos.Y.Offset + delta.Y
            )
        end
    end))
end
makeDraggable(header, window)
makeDraggable(launcher, launcher)

track(minButton.MouseButton1Click:Connect(function()
    window.Visible = false
    launcher.Visible = true
end))
track(exitButton.MouseButton1Click:Connect(function()
    app:Destroy()
end))
track(launcher.MouseButton1Click:Connect(function()
    launcher.Visible = false
    window.Visible = true
end))

-- Resize on screen-size changes (rotation, emulator resize, desktop window resize).
local previousViewport = Vector2.new(0, 0)
track(RunService.Heartbeat:Connect(function()
    if not active then return end
    local current = workspace.CurrentCamera or camera
    if current and current.ViewportSize ~= previousViewport then
        previousViewport = current.ViewportSize
        resizeWindow()
    end
end))

-- Real elapsed time (not fishing / inventory data).
task.spawn(function()
    while active and screen.Parent do
        local seconds = math.floor(os.clock() - state.openedAt)
        local displayTime = string.format("%02d:%02d", math.floor(seconds / 60), seconds % 60)
        footerTime.Text = "UI Session " .. displayTime
        if statsSessionValue and statsSessionValue.Parent then
            statsSessionValue.Text = displayTime
        end
        task.wait(1)
    end
end)

resizeWindow()
refreshNav()
renderTab()
toast("KIMS HUB V1 ready. This is a UI preview; gameplay features are offline.")
print("[KIMS FISHIT HUB V1] UI loaded. Gameplay actions are not implemented.")
