-- KIMS TECH | ZETSU POST SHAPE MONITOR V2
-- Diagnostic only, intended for observing YOUR OWN normal Zetsu session.
-- Records ONLY safe structural aggregates for POST requests to stats.zetsu.lol.
-- NEVER logs URLs, query strings, headers, API keys, usernames, values, or request body.
-- Nothing is uploaded. Does NOT change inventory or game remotes.
-- Run FIRST in a fresh Roblox/Delta session, then use your own regular Zetsu loader.

local Players = game:GetService('Players')
local HttpService = game:GetService('HttpService')
local plr = Players.LocalPlayer
if not plr then return end
local pg = plr:WaitForChild('PlayerGui')
local env = (type(getgenv) == 'function' and getgenv()) or _G
local key = 'KIMS_ZETSU_SHAPE_MONITOR_V2'
if type(env[key]) == 'table' then
    local prev = env[key]
    prev.active = false
    if type(prev.close) == 'function' then pcall(prev.close) end
end

local started = os.clock()
local S = {
    active=true, stopped=false, marker=nil, attempts=0, hooks={}, posts={},
    dropped=0, diagnostics={}, exceptions=0, close=nil,
}
env[key] = S
local function sec() return math.max(0, math.floor(os.clock()-started)) end
local function pushPost(row)
    if not S.active then return end
    S.attempts=S.attempts+1
    if #S.posts < 18 then table.insert(S.posts,row) else S.dropped=S.dropped+1 end
end
local function methodOf(o)
    if type(o) ~= 'table' then return 'GET' end
    local m=o.Method or o.method or 'GET'
    return type(m)=='string' and m:upper() or 'GET'
end
local function getHost(url)
    if type(url)~='string' then return nil end
    local raw=url:match('^%a[%w+.-]*://([^/?#]+)')
    if not raw then return nil end
    -- Compare only hostname; never print full URLs, paths, queries or credentials.
    raw=raw:match('@(.+)$') or raw
    raw=raw:gsub(':%d+$',''):lower()
    return raw
end

-- Static safe field allowlist. We never print names of unknown/private keys.
local KINDS={
    fish='Fish',fishes='Fish',fishingrods='Rods',rods='Rods',rod='Rods',
    baits='Baits',bait='Baits',pets='Pets',pet='Pets',
    items='Items',item='Items',gears='Gear',gear='Gear',
    enchantstones='Stones',stones='Stones',stone='Stones',
    charms='Charms',emotes='Emotes',abilities='Abilities',
    potions='Potions',boats='Boats',lanterns='Lanterns',halos='Halos',
}
local SHAPE={
    inventory='inventory',inventories='inventory',data='data',
    collections='collection',collection='collection',
    quantity='quantity',qty='quantity',count='quantity',amount='quantity',
    itemid='id',uid='id',uuid='id',id='id',
    mutation='mutation',variant='mutation',rarity='rarity',
    weight='weight',weightkg='weight',name='name',
}
local function normalized(k)
    if type(k)~='string' then return '' end
    if #k > 48 then return '' end
    return k:lower():gsub('[^%w]','')
end
local function isArray(t)
    if type(t)~='table' then return false,0 end
    local n=0
    for k in pairs(t) do
        if type(k)=='number' and k>=1 and k%1==0 then n=n+1
        else return false,0 end
        if n>20000 then break end
    end
    return n>0,n
end
local function describeBody(body)
    local result={
        bytes=type(body)=='string' and #body or -1, fmt='missing',
        parsed=false, inspected=0, maxDepth=0, maxArray=0, arrays=0,
        objects=0, scalarTypes={string=0,number=0,boolean=0,other=0},
        categories={}, fields={}, truncated=false, root='unknown'
    }
    if type(body)~='string' then return result end
    local prefix=body:match('^%s*(.)') or ''
    if prefix=='{' or prefix=='[' then result.fmt='json-like'
    elseif body:find('=',1,true) then result.fmt='form-or-encoded'
    else result.fmt='other' end
    -- Deliberate size cap: avoid freezing Android and avoid retaining raw body.
    if #body > 450000 then result.fmt=result.fmt..'/too-large'; return result end
    if prefix~='{' and prefix~='[' then return result end
    local ok,root=pcall(function() return HttpService:JSONDecode(body) end)
    if not ok or type(root)~='table' then return result end
    result.parsed=true
    local arr=isArray(root)
    result.root=arr and 'array' or 'object'
    local stack={{v=root,depth=0}}
    local seen={}
    local nodeBudget=2300
    local perTable=300
    while #stack>0 do
        local entry=table.remove(stack)
        local value=entry.v
        local depth=entry.depth
        if type(value)=='table' and not seen[value] then
            seen[value]=true
            result.inspected=result.inspected+1
            if result.inspected>=nodeBudget then result.truncated=true; break end
            if depth>result.maxDepth then result.maxDepth=depth end
            local array,len=isArray(value)
            if array then
                result.arrays=result.arrays+1
                if len>result.maxArray then result.maxArray=len end
            else result.objects=result.objects+1 end
            local current=0
            for k,v in pairs(value) do
                current=current+1
                if current>perTable then result.truncated=true; break end
                local norm=normalized(k)
                local kind=KINDS[norm]
                if kind then
                    local meta=result.categories[kind]
                    if not meta then meta={hits=0,maxEntries=0,type='unknown'}; result.categories[kind]=meta end
                    meta.hits=meta.hits+1
                    if type(v)=='table' then
                        local count=0
                        for _ in pairs(v) do
                            count=count+1
                            if count>10000 then break end
                        end
                        if count>meta.maxEntries then meta.maxEntries=count end
                        meta.type='table'
                    else
                        meta.type=type(v)
                    end
                end
                local sf=SHAPE[norm]
                if sf then result.fields[sf]=(result.fields[sf] or 0)+1 end
                if type(v)=='table' then
                    if depth < 9 then stack[#stack+1]={v=v,depth=depth+1}
                    else result.truncated=true end
                else
                    local vt=type(v)
                    if result.scalarTypes[vt] then result.scalarTypes[vt]=result.scalarTypes[vt]+1
                    else result.scalarTypes.other=result.scalarTypes.other+1 end
                end
            end
        end
    end
    return result
end
local function rowFromBody(body, source)
    local shape
    local ok,res=pcall(describeBody,body)
    if ok then shape=res else
        S.exceptions=S.exceptions+1
        shape={bytes=type(body)=='string' and #body or -1,fmt='inspect-error',parsed=false}
    end
    return {at=sec(),after=(S.marker~=nil and os.clock()>=S.marker),source=source,shape=shape}
end
local hooked={}
local wrap = type(newcclosure)=='function' and newcclosure or function(f) return f end
local function hookExecutor(fn,tag)
    if type(fn)~='function' or type(hookfunction)~='function' then
        S.hooks[#S.hooks+1]=tag..': unavailable'
        return
    end
    if hooked[fn] then return end
    hooked[fn]=true
    local original
    local ok=pcall(function()
        original=hookfunction(fn,wrap(function(options,...)
            if S.active and type(options)=='table' then
                -- No path/query/body/headers retained; only check destination host.
                local host=getHost(options.Url or options.URL or options.url)
                if host=='stats.zetsu.lol' and methodOf(options)=='POST' then
                    local ok2,row=pcall(function()
                        local body=options.Body or options.body
                        return rowFromBody(body,tag)
                    end)
                    if ok2 and row then pushPost(row) else S.exceptions=S.exceptions+1 end
                end
            end
            return original(options,...)
        end))
    end)
    S.hooks[#S.hooks+1]=tag..': '..(ok and 'OK' or 'unavailable')
end
local function field(t,k)
    if type(t)~='table' then return nil end
    local ok,x=pcall(function() return t[k] end)
    return ok and x or nil
end
hookExecutor(field(env,'request'),'request')
hookExecutor(field(env,'http_request'),'http_request')
hookExecutor(field(field(env,'http'),'request'),'http.request')
hookExecutor(field(field(env,'syn'),'request'),'syn.request')
hookExecutor(field(field(env,'fluxus'),'request'),'fluxus.request')
hookExecutor(field(_G,'request'),'_G.request')

-- Small mobile-friendly, movable GUI. Does not hook game remotes or require modules.
local previous=pg:FindFirstChild('KIMSZetsuMonitorV2')
if previous then previous:Destroy() end
local gui=Instance.new('ScreenGui')
gui.Name='KIMSZetsuMonitorV2'; gui.ResetOnSpawn=false; gui.DisplayOrder=9999
gui.ZIndexBehavior=Enum.ZIndexBehavior.Sibling; gui.Parent=pg
local frame=Instance.new('Frame')
frame.Size=UDim2.new(.92,0,.56,0)
frame.Position=UDim2.new(.04,0,.20,0)
frame.BackgroundColor3=Color3.fromRGB(12,19,35)
frame.BorderSizePixel=0; frame.Active=true; frame.Draggable=true; frame.Parent=gui
Instance.new('UICorner',frame).CornerRadius=UDim.new(0,12)
local stroke=Instance.new('UIStroke',frame); stroke.Color=Color3.fromRGB(108,93,223); stroke.Thickness=2
local title=Instance.new('TextLabel',frame)
title.BackgroundTransparency=1; title.Size=UDim2.new(.96,0,0,30)
title.Position=UDim2.new(.02,0,0,5); title.Text='KIMS ZETSU V2 | POST SHAPE ONLY'
title.Font=Enum.Font.GothamBold; title.TextSize=13
title.TextColor3=Color3.fromRGB(191,181,255); title.TextXAlignment=Enum.TextXAlignment.Left
local function makeButton(label,x,w)
    local b=Instance.new('TextButton',frame)
    b.Text=label; b.Font=Enum.Font.GothamBold; b.TextScaled=true
    b.TextColor3=Color3.new(1,1,1); b.BackgroundColor3=Color3.fromRGB(70,55,135)
    b.Position=UDim2.new(x,0,0,39); b.Size=UDim2.new(w,0,0,32)
    Instance.new('UICorner',b).CornerRadius=UDim.new(0,7)
    return b
end
local mark=makeButton('TANDA',.025,.21)
local stop=makeButton('STOP',.245,.17)
local copy=makeButton('SALIN',.425,.17)
local mini=makeButton('MINI',.605,.17)
local closeBtn=makeButton('X',.79,.16)
local info=Instance.new('TextLabel',frame)
info.BackgroundTransparency=1; info.Size=UDim2.new(.95,0,0,24)
info.Position=UDim2.new(.025,0,0,79); info.TextXAlignment=Enum.TextXAlignment.Left
info.Font=Enum.Font.Code; info.TextSize=12; info.TextColor3=Color3.fromRGB(105,224,164)
local scroll=Instance.new('ScrollingFrame',frame)
scroll.Position=UDim2.new(.025,0,0,110); scroll.Size=UDim2.new(.95,0,1,-119)
scroll.BackgroundColor3=Color3.fromRGB(21,29,49)
scroll.BorderSizePixel=0; scroll.ScrollBarThickness=6
scroll.AutomaticCanvasSize=Enum.AutomaticSize.Y; scroll.Parent=frame
local lbl=Instance.new('TextLabel',scroll)
lbl.Position=UDim2.new(0,6,0,5); lbl.Size=UDim2.new(1,-16,0,0)
lbl.AutomaticSize=Enum.AutomaticSize.Y; lbl.BackgroundTransparency=1
lbl.TextXAlignment=Enum.TextXAlignment.Left; lbl.TextYAlignment=Enum.TextYAlignment.Top
lbl.TextWrapped=true; lbl.Font=Enum.Font.Code; lbl.TextSize=12
lbl.TextColor3=Color3.fromRGB(228,232,247)

local ORDER={'Fish','Rods','Baits','Items','Gear','Pets','Stones','Charms','Emotes','Abilities','Potions','Boats','Lanterns','Halos'}
local FIELDS={'inventory','data','collection','quantity','id','mutation','rarity','weight','name'}
local function fmtShape(s)
    if not s then return 'NO BODY SUMMARY' end
    local a={'bytes='..tostring(s.bytes)..' | format='..tostring(s.fmt)..' | parsed='..tostring(s.parsed)}
    if s.parsed then
        a[#a+1]='root='..tostring(s.root)..' | objects='..tostring(s.objects)..' | arrays='..tostring(s.arrays)..' | largestArray='..tostring(s.maxArray)
        a[#a+1]='nodes='..tostring(s.inspected)..' | maxDepth='..tostring(s.maxDepth)..' | truncated='..tostring(s.truncated)
        local scal=s.scalarTypes
        a[#a+1]='scalar values: string='..tostring(scal.string)..' number='..tostring(scal.number)..' bool='..tostring(scal.boolean)
        local categories={}
        for _,k in ipairs(ORDER) do
            local c=s.categories[k]
            if c then categories[#categories+1]=k..'(seen='..c.hits..',entries<='..c.maxEntries..',type='..c.type..')' end
        end
        a[#a+1]='CATEGORIES: '..(#categories>0 and table.concat(categories,' ; ') or '(none identified)')
        local fields={}
        for _,k in ipairs(FIELDS) do
            if s.fields[k] then fields[#fields+1]=k..'='..s.fields[k] end
        end
        a[#a+1]='SAFE FIELD COUNTS: '..(#fields>0 and table.concat(fields,', ') or '(none identified)')
    end
    return table.concat(a,'\n  ')
end
local function report()
    local rows={
        'KIMS ZETSU MONITOR V2 | SAFE POST STRUCTURE ONLY',
        'PlaceId='..tostring(game.PlaceId)..' | elapsed='..sec()..'s | '..(S.active and 'RECORDING' or 'STOPPED'),
        'Marked='..(S.marker and tostring(math.floor(S.marker-started))..'s' or 'NO'),
        'No raw URLs, credentials, headers, bodies, usernames, item names or values retained.',
        'Only POST metadata for stats.zetsu.lol is reported.',
        '', '=== HOOK STATUS ==='
    }
    for _,x in ipairs(S.hooks) do rows[#rows+1]=x end
    rows[#rows+1]=''
    rows[#rows+1]='=== POST METADATA ==='
    rows[#rows+1]='Observed='..S.attempts..' | displayed='..#S.posts..' | dropped='..S.dropped..' | parser errors='..S.exceptions
    for i,row in ipairs(S.posts) do
        rows[#rows+1]=''
        rows[#rows+1]='POST '..i..' @'..row.at..'s | afterMark='..tostring(row.after)..' | via='..row.source
        rows[#rows+1]='  '..fmtShape(row.shape)
    end
    rows[#rows+1]=''
    rows[#rows+1]='=== LIMITATIONS ==='
    rows[#rows+1]='Only observed executor-level POST calls; native/hidden requests may not be seen.'
    rows[#rows+1]='A detected inventory-shaped request does not prove how Zetsu read client data.'
    rows[#rows+1]='No copied API credentials or raw request payload. No automatic uploads.'
    return table.concat(rows,'\n')
end
mark.MouseButton1Click:Connect(function()
    if not S.marker then S.marker=os.clock(); mark.Text='DITANDAI' end
end)
stop.MouseButton1Click:Connect(function()
    S.active=false; S.stopped=true; stop.Text='STOPPED'; lbl.Text=report()
    info.Text='STOPPED | tekan SALIN'
end)
copy.MouseButton1Click:Connect(function()
    local txt=report()
    lbl.Text=txt
    if type(setclipboard)=='function' then
        local ok=pcall(setclipboard,txt)
        info.Text=ok and 'Laporan aman tersalin.' or 'Salin gagal, baca panel.'
    else info.Text='setclipboard tidak tersedia di Delta.' end
end)
local collapsed=false
mini.MouseButton1Click:Connect(function()
    collapsed=not collapsed
    frame.Size=collapsed and UDim2.new(.92,0,0,110) or UDim2.new(.92,0,.56,0)
    scroll.Visible=not collapsed
    mini.Text=collapsed and 'BUKA' or 'MINI'
end)
local function close()
    S.active=false; S.stopped=true
    if gui.Parent then gui:Destroy() end
end
S.close=close
closeBtn.MouseButton1Click:Connect(close)
S.hooks[#S.hooks+1]='Method: only executor request hooks (no game remote hooking)'
lbl.Text=report()
task.spawn(function()
    while gui.Parent and not S.stopped do
        info.Text='REC ON | POST='..tostring(S.attempts)..(S.marker and ' | ZETSU MARKED' or ' | tekan TANDA')
        lbl.Text=report()
        task.wait(1.8)
    end
end)
