local FILE_NAME = "KIMS_FISHIT_HUB_V1_config.json"
local resizeWindow
local function saveConfig()
    if type(writefile) ~= "function" then
        toast("Save unavailable: this executor has no writefile API.")
        return
    end
    local payload = {
        version = 1,
        uiScale = state.uiScale,
        choices = state.choices,
        previewToggles = state.previewToggles,
    }
    local ok, err = pcall(function()
        writefile(FILE_NAME, HttpService:JSONEncode(payload))
    end)
    if ok then
        toast("KIMS UI settings saved: " .. FILE_NAME)
    else
        toast("Could not save UI settings: " .. tostring(err))
    end
end

local function loadConfig()
    if type(readfile) ~= "function" then
        toast("Load unavailable: this executor has no readfile API.")
        return
    end
    local ok, parsed = pcall(function()
        return HttpService:JSONDecode(readfile(FILE_NAME))
    end)
    if not ok or type(parsed) ~= "table" or parsed.version ~= 1 then
        toast("No valid V1 UI configuration found.")
        return
    end
    if type(parsed.choices) == "table" then
        for key, value in pairs(parsed.choices) do
            if type(key) == "string" and type(value) == "string" then
                state.choices[key] = value
            end
        end
    end
    state.previewToggles = {}
    if type(parsed.previewToggles) == "table" then
        for key, value in pairs(parsed.previewToggles) do
            if type(key) == "string" and type(value) == "boolean" then
                state.previewToggles[key] = value
            end
        end
    end
    state.uiScale = math.clamp(tonumber(parsed.uiScale) or 1, 0.85, 1.10)
    state.choices.uiScale = (state.uiScale < 0.95 and "85%") or
                            (state.uiScale > 1.05 and "110%") or "100%"
    resizeWindow()
    renderTab()
    toast("UI settings loaded. Gameplay is still offline.")
end

local function resetConfig()
    state.previewToggles = {}
    state.uiScale = 1
    state.choices = {
        fishingMode = "Precision", castMode = "Normal",
        rod = "Best Available", bait = "Best Available",
        rarity = "All Rarities", sellRarity = "Common",
        waypoint = "Slot 1", uiScale = "100%",
    }
    resizeWindow()
    renderTab()
    toast("UI preview settings reset.")
end

renderTab = function()
    if not active then return end
    for _, conn in ipairs(contentConnections) do
        pcall(function() conn:Disconnect() end)
    end
    contentConnections = {}
    statsSessionValue = nil
    for _, child in ipairs(content:GetChildren()) do
        if child:IsA("GuiObject") then
            child:Destroy()
        end
    end
    itemOrder = 0
    content.CanvasPosition = Vector2.new(0, 0)

