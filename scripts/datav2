local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")

local p = Players.LocalPlayer
local pg = p:WaitForChild("PlayerGui")

-- =========================================
-- CONFIG
-- =========================================

local MAX_SNAPSHOTS = 6
local INTERVAL = 1

local MAX_OBJECTS = 20
local MAX_VALUES = 20
local MAX_ATTRIBUTES = 20
local MAX_SCAN_DEPTH = 5000
local MAX_RS_DEPTH = 5000

local snapshots = {}
local attributes = {}
local objects = {}
local values = {}

-- =========================================
-- HELPERS
-- =========================================

local function safe(fn, fallback)
    local ok, result = pcall(fn)
    if ok then return result end
    return fallback
end

local function addObject(path, className, text)
    if #objects >= MAX_OBJECTS then return end
    table.insert(objects, {
        path = tostring(path or ""),
        className = tostring(className or ""),
        text = tostring(text or "")
    })
end

local function addValue(path, className, value)
    if #values >= MAX_VALUES then return end
    table.insert(values, {
        path = tostring(path or ""),
        className = tostring(className or ""),
        value = tostring(value)
    })
end

local function addAttribute(path, name, value)
    if #attributes >= MAX_ATTRIBUTES then return end
    table.insert(attributes, {
        path = tostring(path or ""),
        name = tostring(name or ""),
        value = tostring(value)
    })
end

local function addSnapshot(label, path, text)
    if #snapshots >= MAX_SNAPSHOTS then return end
    table.insert(snapshots, {
        index = #snapshots + 1,
        timestamp = os.time(),
        label = tostring(label or ""),
        path = tostring(path or ""),
        text = tostring(text or "")
    })
end

local function getFullName(obj)
    return safe(function() return obj:GetFullName() end, "?")
end

local function parseMultiplier(value)
    if value == nil then return nil end
    local s = tostring(value):lower()
    local n =
        s:match("[x×]%s*(%d+)")
        or s:match("(%d+)%s*[x×]")
        or s:match("luckmultiplier[^%d]*(%d+)")
    n = tonumber(n)
    if n == 2 or n == 4 or n == 6 or n == 8 then
        return n
    end
    return nil
end

local function parseCountdown(value)
    if value == nil then return nil end
