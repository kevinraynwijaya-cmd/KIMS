-- KIMS TECH | UNIVERSAL INVENTORY DATA HUNTER V8
-- Personal account diagnostics. Read-only: no HTTP, no remote firing, no inventory changes.
-- MODUL = fast inventory controller discovery; CACHE = optional bounded client table inspection.
-- IMPORTANT: Cache candidates are not proof of ownership or full inventory until validated.

local Players = game:GetService('Players')
local ReplicatedStorage = game:GetService('ReplicatedStorage')
local player = Players.LocalPlayer
if not player then return end
local playerGui = player:WaitForChild('PlayerGui')
local previous = playerGui:FindFirstChild('KIMSDataHunterV8')
if previous then previous:Destroy() end

local screen = Instance.new('ScreenGui')
screen.Name = 'KIMSDataHunterV8'
screen.ResetOnSpawn = false
screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screen.Parent = playerGui

local main = Instance.new('Frame')
main.Size = UDim2.new(.94,0,.76,0)
main.Position = UDim2.new(.03,0,.10,0)
main.BackgroundColor3 = Color3.fromRGB(12,17,34)
main.BorderSizePixel = 0
main.Parent = screen
Instance.new('UICorner',main).CornerRadius = UDim.new(0,12)
local stroke = Instance.new('UIStroke',main)
stroke.Color = Color3.fromRGB(108,91,225)
stroke.Thickness = 2

local function textLabel(parent,value,pos,size,color)
    local t = Instance.new('TextLabel')
    t.BackgroundTransparency = 1
    t.Position = pos
    t.Size = size
    t.Text = value
    t.TextXAlignment = Enum.TextXAlignment.Left
    t.TextYAlignment = Enum.TextYAlignment.Top
    t.TextColor3 = color or Color3.fromRGB(226,235,255)
    t.TextSize = 12
    t.Font = Enum.Font.Code
    t.Parent = parent
    return t
end
local title = textLabel(main,'KIMS DATA HUNTER V8 | READ ONLY',UDim2.new(.02,0,.015,0),UDim2.new(.96,0,0,26),Color3.fromRGB(190,180,255))
title.Font = Enum.Font.GothamBold
title.TextSize = 15
local function makeButton(value,x,width)
    local b = Instance.new('TextButton')
    b.Position = UDim2.new(x,0,0,39)
    b.Size = UDim2.new(width,0,0,34)
    b.BackgroundColor3 = Color3.fromRGB(64,57,119)
    b.TextColor3 = Color3.new(1,1,1)
    b.Font = Enum.Font.GothamBold
    b.TextScaled = true
    b.Text = value
    b.Parent = main
    Instance.new('UICorner',b).CornerRadius = UDim.new(0,6)
    return b
end
local modulesButton = makeButton('MODUL',.02,.22)
local cacheButton = makeButton('CACHE',.26,.22)
local copyButton = makeButton('SALIN',.50,.22)
local closeButton = makeButton('TUTUP',.74,.22)
local status = textLabel(main,'Siap. Tekan MODUL lebih dulu.',UDim2.new(.02,0,0,82),UDim2.new(.96,0,0,22),Color3.fromRGB(110,226,165))
local scroller = Instance.new('ScrollingFrame')
scroller.Position = UDim2.new(.02,0,0,107)
scroller.Size = UDim2.new(.96,0,1,-116)
scroller.BackgroundColor3 = Color3.fromRGB(20,27,46)
scroller.BorderSizePixel = 0
scroller.ScrollBarThickness = 6
scroller.AutomaticCanvasSize = Enum.AutomaticSize.Y
scroller.Parent = main
local output = textLabel(scroller,'',UDim2.new(0,6,0,6),UDim2.new(1,-20,0,0))
output.AutomaticSize = Enum.AutomaticSize.Y
output.TextWrapped = true

local lines = {}
local working = false
local closed = false
local MAX_LINES = 145
local function add(s)
    if #lines < MAX_LINES then
        lines[#lines+1] = tostring(s)
    end
end
local function update()
    if closed then return end
    output.Text = table.concat(lines,'\n')
end
local function clean(v)
    return tostring(v or ''):gsub('[\r\n|]',' '):sub(1,75)
end
local function countKeys(t,limit)
    local n = 0
    for _ in pairs(t) do
        n = n+1
        if n >= limit then return n,true end
    end
    return n,false
end
local function safeName(obj)
    local ok,name = pcall(function() return obj:GetFullName() end)
    return ok and clean(name) or '(no path)'
end
local function sectionHeader(label)
    add('')
    add('=== '..label..' ===')
end
local function beginWork(kind,fn)
    if working then return end
    working = true
    status.Text = kind..' berjalan...'
    task.spawn(function()
        local ok,err = pcall(fn)
        if not ok then add('['..kind..' ERROR] '..clean(err)) end
        if not closed then
            working = false
            status.Text = kind..(ok and ' selesai. Tekan SALIN.' or ' gagal. Salin error.')
            update()
        end
    end)
end
local function stats()
    local ls = player:FindFirstChild('leaderstats')
    if not ls then return end
    for _,key in ipairs({'Caught','Rarest Fish'}) do
        local v = ls:FindFirstChild(key)
        if v and v:IsA('ValueBase') then add('STAT '..key..' = '..clean(v.Value)) end
    end
end
add('KIMS DATA HUNTER V8 | READ ONLY | NO UPLOAD')
add('USER @'..player.Name..' | Display='..player.DisplayName..' | UserId='..tostring(player.UserId))
add('PlaceId='..tostring(game.PlaceId))
stats()
add('')
add('MODUL: cek modul/controller inventory yang sudah loaded.')
add('CACHE: opsional. Periksa tabel client yang sudah ada di memori Delta.')
add('Tidak menjalankan require, remote, HTTP, maupun mengubah item.')
add('Cache mungkin berat di sebagian Delta; jangan klik berulang.')
update()

local relevantWords = {'inventory','backpack','profile','playerdata','datahandler','datacontroller','replica','controller','itemservice','itemmanager','fishservice','fishinventory','iteminventory','save','store'}
local function relevantName(name)
    local s = tostring(name):lower()
    for _,word in ipairs(relevantWords) do
        if s:find(word,1,true) then return true end
    end
    return false
end

local function runModules()
    sectionHeader('MODULE / CONTROLLER MAP')
    add('getloadedmodules available='..tostring(type(getloadedmodules)=='function'))
    add('getgc available='..tostring(type(getgc)=='function'))
    add('getsenv available='..tostring(type(getsenv)=='function'))
    add('getupvalues available='..tostring(type(getupvalues)=='function'))
    local n=0
    if type(getloadedmodules)=='function' then
        local ok,modules = pcall(getloadedmodules)
        if ok and type(modules)=='table' then
            add('Loaded module count='..#modules)
            for i,obj in ipairs(modules) do
                if typeof(obj)=='Instance' and obj:IsA('ModuleScript') then
                    local path = safeName(obj)
                    -- Exclude individual fish definitions from generic item catalog.
                    if relevantName(obj.Name) or (path:lower():find('inventory',1,true)) then
                        if not path:find('ReplicatedStorage.Items.',1,true) then
                            n=n+1
                            if n<=45 then add('MODULE '..clean(path)) end
                        end
                    end
                end
                if i%350==0 then task.wait() end
            end
            add('Relevant loaded modules='..n..(n>45 and ' (45 displayed)' or ''))
        else add('getloadedmodules failed/unavailable') end
    end
    local ps=player:FindFirstChild('PlayerScripts')
    if ps then
        local examined=0
        local found=0
        local queue={ps}
        local head=1
        while head<=#queue and examined<1800 do
            local node=queue[head];head=head+1
            examined=examined+1
            if (node:IsA('LocalScript') or node:IsA('ModuleScript')) and relevantName(node.Name) then
                found=found+1
                if found<=30 then add('PLAYER SCRIPT '..safeName(node)) end
            end
            for _,child in ipairs(node:GetChildren()) do
                if #queue<1800 then queue[#queue+1]=child end
            end
            if examined%240==0 then task.wait() end
        end
        add('PlayerScripts inspected='..examined..' | relevant='..found)
    else add('PlayerScripts not found') end
    local rootMatches=0
    for _,obj in ipairs(ReplicatedStorage:GetChildren()) do
        if (obj:IsA('ModuleScript') or obj:IsA('Folder')) and relevantName(obj.Name) then
            rootMatches=rootMatches+1
            if rootMatches<=24 then add('RS ROOT '..clean(obj.Name)..' ('..obj.ClassName..')') end
        end
    end
    add('RS relevant roots='..rootMatches..' (definitions are NOT player inventory)')
    add('RESULT: module paths are clues, not proof of where owned items are stored.')
end

-- Never display arbitrary strings from client memory. Keys are filtered; values
-- are only inspected if they have a recognizable inventory-item structure.
local keysOfInterest = {
    inventory=true, inventories=true, items=true, fishes=true, fish=true,
    rods=true, baits=true, pets=true, stones=true, potions=true,
    data=true, profile=true, playerdata=true, backpack=true,
    itemid=true, uuid=true, uid=true, weight=true, variant=true,
    mutation=true, name=true, id=true, quantity=true, amount=true,
}
local collectionKeys = {
    inventory=true, inventories=true, items=true, fishes=true,
    fish=true, rods=true, baits=true, pets=true, stones=true,
    potions=true, backpack=true,
}
local idKeys = {name=true,itemname=true,fishname=true,weight=true,variant=true,mutation=true,uuid=true,uid=true,quantity=true}

local function scoreTable(t)
    local matched = {}
    local collections = {}
    local score=0
    local visited=0
    local sawName=false
    local sawItemInfo=false
    -- Bounded pairs: avoid enumerating massive inventory dictionaries.
    for k,v in pairs(t) do
        visited=visited+1
        if visited>70 then break end
        if type(k)=='string' then
            local key=k:lower():gsub('[ _-]','')
            if keysOfInterest[key] then
                if #matched<12 then matched[#matched+1]=k end
                if collectionKeys[key] and type(v)=='table' then
                    score=score+7
                    if #collections<6 then collections[#collections+1]={key=k,value=v} end
                elseif key=='data' or key=='profile' or key=='playerdata' then
                    if type(v)=='table' then score=score+2 end
                elseif key=='name' or key=='itemname' or key=='fishname' then
                    sawName=true
                elseif idKeys[key] then
                    sawItemInfo=true
                end
            end
        end
    end
    if sawName and sawItemInfo then score=score+3 end
    local arrLength=#t
    if arrLength>=5 then
        local sample=t[1]
        if type(sample)=='table' then
            local fields=0
            local checked=0
            for key in pairs(sample) do
                checked=checked+1
                if checked>30 then break end
                if type(key)=='string' and idKeys[key:lower():gsub('[ _-]','')] then fields=fields+1 end
            end
            if fields>=2 then score=score+9 end
        end
    end
    return score,matched,collections,arrLength
end
local function itemSample(t)
    -- Report only recognizable item metadata, never arbitrary table values.
    if type(t)~='table' then return nil end
    local name=t.Name or t.name or t.ItemName or t.itemName or t.FishName or t.fishName
    local weight=t.Weight or t.weight
    local variant=t.Variant or t.variant or t.Mutation or t.mutation
    local count=t.Quantity or t.quantity
    if type(name)~='string' or #name>80 then return nil end
    if weight==nil and variant==nil and count==nil then return nil end
    local output='item='..clean(name)
    if type(weight)=='number' or type(weight)=='string' then output=output..', weight='..clean(weight) end
    if type(variant)=='string' then output=output..', variant='..clean(variant) end
    if type(count)=='number' then output=output..', qty='..tostring(count) end
    return output
end
local function runCache()
    sectionHeader('CLIENT TABLE CACHE (EXPERIMENTAL)')
    if type(getgc)~='function' then
        add('[NOT SUPPORTED] Delta tidak menyediakan getgc. Jangan paksa hook.')
        return
    end
    add('Membaca tabel client yang sudah termuat. Tidak membaca token/API key.')
    add('Mulai getgc(true) ...')
    update()
    task.wait()
    local ok,objects=pcall(getgc,true)
    if not ok or type(objects)~='table' then
        add('[ERROR] getgc(true) gagal. Tidak ada perubahan ke game.')
        return
    end
    local total=#objects
    add('GC objects='..total)
    local ceiling=math.min(total,16000)
    local tablesSeen=0
    local candidates={}
    local itemStructures=0
    local bestScore=0
    for i=1,ceiling do
        local t=objects[i]
        if type(t)=='table' then
            tablesSeen=tablesSeen+1
            local okScore,score,matched,collections,arrayLength=pcall(scoreTable,t)
            if okScore then
                if score>bestScore then bestScore=score end
                if score>=9 then
                    if #candidates<55 then
                        candidates[#candidates+1]={score=score,matched=matched,collections=collections,size=arrayLength,ref=t}
                    end
                elseif score>=3 then
                    itemStructures=itemStructures+1
                end
            end
        end
        if i%140==0 then
            status.Text='CACHE '..i..'/'..ceiling
            task.wait()
            if closed then return end
        end
    end
    add('Inspected='..ceiling..' | tables='..tablesSeen..' | candidates='..#candidates)
    add('Small item-like tables='..itemStructures..' | max score='..bestScore)
    table.sort(candidates,function(a,b) return a.score>b.score end)
    local shown=math.min(#candidates,12)
    for i=1,shown do
        local c=candidates[i]
        add('')
        add('CANDIDATE '..i..' | score='..c.score..' | array length='..c.size)
        add('  keys='..table.concat(c.matched,', '))
        for j=1,math.min(#c.collections,4) do
            local item=c.collections[j]
            local arrLength=#item.value
            local keyCount,capped=countKeys(item.value,120)
            add('  '..clean(item.key)..': array='..arrLength..' | keys sampled='..keyCount..(capped and '+' or ''))
            local shownSamples=0
            for p=1,math.min(arrLength,12) do
                local s=itemSample(item.value[p])
                if s then add('    '..s);shownSamples=shownSamples+1 end
                if shownSamples>=3 then break end
            end
        end
        if c.size>0 then
            for j=1,math.min(c.size,5) do
                local sample=itemSample(c.ref[j])
                if sample then add('  SAMPLE '..sample);break end
            end
        end
    end
    add('')
    add('NOTICE: Candidate may be catalog or temporary cache, NOT owned inventory.')
    add('If no candidates, Delta may hide tables or inventory may live in closures/server.')
    -- Release references after report; do not preserve memory structures.
    objects=nil
    candidates=nil
end
modulesButton.MouseButton1Click:Connect(function() beginWork('MODUL',runModules) end)
cacheButton.MouseButton1Click:Connect(function() beginWork('CACHE',runCache) end)
copyButton.MouseButton1Click:Connect(function()
    local c=(type(setclipboard)=='function' and setclipboard) or (type(toclipboard)=='function' and toclipboard)
    if not c then status.Text='Clipboard tidak didukung Delta';return end
    local ok=pcall(c,table.concat(lines,'\n'))
    status.Text=ok and 'SALIN BERHASIL! Paste ke ChatGPT.' or 'SALIN gagal'
end)
closeButton.MouseButton1Click:Connect(function()
    closed=true
    screen:Destroy()
end)
