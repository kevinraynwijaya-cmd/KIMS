-- =========================================================
-- HELPERS
-- =========================================================

local function textOf(obj)
    if not obj then
        return ""
    end

    local ok, value = pcall(function()
        return obj.Text
    end)

    if ok and value ~= nil then
        return tostring(value)
    end

    return ""
end

local function fullNameOf(obj)
    if not obj then
        return ""
    end

    local ok, value = pcall(function()
        return obj:GetFullName()
    end)

    if ok and value then
        return tostring(value)
    end

    return ""
end

local function parseMultiplier(text)
    text = tostring(text or "")

    local n =
        text:match("[xX×]%s*(%d+)")
        or text:match("(%d+)%s*[xX×]")

    return tonumber(n)
end

local function parseTimer(text)
    text = tostring(text or "")

    local h, m, s =
        text:match("(%d+)%s*[hH]%s*(%d+)%s*[mM]%s*(%d+)%s*[sS]")

    if h then
        return tonumber(h) * 3600
            + tonumber(m) * 60
            + tonumber(s)
    end

    local m2, s2 =
        text:match("(%d+)%s*[mM]%s*(%d+)%s*[sS]")

    if m2 then
        return tonumber(m2) * 60 + tonumber(s2)
    end

    local onlySeconds =
        text:match("(%d+)%s*[sS]")

    if onlySeconds then
        return tonumber(onlySeconds)
    end

    local hh, mm, ss =
        text:match("(%d+):(%d+):(%d+)")

    if hh then
        return tonumber(hh) * 3600
            + tonumber(mm) * 60
            + tonumber(ss)
    end

    return nil
