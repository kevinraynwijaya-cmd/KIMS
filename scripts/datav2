    ["Lost Isle"] = CFrame.new(-3618.157, 240.8367, -1317.458),
    ["Weather Machine"] = CFrame.new(-1488.512, 83.1733, 1876.303),
    ["Tropical Grove"] = CFrame.new(-2095.341, 197.2, 3718.08),
    ["Mount Hallow"] = CFrame.new(2136.623, 78.9164, 3272.5044),
    ["Treasure Room"] = CFrame.new(-3606.3499, -266.5737, -1580.9734),
    ["Kohana"] = CFrame.new(-663.9042, 3.0458, 718.7969),
    ["Underground Cellar"] = CFrame.new(2109.5215, -94.1875, -708.6091),
    ["Ancient Jungle"] = CFrame.new(1831.7136, 6.625, -299.2792),
    ["Sacred Temple"] = CFrame.new(1466.9215, -21.8751, -622.8357)
}

local function teleportTo(name)
    local destination = LOCATIONS[name]
    if not destination then
        return false, "Location unavailable"
    end

    local character = LP.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")

    if not root then
        return false, "Character not ready"
    end

    return pcall(function()
        root.CFrame = destination
    end)
end

-- ============================================================
-- FISH IT NETWORK
-- ============================================================

local REMOTES = {
    fishing = "RE/FishingCompleted",
    sell = "RF/SellAllItems",
    charge = "RF/ChargeFishingRod",
    minigame = "RF/RequestFishingMinigameStarted",
    cancel = "RF/CancelFishingInputs",
    equip = "RE/EquipToolFromHotbar",
    unequip = "RE/UnequipToolFromHotbar",
    favorite = "RE/FavoriteItem"
}

local function scanEngine()
    local packages = RS:FindFirstChild("Packages")
    local index = packages and packages:FindFirstChild("_Index")
    local package = index and index:FindFirstChild("sleitnick_net@0.2.0")
    local net = package and package:FindFirstChild("net")

    remoteCount = 0

    for key, name in pairs(REMOTES) do
        local remote = net and net:FindFirstChild(name)
        events[key] = remote

        if remote then
            remoteCount = remoteCount + 1
        end
    end

    log(
        "Remote scan: " .. remoteCount .. "/8",
        remoteCount == 8 and C.green or C.orange
    )

    return remoteCount
end

local function fishingReady()
    return events.equip ~= nil
        and events.charge ~= nil
        and events.minigame ~= nil
        and events.fishing ~= nil
end

local function fire(key, ...)
    local remote = events[key]

    if not remote or not remote:IsA("RemoteEvent") then
        return false, "Missing RemoteEvent: " .. key
    end

    local ok, err = pcall(function(...)
        remote:FireServer(...)
    end, ...)

    return ok, err
end

local function invoke(key, ...)
    local remote = events[key]

    if not remote or not remote:IsA("RemoteFunction") then
        return false, "Missing RemoteFunction: " .. key
    end

    return pcall(function(...)
        return remote:InvokeServer(...)
    end, ...)
end

-- ============================================================
-- NORMAL FISHING ENGINE
-- ============================================================

local function castRod()
    local ok, err = fire("equip", 1)
    if not ok then return false, err end

    task.wait(0.05)

    ok, err = invoke("charge", 1755848498.4834)
    if not ok then return false, err end

    task.wait(0.02)

    return invoke("minigame", 1.2854545116425, 1)
end

local function reelIn()
    return fire("fishing")
end

local function stopFishing()
    fishing = false
    fishToken = fishToken + 1
    CONFIG.AutoFish = false

    saveConfig()

    if events.unequip then
        fire("unequip")
    end

    log("Auto Fish stopped", C.orange)
end

local function fishingLoop(token)
    while alive and fishing and fishToken == token do
        if not fishingReady() then
            log("Required fishing remotes missing", C.orange)
            break
        end

        -- One cast per cycle
        local ok, err = castRod()

        if not ok then
            log("Cast failed: " .. tostring(err), C.orange)
            break
        end

        task.wait(CONFIG.FishDelay)

        if not alive or not fishing or fishToken ~= token then
            break
        end

        -- One reel per cycle
        ok, err = reelIn()

        if not ok then
            log("Reel failed: " .. tostring(err), C.orange)
            break
        end

        task.wait(CONFIG.CatchDelay)
    end

    if fishToken == token then
        fishing = false
        CONFIG.AutoFish = false
        saveConfig()
        log("Fishing loop ended", C.orange)
    end
end

local function startFishing()
    if fishing then return true end

    scanEngine()

    if not fishingReady() then
        log("Fishing unavailable: remotes missing", C.orange)
        return false
    end

    fishToken = fishToken + 1
    local token = fishToken

    fishing = true
    CONFIG.AutoFish = true
    saveConfig()

    task.spawn(function()
        local ok, err = pcall(fishingLoop, token)

        if not ok then
            fishing = false
            CONFIG.AutoFish = false
            log("Fishing error: " .. tostring(err), C.orange)
        end
    end)

    log("Normal fishing requests started", C.cyan)
    return true
end

-- ============================================================
-- INVENTORY AND FAVORITE
-- ============================================================

local RARITY = {
    Common = 1,
    Uncommon = 2,
    Rare = 3,
    Epic = 4,
    Legendary = 5,
    Mythic = 6,
    Secret = 7
}

local favoriteCache = {}

local function getItems()
    if not playerData then
        return nil, "PlayerData unavailable"
    end

    local ok, result = pcall(function()
        return playerData:GetExpect("Inventory")
    end)

    if not ok or type(result) ~= "table" then
        return nil, "Inventory not ready"
    end

    if type(result.Items) ~= "table" then
        return nil, "Inventory items unavailable"
    end

    return result.Items
end

local function favoriteNow()
    if not itemUtility then
        return false, "ItemUtility unavailable"
    end

    if not events.favorite then
        return false, "Favorite remote unavailable"
    end

    local items, err = getItems()
    if not items then return false, err end

    local threshold = RARITY[CONFIG.FavoriteRarity] or 6
    local count = 0

    for _, item in ipairs(items) do
        if not alive then break end

        if item.UUID and not item.Favorited
            and not favoriteCache[item.UUID] then

            local ok, data = pcall(function()
                return itemUtility:GetItemData(item.Id)
            end)

            local rarity = ok and data and data.Data
                and data.Data.Rarity

            if rarity and (RARITY[rarity] or 0) >= threshold then
                local sent = fire("favorite", item.UUID)

                if sent then
                    favoriteCache[item.UUID] = true
                    count = count + 1
                    task.wait(0.3)
                end
            end
        end
    end

    return true, count
end

local function sellAll()
    return invoke("sell")
end

-- ============================================================
-- GUI HELPERS
-- ============================================================

local function new(class, parent, props)
    local object = Instance.new(class)

    for key, value in pairs(props or {}) do
        object[key] = value
    end

    object.Parent = parent
    return object
end

local function round(object, radius)
    new("UICorner", object, {
        CornerRadius = UDim.new(0, radius or 9)
    })
end

local function stroke(object, color)
    new("UIStroke", object, {
        Color = color or C.purple,
        Thickness = 1.2,
        Transparency = 0.25
    })
end

local function text(parent, value, size, color)
    return new("TextLabel", parent, {
        BackgroundTransparency = 1,
        Text = tostring(value),
        TextColor3 = color or C.white,
        Font = Enum.Font.Gotham,
        TextSize = size or 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true
    })
end

