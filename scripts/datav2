local function teleportTo(name)
    local cf = LOCATIONS[name]
    if not cf then
        return false, "Unknown location"
    end

    local char = LP.Character
    if not char then
        return false, "Character unavailable"
    end

    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then
        return false, "HumanoidRootPart unavailable"
    end

    local ok, err = pcall(function()
        root.CFrame = cf
    end)

    return ok, err
end

-- =========================================================
-- NETWORK ENGINE
-- =========================================================

local REMOTE_NAMES = {
    fishing = "RE/FishingCompleted",
    sell = "RF/SellAllItems",
    charge = "RF/ChargeFishingRod",
    minigame = "RF/RequestFishingMinigameStarted",
    cancel = "RF/CancelFishingInputs",
    equip = "RE/EquipToolFromHotbar",
    unequip = "RE/UnequipToolFromHotbar",
    favorite = "RE/FavoriteItem"
}

local function scanRemotes()
    local packages = RS:FindFirstChild("Packages")
    local index = packages and packages:FindFirstChild("_Index")
    local netPackage = index and
        index:FindFirstChild("sleitnick_net@0.2.0")
    local net = netPackage and
        netPackage:FindFirstChild("net")

    if not net then
        return false, "Network package not found"
    end

    local found = 0

    for key, name in pairs(REMOTE_NAMES) do
        local remote = net:FindFirstChild(name)
        S.events[key] = remote

        if remote then
            found = found + 1
        end
    end

    return found > 0, found .. "/8 remotes found"
end

local function fishReady()
    local e = S.events
    return e.equip and e.charge and
        e.minigame and e.fishing
end

local function remoteCall(key, method, ...)
    local remote = S.events[key]
    if not remote then
        return false, "Missing remote: " .. key
    end

    local ok, result = pcall(function(...)
        if method == "InvokeServer" then
            return remote:InvokeServer(...)
        else
            remote:FireServer(...)
            return true
        end
    end, ...)

    if not ok then
        S.lastError = tostring(result)
        return false, result
    end

    return true, result
end

-- =========================================================
-- FISHING ENGINE
-- =========================================================

local function castRod()
    local ok, err = remoteCall(
        "equip", "FireServer", 1
    )
    if not ok then return false, err end

    task.wait(0.05)

    ok, err = remoteCall(
        "charge",
        "InvokeServer",
        1755848498.4834
    )
    if not ok then return false, err end

    task.wait(0.02)

    ok, err = remoteCall(
        "minigame",
        "InvokeServer",
        1.2854545116425,
        1
    )

    return ok, err
end

local function reelIn()
    return remoteCall(
        "fishing", "FireServer"
    )
end

local function stopFishing()
    S.fishing = false
    S.fishToken = S.fishToken + 1
    Config.AutoFish = false

    remoteCall("unequip", "FireServer")
    saveConfig()
    status("Auto Fish stopped", C.orange)
end

local function fishingWorker(token)
    while S.alive and S.fishing and
        S.fishToken == token do

        if not fishReady() then
            status("Fishing remotes missing", C.orange)
            break
        end

        local ok, err

        if Config.BlatantMode then
            -- Original overlapping cast method
            remoteCall("equip", "FireServer", 1)

            for i = 1, 2 do
                task.spawn(function()
                    remoteCall(
                        "charge",
                        "InvokeServer",
                        1755848498.4834
                    )
                    task.wait(0.01)
                    remoteCall(
                        "minigame",
                        "InvokeServer",
                        1.2854545116425,
                        1
                    )
                end)
                task.wait(0.05)
            end

            task.wait(Config.FishDelay)

            for i = 1, 5 do
                if not S.alive or
                    S.fishToken ~= token then
                    break
                end

                ok, err = reelIn()

                if not ok then
                    status(tostring(err), C.orange)
                    break
                end

                task.wait(0.01)
            end

            task.wait(Config.CatchDelay * 0.5)
        else
            ok, err = castRod()

            if not ok then
                status("Cast failed: " .. tostring(err), C.orange)
                break
            end

            task.wait(Config.FishDelay)

            if not S.alive or
                S.fishToken ~= token then
                break
            end

            ok, err = reelIn()

            if not ok then
                status("Reel failed: " .. tostring(err), C.orange)
                break
            end

            task.wait(Config.CatchDelay)
        end
    end

    if S.fishToken == token then
        S.fishing = false
        Config.AutoFish = false
        status("Fishing loop ended", C.orange)
    end
end

local function startFishing()
    if S.fishing then return true end

    scanRemotes()

    if not fishReady() then
        status("Cannot start: fishing remotes missing", C.orange)
        return false
    end

    S.fishToken = S.fishToken + 1
    S.fishing = true
    Config.AutoFish = true

    local token = S.fishToken
    saveConfig()

    task.spawn(function()
        local ok, err = pcall(fishingWorker, token)

        if not ok then
            S.fishing = false
            status("Fishing error: " .. tostring(err), C.orange)
        end
    end)

    status("Fishing requests started (unverified)", C.green)
    return true
end

-- =========================================================
-- AUTO SELL
-- =========================================================

local function sellAll()
    if not S.events.sell then
        return false, "Sell remote unavailable"
    end

    return remoteCall("sell", "InvokeServer")
end

-- =========================================================
-- INVENTORY / AUTO FAVORITE
-- =========================================================

local rarityRank = {
    Common = 1,
    Uncommon = 2,
    Rare = 3,
    Epic = 4,
    Legendary = 5,
    Mythic = 6,
    Secret = 7
}

local favoritedCache = {}

local function inventoryItems()
    if not S.data then
        return nil, "PlayerData unavailable"
    end

    local ok, inventory = pcall(function()
        return S.data:GetExpect("Inventory")
    end)

    if not ok or type(inventory) ~= "table" then
        return nil, "Inventory unavailable"
    end

    if type(inventory.Items) ~= "table" then
        return nil, "Inventory.Items unavailable"
    end

    return inventory.Items
end

local function autoFavorite()
    if not S.itemUtility then
        return false, "ItemUtility unavailable"
    end

    local items, err = inventoryItems()
    if not items then return false, err end

    if not S.events.favorite then
        return false, "Favorite remote missing"
    end

    local threshold =
        rarityRank[Config.FavoriteRarity] or 6

    threshold = math.max(6, threshold)

    local count = 0

    for _, item in ipairs(items) do
        if not S.alive then break end

        if item.UUID and not item.Favorited and
            not favoritedCache[item.UUID] then

            local ok, data = pcall(function()
                return S.itemUtility:GetItemData(item.Id)
            end)

            local rarity = ok and data and
                data.Data and data.Data.Rarity

            if rarity and
                (rarityRank[rarity] or 0) >= threshold then

                local sent = remoteCall(
                    "favorite",
                    "FireServer",
                    item.UUID
                )

                if sent then
                    favoritedCache[item.UUID] = true
                    count = count + 1
                    task.wait(0.3)
                end
            end
        end
    end

    return true, count
end

-- =========================================================
-- GPU SAVER
-- =========================================================

local function disableGPU()
    Config.GPUSaver = false

    pcall(function()
        settings().Rendering.QualityLevel =
            Enum.QualityLevel.Automatic
        Lighting.GlobalShadows = true
        Lighting.FogEnd = 100000

        if setfpscap then setfpscap(0) end
    end)

    if S.gpuGui then
        S.gpuGui:Destroy()
        S.gpuGui = nil
    end
end

local function enableGPU()
    if S.gpuGui then return end

    pcall(function()
        settings().Rendering.QualityLevel =
            Enum.QualityLevel.Level01
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 1

        if setfpscap then setfpscap(8) end
    end)

    local gpu = Instance.new("ScreenGui")
    gpu.Name = "KIMS_GPU_SAVER"
    gpu.ResetOnSpawn = false
    gpu.DisplayOrder = 9999999
    gpu.Parent = S.gui

    local cover = Instance.new("Frame")
    cover.Size = UDim2.fromScale(1, 1)
    cover.BackgroundColor3 = Color3.fromRGB(8,8,15)
    cover.BorderSizePixel = 0
    cover.Parent = gpu

    local message = Instance.new("TextLabel")
    message.Size = UDim2.fromScale(1, 0.3)
    message.Position = UDim2.fromScale(0, 0.28)
    message.BackgroundTransparency = 1
    message.Text = "KIMS GPU SAVER\nACTIVE"
    message.TextColor3 = C.cyan
    message.TextScaled = true
    message.Font = Enum.Font.GothamBold
    message.Parent = cover

    local restore = Instance.new("TextButton")
    restore.AnchorPoint = Vector2.new(0.5, 0)
    restore.Position = UDim2.fromScale(0.5, 0.67)
    restore.Size = UDim2.fromOffset(210, 45)
    restore.Text = "RESTORE DISPLAY"
    restore.TextColor3 = C.white
    restore.BackgroundColor3 = C.purple
    restore.Font = Enum.Font.GothamBold
    restore.TextSize = 14
    restore.Parent = cover

    Instance.new("UICorner", restore).CornerRadius =
        UDim.new(0, 9)

    S.gpuGui = gpu

    restore.Activated:Connect(function()
        disableGPU()
        saveConfig()
        status("GPU Saver disabled", C.cyan)
    end)
end

-- =========================================================
-- ANTI AFK / BACKGROUND TASKS
-- =========================================================

track(LP.Idled:Connect(function()
    if not S.alive then return end
    pcall(function()
        VirtualUser:CaptureController()
        VirtualUser:ClickButton2(Vector2.new())
    end)
end))

task.spawn(function()
    while S.alive do
        task.wait(0.1)

        if Config.AutoCatch and
            not S.fishing and S.events.fishing then
            remoteCall("fishing", "FireServer")
        end

        task.wait(math.max(0.1, Config.CatchDelay))
    end
end)

task.spawn(function()
    while S.alive do
        task.wait(1)

        if Config.AutoSell and S.events.sell then
            S.sellElapsed = (S.sellElapsed or 0) + 1

            if S.sellElapsed >= Config.SellDelay then
                S.sellElapsed = 0
                local ok, result = sellAll()

                if not ok then
                    status("Auto Sell error: " ..
                        tostring(result), C.orange)
                end
            end
        else
            S.sellElapsed = 0
        end
    end
end)

task.spawn(function()
    while S.alive do
        task.wait(10)

        if Config.AutoFavorite and
            S.data and S.itemUtility then
            local ok, result = autoFavorite()

            if not ok then
                warn("[KIMS Favorite] " .. tostring(result))
            end
        end
    end
end)

-- =========================================================
-- CUSTOM KIMS NEON UI
-- =========================================================

local function make(class, props, parent)
    local obj = Instance.new(class)

    for key, value in pairs(props or {}) do
        obj[key] = value
    end

    obj.Parent = parent
    return obj
end

local function round(obj, radius)
    make("UICorner", {
        CornerRadius = UDim.new(0, radius or 9)
    }, obj)
end

local function stroke(obj, color)
    make("UIStroke", {
        Color = color or C.purple,
        Thickness = 1,
        Transparency = 0.3
    }, obj)
end

local function text(parent, value, size, color)
    return make("TextLabel", {
        BackgroundTransparency = 1,
        Text = tostring(value),
        TextColor3 = color or C.white,
        Font = Enum.Font.Gotham,
        TextSize = size or 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true
    }, parent)
end

local gui = make("ScreenGui", {
    Name = "KIMS_FISH_IT_V11",
    ResetOnSpawn = false,
    IgnoreGuiInset = false,
    DisplayOrder = 10000
}, nil)

local parentOk = pcall(function()
    gui.Parent = CoreGui
end)

if not parentOk then
    gui.Parent = LP:WaitForChild("PlayerGui")
end

S.gui = gui

local window = make("Frame", {
    AnchorPoint = Vector2.new(0.5,0.5),
    Position = UDim2.fromScale(0.5,0.5),
    Size = UDim2.fromOffset(780,500),
    BackgroundColor3 = C.bg,
    BorderSizePixel = 0,
    Active = true
}, gui)

round(window, 15)
stroke(window, C.purple)

local uiScale = make("UIScale", {
    Scale = 1
}, window)

local function resize()
    local camera = workspace.CurrentCamera
    if not camera then return end

    local v = camera.ViewportSize

    uiScale.Scale = math.min(
        1,
        (v.X - 24) / 780,
        (v.Y - 24) / 500
    )

    uiScale.Scale = math.max(0.3, uiScale.Scale)
end

resize()

if workspace.CurrentCamera then
    track(workspace.CurrentCamera:
        GetPropertyChangedSignal("ViewportSize"):
        Connect(resize))
end

