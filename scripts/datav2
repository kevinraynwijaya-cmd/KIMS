    App.ReportBox = create("TextBox", {BackgroundColor3 = COLOR.Panel, BorderSizePixel = 0,
        Size = UDim2.new(1, -4, 0, 80), AutomaticSize = Enum.AutomaticSize.Y, Text = "Menunggu scan...",
        TextWrapped = true, MultiLine = true, ClearTextOnFocus = false, TextEditable = true,
        TextSize = 12, Font = Enum.Font.Code, TextColor3 = COLOR.Text,
        TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top}, reportScroll)
    create("UIPadding", {PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10),
        PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10)}, App.ReportBox)
    round(App.ReportBox, 8)

    local settingsPage = App.Pages.PENGATURAN
    App.SettingsList = listFrame(settingsPage, 0)
    local settingsBody = create("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, -4, 0, 250)}, App.SettingsList)
    label(settingsBody, "Pemantauan akun", UDim2.new(), UDim2.new(1, 0, 0, 24), false, 14)
    App.AutoButton = button(settingsBody, "", UDim2.fromOffset(0, 34), UDim2.new(1, 0, 0, 35), function()
        App.AutoRefresh = not App.AutoRefresh
        App:SaveSettings()
        App:Render()
    end)
    App.IntervalButton = button(settingsBody, "", UDim2.fromOffset(0, 78), UDim2.new(1, 0, 0, 35), function()
        App.Interval = App.Interval == 3 and 5 or (App.Interval == 5 and 10 or 3)
        App:SaveSettings()
        App:Render()
    end)
    button(settingsBody, "SIMPAN PREFERENSI", UDim2.fromOffset(0, 122), UDim2.new(0.5, -5, 0, 35), function()
        local _, message = App:SaveSettings(); App:Toast(message)
    end)
    button(settingsBody, "TES UI", UDim2.new(0.5, 5, 0, 122), UDim2.new(0.5, -5, 0, 35), function()
        App:Log("PASS", "Tombol dan notifikasi UI berfungsi.")
        App:Toast("Tes UI berhasil, bro. Tombol dan notifikasi aktif.")
    end)
    local help = label(settingsBody, "Scan data saat masuk game. Field kosong tetap ditandai belum terbaca.\nRight Shift / bubble K untuk membuka panel. X menghentikan pemantauan.",
        UDim2.fromOffset(0, 170), UDim2.new(1, 0, 0, 72), true, 12)
    help.TextWrapped, help.TextTruncate = true, Enum.TextTruncate.None

    local footer = create("Frame", {Position = UDim2.new(0, 18, 1, -51), Size = UDim2.new(1, -36, 0, 35),
        BackgroundTransparency = 1}, window)
    App.StatusLabel = label(footer, "Memulai...", UDim2.new(), UDim2.new(1, -110, 1, 0), true, 10)
    App.ScanButton = button(footer, "SCAN ULANG", UDim2.new(1, -105, 0, 0), UDim2.fromOffset(105, 35), function()
        if App.Busy then App:Toast("Scan masih berjalan."); return end
        task.spawn(function() App:Scan(true) end)
    end)

    App.Bubble = button(gui, "K", UDim2.fromOffset(20, 120), UDim2.fromOffset(48, 48), function()
        if os.clock() >= (App.IgnoreBubbleClickUntil or 0) then App:Show() end
    end)
    App.Bubble.Name, App.Bubble.TextSize, App.Bubble.TextColor3 = "KimsBubble", 22, COLOR.Gold
    App.Bubble.Font, App.Bubble.Visible = Enum.Font.GothamBold, false
    App.ToastLabel = create("TextLabel", {Name = "Toast", AnchorPoint = Vector2.new(0.5, 1),
        Position = UDim2.new(0.5, 0, 1, -18), Size = UDim2.new(0.9, 0, 0, 54),
        BackgroundColor3 = COLOR.Row, BorderSizePixel = 0, TextColor3 = COLOR.Text,
        Font = Enum.Font.Gotham, TextSize = 13, TextWrapped = true, Visible = false, ZIndex = 20}, gui)
    round(App.ToastLabel, 10)
    attachDrag(header, window, false)
    attachDrag(App.Bubble, App.Bubble, true)

    function App:Show()
        if not self.Alive then return end
        self.Window.Visible, self.Bubble.Visible = true, false
        self.Gui.Enabled = true
    end
    function App:Minimize()
        self.Window.Visible, self.Bubble.Visible = false, true
    end
    function App:SelectTab(name)
        if not self.Pages[name] then return end
        self.ActiveTab = name
        for tabName, page in pairs(self.Pages) do
            page.Visible = tabName == name
            self.TabButtons[tabName].BackgroundColor3 = tabName == name and COLOR.Gold or COLOR.Row
            self.TabButtons[tabName].TextColor3 = tabName == name and COLOR.Background or COLOR.Text
        end
        self:Render()
    end
    function App:Render()
        self.StatsSummary.Text = clean(player.Name) .. "  /  " .. #self.Rows .. " field kandidat"
        self.StatsNote.Text = self.Source .. (self.Truncated and " | Hasil dibatasi" or " | Nilai mengikuti data game")
        self.InventorySummary.Text = self.InventoryState or "Inventory belum diperiksa"
        self.EquippedLabel.Text = "EquippedId: " .. self.Equipped
        self.StatusLabel.Text = (self.Busy and "Scan berjalan..." or ("Scan " .. self.LastScan)) .. "  |  " .. self.Source
        self.AutoButton.Text = "REFRESH STAT: " .. (self.AutoRefresh and "ON" or "OFF")
        self.IntervalButton.Text = "INTERVAL: " .. self.Interval .. " DETIK  (klik untuk ubah)"
        self.LiveSummary.Text = (self.LiveEnabled and self.LiveStatus or "PAUSE") .. " | " .. #self.LiveFeed .. " perubahan"
        self.LiveEventLabel.Text = (self.DataConnection and "EVENT + POLL 0.5s" or "POLL 0.5s")
            .. " | event " .. self.LiveSignals .. " | terakhir " .. self.LiveLastEvent
        self.LiveToggle.Text = "PANTAU: " .. (self.LiveEnabled and "ON" or "OFF")
        if self.ActiveTab == "TANGKAPAN LIVE" then
            renderLive()
        elseif self.ActiveTab == "STAT AKUN" then
            renderList(self.StatsList, self.Rows, self.StatsSearch.Text,
                "Belum ada field stat terbaca. Buka Diagnostik lalu salin laporan pemeriksaan.")
        elseif self.ActiveTab == "INVENTORY" then
            renderList(self.InventoryList, self.Inventory, self.InventorySearch.Text,
                self.InventoryAvailable and "Inventory terbaca; belum ada entri yang ditampilkan."
                    or "Inventory belum tersedia dari channel Data.")
        elseif self.ActiveTab == "DIAGNOSTIK" and not self.ReportBox:IsFocused() then
            self.ReportBox.Text = self:Report()
        end
    end

    local function fit(center)
        if not App.Alive then return end
        local viewport = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(800, 600)
        local w, h = math.min(680, math.max(240, viewport.X - 24)), math.min(500, math.max(300, viewport.Y - 24))
        window.Size = UDim2.fromOffset(w, h)
        local p = window.Position
        window.Position = UDim2.fromOffset(center and math.max(4, (viewport.X - w) / 2)
            or math.clamp(p.X.Offset, 4, math.max(4, viewport.X - w - 4)),
            center and math.max(4, (viewport.Y - h) / 2)
            or math.clamp(p.Y.Offset, 4, math.max(4, viewport.Y - h - 4)))
    end
    fit(true)
    local camera = workspace.CurrentCamera
    if camera then App:Track(camera:GetPropertyChangedSignal("ViewportSize"):Connect(function() fit(false) end)) end
    App:Track(UIS.InputBegan:Connect(function(input, processed)
        if not processed and input.KeyCode == Enum.KeyCode.RightShift and not UIS:GetFocusedTextBox() then
            if window.Visible then App:Minimize() else App:Show() end
        end
    end))
    App:Track(gui.Destroying:Connect(function() App:Destroy() end))
    App:SelectTab("TANGKAPAN LIVE")
    pcall(function()
        window.BackgroundTransparency = 0.35
        Tween:Create(window, TweenInfo.new(0.25), {BackgroundTransparency = 0}):Play()
    end)
    App:Log("START", "KIMS SCRIPT " .. VERSION .. " aktif. Menunggu pembacaan data akun.")
    task.spawn(function() App:Scan(true) end)
    task.spawn(function()
        local last = os.clock()
        local busySince, warned = nil, false
        while App.Alive do
            task.wait(0.5)
            if not App.Alive then break end
            if App.Busy then
                busySince = busySince or os.clock()
                if not warned and os.clock() - busySince > 12 then
                    warned = true
                    App:Log("WAIT", "Pembacaan modul masih menunggu; UI tetap dapat dipakai.")
                    App:Toast("Pembacaan modul masih menunggu. Lihat Diagnostik.")
                end
            else busySince, warned = nil, false end
            if App.LiveEnabled and App.Data and not App.LivePending then
                App:ObserveLive("POLL 0.5s", os.clock(), os.date("%H:%M:%S"))
            end
            if App.AutoRefresh and not App.Busy and os.clock() - last >= App.Interval then
                last = os.clock()
                task.spawn(function() App:Scan(false) end)
            end
        end
    end)
end

local initialized, problem = xpcall(initialize, function(err) return clean(err, 220) end)
if not initialized then
    App:Destroy()
    warn("[KIMS] Gagal membuka panel: " .. tostring(problem))
    error("KIMS SCRIPT: " .. tostring(problem), 0)
end
return App
