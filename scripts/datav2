-- KIMS TECH | UNIVERSAL INVENTORY READER V11
-- Fish It | Delta Android | Lightweight UI snapshot
-- READ ONLY: No getgc, require, remotes, HTTP, inventory changes or auto-scrolling.
-- REFRESH reads rendered GUI counts and a few loaded item labels, not full owned items.
-- SALIN copies report; JSON copies normalized summary. LIVE optionally refreshes every 15s.

local Players = game:GetService('Players')
local HttpService = game:GetService('HttpService')
local player = Players.LocalPlayer
if not player then return end
local pg = player:WaitForChild('PlayerGui')

for _,name in ipairs({'KIMSUniversalV11','KIMSDataTraceV10','KIMSReaderV61'}) do
    local old = pg:FindFirstChild(name)
    if old then pcall(function() old:Destroy() end) end
end

local screen = Instance.new('ScreenGui')
screen.Name = 'KIMSUniversalV11'
screen.ResetOnSpawn = false
screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screen.DisplayOrder = 950
screen.Parent = pg

local main = Instance.new('Frame')
main.Size = UDim2.new(.94,0,.75,0)
main.Position = UDim2.new(.03,0,.12,0)
main.BackgroundColor3 = Color3.fromRGB(12,17,34)
main.BorderSizePixel = 0
main.Parent = screen
Instance.new('UICorner',main).CornerRadius=UDim.new(0,12)
local border=Instance.new('UIStroke',main)
border.Color=Color3.fromRGB(113,94,230)
border.Thickness=2

local function makeLabel(parent,txt,pos,size,color,sz)
    local t=Instance.new('TextLabel')
    t.BackgroundTransparency=1
    t.Position=pos
    t.Size=size
    t.Text=txt
    t.Font=Enum.Font.Code
    t.TextSize=sz or 12
    t.TextColor3=color or Color3.fromRGB(232,238,255)
    t.TextXAlignment=Enum.TextXAlignment.Left
    t.TextYAlignment=Enum.TextYAlignment.Top
    t.Parent=parent
    return t
end
local heading=makeLabel(main,'KIMS UNIVERSAL V11  |  8 KATEGORI',UDim2.new(.018,0,.01,0),UDim2.new(.96,0,0,28),Color3.fromRGB(197,184,255),15)
heading.Font=Enum.Font.GothamBold

local function makeButton(txt,x,w)
    local b=Instance.new('TextButton')
    b.Position=UDim2.new(x,0,0,40)
    b.Size=UDim2.new(w,0,0,33)
    b.Text=txt
    b.TextScaled=true
    b.Font=Enum.Font.GothamBold
    b.BackgroundColor3=Color3.fromRGB(68,60,124)
    b.TextColor3=Color3.new(1,1,1)
    b.Parent=main
    Instance.new('UICorner',b).CornerRadius=UDim.new(0,6)
    return b
end
local refreshBtn=makeButton('REFRESH',.018,.18)
local liveBtn=makeButton('LIVE OFF',.213,.18)
local copyBtn=makeButton('SALIN',.408,.18)
local jsonBtn=makeButton('JSON',.603,.18)
local closeBtn=makeButton('TUTUP',.798,.18)
local status=makeLabel(main,'Siap. Buka Inventory lalu tekan REFRESH.',UDim2.new(.02,0,0,82),UDim2.new(.96,0,0,20),Color3.fromRGB(114,230,172),12)

local scroll=Instance.new('ScrollingFrame')
scroll.Position=UDim2.new(.02,0,0,108)
scroll.Size=UDim2.new(.96,0,1,-117)
scroll.BackgroundColor3=Color3.fromRGB(20,27,46)
scroll.BorderSizePixel=0
scroll.ScrollBarThickness=7
scroll.AutomaticCanvasSize=Enum.AutomaticSize.Y
scroll.Parent=main
local out=makeLabel(scroll,'',UDim2.new(0,7,0,7),UDim2.new(1,-21,0,0),nil,12)
out.TextWrapped=true
out.AutomaticSize=Enum.AutomaticSize.Y

local CATEGORIES={'Fish','Rods','Baits','Items','Charms','Emotes','Abilities','Pets'}
local CATEGORY_LOOKUP={}
for _,cat in ipairs(CATEGORIES) do CATEGORY_LOOKUP[string.lower(cat)]=cat end
local state={report='',json='',scans=0,busy=false,live=false,closed=false}

local function clean(v)
    return tostring(v or ''):gsub('<.->',''):gsub('[\r\n\t]',' '):gsub('%s+',' '):gsub('^%s+',''):gsub('%s+$','')
end
local function shown(node,root)
    local n=node
    while n and n~=pg do
        if n:IsA('GuiObject') and not n.Visible then return false end
        if n:IsA('ScreenGui') and not n.Enabled then return false end
        n=n.Parent
    end
    return root and root:IsDescendantOf(pg)
end
local function getText(node)
    if node:IsA('TextLabel') or node:IsA('TextButton') then return clean(node.Text) end
    return ''
end
local function numPair(s)
    -- Example: 886/4,500, 96/800, 1,126/400
    local a,b=s:match('^([%d][%d,%.]*)%s*/%s*([%d][%d,%.]*)$')
    if not a then return nil end
    a=tonumber((a:gsub('[,%.]','')))
    b=tonumber((b:gsub('[,%.]','')))
    if not a or not b then return nil end
    return a,b
end
local function nodePath(node)
    local path={}
    local n=node
    while n and n~=pg and #path<9 do
        table.insert(path,1,n.Name)
        n=n.Parent
    end
    return table.concat(path,'/')
end
local function getCenter(node)
    local pos=node.AbsolutePosition
    local size=node.AbsoluteSize
    return pos.X + size.X*.5, pos.Y + size.Y*.5, size.X, size.Y
end
local function nearby(a,b)
    local ax,ay,aw,ah=getCenter(a.node)
    local bx,by,bw,bh=getCenter(b.node)
    if aw<=0 or ah<=0 or bw<=0 or bh<=0 then return nil end
    local dx=math.abs(ax-bx)
    local dy=by-ay
    -- Counter should be directly under (or in same row as) category text.
    if dx>math.max(76,aw*.9) or dy < -14 or dy>88 then return nil end
    local score=dx*1.4 + math.abs(dy-15)*.65
    if a.node.Parent==b.node.Parent then score=score-15 end
    if a.node.Parent and b.node.Parent and a.node.Parent.Parent==b.node.Parent.Parent then score=score-4 end
    if b.root==a.root then score=score-10 end
    return score
end

local function snapshotCounters()
    local labels,amounts={},{}
    local inspected,cap=0,12500
    local roots={}
    -- Visit Inventory first, then other UI roots that might contain the top tab bar.
    local inv=pg:FindFirstChild('Inventory')
    if inv then roots[#roots+1]=inv end
    for _,r in ipairs(pg:GetChildren()) do
        if r~=inv and r:IsA('ScreenGui') and r~=screen and not r.Name:match('^KIMS') then
            roots[#roots+1]=r
        end
    end
    for _,root in ipairs(roots) do
        if inspected>=cap then break end
        if not root:IsA('ScreenGui') or root.Enabled then
            local nodes=root:GetDescendants()
            for _,n in ipairs(nodes) do
                inspected=inspected+1
                if inspected>cap then break end
                if (n:IsA('TextLabel') or n:IsA('TextButton')) and shown(n,root) then
                    local t=getText(n)
                    if t~='' and #t<=85 then
                        local cat=CATEGORY_LOOKUP[string.lower(t)]
                        if cat then
                            labels[#labels+1]={node=n,root=root,category=cat}
                        else
                            local curr,maximum=numPair(t)
                            if curr~=nil then
                                amounts[#amounts+1]={node=n,root=root,current=curr,capacity=maximum,text=t}
                            else
                                -- Some interfaces put title and count in one TextLabel.
                                for _,name in ipairs(CATEGORIES) do
                                    local rest=t:match('^'..name..'%s+(.+)$')
                                    if rest then
                                        local value,limit=numPair(rest)
                                        if value~=nil then
                                            labels[#labels+1]={node=n,root=root,category=name,embedded={current=value,capacity=limit}}
                                            break
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        task.wait()
    end
    local result={}
    for _,category in ipairs(CATEGORIES) do result[category]={found=false,counter=false} end
    local assigned={}
    for _,c in ipairs(labels) do
        local rec=result[c.category]
        rec.found=true
        if c.embedded then
            local evidence={current=c.embedded.current,capacity=c.embedded.capacity,path=nodePath(c.node),score=-100}
            if not rec.counter or evidence.score<rec.score then
                rec.current=evidence.current;rec.capacity=evidence.capacity;rec.path=evidence.path;rec.score=evidence.score;rec.counter=true
            end
        end
    end
    -- Assign each number to its closest category across ALL anchors, reducing cross-column mistakes.
    for _,amount in ipairs(amounts) do
        local best,bestScore=nil,math.huge
        for _,anchor in ipairs(labels) do
            if anchor.node~=amount.node then
                local score=nearby(anchor,amount)
                if score and score<bestScore then bestScore=score;best=anchor end
            end
        end
        if best and bestScore<115 then
            local rec=result[best.category]
            if (not rec.counter or bestScore<rec.score) and not assigned[amount.node] then
                rec.current=amount.current;rec.capacity=amount.capacity
                rec.path=nodePath(amount.node);rec.score=bestScore;rec.counter=true
            end
            assigned[amount.node]=true
        end
    end
    return result,inspected,#roots,#labels,#amounts
end

local function inspectVisiblePages()
    local inv=pg:FindFirstChild('Inventory')
    if not inv then return {'PlayerGui.Inventory tidak ditemukan'},0 end
    local pages=inv:FindFirstChild('Main')
    pages=pages and pages:FindFirstChild('Content')
    pages=pages and pages:FindFirstChild('Pages')
    if not pages then return {'Main/Content/Pages tidak ditemukan'},0 end
    local output={}
    local pageCount=0
    for _,page in ipairs(pages:GetChildren()) do
        if page:IsA('GuiObject') and shown(page,inv) then
            pageCount=pageCount+1
            local found,sample,seen=0,{},{}
            local count=0
            for _,n in ipairs(page:GetDescendants()) do
                count=count+1
                if count>3800 then break end
                if n:IsA('TextLabel') and n.Name=='ItemName' and (not n.Parent or n.Parent.Name~='Variant') and shown(n,inv) then
                    local t=getText(n)
                    if t~='' and t~='ItemName' then
                        found=found+1
                        if not seen[t] and #sample<5 then sample[#sample+1]=t;seen[t]=true end
                    end
                end
            end
            output[#output+1]='  '..page.Name..': loaded ItemName labels='..found..' | contoh='..(#sample>0 and table.concat(sample,' ; ') or '-')
        end
    end
    if #output==0 then output[1]='Tidak ada page aktif terlihat saat scan' end
    return output,pageCount
end

local function statLines()
    local lines={}
    local stats=player:FindFirstChild('leaderstats')
    if stats then
        for _,name in ipairs({'Caught','Rarest Fish'}) do
            local obj=stats:FindFirstChild(name)
            if obj and obj:IsA('ValueBase') then
                lines[#lines+1]=name..'='..tostring(obj.Value)
            end
        end
    end
    return lines
end

local function refresh()
    if state.closed or state.busy then return end
    state.busy=true
    refreshBtn.Text='MEMBACA...'
    local ok,err=pcall(function()
        state.scans=state.scans+1
        local values,inspected,roots,labelCount,amountCount=snapshotCounters()
        local details,pages=inspectVisiblePages()
        local lines={
            'KIMS UNIVERSAL V11 | READ ONLY | NO UPLOAD',
            'USER @'..player.Name..' | UserId='..tostring(player.UserId),
            'PLACE '..tostring(game.PlaceId)..' | SCAN '..state.scans,
            '=== 8 INVENTORY TABS (GUI COUNTERS) ==='
        }
        local payload={version='11',source='client_gui',userId=player.UserId,username=player.Name,placeId=game.PlaceId,capturedAt=os.time(),categories={}}
        local foundCounters=0
        for _,category in ipairs(CATEGORIES) do
            local data=values[category]
            if data.counter then
                foundCounters=foundCounters+1
                lines[#lines+1]=category..' = '..tostring(data.current)..' / '..tostring(data.capacity)..' [GUI]'
                lines[#lines+1]='  source: '..data.path
                payload.categories[category]={status='gui_counter',current=data.current,capacity=data.capacity}
            elseif data.found then
                lines[#lines+1]=category..' = tab terlihat, counter belum ditemukan'
                payload.categories[category]={status='tab_only'}
            else
                lines[#lines+1]=category..' = belum terdeteksi dalam GUI aktif (BUKAN 0)'
                payload.categories[category]={status='not_detected'}
            end
        end
        lines[#lines+1]=''
        lines[#lines+1]='=== LEADERSTATS (BUKAN JUMLAH INVENTORY) ==='
        for _,v in ipairs(statLines()) do lines[#lines+1]=v end
        lines[#lines+1]=''
        lines[#lines+1]='=== CONTOH DETAIL DARI PAGE AKTIF ==='
        for _,v in ipairs(details) do lines[#lines+1]=v end
        lines[#lines+1]=''
        lines[#lines+1]='=== AUDIT ==='
        lines[#lines+1]='GUI nodes diperiksa='..inspected..' | roots='..roots..' | category labels='..labelCount..' | number labels='..amountCount
        lines[#lines+1]='Pages aktif='..pages..' | counters ketemu='..foundCounters..'/8'
        lines[#lines+1]='CATATAN: counter GUI = jumlah yang GAME TAMPILKAN pada saat scan.'
        lines[#lines+1]='Counter bukan daftar lengkap item; label tile bukan total item.'
        lines[#lines+1]='Tidak ada getgc, require, remote, HTTP, upload atau scroll otomatis.'
        state.report=table.concat(lines,'\n')
        state.json=HttpService:JSONEncode(payload)
        out.Text=state.report
        status.Text='SCAN '..state.scans..' | '..foundCounters..' counter ditemukan | LIVE '..(state.live and 'ON' or 'OFF')
    end)
    if not ok then
        status.Text='ERROR: '..tostring(err):sub(1,115)
        out.Text=state.report..'\n[SCAN ERROR] '..tostring(err)
    end
    refreshBtn.Text='REFRESH'
    state.busy=false
end

local function copyContent(value,btn)
    local f=(type(setclipboard)=='function' and setclipboard) or (type(toclipboard)=='function' and toclipboard)
    if not f then btn.Text='NO COPY';return end
    if value=='' then btn.Text='KOSONG';return end
    local ok=pcall(f,value)
    btn.Text=ok and 'TERSALIN' or 'GAGAL'
    task.delay(2,function()
        if not state.closed and btn and btn.Parent then
            if btn==copyBtn then btn.Text='SALIN' else btn.Text='JSON' end
        end
    end)
end
refreshBtn.MouseButton1Click:Connect(refresh)
copyBtn.MouseButton1Click:Connect(function() copyContent(state.report,copyBtn) end)
jsonBtn.MouseButton1Click:Connect(function() copyContent(state.json,jsonBtn) end)
closeBtn.MouseButton1Click:Connect(function() state.closed=true;state.live=false;screen:Destroy() end)
liveBtn.MouseButton1Click:Connect(function()
    state.live=not state.live
    liveBtn.Text=state.live and 'LIVE ON' or 'LIVE OFF'
    status.Text=state.live and 'LIVE tiap 15 detik, hanya GUI' or 'LIVE dimatikan'
end)

out.Text='KIMS Universal Reader V11 siap.\n\nBuka inventory Fish It, tekan REFRESH sekali.\nLIVE ON opsional untuk membaca ulang GUI tiap 15 detik.\nSALIN laporan, JSON untuk ringkasan lokal.\n\nTidak perlu scroll atau membuka 8 kategori satu per satu.\nTidak ada pengiriman data ke website.'
-- Run one first snapshot automatically when interface is ready.
task.spawn(function()
    task.wait(1.5)
    if not state.closed then refresh() end
    while not state.closed and screen.Parent do
        task.wait(15)
        if state.live and not state.closed then refresh() end
    end
end)
