subtitle.Size = UDim2.fromOffset(250, 15)

local headerInfo = label(
    header, "KIMS SCRIPT  |  NEON EDITION", 12, C.muted
)
headerInfo.Position = UDim2.fromOffset(300, 21)
headerInfo.Size = UDim2.fromOffset(340, 25)

