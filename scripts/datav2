-- KIMS TECH | INVENTORY AUTO CAPTURE V12
-- Fish It / Roblox Delta Android. READ ONLY.
-- Starts automatically. Open every inventory tab normally, press STOP, then SALIN.
-- Observes client-visible GUI instances and selected local player data containers.
-- Does NOT inspect server storage, intercept network/remotes, require modules,
-- call getgc, scroll, modify inventory, upload, or save credentials.

local Players = game:GetService('Players')
local ReplicatedStorage = game:GetService('ReplicatedStorage')
local player = Players.LocalPlayer
if not player then return end
local pg = player:WaitForChild('PlayerGui')

-- Shut down an older instance cleanly if the script is executed again.
local previous = pg:FindFirstChild('KIMSInventoryCaptureV12')
if previous then
    local stopSignal = previous:FindFirstChild('KIMS_StopRecorder')
    if stopSignal and stopSignal:IsA('BindableEvent') then
        pcall(function() stopSignal:Fire() end)
    end
    pcall(function() previous:Destroy() end)
end

local screen = Instance.new('ScreenGui')
screen.Name = 'KIMSInventoryCaptureV12'
screen.ResetOnSpawn = false
screen.DisplayOrder = 999
screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screen.Parent = pg
local shutdownSignal = Instance.new('BindableEvent')
shutdownSignal.Name = 'KIMS_StopRecorder'
shutdownSignal.Parent = screen

local panel = Instance.new('Frame')
panel.Name = 'RecorderPanel'
panel.Size = UDim2.new(.90,0,0,116)
panel.Position = UDim2.new(.05,0,.055,0)
panel.BackgroundColor3 = Color3.fromRGB(13,20,37)
panel.BorderSizePixel = 0
panel.Active = true
panel.Parent = screen
Instance.new('UICorner',panel).CornerRadius = UDim.new(0,10)
local stroke = Instance.new('UIStroke',panel)
stroke.Color = Color3.fromRGB(104,96,221)
stroke.Thickness = 2

local title = Instance.new('TextLabel')
title.Name = 'DragHandle'
title.Text = 'KIMS CAPTURE V12  |  REC OTOMATIS'
title.Font = Enum.Font.GothamBold
title.TextSize = 14
title.TextColor3 = Color3.fromRGB(217,211,255)
title.BackgroundTransparency = 1
title.TextXAlignment = Enum.TextXAlignment.Left
title.Position = UDim2.new(.025,0,0,5)
title.Size = UDim2.new(.95,0,0,29)
title.Active = true
title.Parent = panel

local function makeButton(s,x,w)
    local b = Instance.new('TextButton')
    b.Size = UDim2.new(w,0,0,34)
    b.Position = UDim2.new(x,0,0,40)
    b.BackgroundColor3 = Color3.fromRGB(68,61,129)
    b.TextColor3 = Color3.fromRGB(255,255,255)
    b.Font = Enum.Font.GothamBold
    b.TextScaled = true
    b.Text = s
    b.Parent = panel
    Instance.new('UICorner',b).CornerRadius = UDim.new(0,6)
    return b
end
local recBtn = makeButton('STOP',.025,.21)
local copyBtn = makeButton('SALIN',.255,.21)
local previewBtn = makeButton('HASIL',.485,.21)
local closeBtn = makeButton('TUTUP',.715,.255)

local status = Instance.new('TextLabel')
status.Text='Merekam otomatis. Buka kategori inventory satu per satu.'
status.Font=Enum.Font.Code
status.TextSize=11
status.TextColor3=Color3.fromRGB(111,231,170)
status.BackgroundTransparency=1
status.TextXAlignment=Enum.TextXAlignment.Left
status.TextTruncate=Enum.TextTruncate.AtEnd
status.Position=UDim2.new(.025,0,0,81)
status.Size=UDim2.new(.95,0,0,23)
status.Parent=panel

