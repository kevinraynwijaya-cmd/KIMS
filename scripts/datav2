--[[
    KIMS - Zetsu State Hunter
    Full client/replicated-state diagnostic

    Ground truth:
        Active Luck     = x8
        Remaining       = 01h 01m 45s
        Remaining secs  = 3705

    IMPORTANT:
        NextLuckCounter is ignored.
        This scanner does NOT attempt to bypass server security.
]]

local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local ReplicatedFirst = game:GetService("ReplicatedFirst")

local p = Players.LocalPlayer
local pg = p:WaitForChild("PlayerGui")

-- =========================================================
-- CONFIG
-- =========================================================

local SNAPSHOT_COUNT = 20
local SNAPSHOT_INTERVAL = 1

local KNOWN_MULTIPLIER = 8
local KNOWN_HOURS = 1
local KNOWN_MINUTES = 1
local KNOWN_SECONDS = 45

local KNOWN_TOTAL_SECONDS =
    (KNOWN_HOURS * 3600)
    + (KNOWN_MINUTES * 60)
    + KNOWN_SECONDS

local MAX_CANDIDATES = 2500
local MAX_RECORDS = 6000
local MAX_CHANGES = 3000
local MAX_STATS = 500
local MAX_ERRORS = 300

local API_URL =
    "https://kims.asia/statakun/api/debug.php"

local API_KEY =
    "stat-kims2026"

-- =========================================================
-- STORAGE
-- =========================================================

local candidates = {}
local candidateObjects = {}

local records = {}
local changes = {}
local stats = {}
local errors = {}

local candidateKeys = {}
local previous = {}

local counts = {
    candidates = 0,
    records = 0,
    changes = 0,
    stats = 0,
    errors = 0
}

-- =========================================================
-- BASIC HELPERS
-- =========================================================

local function safeString(value)
    local ok, result = pcall(function()
        return tostring(value)
    end)

    if ok then
        return result
    end

    return ""
end

local function lower(value)
    return string.lower(
        safeString(value)
    )
end

local function addError(stage, message)

    if counts.errors >= MAX_ERRORS then
        return
    end

    counts.errors += 1

    table.insert(errors, {
        stage = stage,
        message = safeString(message),
        timestamp = os.time()
    })
end

-- =========================================================
-- IGNORE
-- =========================================================

local function isIgnored(path)

    local s = lower(path)

    if string.find(
        s,
        "nextluckcounter",
        1,
        true
    ) then
        return true
    end

    return false
end

-- =========================================================
-- KEYWORD SYSTEM
-- =========================================================

local keywords = {

    "luck",
    "boost",
    "serverluck",
    "server_luck",

    "timer",
    "countdown",
    "counter",

    "remaining",
    "remain",

    "duration",
    "durationleft",

    "expire",
    "expires",
    "expiry",
    "expiration",

    "endtime",
    "end_time",
    "starttime",
    "start_time",

    "multiplier",

    "active",
    "current",

    "seconds",
    "second",

    "minutes",
    "minute",

    "hours",
    "hour",

    "caught",
    "fish",
    "coins",
    "level",

    "location",
    "rod",
    "pet",
    "skin",
    "enchant",

    "rarest"

}

local function hasKeyword(text)

    local s = lower(text)

    for _, word in ipairs(keywords) do

        if string.find(
            s,
            word,
            1,
            true
        ) then
            return true
        end

    end

    return false
end

-- =========================================================
-- NUMBER HELPERS
-- =========================================================

local function toNumber(value)

    if typeof(value) == "number" then
        return value
    end

    return tonumber(
        safeString(value)
    )
end

local function isNearKnownCountdown(number)

    if not number then
        return false
    end

    return math.abs(
        number - KNOWN_TOTAL_SECONDS
    ) <= 120
end

local function isPossibleUnixExpiry(number)

    if not number then
        return false
    end

    local now = os.time()

    -- Future Unix timestamps.
    return
        number > now
        and number < now + 7 * 24 * 60 * 60
end

-- =========================================================
-- COUNTDOWN PARSER
-- =========================================================

local function parseCountdown(text)

    text = safeString(text)

    -- 01h 01m 45s

    local h, m, s =
        string.match(
            text,
            "(%d+)%s*[hH]%s*(%d+)%s*[mM]%s*(%d+)%s*[sS]"
        )

    if h and m and s then

        return
            tonumber(h) * 3600
            + tonumber(m) * 60
            + tonumber(s),
            "HMS"

    end

    -- 01h 01m

    local h2, m2 =
        string.match(
            text,
            "(%d+)%s*[hH]%s*(%d+)%s*[mM]"
        )

    if h2 and m2 then

        return
            tonumber(h2) * 3600
            + tonumber(m2) * 60,
            "HM"

    end

    -- 01h

    local h3 =
        string.match(
            text,
            "(%d+)%s*[hH]"
        )

    if h3 then
        return tonumber(h3) * 3600, "H"
    end

    -- 01m 45s

    local m3, s3 =
        string.match(
            text,
            "(%d+)%s*[mM]%s*(%d+)%s*[sS]"
        )

    if m3 and s3 then

        return
            tonumber(m3) * 60
            + tonumber(s3),
            "MS"

    end

    -- HH:MM:SS

    local hh, mm, ss =
        string.match(
            text,
            "^(%d+):(%d%d):(%d%d)$"
        )

    if hh and mm and ss then

        return
            tonumber(hh) * 3600
            + tonumber(mm) * 60
            + tonumber(ss),
            "HHMMSS"

    end

    -- MM:SS

    local min, sec =
        string.match(
            text,
            "^(%d+):(%d%d)$"
        )

    if min and sec then

        return
            tonumber(min) * 60
            + tonumber(sec),
            "MMSS"

    end

    return nil, nil
end

-- =========================================================
-- CANDIDATE ADDER
-- =========================================================

local function addCandidate(
    instance,
    source,
    property,
    value,
    reason
)

    if counts.candidates >= MAX_CANDIDATES then
        return
    end

    local path = ""

    pcall(function()
        path = instance:GetFullName()
    end)

    if path == "" then
        return
    end

    if isIgnored(path) then
        return
    end

    local key =
        path
        .. "|"
        .. property

    if candidateKeys[key] then
        return
    end

    candidateKeys[key] = true

    local numeric =
        toNumber(value)

    local parsed,
        format =
        parseCountdown(value)

    local reasonText =
        reason or "candidate"

    counts.candidates += 1

    candidates[
        counts.candidates
    ] = {

        index =
            counts.candidates,

        path =
            path,

        className =
            instance.ClassName,

        source =
            source,

        property =
            property,

        initialValue =
            safeString(value),

        numeric =
            numeric,

        parsedSeconds =
            parsed,

        parsedFormat =
            format,

        distanceFromKnown =
            parsed
            and math.abs(
                parsed
                - KNOWN_TOTAL_SECONDS
            )
            or numeric
            and math.abs(
                numeric
                - KNOWN_TOTAL_SECONDS
            )
            or nil,

        unixExpiryCandidate =
            isPossibleUnixExpiry(
                numeric
            ),

        reason =
            reasonText
    }

    candidateObjects[
        counts.candidates
    ] = instance
end

-- =========================================================
-- TEXT SCAN
-- =========================================================

local function inspectText(
    instance,
    rootName
)

    local text = ""

    local ok = pcall(function()
        text = instance.Text
    end)

    if not ok then
        return
    end

    local numeric =
        toNumber(text)

    local parsed =
        parseCountdown(text)

    local interesting =
        hasKeyword(
            instance:GetFullName()
        )
        or hasKeyword(text)
        or parsed ~= nil
        or isNearKnownCountdown(
            numeric
        )

    if interesting then

        addCandidate(
            instance,
            "TEXT",
            "Text",
            text,
            parsed
            and "COUNTDOWN_TEXT"
            or numeric
            and "NUMERIC_TEXT"
            or "KEYWORD_TEXT"
        )

    end
end

-- =========================================================
-- VALUE SCAN
-- =========================================================

local function inspectValue(
    instance
)

    local value = nil

    local ok = pcall(function()
        value = instance.Value
    end)

    if not ok then
        return
    end

    local numeric =
        toNumber(value)

    local parsed =
        parseCountdown(value)

    local interesting =
        hasKeyword(
            instance:GetFullName()
        )
        or parsed ~= nil
        or isNearKnownCountdown(
            numeric
        )
        or isPossibleUnixExpiry(
            numeric
        )

    if interesting then

        addCandidate(
            instance,
            "VALUE",
            "Value",
            value,
            parsed
            and "COUNTDOWN_VALUE"
            or isPossibleUnixExpiry(numeric)
            and "EXPIRY_TIMESTAMP"
            or numeric
            and "NUMERIC_VALUE"
            or "KEYWORD_VALUE"
        )

    end
end

-- =========================================================
-- ATTRIBUTE SCAN
-- =========================================================

local function inspectAttributes(
    instance
)

    local attrs = {}

    local ok = pcall(function()
        attrs =
            instance:GetAttributes()
    end)

    if not ok then
        return
    end

    for name, value in pairs(attrs) do

        local lname =
            lower(name)

        -- We know this is useful,
        -- but it is not the countdown itself.
        if lname == "luckmultiplier" then

            if counts.stats < MAX_STATS then

                counts.stats += 1

                table.insert(
                    stats,
                    {
                        type = "LuckMultiplier",
                        path =
                            instance:GetFullName(),
                        name = name,
                        value =
                            safeString(value),
                        timestamp =
                            os.time()
                    }
                )

            end

        else

            local numeric =
                toNumber(value)

            local parsed =
                parseCountdown(value)

            local interesting =
                hasKeyword(
                    instance:GetFullName()
                )
                or hasKeyword(name)
                or parsed ~= nil
                or isNearKnownCountdown(
                    numeric
                )
                or isPossibleUnixExpiry(
                    numeric
                )

            if interesting then

                addCandidate(
                    instance,
                    "ATTRIBUTE",
                    name,
                    value,
                    parsed
                    and "COUNTDOWN_ATTRIBUTE"
                    or isPossibleUnixExpiry(numeric)
                    and "EXPIRY_ATTRIBUTE"
                    or "KEYWORD_ATTRIBUTE"
                )

            end

        end
    end
end

-- =========================================================
-- ROOT SCANNER
-- =========================================================

local function scanRoot(
    root,
    rootName
)

    if not root then
        return
    end

    print(
        "[KIMS] SCANNING:",
        rootName
    )

    local ok, descendants =
        pcall(function()
            return root:GetDescendants()
        end)

    if not ok then

        addError(
            "SCAN_ROOT",
            rootName
            .. ": "
            .. safeString(descendants)
        )

        return
    end

    -- Scan root itself.

    pcall(function()

        local class =
            root.ClassName

        if
            class == "TextLabel"
            or class == "TextButton"
            or class == "TextBox"
        then
            inspectText(
                root,
                rootName
            )
        end

        local valueClasses = {

            StringValue = true,
            IntValue = true,
            NumberValue = true,
            BoolValue = true

        }

        if valueClasses[class] then
            inspectValue(root)
        end

        inspectAttributes(root)

    end)

    for _, instance in ipairs(descendants) do

        if counts.candidates >= MAX_CANDIDATES then
            break
        end

        pcall(function()

            local class =
                instance.ClassName

            if
                class == "TextLabel"
                or class == "TextButton"
                or class == "TextBox"
            then

                inspectText(
                    instance,
                    rootName
                )

            end

            if
                class == "StringValue"
                or class == "IntValue"
                or class == "NumberValue"
                or class == "BoolValue"
            then

                inspectValue(
                    instance
                )

            end

            inspectAttributes(
                instance
            )

        end)

    end
end

-- =========================================================
-- PLAYER STATS
-- =========================================================

local function collectPlayerStats()

    print("[KIMS] COLLECTING PLAYER STATS")

    local containers = {

        p,
        p:FindFirstChild("leaderstats"),
        p:FindFirstChild("Data"),
        p:FindFirstChild("Stats"),
        p:FindFirstChild("PlayerData"),
        p:FindFirstChild("Inventory"),
        p:FindFirstChild("CharacterData")

    }

    local seen = {}

    for _, container in ipairs(containers) do

        if container and not seen[container] then

            seen[container] = true

            pcall(function()

                local descendants =
                    container:GetDescendants()

                for _, obj in ipairs(
                    descendants
                ) do

                    if counts.stats >= MAX_STATS then
                        return
                    end

                    local class =
                        obj.ClassName

                    if
                        class == "StringValue"
                        or class == "IntValue"
                        or class == "NumberValue"
                        or class == "BoolValue"
                    then

                        local value = nil

                        pcall(function()
                            value = obj.Value
                        end)

                        counts.stats += 1

                        table.insert(
                            stats,
                            {
                                type =
                                    "PlayerStat",

                                path =
                                    obj:GetFullName(),

                                name =
                                    obj.Name,

                                className =
                                    class,

                                value =
                                    safeString(value),

                                timestamp =
                                    os.time()
                            }
                        )

                    end

                end

            end)

        end
    end
end

