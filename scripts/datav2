-- =========================================================
-- SNAPSHOT READ
-- =========================================================

local function readCandidate(index)

    local obj =
        candidateObjects[index]

    local candidate =
        candidates[index]

    if not obj or not candidate then
        return nil
    end

    local value = nil

    local ok = pcall(function()

        if candidate.property == "Text" then

            value = obj.Text

        elseif candidate.property == "Value" then

            value = obj.Value

        else

            value =
                obj:GetAttribute(
                    candidate.property
                )

        end

    end)

    if not ok then
        return nil
    end

    return value
end

-- =========================================================
-- RECORD
-- =========================================================

local function record(
    index,
    second
)

    if counts.records >= MAX_RECORDS then
        return
    end

    local candidate =
        candidates[index]

    local value =
        readCandidate(index)

    if value == nil then
        return
    end

    local text =
        safeString(value)

    local numeric =
        toNumber(value)

    local parsed,
        format =
        parseCountdown(text)

    local key =
        candidate.path
        .. "|"
        .. candidate.property

    local old =
        previous[key]

    local changed =
        old ~= nil
        and old ~= text

    local oldParsed = nil

    if old then

        oldParsed =
            parseCountdown(old)

    end

    local delta = nil

    if
        type(oldParsed) == "number"
        and type(parsed) == "number"
    then

        delta =
            parsed
            - oldParsed

    end

    local distance =
        parsed
        and math.abs(
            parsed
            - KNOWN_TOTAL_SECONDS
        )
        or numeric
        and math.abs(
            numeric
            - KNOWN_TOTAL_SECONDS
        )
        or nil

    counts.records += 1

    table.insert(
        records,
        {
            index =
                counts.records,

            second =
                second,

            timestamp =
                os.time(),

            path =
                candidate.path,

            className =
                candidate.className,

            source =
                candidate.source,

            property =
                candidate.property,

            value =
                text,

            numeric =
                numeric,

            parsedSeconds =
                parsed,

            parsedFormat =
                format,

            distanceFromKnown =
                distance,

            changed =
                changed,

            countdownDelta =
                delta
        }
    )

    -- =====================================================
    -- CHANGE RECORD
    -- =====================================================

    if
        changed
        and counts.changes < MAX_CHANGES
    then

        counts.changes += 1

        table.insert(
            changes,
            {
                index =
                    counts.changes,

                second =
                    second,

                timestamp =
                    os.time(),

                path =
                    candidate.path,

                className =
                    candidate.className,

                source =
                    candidate.source,

                property =
                    candidate.property,

                previous =
                    old,

                current =
                    text,

                parsedSeconds =
                    parsed,

                countdownDelta =
                    delta,

                distanceFromKnown =
                    distance
            }
        )

    end

    previous[key] =
        text
end

-- =========================================================
-- SNAPSHOT LOOP
-- =========================================================

print(
    "[KIMS] TOTAL CANDIDATES:",
    #candidates
)

print(
    "[KIMS] STARTING",
    SNAPSHOT_COUNT,
    "SECOND RUNTIME WATCH"
)

for second = 0, SNAPSHOT_COUNT do

    print(
        "[KIMS] WATCH SECOND:",
        second
    )

    for index = 1, #candidates do

        pcall(function()

            record(
                index,
                second
            )

        end)

    end

    -- Re-check the known multiplier.

    pcall(function()

        if mainLuck then

            local display =
                mainLuck
                .GameLuckDisplayFrame

            local multiplier =
                display:GetAttribute(
                    "LuckMultiplier"
                )

            if counts.stats < MAX_STATS then

                counts.stats += 1

                table.insert(
                    stats,
                    {
                        type =
                            "MultiplierSnapshot",

                        path =
                            display:GetFullName(),

                        name =
                            "LuckMultiplier",

                        value =
                            safeString(
                                multiplier
                            ),

                        second =
                            second,

                        timestamp =
                            os.time()
                    }
                )

            end

        end

    end)

    if second < SNAPSHOT_COUNT then
        task.wait(
            SNAPSHOT_INTERVAL
        )
    end

end

-- =========================================================
-- FINAL MULTIPLIER
-- =========================================================

local finalMultiplier = nil

pcall(function()

    if mainLuck then

        finalMultiplier =
            mainLuck
            .GameLuckDisplayFrame
            :GetAttribute(
                "LuckMultiplier"
            )

    end

end)

-- =========================================================
-- SUMMARY
-- =========================================================

local summary = {

    mainServerLuckFound =
        mainLuck ~= nil,

    altServerLuckFound =
        altLuck ~= nil,

    initialMultiplier =
        safeString(
            initialMultiplier
        ),

    finalMultiplier =
        safeString(
            finalMultiplier
        ),

    knownRemaining =
        "01h 01m 45s",

    knownRemainingSeconds =
        KNOWN_TOTAL_SECONDS,

    candidates =
        #candidates,

    records =
        #records,

    changes =
        #changes,

    stats =
        #stats,

    errors =
        #errors,

    snapshotCount =
        SNAPSHOT_COUNT,

    snapshotInterval =
        SNAPSHOT_INTERVAL,

    nextLuckCounterIgnored =
        true,

    scanner =
        "KIMS-ZETSU-STATE-HUNTER-V1"
}

-- =========================================================
-- PAYLOAD
-- =========================================================

local payload = {

    version =
        "KIMS-ZETSU-STATE-HUNTER-V1",

    userId =
        p.UserId,

    username =
        p.Name,

    clientTimestamp =
        os.time(),

    knownState = {

        multiplier =
            KNOWN_MULTIPLIER,

        remaining =
            "01h 01m 45s",

        remainingSeconds =
            KNOWN_TOTAL_SECONDS

    },

    summary =
        summary,

    stats =
        stats,

    candidates =
        candidates,

    records =
        records,

    changes =
        changes,

    errors =
        errors,

    ping = true
}

-- =========================================================
-- ENCODE
-- =========================================================

local body = nil

local encodeOk,
    encodeError =
    pcall(function()

        body =
            HttpService:JSONEncode(
                payload
            )

    end)

if not encodeOk then

    warn(
        "[KIMS] JSON ERROR:",
        safeString(
            encodeError
        )
    )

    return
end

print(
    "[KIMS] JSON SIZE:",
    #body
)

-- =========================================================
-- UPLOAD
-- =========================================================

local ok, response =
    pcall(function()

        return HttpService:RequestAsync({

            Url =
                API_URL,

            Method =
                "POST",

            Headers = {

                ["Content-Type"] =
                    "application/json",

                ["Authorization"] =
                    "Bearer "
                    .. API_KEY

            },

            Body =
                body

        })

    end)

-- =========================================================
-- RESULT
-- =========================================================

if
    ok
    and response
    and response.Success
then

    print(
        "[KIMS] ZETSU STATE HUNTER UPLOAD OK"
    )

    print(
        "[KIMS] CANDIDATES:",
        #candidates
    )

    print(
        "[KIMS] RECORDS:",
        #records
    )

    print(
        "[KIMS] CHANGES:",
        #changes
    )

    print(
        "[KIMS] STATS:",
        #stats
    )

    print(
        "[KIMS] INITIAL MULTIPLIER:",
        safeString(
            initialMultiplier
        )
    )

    print(
        "[KIMS] FINAL MULTIPLIER:",
        safeString(
            finalMultiplier
        )

else

    warn(
        "[KIMS] ZETSU STATE HUNTER UPLOAD FAILED"
    )

    if response then

        warn(
            "[KIMS] HTTP:",
            response.StatusCode,
            response.StatusMessage
        )

        if response.Body then

            warn(
                "[KIMS] BODY:",
                response.Body
            )

        end

    else

        warn(
            "[KIMS] ERROR:",
            safeString(response)
        )

    end

end

print(
    "[KIMS] ZETSU STATE HUNTER FINISHED"
)
