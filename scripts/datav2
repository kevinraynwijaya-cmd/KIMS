-- KIMS FISH READER V6.1 FIX — LIGHT MANUAL SCAN
-- Read-only. Does not upload, alter inventory, fire remotes, or scroll automatically.
local Players = game:GetService('Players')
local player = Players.LocalPlayer
local pg = player:WaitForChild('PlayerGui')
local gui = pg:FindFirstChild('Inventory')
local old = pg:FindFirstChild('KIMSReaderV61')
if old then old:Destroy() end
local screen = Instance.new('ScreenGui')
screen.Name = 'KIMSReaderV61'; screen.ResetOnSpawn = false
screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screen.Parent = pg
local main = Instance.new('Frame')
main.Size = UDim2.new(0.90,0,0.71,0); main.Position = UDim2.new(.05,0,.13,0)
main.BackgroundColor3 = Color3.fromRGB(12,17,34); main.BorderSizePixel=0; main.Parent=screen
Instance.new('UICorner', main).CornerRadius=UDim.new(0,12)
local stroke=Instance.new('UIStroke',main); stroke.Color=Color3.fromRGB(108,91,225); stroke.Thickness=2
local title=Instance.new('TextLabel',main)
title.BackgroundTransparency=1; title.Position=UDim2.new(.025,0,.015,0); title.Size=UDim2.new(.95,0,0,30)
title.Font=Enum.Font.GothamBold; title.TextSize=16; title.TextColor3=Color3.fromRGB(190,180,255)
title.TextXAlignment=Enum.TextXAlignment.Left; title.Text='KIMS READER V6.1 FIX | MANUAL SCAN'
local function button(name,x,w)
 local b=Instance.new('TextButton',main); b.Size=UDim2.new(w,0,0,32); b.Position=UDim2.new(x,0,0,44)
 b.Text=name; b.TextScaled=true; b.Font=Enum.Font.GothamBold
 b.TextColor3=Color3.new(1,1,1); b.BackgroundColor3=Color3.fromRGB(64,57,119)
 Instance.new('UICorner',b).CornerRadius=UDim.new(0,6); return b
end
local scanBtn=button('SCAN',.025,.19)
local copyBtn=button('SALIN',.23,.19)
local clearBtn=button('RESET',.435,.19)
local closeBtn=button('TUTUP',.64,.18)
local counter=Instance.new('TextLabel',main)
counter.Position=UDim2.new(.025,0,0,83); counter.Size=UDim2.new(.95,0,0,24)
counter.BackgroundTransparency=1; counter.Font=Enum.Font.Code; counter.TextSize=13
counter.TextXAlignment=Enum.TextXAlignment.Left; counter.TextColor3=Color3.fromRGB(110,226,165)
local sc=Instance.new('ScrollingFrame',main)
sc.Size=UDim2.new(.95,0,1,-119); sc.Position=UDim2.new(.025,0,0,112)
sc.BackgroundColor3=Color3.fromRGB(20,27,46); sc.BorderSizePixel=0
sc.ScrollBarThickness=7; sc.AutomaticCanvasSize=Enum.AutomaticSize.Y
local content=Instance.new('TextLabel',sc)
content.BackgroundTransparency=1; content.Size=UDim2.new(1,-12,0,0)
content.AutomaticSize=Enum.AutomaticSize.Y; content.TextWrapped=true
content.TextXAlignment=Enum.TextXAlignment.Left; content.TextYAlignment=Enum.TextYAlignment.Top
content.Font=Enum.Font.Code; content.TextSize=12; content.TextColor3=Color3.fromRGB(228,236,255)
local layout=Instance.new('UIPadding',sc); layout.PaddingTop=UDim.new(0,6); layout.PaddingLeft=UDim.new(0,6)
local log={}; local signatures={}; local signatureCount=0; local observations=0; local scans=0
local invScroll
if gui then
 local pages=gui:FindFirstChild('Main')
 pages=pages and pages:FindFirstChild('Content')
 pages=pages and pages:FindFirstChild('Pages')
 pages=pages and pages:FindFirstChild('Inventory2')
 pages=pages and pages:FindFirstChild('Main')
 invScroll=pages and pages:FindFirstChild('Inventory')
end
local function val(label)
 if not label or not label:IsA('TextLabel') then return '' end
 return tostring(label.Text or ''):gsub('[\r\n|]',' '):gsub('^%s+',''):gsub('%s+$','')
end
local function active(o)
 local n=o
 while n and n~=invScroll do
  if n:IsA('GuiObject') and not n.Visible then return false end
  n=n.Parent
 end
 return true
end
local function itemEntry(label)
 local tile=label.Parent
 while tile and tile.Parent~=invScroll do tile=tile.Parent end
 if not tile or not active(tile) then return nil end
 local name=val(label)
 if name=='' or name=='ItemName' then return nil end
 local weight=''; local variant=''; local id=''
 for _,d in ipairs(tile:GetDescendants()) do
  if d:IsA('TextLabel') then
   local t=val(d)
   if weight=='' and t:find('kg',1,true) then weight=t end
   if variant=='' and d~=label and d.Name=='ItemName' and d.Parent and d.Parent.Name=='Variant' then variant=t end
  end
 end
 for _,a in ipairs({'UUID','UID','Id','ItemId','Guid'}) do
  local v=tile:GetAttribute(a)
  if v~=nil then id=tostring(v); break end
 end
 return name,weight,variant,id
end
local function render()
 counter.Text='SCAN '..scans..'  |  TERAMATI '..observations..'  |  SIGNATURE UNIK '..signatureCount
 local header='KIMS V6.1 | READ ONLY | NO UPLOAD\nUSER: @'..player.Name..' | Display: '..player.DisplayName..' | UserId: '..player.UserId..'\n'
 local ls=player:FindFirstChild('leaderstats')
 if ls then
  for _,name in ipairs({'Caught','Rarest Fish'}) do
   local v=ls:FindFirstChild(name)
   if v and v:IsA('ValueBase') then header=header..name..': '..tostring(v.Value)..'\n' end
  end
 end
 header=header..'INV SCROLL: '..(invScroll and invScroll:GetFullName() or 'NOT FOUND')..'\n'
 header=header..'INFO: Scan MANUAL setelah scroll, signature unik bukan total ikan.\n'
 local from=math.max(1,#log-185)
 content.Text=header..'--- ITEM TERAMATI ---\n'..table.concat(log,'\n',from)
end
local function scan()
 scans=scans+1
 if not invScroll then table.insert(log,'[ERROR] Inventory2.Main.Inventory tidak ditemukan. Buka inventory game.');render();return end
 local current=0; local new=0
 local processed=0
 for _,d in ipairs(invScroll:GetDescendants()) do
  processed=processed+1
  if processed>4500 then break end
  if d:IsA('TextLabel') and d.Name=='ItemName' and (not d.Parent or d.Parent.Name~='Variant') then
   local name,weight,variant,id=itemEntry(d)
   if name then
    current=current+1
    local sig=table.concat({name,weight,variant,id},'|')
    if not signatures[sig] then
     signatures[sig]=true; signatureCount=signatureCount+1; new=new+1
     observations=observations+1
     table.insert(log,string.format('%03d | %s | weight=%s | variant=%s | id=%s',signatureCount,name,weight~='' and weight or '?',variant~='' and variant or '?',id~='' and id or '?'))
    end
   end
  end
 end
 if new>0 or scans==1 then table.insert(log,'[SCAN '..scans..'] tiles aktif='..current..' | signature baru='..new) end
 render()
end
scanBtn.MouseButton1Click:Connect(scan)
copyBtn.MouseButton1Click:Connect(function()
 local data='KIMS V6.1 | READ ONLY\nUSER: @'..player.Name..' | UserId: '..player.UserId..'\n'
 local ls=player:FindFirstChild('leaderstats')
 if ls then for _,k in ipairs({'Caught','Rarest Fish'}) do local o=ls:FindFirstChild(k);if o and o:IsA('ValueBase') then data=data..k..'='..tostring(o.Value)..'\n' end end end
 data=data..'Scans='..scans..' | unique signatures='..signatureCount..' (NOT total items)\n'..table.concat(log,'\n')
 if type(setclipboard)=='function' then
  local ok=pcall(setclipboard,data)
  copyBtn.Text=ok and 'TERSALIN!' or 'GAGAL COPY'
 elseif type(toclipboard)=='function' then
  local ok=pcall(toclipboard,data)
  copyBtn.Text=ok and 'TERSALIN!' or 'GAGAL COPY'
 else copyBtn.Text='NO CLIPBOARD' end
end)
clearBtn.MouseButton1Click:Connect(function() signatures={};signatureCount=0;observations=0;scans=0;log={};scan() end)
closeBtn.MouseButton1Click:Connect(function() screen:Destroy() end)
table.insert(log, '[SIAP] Buka inventory, scroll, tekan SCAN. Tidak ada scan otomatis.')
render()
