-- KIMS TECH | INVENTORY DATA TRACE V10
-- Single-run read-only audit for Fish It / Roblox client.
-- Replion require only. No remote calls, HTTP, file writes or item changes.
-- Does not claim that arbitrary cache tables represent owned inventory.
-- Created for manual execution in Delta Android. Open panel > LACAK > SALIN.
local Players = game:GetService('Players')
local ReplicatedStorage = game:GetService('ReplicatedStorage')
local player = Players.LocalPlayer
if not player then return end
local pg = player:WaitForChild('PlayerGui')
local old = pg:FindFirstChild('KIMSDataTraceV10Replion')
if old then old:Destroy() end
local screen = Instance.new('ScreenGui')
screen.Name = 'KIMSDataTraceV10Replion'
screen.ResetOnSpawn = false
screen.DisplayOrder = 1000
screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screen.Parent = pg
local panel = Instance.new('Frame')
panel.Size = UDim2.new(.94,0,.76,0)
panel.Position = UDim2.new(.03,0,.11,0)
panel.BackgroundColor3 = Color3.fromRGB(12,17,34)
panel.BorderSizePixel = 0
panel.Parent = screen
Instance.new('UICorner',panel).CornerRadius = UDim.new(0,12)
local border = Instance.new('UIStroke',panel)
border.Thickness = 2
border.Color = Color3.fromRGB(108,91,225)
local function label(parent,s,pos,size,color)
    local t = Instance.new('TextLabel')
    t.BackgroundTransparency = 1
    t.Position = pos
    t.Size = size
    t.Text = s
    t.Font = Enum.Font.Code
    t.TextSize = 12
    t.TextColor3 = color or Color3.fromRGB(230,235,250)
    t.TextXAlignment = Enum.TextXAlignment.Left
    t.TextYAlignment = Enum.TextYAlignment.Top
    t.Parent = parent
    return t
end
local heading = label(panel,'KIMS V10 + REPLION | INVENTORY TRACE',UDim2.new(.02,0,.012,0),UDim2.new(.96,0,0,27),Color3.fromRGB(190,180,255))
heading.Font = Enum.Font.GothamBold
heading.TextSize = 15
local function button(txt,x)
    local b = Instance.new('TextButton')
    b.Position = UDim2.new(x,0,0,39)
    b.Size = UDim2.new(.29,0,0,35)
    b.Text = txt
    b.Font = Enum.Font.GothamBold
    b.TextScaled = true
    b.TextColor3 = Color3.new(1,1,1)
    b.BackgroundColor3 = Color3.fromRGB(64,57,119)
    b.Parent = panel
    Instance.new('UICorner',b).CornerRadius = UDim.new(0,6)
    return b
end
local runBtn = button('LACAK',.02)
local copyBtn = button('SALIN',.35)
local closeBtn = button('TUTUP',.68)
local status = label(panel,'Siap. Tekan LACAK sekali.',UDim2.new(.02,0,0,83),UDim2.new(.96,0,0,20),Color3.fromRGB(110,226,165))
local sc = Instance.new('ScrollingFrame')
sc.Position = UDim2.new(.02,0,0,108)
sc.Size = UDim2.new(.96,0,1,-117)
sc.BackgroundColor3 = Color3.fromRGB(20,27,46)
sc.BorderSizePixel = 0
sc.ScrollBarThickness = 7
sc.AutomaticCanvasSize = Enum.AutomaticSize.Y
sc.Parent = panel
local out = label(sc,'',UDim2.new(0,7,0,7),UDim2.new(1,-23,0,0))
out.TextWrapped = true
out.AutomaticSize = Enum.AutomaticSize.Y
local lines = {}
local busy,done,closed = false,false,false
local MAX_GC = 330000
local MAX_CANDIDATES = 40
local MAX_KEYS = 550
local MAX_FUNCTIONS_ENV = 8500
local MAX_CONTROLLER_MATCHES = 16
local MAX_UPVALUES = 22
local CATEGORY_NAMES = {'Fish','Fishing Rods','Baits','Potions','Pets','Pet Eggs','Enchant Stones','Charms','Boats','Gears','Lanterns','Halos','Emotes'}
local function add(s)
    if #lines < 400 then lines[#lines+1] = tostring(s) end
end
local function redraw()
    if not closed then out.Text = table.concat(lines,'\n') end
end
local function short(s,maxlen)
    return tostring(s or ''):gsub('[\r\n]',' '):sub(1,maxlen or 100)
end
local function countTable(t,limit)
    if type(t) ~= 'table' then return 0,false end
    local n=0
    for _ in pairs(t) do
        n=n+1
