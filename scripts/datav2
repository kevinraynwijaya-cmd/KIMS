    Text = "✕",
    Font = Enum.Font.GothamBold,
    TextSize = 21,
    TextColor3 = C.orange,
    BackgroundTransparency = 1,
    Position = UDim2.new(1, -45, 0, 13),
    Size = UDim2.fromOffset(34, 36)
}, header)

-- FLOATING REOPEN BUTTON
local floating = make("TextButton", {
    Text = "⚡ KIMS",
    Font = Enum.Font.GothamBold,
    TextSize = 16,
    TextColor3 = C.white,
    BackgroundColor3 = C.panel,
    Position = UDim2.fromScale(0.03, 0.55),
    Size = UDim2.fromOffset(110, 43),
    Visible = false
