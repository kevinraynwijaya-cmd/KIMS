-- KIMS TECH | ZETSU BEHAVIOR MONITOR V1 (METADATA ONLY)
-- Run FIRST, then run your OWN normal Zetsu loader in the SAME Roblox session.
-- For observing your own client only. No request body/headers/keys/item contents.
-- Does not require Zetsu, does not alter inventory, does not transmit anything.
-- Hooks may be unsupported/conflict with other scripts; use a fresh game session.

local Players = game:GetService('Players')
local localPlayer = Players.LocalPlayer
if not localPlayer then return end
local pg = localPlayer:WaitForChild('PlayerGui')
local clockStart = os.clock()
local env = (type(getgenv) == 'function' and getgenv()) or _G

if type(env.KIMS_ZETSU_MONITOR_V1) == 'table' then
    local prior = env.KIMS_ZETSU_MONITOR_V1
    prior.active = false
    if type(prior.close) == 'function' then pcall(prior.close) end
end

local state = {
    active = true, stopped = false, marker = nil, events = {}, groups = {},
    groupKeys = {}, hooks = {}, firstModules = {}, dropped = 0, monitored = 0,
    baseModules = 0, lastModules = 0, connections = {}, moduleReport = nil
}
env.KIMS_ZETSU_MONITOR_V1 = state

local function tidy(s, limit)
    s = tostring(s or ''):gsub('[\r\n\t]', ' ')
    if #s > (limit or 95) then return s:sub(1, limit or 95) .. '...' end
    return s
end
local function domain(url)
    if type(url) ~= 'string' then return '(unknown host)' end
    local h = url:match('^%a[%w+.-]*://([^/?#]+)')
    if not h then return '(local/non-URL)' end
    h = h:match('@(.+)$') or h -- discard user:pass@host if supplied
    return tidy((h:lower():gsub(':%d+$', '')), 70)
end
local function age()
    return math.max(0, math.floor(os.clock() - clockStart))
end
local function record(kind, key)
    if not state.active then return end
    key = tidy(key, 165)
    state.monitored = state.monitored + 1
    local id = kind .. '|' .. key
    local g = state.groups[id]
    if not g then
        if #state.groupKeys >= 100 then state.dropped = state.dropped + 1; return end
        g = {type=kind, name=key, count=0, first=age(), last=age(), after=0}
        state.groups[id] = g
        table.insert(state.groupKeys, id)
    end
    g.count = g.count + 1
    g.last = age()
    if state.marker and os.clock() >= state.marker then g.after = g.after + 1 end
    if #state.events < 160 then
        if g.count <= 2 or g.count == 5 or g.count == 20 then
            table.insert(state.events, string.format('[%03ds] %s %s', age(), kind, key))
        end
    else
        state.dropped = state.dropped + 1
    end
end

local function safeInstanceName(self)
    if typeof(self) ~= 'Instance' then return '(non-Instance)' end
    local name = tidy(self.Name, 56)
    local ok, path = pcall(function() return self:GetFullName() end)
    if ok and type(path) == 'string' then
        local suffix = path:match('ReplicatedStorage[%.%/](.+)')
        if suffix then return 'RS/' .. tidy(suffix, 125) end
        local suffix2 = path:match('ReplicatedFirst[%.%/](.+)')
        if suffix2 then return 'RF/' .. tidy(suffix2, 125) end
    end
    return name
end

local function moduleSnapshot()
    local result = {}
    if type(getloadedmodules) ~= 'function' then return result, 0, false end
    local ok, modules = pcall(getloadedmodules)
    if not ok or type(modules) ~= 'table' then return result, 0, false end
    local n = 0
    for _, v in pairs(modules) do
        if typeof(v) == 'Instance' and v:IsA('ModuleScript') then
            local ok2, full = pcall(function() return v:GetFullName() end)
            if ok2 and type(full) == 'string' then result[full] = true; n = n + 1 end
        end
    end
    return result, n, true
end

state.firstModules, state.baseModules, state.modulesAvailable = moduleSnapshot()

-- GUI: compact panel with metadata-only report, draggable on Android.
local old = pg:FindFirstChild('KIMSZetsuMonitorV1')
if old then old:Destroy() end
local screen = Instance.new('ScreenGui')
screen.Name = 'KIMSZetsuMonitorV1'
screen.ResetOnSpawn = false
screen.DisplayOrder = 9999
screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screen.Parent = pg

local panel = Instance.new('Frame')
panel.Name = 'Panel'
panel.Size = UDim2.new(.92, 0, .53, 0)
panel.Position = UDim2.new(.04, 0, .23, 0)
panel.BackgroundColor3 = Color3.fromRGB(13, 18, 33)
panel.BorderSizePixel = 0
panel.Active = true
panel.Draggable = true
panel.Parent = screen
Instance.new('UICorner', panel).CornerRadius = UDim.new(0, 10)
local stroke = Instance.new('UIStroke', panel)
stroke.Color = Color3.fromRGB(121, 89, 224)
stroke.Thickness = 2
local title = Instance.new('TextLabel', panel)
title.BackgroundTransparency = 1
title.Position = UDim2.new(.025, 0, 0, 7)
title.Size = UDim2.new(.95, 0, 0, 26)
title.TextXAlignment = Enum.TextXAlignment.Left
title.Text = 'KIMS ZETSU MONITOR | METADATA ONLY'
title.Font = Enum.Font.GothamBold
title.TextSize = 14
title.TextColor3 = Color3.fromRGB(196, 184, 255)
local function button(label, x, width)
    local b = Instance.new('TextButton', panel)
    b.Size = UDim2.new(width, 0, 0, 32)
    b.Position = UDim2.new(x, 0, 0, 40)
    b.Text = label
    b.TextScaled = true
    b.Font = Enum.Font.GothamBold
    b.TextColor3 = Color3.new(1, 1, 1)
    b.BackgroundColor3 = Color3.fromRGB(72, 56, 139)
    Instance.new('UICorner', b).CornerRadius = UDim.new(0, 6)
    return b
end
local markBtn = button('TANDA ZETSU', .025, .26)
local stopBtn = button('STOP', .300, .17)
local copyBtn = button('SALIN', .485, .17)
local miniBtn = button('MINI', .670, .14)
local exitBtn = button('X', .826, .135)
local status = Instance.new('TextLabel', panel)
status.Position = UDim2.new(.025, 0, 0, 77)
status.Size = UDim2.new(.95, 0, 0, 24)
status.BackgroundTransparency = 1
status.TextColor3 = Color3.fromRGB(109, 230, 166)
status.TextXAlignment = Enum.TextXAlignment.Left
status.Font = Enum.Font.Code
status.TextSize = 12
status.Text = 'Memasang monitor...'
local scroll = Instance.new('ScrollingFrame', panel)
scroll.Position = UDim2.new(.025, 0, 0, 105)
scroll.Size = UDim2.new(.95, 0, 1, -113)
scroll.BackgroundColor3 = Color3.fromRGB(23, 30, 48)
scroll.BorderSizePixel = 0
scroll.ScrollBarThickness = 6
scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
scroll.Parent = panel
local reportLabel = Instance.new('TextLabel', scroll)
reportLabel.Position = UDim2.new(0, 6, 0, 5)
reportLabel.Size = UDim2.new(1, -16, 0, 0)
reportLabel.AutomaticSize = Enum.AutomaticSize.Y
reportLabel.BackgroundTransparency = 1
reportLabel.TextWrapped = true
reportLabel.TextXAlignment = Enum.TextXAlignment.Left
reportLabel.TextYAlignment = Enum.TextYAlignment.Top
reportLabel.Font = Enum.Font.Code
reportLabel.TextSize = 12
reportLabel.TextColor3 = Color3.fromRGB(220, 230, 244)

local createClosure = type(newcclosure) == 'function' and newcclosure or function(f) return f end
local namecallHooked = false
if type(hookmetamethod) == 'function' and type(getnamecallmethod) == 'function' then
    local previous
    local ok = pcall(function()
        previous = hookmetamethod(game, '__namecall', createClosure(function(self, ...)
            if state.active then
                local method = getnamecallmethod()
                if method == 'FireServer' or method == 'InvokeServer' then
                    if typeof(self) == 'Instance' then
                        local cls = self.ClassName
                        if cls == 'RemoteEvent' or cls == 'RemoteFunction' or cls == 'UnreliableRemoteEvent' then
                            record('REMOTE', method .. ' ' .. safeInstanceName(self))
                        end
                    end
                elseif method == 'HttpGet' or method == 'HttpGetAsync' or method == 'GetAsync' or method == 'PostAsync' or method == 'RequestAsync' then
                    local first = select(1, ...)
                    if type(first) == 'string' then
                        record('HTTP-ROBLOX', method .. ' ' .. domain(first))
                    elseif type(first) == 'table' then
                        record('HTTP-ROBLOX', method .. ' ' .. domain(first.Url or first.URL))
                    end
                end
            end
            return previous(self, ...)
        end))
    end)
    namecallHooked = ok
end
state.hooks[#state.hooks + 1] = 'Namecall Roblox: ' .. (namecallHooked and 'OK' or 'unavailable')

local hookedFunctions = {}
local function hookRequest(fn, tag)
    if type(fn) ~= 'function' or type(hookfunction) ~= 'function' then return end
    if hookedFunctions[fn] then return end
    hookedFunctions[fn] = true
    local original
    local ok = pcall(function()
        original = hookfunction(fn, createClosure(function(options, ...)
            if state.active then
                local url, method
                if type(options) == 'table' then
                    url = options.Url or options.URL or options.url
                    method = options.Method or options.method or 'GET'
                elseif type(options) == 'string' then
                    url, method = options, 'GET'
                end
                record('HTTP-EXEC', tostring(method):upper():sub(1, 8) .. ' ' .. domain(url))
            end
            return original(options, ...)
        end))
    end)
    if ok then state.hooks[#state.hooks + 1] = tag .. ': OK'
    else state.hooks[#state.hooks + 1] = tag .. ': unavailable' end
end
local function field(tableObj, key)
    if type(tableObj) ~= 'table' then return nil end
    local ok, v = pcall(function() return tableObj[key] end)
    return ok and v or nil
end
hookRequest(field(env, 'request'), 'request')
hookRequest(field(env, 'http_request'), 'http_request')
hookRequest(field(env, 'http'), 'http') -- normally a table, ignored
hookRequest(field(field(env, 'syn'), 'request'), 'syn.request')
hookRequest(field(field(env, 'http'), 'request'), 'http.request')
hookRequest(field(env, 'fluxus') and field(field(env, 'fluxus'), 'request'), 'fluxus.request')
hookRequest(field(_G, 'request'), '_G.request')

local function updateModuleReport()
    local out = {}
    local now, currentCount, available = moduleSnapshot()
    out[#out + 1] = 'baseline=' .. tostring(state.baseModules) .. ' now=' .. tostring(currentCount) .. ' available=' .. tostring(available)
    if available then
        local total, shown = 0, 0
        for name in pairs(now) do
            if not state.firstModules[name] then
                total = total + 1
                if shown < 25 then
                    out[#out + 1] = 'NEW MODULE ' .. tidy(name, 145)
                    shown = shown + 1
                end
            end
        end
        out[#out + 1] = 'New modules=' .. tostring(total)
    end
    state.moduleReport = out
end

local function report()
    local lines = {
        'KIMS ZETSU MONITOR V1 | METADATA ONLY',
        'PlaceId=' .. tostring(game.PlaceId),
        'Elapsed=' .. tostring(age()) .. 's | status=' .. (state.active and 'RECORDING' or 'STOPPED'),
        'ZETSU MARK=' .. (state.marker and tostring(math.floor(state.marker - clockStart)) .. 's' or 'not set'),
        'No request body, headers, keys, URL query or item payload stored.',
        '', '=== INSTALLED HOOKS ===',
    }
    for _, s in ipairs(state.hooks) do lines[#lines + 1] = s end
    lines[#lines + 1] = ''
    lines[#lines + 1] = '=== NETWORK / REMOTE SUMMARY ==='
    lines[#lines + 1] = 'Unique events=' .. tostring(#state.groupKeys) .. ' | seen=' .. tostring(state.monitored) .. ' | truncated=' .. tostring(state.dropped)
    for _, id in ipairs(state.groupKeys) do
        local g = state.groups[id]
        if g then
            lines[#lines + 1] = g.type .. ' x' .. tostring(g.count) .. ' afterMark=' .. tostring(g.after) .. ' @' .. tostring(g.first) .. 's ' .. g.name
        end
    end
    lines[#lines + 1] = ''
    lines[#lines + 1] = '=== MODULES LOADED AFTER MONITOR START ==='
    for _, line in ipairs(state.moduleReport or {'Snapshot calculated on STOP or SALIN.'}) do
        lines[#lines + 1] = line
    end
    lines[#lines + 1] = ''
    lines[#lines + 1] = '=== SAMPLED TIMELINE ==='
    for _, e in ipairs(state.events) do lines[#lines + 1] = e end
    lines[#lines + 1] = ''
    lines[#lines + 1] = 'Interpretation: Remotes may be normal game traffic; host alone does not prove where inventory was read.'
    lines[#lines + 1] = 'Direct local module/cache reads and native executor traffic can escape these hooks.'
    return table.concat(lines, '\n')
end

markBtn.MouseButton1Click:Connect(function()
    if not state.marker then
        state.marker = os.clock()
        record('MARK', 'User is about to execute Zetsu')
        markBtn.Text = 'DITANDAI'
    end
end)
stopBtn.MouseButton1Click:Connect(function()
    state.active = false
    state.stopped = true
    stopBtn.Text = 'STOPPED'
    updateModuleReport()
    status.Text = 'STOPPED | tekan SALIN'
    reportLabel.Text = report()
end)
copyBtn.MouseButton1Click:Connect(function()
    if not state.moduleReport then updateModuleReport() end
    local txt = report()
    if type(setclipboard) == 'function' then
        local ok = pcall(setclipboard, txt)
        status.Text = ok and 'Laporan metadata tersalin.' or 'Clipboard gagal; lihat panel.'
    else
        status.Text = 'Delta tidak menyediakan setclipboard.'
    end
    reportLabel.Text = txt
end)
local mini = false
miniBtn.MouseButton1Click:Connect(function()
    mini = not mini
    if mini then
        panel.Size = UDim2.new(.92, 0, 0, 110)
        scroll.Visible = false
        miniBtn.Text = 'BUKA'
    else
        panel.Size = UDim2.new(.92, 0, .53, 0)
        scroll.Visible = true
        miniBtn.Text = 'MINI'
    end
end)
local function close()
    state.active = false
    state.stopped = true
    if screen.Parent then screen:Destroy() end
end
state.close = close
exitBtn.MouseButton1Click:Connect(close)

record('STATUS', 'Monitor ready (run before Zetsu loader)')
task.spawn(function()
    while screen.Parent and not state.stopped do
        local e = #state.groupKeys
        status.Text = (state.active and 'REC ON | ' or 'OFF | ') .. 'unique=' .. tostring(e) ..
            ' | hits=' .. tostring(state.monitored) ..
            (state.marker and ' | ZETSU MARKED' or ' | press TANDA ZETSU')
        reportLabel.Text = report()
        task.wait(1.5)
    end
end)
