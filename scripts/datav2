local function toggleRow(title, subtitle, key)
    local frame = card(68)
    textLabel(frame, title, 14, true, C.white, {
        Position = UDim2.fromOffset(13, 8), Size = UDim2.new(1, -111, 0, 24),
    })
    textLabel(frame, subtitle or "Demo toggle — not connected to game", 10, false, C.muted, {
        Position = UDim2.fromOffset(14, 35), Size = UDim2.new(1, -110, 0, 20),
    })
    local button = textButton(frame, "", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -12, 0.5, 0),
        Size = UDim2.fromOffset(84, 33),
        TextSize = 10,
    })
    round(button, 17)
    local function paint()
        local checked = (state.previewToggles[key] == true)
        button.Text = checked and "ON · DEMO" or "OFF · DEMO"
        button.BackgroundColor3 = checked and C.glow or C.surface
        button.TextColor3 = checked and C.white or C.muted
    end
    paint()
    trackContent(button.MouseButton1Click:Connect(function()
        state.previewToggles[key] = not (state.previewToggles[key] == true)
        paint()
        toast(title .. " is a visual preview; gameplay is unchanged.")
    end))
end

local function selectorRow(title, subtitle, key, options, onChanged)
    local viewport = (workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize) or Vector2.new(920, 570)
    local narrow = viewport.X < 560
    local frame = card(narrow and 110 or 70)
    textLabel(frame, title, 13, true, C.white, {
        Position = UDim2.fromOffset(12, 8),
        Size = narrow and UDim2.new(1, -24, 0, 24) or UDim2.new(1, -190, 0, 25),
    })
    textLabel(frame, subtitle or "Tap to cycle options", 10, false, C.muted, {
        Position = UDim2.fromOffset(12, narrow and 30 or 36),
        Size = narrow and UDim2.new(1, -24, 0, 19) or UDim2.new(1, -190, 0, 22),
    })
    local selector = textButton(frame, "", {
        AnchorPoint = narrow and Vector2.new(0, 0) or Vector2.new(1, 0.5),
        Position = narrow and UDim2.fromOffset(12, 58) or UDim2.new(1, -12, 0.5, 0),
        Size = narrow and UDim2.new(1, -24, 0, 38) or UDim2.fromOffset(154, 37),
        BackgroundColor3 = C.surface,
        TextSize = 11,
    })
    round(selector, 9)
    stroke(selector, C.border, 1, 0.15)
    local function display()
        selector.Text = tostring(state.choices[key] or options[1]) .. "  >"
    end
    display()
    trackContent(selector.MouseButton1Click:Connect(function()
        local position = 1
        for index, option in ipairs(options) do
            if option == state.choices[key] then
                position = index
                break
            end
        end
        state.choices[key] = options[(position % #options) + 1]
        display()
        if onChanged then
            onChanged(state.choices[key])
        else
            toast(title .. " selection is UI-only in V1.")
        end
    end))
end

