outputFrame.Position=UDim2.new(.025,0,0,112)
outputFrame.Size=UDim2.new(.95,0,1,-124)
outputFrame.BackgroundColor3=Color3.fromRGB(22,30,50)
outputFrame.ScrollBarThickness=5
outputFrame.BorderSizePixel=0
outputFrame.AutomaticCanvasSize=Enum.AutomaticSize.Y
