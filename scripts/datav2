-- Keep UI movable on Android.
local dragging=false
local origin,position,dragInput
local conn={}
local function link(s,fn)
    local ok,c=pcall(function() return s:Connect(fn) end)
    if ok and c then conn[#conn+1]=c end
end
link(title.InputBegan,function(input)
    if input.UserInputType==Enum.UserInputType.Touch or input.UserInputType==Enum.UserInputType.MouseButton1 then
        dragging=true; origin=input.Position; position=panel.Position; dragInput=input
    end
end)
link(UserInputService.InputChanged,function(input)
    if dragging and (input==dragInput or (dragInput and dragInput.UserInputType==Enum.UserInputType.MouseButton1 and input.UserInputType==Enum.UserInputType.MouseMovement)) then
        local d=input.Position-origin
        panel.Position=UDim2.new(position.X.Scale,position.X.Offset+d.X,position.Y.Scale,position.Y.Offset+d.Y)
    end
end)
link(UserInputService.InputEnded,function(input)
    if dragging and (input==dragInput or input.UserInputType==Enum.UserInputType.MouseButton1) then dragging=false end
end)

local CATS={'Fish','Rods','Baits','Items','Charms','Emotes','Abilities','Pets'}
local names={}
for _,c in ipairs(CATS) do names[c:lower()]=c end
local pages={Inventory2='Fish/Items',Rods2='Rods',Baits='Baits',Charms='Charms',Abilities='Abilities',Pets='Pets',Emotes='Emotes'}
local data={}
for _,c in ipairs(CATS) do data[c]={visits=0,shots=0,tiles=0,labels=0,samples={},sampleSet={},attr={},counters={},page='',qtyLabels=0,firstPath='',source=''} end
local extra={visits=0,shots=0,tiles=0,labels=0,samples={},sampleSet={},attr={},counters={},page='',qtyLabels=0,firstPath='',source=''}
data['Fish/Items']=extra
local state={started=os.clock(),running=true,closed=false,expanded=false,selected=nil,selectedAt=0,root=nil,
            scans=0,events={},eventDropped=0,rawPairs={},rawSet={},busy=false,lastScan=0,
            seenTab={},boundButtons=setmetatable({}, {__mode='k'}),boundPages=setmetatable({}, {__mode='k'}),
            roots=setmetatable({}, {__mode='k'}),report='',json=''}
local function log(s)
    local line=string.format('[%03ds] %s',math.floor(os.clock()-state.started),s)
    state.events[#state.events+1]=line
    if #state.events>100 then table.remove(state.events,1);state.eventDropped=state.eventDropped+1 end
end
local function clean(v,maxlen)
    local s=tostring(v or '')
    s=s:gsub('<[^>]*>',''):gsub('[\r\n\t]',' '):gsub('%s+',' '):gsub('^%s+',''):gsub('%s+$','')
    if #s>(maxlen or 110) then s=s:sub(1,maxlen or 110)..'...' end
    return s
end
local function pathOf(n)
    local parts={}
    local step=0
    while n and n~=pg and step<15 do
        table.insert(parts,1,n.Name)
        n=n.Parent
        step=step+1
    end
    return table.concat(parts,'/')
end
local function isText(n)
    return n:IsA('TextLabel') or n:IsA('TextButton') or n:IsA('TextBox')
end
local function isVisible(n)
    while n and n~=pg do
        if n:IsA('GuiObject') and not n.Visible then return false end
        if n:IsA('ScreenGui') and not n.Enabled then return false end
        n=n.Parent
    end
    return n==pg
end
local function inventoryRoot()
    local inv=pg:FindFirstChild('Inventory')
    if inv and inv:IsA('ScreenGui') then return inv end
    return nil
end
local function findPages(inv)
    local n=inv and inv:FindFirstChild('Main')
    n=n and n:FindFirstChild('Content')
    return n and n:FindFirstChild('Pages')
end
local function categoryFromOption(n)
    local p=n
    for _=1,10 do
        if not p then break end
        if p.Parent and p.Parent.Name=='Options' then return names[p.Name:lower()] end
        p=p.Parent
    end
    return nil
end
local function categoryFromPage(n)
    local p=n
    for _=1,16 do
        if not p then break end
        if p.Parent and p.Parent.Name=='Pages' then
            local c=pages[p.Name]
            if c=='Fish/Items' then
                -- The shared page cannot identify Fish versus Items by itself.
                -- A top-tab path or named text is required to attribute its counter.
                return 'Fish/Items'
            end
            return c
        end
        p=p.Parent
    end
    return nil
end
local function addSample(r,value)
    value=clean(value,75)
    if value=='' or value=='ItemName' or r.sampleSet[value] then return end
    if #r.samples<7 then
        r.samples[#r.samples+1]=value
        r.sampleSet[value]=true
    end
end
local function parsePair(txt)
    -- Accept 886/4,500, 1.126 / 400 and 'Fish: 886 / 4500'.
    -- Never treat ratio 1/40M as an inventory count.
    local a,b=txt:match('(%d[%d,.]*)%s*/%s*(%d[%d,.]*)')
    if not a then return nil end
    if txt:match('%d[%d,.]*%s*/%s*%d[%d,.]*%s*[MmKkBb]') then return nil end
    local va=tonumber((a:gsub('[,.]','')))
    local vb=tonumber((b:gsub('[,.]','')))
    if not va or not vb then return nil end
    if va>100000000 or vb>100000000 or vb==0 then return nil end
    return va,vb
end
local function keepCounter(category,record)
    if not category or not data[category] then return end
    local r=data[category]
    -- Same source path can change as the player keeps fishing; update the latest reading.
    for _,old in ipairs(r.counters) do
        if old.path==record.path then
            old.current=record.current;old.capacity=record.capacity
            old.text=record.text;old.time=record.time;old.evidence=record.evidence
            return
        end
    end
    if #r.counters<12 then r.counters[#r.counters+1]=record end
end
local function inspectCounters(inv,category,reason)
    local objs=inv:GetDescendants()
    local inspected=0
    local count=0
    for _,n in ipairs(objs) do
        inspected=inspected+1
        if inspected>12500 then break end
        if isText(n) then
            local t=clean(n.Text,115)
            local current,capacity=parsePair(t)
            if current then
                count=count+1
                local inTab=categoryFromOption(n)
                local inPage=categoryFromPage(n)
                local named=nil
                for _,cat in ipairs(CATS) do
                    if t:lower():match('^'..cat:lower()..'%f[%A]') then named=cat;break end
                end
                local owner=inTab or named or inPage
                -- Fish and Items share Inventory2; only tab evidence can distinguish them.
                local proof='page'
                if inTab then proof='tab'
                elseif named then proof='named_label'
                elseif inPage then proof='page' end
                local visible=isVisible(n)
                if visible and owner and data[owner] then
                    keepCounter(owner,{current=current,capacity=capacity,text=t,path='PlayerGui/'..pathOf(n),
                                       evidence=proof,time=math.floor(os.clock()-state.started)})
                end
                local key=pathOf(n)..'|'..t
                if not state.rawSet[key] and #state.rawPairs<30 then
                    state.rawSet[key]=true
                    state.rawPairs[#state.rawPairs+1]={category=owner or '?',proof=proof,
                         path='PlayerGui/'..pathOf(n),text=t,visible=visible}
                end
            end
        end
        if inspected%2600==0 then task.wait() end
    end
    return count,inspected
end
local function descendantVariant(n,tile)
    local p=n.Parent
    while p and p~=tile do
        if p.Name=='Variant' then return true end
        p=p.Parent
    end
    return false
end
local function inspectPage(page,cat)
    local r=data[cat] or extra
    r.visits=math.max(r.visits,1)
    r.shots=r.shots+1
    r.page=page.Name
    local descendants=page:GetDescendants()
    local tiles,labels,quantities=0,0,0
    local perPageNames={}
    local seenTile=setmetatable({}, {__mode='k'})
    for i,n in ipairs(descendants) do
        if i>7000 then break end
        if n.Name=='Tile' and n:IsA('GuiObject') then
            tiles=tiles+1
            if tiles<30 then
                local ok,attrs=pcall(function() return n:GetAttributes() end)
                if ok and attrs then
                    for k,v in pairs(attrs) do
                        local label=clean(k,35)..' ('..type(v)..')'
                        r.attr[label]=true
                    end
                end
            end
        elseif n.Name=='ItemName' and isText(n) then
            local txt=clean(n.Text,80)
            local p=n.Parent
            local tile=nil
            for _=1,10 do
                if not p or p==page then break end
                if p.Name=='Tile' then tile=p;break end
                p=p.Parent
            end
            if txt~='' and txt~='ItemName' and not descendantVariant(n,tile or page) then
                labels=labels+1
                addSample(r,txt)
                if r.firstPath=='' then r.firstPath='PlayerGui/'..pathOf(n) end
                if tile then seenTile[tile]=true end
            end
        elseif (n.Name=='Quantity' or n.Name=='Count') and isText(n) then
            local txt=clean(n.Text,50)
            if txt~='' then
                quantities=quantities+1
                if quantities<=4 and n.Parent then
                    local parentName=clean(n.Parent.Name,35)
                    if parentName~='Tile' then addSample(r,parentName..' ('..txt..')') end
                end
            end
        end
    end
    r.tiles=math.max(tiles,r.tiles)
    r.labels=math.max(labels,r.labels)
    r.qtyLabels=math.max(quantities,r.qtyLabels)
    return tiles,labels,quantities
end
local function activePage(inv)
    local root=findPages(inv)
    if not root then return nil end
    for _,page in ipairs(root:GetChildren()) do
        if page:IsA('GuiObject') and isVisible(page) then return page end
    end
    return nil
end
local function snapshot(reason)
    if not state.running or state.busy then return end
    local now=os.clock()
    if now-state.lastScan<.32 then return end
    state.lastScan=now
    state.busy=true
    local ok,err=pcall(function()
        local inv=inventoryRoot()
        if not inv or not inv.Enabled then
            log('SNAP '..reason..' | inventory closed/not mounted')
            return
        end
        local page=activePage(inv)
        local cat=state.selected
        if page then
            local mapped=pages[page.Name]
            if mapped=='Fish/Items' then
                if cat~='Fish' and cat~='Items' then cat='Fish/Items' end
            elseif mapped then cat=mapped end
        end
        if not cat then cat='Fish/Items' end
        local r=data[cat] or extra
        r.visits=math.max(r.visits,1)
        local tiles,labels,quantities=0,0,0
        if page then tiles,labels,quantities=inspectPage(page,cat) end
        local counters,visited=inspectCounters(inv,cat,reason)
        state.scans=state.scans+1
        log('SNAP '..reason..' tab='..cat..' page='..(page and page.Name or '?')..
            ' GUItiles='..tiles..' names='..labels..' quantityLabels='..quantities..
            ' pairsInRoot='..counters..' inspected='..visited)
        status.Text='REC ON | '..state.scans..' captures | tab '..cat
    end)
    state.busy=false
    if not ok then log('SNAP ERROR '..clean(err,125)) end
end
local function scheduleSnapshot(label)
    task.delay(.38,function() if state.running then snapshot(label..'+380ms') end end)
    task.delay(1.20,function() if state.running then snapshot(label..'+1200ms') end end)
end
local function chooseCategory(cat,from)
    if not data[cat] then return end
    local elapsed=os.clock()-state.selectedAt
    if state.selected==cat and elapsed<.18 then return end
    state.selected=cat
    state.selectedAt=os.clock()
    data[cat].visits=data[cat].visits+1
    state.seenTab[cat]=true
    log('TAB '..cat..' via '..from)
    scheduleSnapshot('tab '..cat)
end
local function attachOptionButtons(inv)
    local main=inv:FindFirstChild('Main')
    local top=main and main:FindFirstChild('Top')
    local options=top and top:FindFirstChild('Options')
    if not options then return end
    -- Listen to a tab's own GuiButton and to nested buttons, without sending clicks.
    for _,obj in ipairs(options:GetDescendants()) do
        if obj:IsA('GuiButton') and not state.boundButtons[obj] then
            local cat=categoryFromOption(obj)
            if cat then
                state.boundButtons[obj]=true
                link(obj.Activated,function() if state.running then chooseCategory(cat,'Options/'..obj.Name) end end)
            end
        end
    end
    for _,obj in ipairs(options:GetChildren()) do
        if obj:IsA('GuiButton') and not state.boundButtons[obj] then
            local cat=names[obj.Name:lower()]
            if cat then
                state.boundButtons[obj]=true
                link(obj.Activated,function() if state.running then chooseCategory(cat,'Options') end end)
            end
        end
    end
end
local function attachPages(inv)
    local root=findPages(inv)
    if not root then return end
    for _,p in ipairs(root:GetChildren()) do
        if p:IsA('GuiObject') and not state.boundPages[p] then
            state.boundPages[p]=true
            link(p:GetPropertyChangedSignal('Visible'),function()
                if not state.running or not p.Visible then return end
                local mapped=pages[p.Name]
                if mapped and mapped~='Fish/Items' and state.selected~=mapped then
                    -- Non-shared pages can identify the category even if a click was missed.
                    chooseCategory(mapped,'visible page')
                else
                    scheduleSnapshot('visible '..p.Name)
                end
            end)
        end
    end
end
local function bindRoot(inv)
    if state.roots[inv] then return end
    state.roots[inv]=true
    state.root=inv
    attachOptionButtons(inv)
    attachPages(inv)
    link(inv:GetPropertyChangedSignal('Enabled'),function()
        if state.running then
            log('GUI Enabled='..tostring(inv.Enabled))
            if inv.Enabled then scheduleSnapshot('open') end
        end
    end)
    link(inv.DescendantAdded,function(n)
        if not state.running then return end
        if n.Parent and (n.Parent.Name=='Options' or n.Parent.Name=='Pages') then
            task.defer(function()
                if state.running then attachOptionButtons(inv);attachPages(inv) end
            end)
        end
    end)
    log('BOUND PlayerGui/Inventory + Main/Top/Options + Pages')
    scheduleSnapshot('initial')
end
local function statValue(n)
    local ls=player:FindFirstChild('leaderstats')
    local v=ls and ls:FindFirstChild(n)
    if v and v:IsA('ValueBase') then return tostring(v.Value) end
    return '?'
end
local function reportData()
    local result={
        version='13',source='Roblox client GUI (not authoritative server storage)',
        username=player.Name,userId=player.UserId,placeId=game.PlaceId,
        capturedAt=os.time(),captureDurationSeconds=math.floor(os.clock()-state.started),
        categoryResults={},unassignedCounterEvidence={},
        warnings={'GUI tile totals and sample names are not full item ownership counts.',
                  'Fish and Items share Inventory2, and must be separated by tab click.',
                  'UI counters are snapshots at observation time; no automatic upload.'}
    }
    for _,cat in ipairs(CATS) do
        local r=data[cat]
        result.categoryResults[cat]={tabSeen=(state.seenTab[cat] or false),page=r.page,
            maxGuiTilesSeen=r.tiles,maxNameLabelsSeen=r.labels,quantityLabelsSeen=r.qtyLabels,
            sampleNames=r.samples,exampleNamePath=r.firstPath,attributeNames={},counterEvidence=r.counters}
        for key,_ in pairs(r.attr) do result.categoryResults[cat].attributeNames[#result.categoryResults[cat].attributeNames+1]=key end
        table.sort(result.categoryResults[cat].attributeNames)
    end
    for _,record in ipairs(state.rawPairs) do
        result.unassignedCounterEvidence[#result.unassignedCounterEvidence+1]=record
    end
    return result
end
local function makeReport()
    local out={
        'KIMS INVENTORY AUTO READER V13 | READ ONLY | NO UPLOAD',
        'USER @'..player.Name..' | UserId='..tostring(player.UserId),
        'PlaceId='..tostring(game.PlaceId)..' | duration='..math.floor(os.clock()-state.started)..'s',
        'Capture='..state.scans..' | status='..(state.running and 'RECORDING' or 'STOPPED'),
        'Caught LIFETIME='..statValue('Caught')..' | Rarest Fish='..statValue('Rarest Fish'),
        '', '=== 8 CATEGORIES | CURRENT GUI SNAPSHOTS ==='
    }
    for _,cat in ipairs(CATS) do
        local r=data[cat]
        out[#out+1]='\n['..cat..'] tab clicked='..tostring(state.seenTab[cat] or false)..
            ' | page='..(r.page~='' and r.page or '?')..' | captures='..r.shots
        out[#out+1]='  GUI tiles max='..r.tiles..' | name labels max='..r.labels..' | quantity labels max='..r.qtyLabels
        if #r.samples>0 then out[#out+1]='  examples: '..table.concat(r.samples,' ; ') end
        if r.firstPath~='' then out[#out+1]='  first name path: '..r.firstPath end
        local attr={}
        for k,_ in pairs(r.attr) do attr[#attr+1]=k end
        table.sort(attr)
        if #attr>0 then out[#out+1]='  tile attribute keys/types: '..table.concat(attr,', ') end
        if #r.counters==0 then
            out[#out+1]='  counter: belum terdeteksi (BUKAN nol)'
        else
            for i,e in ipairs(r.counters) do
                if i>6 then break end
                out[#out+1]='  pair '..i..': '..e.current..' / '..e.capacity..' ['..e.evidence..' at '..e.time..'s] '..e.path
            end
            out[#out+1]='  WARNING: pair angka tidak otomatis berarti total kepemilikan.'
        end
    end
    if extra.shots>0 then
        out[#out+1]='\n[Fish/Items UNRESOLVED] captures='..extra.shots..' | tiles='..extra.tiles
        out[#out+1]='  Sebelum klik Fish/Items, shared page tidak boleh diatribusikan ke salah satu.'
    end
    out[#out+1]='\n=== RAW GUI COUNTER EVIDENCE (max 30) ==='
    if #state.rawPairs==0 then out[#out+1]='  Tidak ada pasangan angka terbaca dari Inventory root.' end
    for _,r in ipairs(state.rawPairs) do
        out[#out+1]='  '..r.category..' ['..r.proof..', visible='..tostring(r.visible)..'] '..r.text..' @ '..r.path
    end
    out[#out+1]='\n=== CAPTURE TIMELINE (last 100) ==='
    for _,line in ipairs(state.events) do out[#out+1]=line end
    out[#out+1]='\nREAD ONLY. No require/getgc/HTTP/remotes/upload/auto-scroll/inventory modification.'
    out[#out+1]='Counters are game GUI observations, not proof of a complete item database.'
    return table.concat(out,'\n')
end
local function updatePreview()
    state.report=makeReport()
    local ok,result=pcall(function() return HttpService:JSONEncode(reportData()) end)
    state.json=ok and result or '{"error":"json encoding failed"}'
    if state.expanded then display.Text=state.report end
end
local function stopRecording()
    if not state.running then return end
    snapshot('stop')
    state.running=false
    log('STOP pressed. Capture frozen.')
    updatePreview()
    stopBtn.Text='SELESAI'
    stopBtn.BackgroundColor3=Color3.fromRGB(48,100,80)
    status.Text='STOPPED | SALIN laporan atau JSON'
    for _,c in ipairs(conn) do pcall(function() c:Disconnect() end) end
    conn={}
end
link(signal.Event,stopRecording)
stopBtn.MouseButton1Click:Connect(stopRecording)
local function copy(s,b,original)
    if state.running then updatePreview() end
    local fn=(type(setclipboard)=='function' and setclipboard) or (type(toclipboard)=='function' and toclipboard)
    if not fn then b.Text='NO COPY';return end
    local ok=pcall(fn,s)
    b.Text=ok and 'TERSALIN' or 'GAGAL'
    task.delay(2,function() if b.Parent then b.Text=original end end)
end
copyBtn.MouseButton1Click:Connect(function()
    updatePreview()
    copy(state.report,copyBtn,'SALIN')
end)
jsonBtn.MouseButton1Click:Connect(function()
    updatePreview()
    copy(state.json,jsonBtn,'JSON')
end)
viewBtn.MouseButton1Click:Connect(function()
    state.expanded=not state.expanded
    box.Visible=state.expanded
    panel.Size=state.expanded and UDim2.new(.92,0,.67,0) or UDim2.new(.92,0,0,112)
    viewBtn.Text=state.expanded and 'CIUT' or 'HASIL'
    if state.expanded then updatePreview() end
end)
closeBtn.MouseButton1Click:Connect(function()
    stopRecording()
    state.closed=true
    screen:Destroy()
end)

log('AUTO REC ON. Buka Fish, Rods, Baits, Items, Charms, Emotes, Abilities, Pets.')
log('TAB-CLICK distinguishes Fish vs Items; page Inventory2 alone cannot.')
local first=inventoryRoot()
if first then bindRoot(first) else log('Waiting for PlayerGui.Inventory...') end
link(pg.ChildAdded,function(n)
    if state.running and n.Name=='Inventory' then bindRoot(n) end
end)

-- Fallback for games that reuse an existing page or create tabs after startup.
-- No getgc, no scanning 200k memory objects, no heavy per-tile listeners.
task.spawn(function()
    local lastActive=''
    while state.running and screen.Parent do
        task.wait(1.75)
        if not state.running then break end
        local inv=inventoryRoot()
        if inv then
            if not state.roots[inv] then bindRoot(inv) end
            attachOptionButtons(inv)
            attachPages(inv)
            if inv.Enabled then
                local page=activePage(inv)
                local key=(page and page.Name or '?')..'/'..(state.selected or '?')
                if key~=lastActive then
                    lastActive=key
                    snapshot('fallback category/page')
                end
            end
        end
    end
end)
