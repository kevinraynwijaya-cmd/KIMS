local rayfieldSource, rayfieldErr = safeHttpGet('https://sirius.menu/rayfield')
if not rayfieldSource then
    error("❌ Gagal load Rayfield: " .. tostring(rayfieldErr) .. "\nCoba matikan VPN atau ganti executor.")
    return
end

local Rayfield
local ok, res = pcall(function() return loadstring(rayfieldSource)() end)
if not ok then
    error("❌ Rayfield error: " .. tostring(res))
    return
end
Rayfield = res

