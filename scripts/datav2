    Name = "Show Status",
    Callback = function()
        notify("Auto Fish: " .. (state.autoFish and "ON" or "OFF") ..
            " | Webhook: " .. (state.monitor and "ON" or "OFF") ..
            " | Reel requests: " .. state.requestsSent)
    end
})

local Fishing = Window:CreateTab("Fishing", 4483362458)
Fishing:CreateSection("Normal Fishing Engine (Experimental)")
local fishToggle
fishToggle = Fishing:CreateToggle({
    Name = "Auto Fish (Experimental)",
    CurrentValue = false,
    Flag = "KIMS_V2_AutoFish",
    Callback = function(value)
        if value then
            if not startFishing() then
                task.defer(function()
                    if fishToggle then pcall(function() fishToggle:Set(false) end) end
                end)
            end
        else
            stopFishing()
            notify("Auto Fish OFF")
        end
    end
})
Fishing:CreateDropdown({
    Name = "Cast Protocol (Experimental)",
    Options = {"KIMS V1.3", "Draa"},
    CurrentOption = {"KIMS V1.3"},
    MultipleOptions = false,
    Flag = "KIMS_V2_CastProtocol",
    Callback = function(selected)
        if type(selected) == "table" then
            state.protocol = selected[1] or "KIMS V1.3"
        elseif type(selected) == "string" then
            state.protocol = selected
        end
        notify("Cast protocol: " .. state.protocol)
    end
})
Fishing:CreateSlider({
    Name = "Fishing Delay",
    Range = {1, 10}, Increment = 0.5, Suffix = "s",
    CurrentValue = state.fishDelay,
    Flag = "KIMS_V2_FishDelay",
    Callback = function(value) state.fishDelay = value end
})
Fishing:CreateSlider({
    Name = "Catch Delay",
    Range = {0.3, 3}, Increment = 0.1, Suffix = "s",
    CurrentValue = state.catchDelay,
    Flag = "KIMS_V2_CatchDelay",
    Callback = function(value) state.catchDelay = value end
})
Fishing:CreateButton({
    Name = "Stop Fishing Now",
    Callback = function()
        stopFishing()
        if fishToggle then pcall(function() fishToggle:Set(false) end) end
        notify("Auto Fish stopped")
    end
})

local Teleport = Window:CreateTab("Teleport", 4483362458)
Teleport:CreateSection("Saved Location - Local Player")
Teleport:CreateButton({
    Name = "Save Current Position",
    Callback = function()
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then notify("Character root not found"); return end
        state.savedPosition = root.CFrame
        notify("Current position saved (this session)")
    end
})
Teleport:CreateButton({
    Name = "Teleport to Saved Position",
    Callback = function()
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root or not state.savedPosition then
            notify("Save a position first")
            return
        end
        local ok, err = pcall(function() root.CFrame = state.savedPosition end)
        notify(ok and "Teleport requested" or ("Teleport failed: " .. tostring(err)))
    end
})

local Webhook = Window:CreateTab("Webhook", 4483362458)
Webhook:CreateSection("Discord Fish Alerts")
Webhook:CreateParagraph({
    Title = "Privacy",
    Content = "Webhook URL hanya disimpan sementara di memori perangkat, bukan di GitHub/config. Jangan bagikan URL webhook ke orang lain."
})
Webhook:CreateInput({
    Name = "Discord Webhook URL",
    CurrentValue = "",
    PlaceholderText = "https://discord.com/api/webhooks/...",
    RemoveTextAfterFocusLost = false,
    Flag = "KIMS_V2_WebhookURL",
    Callback = function(value)
        local url = type(value) == "string" and value:match("^%s*(.-)%s*$") or ""
        if url == "" then
            state.webhookURL = ""
            stopMonitor()
            notify("Webhook URL cleared; monitoring OFF")
        elseif validDiscordURL(url) then
            state.webhookURL = url
            notify("Webhook URL valid (not saved)")
        else
            state.webhookURL = ""
            stopMonitor()
            notify("Discord webhook URL tidak valid", 7)
        end
    end
})
Webhook:CreateDropdown({
    Name = "Rarity Filter",
    Options = {"Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic", "Secret", "Forgotten"},
    CurrentOption = {"Secret", "Forgotten"},
    MultipleOptions = true,
    Flag = "KIMS_V2_RarityFilter",
    Callback = function(selected)
        state.webhookFilters = {}
        if type(selected) == "table" then
            for key, value in pairs(selected) do
                if type(value) == "string" then
                    state.webhookFilters[value] = true
                elseif type(key) == "string" and value == true then
                    state.webhookFilters[key] = true
                end
            end
        elseif type(selected) == "string" then
            state.webhookFilters[selected] = true
        end
    end
})
local webhookToggle
webhookToggle = Webhook:CreateToggle({
    Name = "Enable Fish Alerts",
    CurrentValue = false,
    Flag = "KIMS_V2_WebhookMonitor",
    Callback = function(value)
        if value then
            if not startMonitor() then
                task.defer(function()
                    if webhookToggle then pcall(function() webhookToggle:Set(false) end) end
                end)
            end
        else
            stopMonitor()
            notify("Fish webhook monitoring OFF")
        end
    end
})
Webhook:CreateButton({
    Name = "Check Last Fish Event",
    Callback = function()
        notify("Last event: " .. state.lastFishEvent, 9)
    end
})
Webhook:CreateButton({
    Name = "Test Discord Webhook",
    Callback = function()
        local embed = {
            title = "KIMS TECH | Webhook Test",
            description = "Webhook berhasil dikirim dari KIMS SCRIPT V2 jika pesan ini muncul.",
            color = 65280,
            fields = {
                { name = "Player", value = tostring(player.Name), inline = true },
                { name = "Mode", value = "Manual test (not a caught fish)", inline = true }
            },
            footer = { text = "KIMS TECH" },
            timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ")
        }
        task.spawn(function()
            local ok, reason = sendDiscord(embed, true)
            notify(ok and ("Webhook test sent: " .. tostring(reason))
                or ("Webhook test failed: " .. tostring(reason)), 7)
        end)
    end
})

