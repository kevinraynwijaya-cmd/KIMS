-- KIMS SCRIPT - RAYFIELD UI TEST V1
-- Powered by KIMS TECH
-- UI DEMO ONLY: no auto-fishing, teleport, or game modification.
-- Rayfield UI: https://github.com/SiriusSoftwareLtd/Rayfield

-- Disable Rayfield analytics for this script session.
if type(getgenv) == "function" then
    getgenv().DISABLE_RAYFIELD_REQUESTS = true
end

local ok, Rayfield = pcall(function()
    return loadstring(game:HttpGet("https://sirius.menu/rayfield"))()
end)

if not ok or not Rayfield then
    warn("[KIMS TECH] Failed to load Rayfield UI: " .. tostring(Rayfield))
    return
end

local Window = Rayfield:CreateWindow({
    Name = "KIMS SCRIPT | FISH IT",
    Icon = 0,
    LoadingTitle = "KIMS TECH",
    LoadingSubtitle = "Fish It - Rayfield UI Test",
    Theme = "Default",
    DisableRayfieldPrompts = false,
    ConfigurationSaving = { Enabled = false },
    Discord = { Enabled = false },
    KeySystem = false
})

local function notify(message)
    local success, err = pcall(function()
        Rayfield:Notify({
            Title = "KIMS TECH",
            Content = message,
            Duration = 4,
            Image = 4483362458
        })
    end)
    if not success then
        warn("[KIMS TECH] " .. tostring(message) .. " | " .. tostring(err))
    end
end

-- HOME
local Home = Window:CreateTab("Home", 4483362458)
Home:CreateSection("Welcome to KIMS TECH")
Home:CreateButton({
    Name = "Test KIMS Notification",
    Callback = function()
        notify("KIMS SCRIPT UI test berhasil!")
    end
})

-- FISHING (UI DEMO ONLY)
local Fishing = Window:CreateTab("Fishing", 4483362458)
Fishing:CreateSection("Auto Fishing - Demo")
Fishing:CreateToggle({
    Name = "Auto Fish (Demo)",
    CurrentValue = false,
    Flag = "KIMS_DEMO_AutoFish",
    Callback = function(value)
        notify("Auto Fish Demo: " .. (value and "ON" or "OFF"))
    end
})
Fishing:CreateSlider({
    Name = "Fishing Delay (Demo)",
    Range = { 0, 10 },
    Increment = 1,
    Suffix = "s",
    CurrentValue = 3,
    Flag = "KIMS_DEMO_FishDelay",
    Callback = function(value)
        print("[KIMS TECH] Fishing Delay Demo:", value)
    end
})

-- TELEPORT (UI DEMO ONLY)
local Teleport = Window:CreateTab("Teleport", 4483362458)
Teleport:CreateSection("Location Selection - Demo")
local selectedLocation = "Spawn"
Teleport:CreateDropdown({
    Name = "Choose Location",
    Options = { "Spawn", "Kohana", "Lost Isle", "Ancient Jungle" },
    CurrentOption = { "Spawn" },
    MultipleOptions = false,
    Flag = "KIMS_DEMO_Location",
    Callback = function(options)
        if type(options) == "table" then
            selectedLocation = options[1] or "Spawn"
        elseif type(options) == "string" then
            selectedLocation = options
        end
    end
})
Teleport:CreateButton({
    Name = "Teleport (Demo)",
    Callback = function()
        notify("Selected location: " .. selectedLocation)
    end
})

-- SETTINGS (UI DEMO ONLY)
local Settings = Window:CreateTab("Settings", 4483362458)
Settings:CreateSection("KIMS Settings")
Settings:CreateToggle({
    Name = "Low Graphics (Demo)",
    CurrentValue = false,
    Flag = "KIMS_DEMO_LowGraphics",
    Callback = function(value)
        notify("Low Graphics Demo: " .. (value and "ON" or "OFF"))
    end
})
Settings:CreateButton({
    Name = "About KIMS SCRIPT",
    Callback = function()
        notify("KIMS SCRIPT UI TEST V1 | Powered by KIMS TECH")
    end
})

notify("KIMS SCRIPT Rayfield UI Test V1 loaded!")
