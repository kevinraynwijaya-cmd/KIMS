-- =========================================================
-- UI COMPONENTS
-- =========================================================

local order = 0

local function add(obj)
    order = order + 1
    obj.LayoutOrder = order
    return obj
end

local function section(value)
    local obj = add(text(
        content, value, 15, C.cyan
    ))

    obj.Font = Enum.Font.GothamBold
    obj.Size = UDim2.new(1,-8,0,31)
    return obj
end

local function info(value, color)
    local obj = add(make("TextLabel", {
        Size = UDim2.new(1,-8,0,53),
        BackgroundColor3 = C.card,
        BorderSizePixel = 0,
        Text = "  " .. tostring(value),
        TextColor3 = color or C.muted,
        TextSize = 12,
        Font = Enum.Font.Gotham,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left
    }, content))

    round(obj,8)
    return obj
end

local function button(value, callback, color)
    local obj = add(make("TextButton", {
        Size = UDim2.new(1,-8,0,43),
        BackgroundColor3 = color or C.purple,
        BorderSizePixel = 0,
        Text = value,
        TextSize = 13,
        Font = Enum.Font.GothamBold,
        TextColor3 = C.white
    }, content))

    round(obj,9)

    obj.Activated:Connect(function()
        local ok, err = pcall(callback)

        if not ok then
            status("UI action error: " ..
                tostring(err), C.orange)
        end
    end)

    return obj
end

local function missing(value)
    local obj = button(
        value .. "  [NO ENGINE]",
        function()
            status(
                value .. " not available",
                C.orange
            )
        end,
        C.orange
    )

    obj.TextColor3 = C.bg
    return obj
end

local function toggle(value, initial, callback)
    local enabled = initial

    local box = add(make("Frame", {
        Size = UDim2.new(1,-8,0,49),
        BackgroundColor3 = C.card,
        BorderSizePixel = 0
    }, content))
    round(box,9)

    local name = text(
        box, value, 12, C.white
    )
    name.Position = UDim2.fromOffset(12,6)
    name.Size = UDim2.new(1,-105,0,36)

    local switch = make("TextButton", {
        Position = UDim2.new(1,-82,0.5,-15),
        Size = UDim2.fromOffset(69,30),
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        TextColor3 = C.white
    }, box)
    round(switch,7)

    local function redraw()
        switch.Text = enabled and "ON" or "OFF"
        switch.BackgroundColor3 =
            enabled and C.purple or C.bg
    end

    redraw()

    switch.Activated:Connect(function()
        local requested = not enabled
        local ok, result = pcall(callback, requested)

        if not ok or result == false then
            status(
                ok and "Action rejected" or tostring(result),
                C.orange
            )
            return
        end

        enabled = requested
        redraw()
    end)
end

local function numeric(value, current, min, max, callback)
    local box = add(make("Frame", {
        Size = UDim2.new(1,-8,0,49),
        BackgroundColor3 = C.card,
        BorderSizePixel = 0
    }, content))
    round(box,8)

    local name = text(box,value,12,C.white)
    name.Position = UDim2.fromOffset(12,7)
    name.Size = UDim2.new(1,-130,0,33)

    local input = make("TextBox", {
        Position = UDim2.new(1,-108,0,7),
        Size = UDim2.fromOffset(95,34),
        BackgroundColor3 = C.bg,
        TextColor3 = C.white,
        Text = tostring(current),
        TextSize = 13,
        Font = Enum.Font.Gotham,
        ClearTextOnFocus = false
    }, box)
    round(input,7)

    input.FocusLost:Connect(function()
        local num = tonumber(input.Text)

        if not num or num < min or num > max then
            input.Text = tostring(current)
            status("Invalid " .. value, C.orange)
            return
        end

        current = num
        callback(num)
        status(value .. " set: " .. num, C.cyan)
    end)
end

local function selector(value, options, current, callback)
    current = current or options[1]

    local box = add(make("Frame", {
        Size = UDim2.new(1,-8,0,46),
        BackgroundTransparency = 1,
        ClipsDescendants = true
    }, content))

    local pick = make("TextButton", {
        Size = UDim2.new(1,0,0,43),
        BackgroundColor3 = C.card,
        TextColor3 = C.white,
        TextSize = 12,
        Text = value .. ": " .. current .. "  v",
        Font = Enum.Font.GothamBold
    }, box)
    round(pick,8)

    local expanded = false
    local choiceHeight = 34

    local choices = make("Frame", {
        Position = UDim2.fromOffset(0,46),
        Size = UDim2.new(
            1,0,0,#options * choiceHeight
        ),
        BackgroundTransparency = 1,
        Visible = false
    }, box)

    local function setExpanded(open)
        expanded = open
        choices.Visible = open

        box.Size = UDim2.new(
            1,-8,0,
            open and (48 + #options * choiceHeight)
                or 46
        )
    end

    for i, option in ipairs(options) do
        local choice = make("TextButton", {
            Position = UDim2.fromOffset(
                0,(i-1)*choiceHeight
            ),
            Size = UDim2.new(1,0,0,32),
            BackgroundColor3 = C.panel,
            TextColor3 = C.white,
            Font = Enum.Font.Gotham,
            TextSize = 12,
            Text = option
        }, choices)
        round(choice,6)

        choice.Activated:Connect(function()
            current = option
            pick.Text =
                value .. ": " .. option .. "  v"

            setExpanded(false)
            callback(option)
        end)
    end

    pick.Activated:Connect(function()
        setExpanded(not expanded)
    end)
end

local function updateConfig(key, value)
    Config[key] = value
    saveConfig()
    status(key .. " updated", C.cyan)
end

-- =========================================================
-- PAGE NAVIGATION
-- =========================================================

local pages = {
    {"Main", "MAIN", true},
    {"Favorite", "FAVORITE", true},
    {"Teleport", "TELEPORT", true},
    {"Shop", "SHOP", false},
    {"Automation", "AUTOMATION", true},
    {"Trade", "TRADE", false},
    {"Webhook", "WEBHOOK", false},
    {"Stats", "STATS", false}
}

local active = "Main"
local navButtons = {}
local render

for index, entry in ipairs(pages) do
    local pageName = entry[1]
    local titleName = entry[2]
    local ready = entry[3]

    local b = make("TextButton", {
        LayoutOrder = index,
        Size = UDim2.new(1,-3,0,44),
        BackgroundColor3 = C.card,
        BorderSizePixel = 0,
        Text = titleName,
        TextColor3 =
            ready and C.white or C.orange,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextSize = 12,
        Font = Enum.Font.GothamBold
    }, nav)
    round(b,8)

    make("UIPadding", {
        PaddingLeft = UDim.new(0,13)
    }, b)

    navButtons[pageName] = {
        button = b,
        ready = ready
    }

    b.Activated:Connect(function()
        active = pageName
        if render then render() end
    end)
end

search:GetPropertyChangedSignal("Text"):Connect(function()
    local query = string.lower(search.Text)

    for name, data in pairs(navButtons) do
        data.button.Visible =
            string.find(
                string.lower(name),
                query,1,true
            ) ~= nil
    end
end)

-- =========================================================
-- PAGE RENDERING
-- =========================================================

local function buildPage()
    for _, child in ipairs(content:GetChildren()) do
        if child ~= listLayout then
            child:Destroy()
        end
    end

    order = 0
    content.CanvasPosition = Vector2.new(0,0)

    for name, data in pairs(navButtons) do
        local selected = name == active

        data.button.BackgroundColor3 =
            selected and C.purple or C.card

        data.button.TextColor3 =
            selected and C.white or
            (data.ready and C.white or C.orange)
    end

    pageTitle.Text = active
    pageSubtitle.Text =
        "KIMS FISH IT  |  " ..
        (navButtons[active].ready and
            "ENGINE CODE AVAILABLE" or
            "ENGINE MISSING / PARTIAL")

    if active == "Main" then
        section("KIMS ENGINE DASHBOARD")

        info("Roblox Username: " .. LP.Name)
        info("Display Name: " .. LP.DisplayName)
        info("User ID: " .. LP.UserId)

        info(
            "Auto Fish: " ..
            (S.fishing and "RUNNING" or "STOPPED")
        )

        local ready = fishReady() ~= nil
        info(
            "Fishing Remotes: " ..
            (ready and "FOUND" or "NOT READY"),
            ready and C.green or C.orange
        )

        section("QUICK CONTROLS")

        button("START AUTO FISH", function()
            startFishing()
        end)

        button("STOP AUTO FISH", function()
            stopFishing()
        end, C.card)

        button("SCAN ENGINE AGAIN", function()
            local ok, result = scanRemotes()
            status(result, ok and C.cyan or C.orange)
        end, C.card)

        section("ENGINE INFORMATION")

        info(
            "Fishing, Auto Sell, Auto Favorite, " ..
            "Teleport and GPU Saver are included. " ..
            "Success in Fish It is not yet verified."
        )

    elseif active == "Favorite" then
        section("AUTO FAVORITE")

        toggle(
            "Auto Favorite Fish",
            Config.AutoFavorite,
            function(v)
                updateConfig("AutoFavorite",v)
            end
        )

        selector(
            "Favorite Rarity",
            {"Mythic","Secret"},
            Config.FavoriteRarity,
            function(v)
                updateConfig("FavoriteRarity",v)
            end
        )

        button("FAVORITE FISH NOW", function()
            task.spawn(function()
                local ok, result = autoFavorite()
                status(
                    ok and
                    ("Favorite requests sent: " .. result)
                    or tostring(result),
                    ok and C.cyan or C.orange
                )
            end)
        end)

        info(
            "Requires Replion PlayerData and " ..
            "ItemUtility. Targets Mythic/Secret."
        )

    elseif active == "Teleport" then
        section("TELEPORT TO ISLAND")

        local locations = {}

        for name in pairs(LOCATIONS) do
            table.insert(locations,name)
        end

        table.sort(locations)

        selector(
            "Select Island",
            locations,
            Config.TeleportLocation,
            function(v)
                updateConfig("TeleportLocation",v)
            end
        )

        button("TELEPORT", function()
            local ok, err = teleportTo(
                Config.TeleportLocation
            )

            status(
                ok and
                ("Local teleport requested: " ..
                    Config.TeleportLocation)
                or tostring(err),
                ok and C.cyan or C.orange
            )
        end)

        section("ADDITIONAL TELEPORT")

        missing("Teleport to Player")
        missing("Saved Location")
        missing("Event Teleport")

    elseif active == "Automation" then
        section("AUTO FISHING")

        toggle(
            "Auto Fish",
            S.fishing,
            function(v)
                if v then
                    return startFishing()
                else
                    stopFishing()
                    return true
                end
            end
        )

        toggle(
            "Blatant Mode",
            Config.BlatantMode,
            function(v)
                updateConfig("BlatantMode",v)
            end
        )

        toggle(
            "Auto Catch",
            Config.AutoCatch,
            function(v)
                updateConfig("AutoCatch",v)
            end
        )

        numeric(
            "Fish Delay (seconds)",
            Config.FishDelay,0.1,10,
            function(v)
                updateConfig("FishDelay",v)
            end
        )

        numeric(
            "Catch Delay (seconds)",
            Config.CatchDelay,0.1,10,
            function(v)
                updateConfig("CatchDelay",v)
            end
        )

        section("AUTO SELL")

        toggle(
            "Auto Sell",
            Config.AutoSell,
            function(v)
                if v and not S.events.sell then
                    status("Sell remote missing",C.orange)
                    return false
                end

                updateConfig("AutoSell",v)
            end
        )

        numeric(
            "Sell Delay (seconds)",
            Config.SellDelay,10,300,
            function(v)
                updateConfig("SellDelay",v)
            end
        )

        button("SELL ALL NOW", function()
            local ok, result = sellAll()

            status(
                ok and
                    "Sell request sent; verify inventory"
                    or tostring(result),
                ok and C.cyan or C.orange
            )
        end)

        section("PERFORMANCE")

        toggle(
            "GPU Saver",
            Config.GPUSaver,
            function(v)
                Config.GPUSaver = v

                if v then
                    enableGPU()
                else
                    disableGPU()
                end

                saveConfig()
            end
        )

        info("Anti-AFK listener installed.")

    elseif active == "Shop" then
        section("SHOP SYSTEM")
        info("Backend Shop not available.",C.orange)
        missing("Auto Buy Rod")
        missing("Auto Buy Bait")
        missing("Shop Inventory")

    elseif active == "Trade" then
        section("TRADE SYSTEM")
        info("Backend Trade not available.",C.orange)
        missing("Trade to Player")
        missing("Auto Accept Trade")
        missing("Trade Inventory")

    elseif active == "Webhook" then
        section("WEBHOOK SYSTEM")
        info("Backend Webhook not available.",C.orange)
        missing("Discord Webhook")
        missing("Rare Fish Notification")
        missing("Account Stats Report")

    elseif active == "Stats" then
        section("KIMS ACCOUNT STATS")

        info(
            "Partial inventory reader available. " ..
            "Full stats backend is not available.",
            C.orange
        )

        button("CHECK INVENTORY", function()
            task.spawn(function()
                local items, err = inventoryItems()

                status(
                    items and
                    ("Inventory entries: " .. #items)
                    or tostring(err),
                    items and C.cyan or C.orange
                )
            end)
        end)

        missing("Account Level")
        missing("Coins / Balance")
        missing("Total Fish Caught")
        missing("Session Statistics")
        missing("Rare Fish Counter")
    end
end

render = function()
    local ok, err = pcall(buildPage)

    if not ok then
        warn("[KIMS UI ERROR] " .. tostring(err))
        status("UI ERROR: " .. tostring(err),C.orange)
    end
end

-- =========================================================
-- MODULE INITIALIZATION - NON BLOCKING
-- =========================================================

task.spawn(function()
    local packages = RS:FindFirstChild("Packages")
    local replionModule =
        packages and packages:FindFirstChild("Replion")

    local sharedFolder = RS:FindFirstChild("Shared")
    local itemModule = sharedFolder and
        sharedFolder:FindFirstChild("ItemUtility")

    if itemModule then
        local ok, result = pcall(require,itemModule)
        if ok then S.itemUtility = result end
    end

    if replionModule then
        local ok, replion = pcall(require,replionModule)

        if ok and replion then
            local dataOk, result = pcall(function()
                return replion.Client:WaitReplion("Data")
            end)

            if dataOk then
                S.data = result
                status("PlayerData initialized",C.cyan)
            end
        end
    end
end)

task.spawn(function()
    for attempt = 1, 15 do
        if not S.alive then break end

        local ok, result = scanRemotes()

        if fishReady() then
            status(
                "Fishing remotes detected - " ..
                result,
                C.green
            )
            break
        end

        if attempt == 15 then
            status(
                "Remote scan incomplete: " ..
                tostring(result),
                C.orange
            )
        end

        task.wait(1)
    end
end)

-- =========================================================
-- INSTANCE CLEANUP
-- =========================================================

S.stop = function()
    S.alive = false
    S.fishing = false
    S.fishToken = S.fishToken + 1

    for _, connection in ipairs(S.connections) do
        pcall(function()
            connection:Disconnect()
        end)
    end

    disableGPU()

    if S.gui then
        pcall(function()
            S.gui:Destroy()
        end)
    end
end

-- =========================================================
-- START UI
-- =========================================================

render()

status(
    "KIMS FISH IT V1.1 loaded - ready for testing",
    C.cyan
)

print("------------------------------------------")
print("KIMS FISH IT V1.1")
print("FULL ENGINE + CUSTOM NEON UI")
print("Engine compatibility is NOT verified")
print("------------------------------------------")
