
-- KIMS STAT AKUN V1
-- READ ONLY | NO REMOTES | NO WEBHOOK

local RS = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

print("========== KIMS STAT TEST V1 ==========")

local player = Players.LocalPlayer
if not player then
    warn("[FAIL] LocalPlayer tidak tersedia")
    return
end

print("[PASS] LocalPlayer")

local packages = RS:FindFirstChild("Packages")
local moduleScript = packages
    and packages:FindFirstChild("Replion")

if not moduleScript then
    warn("[FAIL] Modul Replion tidak ditemukan")
    return
end

local ok, Replion = pcall(require, moduleScript)
if not ok or not Replion then
    warn("[FAIL] Require Replion:", Replion)
    return
end

print("[PASS] Modul Replion")

local dataOK, Data = pcall(function()
    return Replion.Client:WaitReplion("Data", 12)
end)

if not dataOK or not Data then
    warn("[FAIL] Channel Data belum tersedia:", Data)
    return
end

print("[PASS] Channel Data")

local rootOK, root = pcall(function()
    return Data:Get()
end)

if not rootOK or typeof(root) ~= "table" then
    warn("[FAIL] Root data tidak bisa dibaca")
    return
end

print("[PASS] Root data terbaca")

local equipOK, equip = pcall(function()
    return Data:Get("EquippedId")
end)

if equipOK and equip ~= nil then
    print("[PASS] EquippedId terbaca")
else
    print("[INFO] EquippedId belum ditemukan")
end

local inventoryOK, inventory = pcall(function()
    return Data:Get("Inventory")
end)

if inventoryOK and typeof(inventory) == "table" then
    print("[PASS] Inventory terbaca")
else
    print("[INFO] Inventory belum ditemukan")
end

-- Cari nama field statistik, tanpa dump
-- seluruh data pribadi pemain.

local keywords = {
    "caught", "catch", "rarest",
    "stat", "level", "coin",
    "money", "fishcount",
    "fishcaught"
}

local function isStatKey(key)
    local name = tostring(key):lower()
    for _, word in ipairs(keywords) do
        if name:find(word, 1, true) then
            return true
        end
    end
    return false
end

local found = 0

local function inspect(tbl, prefix, depth)
    if depth > 2 then return end

    local scanned = 0

    for key, value in pairs(tbl) do
        scanned += 1
        if scanned > 500 then break end

        local name = tostring(key)
        local path = prefix == ""
            and name or (prefix .. "." .. name)

        if isStatKey(name) then
            found += 1

            if typeof(value) == "number"
                or typeof(value) == "boolean" then
                print("[STAT]", path, "=", value)
            elseif typeof(value) == "string" then
                print("[STAT]", path,
                    "= string (" .. #value .. " chars)")
            else
                print("[STAT]", path,
                    "=", typeof(value))
            end
        end

        local lower = name:lower()
        local skip = lower == "items"
            or lower == "inventory"

        if typeof(value) == "table"
            and depth < 2 and not skip then
            inspect(value, path, depth + 1)
        end
    end
end

print("------- SCANNING STAT KEYS -------")
inspect(root, "", 0)

print("------- HASIL -------")

if found > 0 then
    print("[KIMS] DITEMUKAN", found,
        "FIELD KANDIDAT STAT AKUN")
else
    warn("[KIMS] BELUM ADA FIELD STAT YANG COCOK")
end

print("========== TEST SELESAI ==========")
