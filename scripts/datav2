-- KIMS FISH READER V4 | local read-only UI inventory diagnostics
-- Reads text from existing client UI; no network requests or inventory changes.
local Players = game:GetService('Players')
local player = Players.LocalPlayer
local guiRoot = player:WaitForChild('PlayerGui')
local old = guiRoot:FindFirstChild('KIMS_Fish_Reader_V4')
if old then old:Destroy() end

local sg = Instance.new('ScreenGui')
sg.Name = 'KIMS_Fish_Reader_V4'
sg.ResetOnSpawn = false
sg.IgnoreGuiInset = true
sg.DisplayOrder = 5000
sg.Parent = guiRoot

local frame = Instance.new('Frame')
frame.Size = UDim2.new(.88,0,.68,0)
frame.Position = UDim2.new(.06,0,.15,0)
frame.BackgroundColor3 = Color3.fromRGB(12,17,35)
frame.BorderSizePixel = 0
frame.Parent = sg
Instance.new('UICorner', frame).CornerRadius = UDim.new(0,12)
local edge = Instance.new('UIStroke',frame)
edge.Color = Color3.fromRGB(99,92,220)
edge.Thickness = 2

local header = Instance.new('TextLabel')
header.Size = UDim2.new(1,-180,0,45)
header.Position = UDim2.new(0,15,0,2)
header.BackgroundTransparency = 1
header.Text = 'KIMS FISH READER V4 - ITEM EXTRACTOR'
header.TextColor3 = Color3.fromRGB(191,200,255)
header.TextSize = 15
header.Font = Enum.Font.GothamBold
header.TextXAlignment = Enum.TextXAlignment.Left
header.Parent = frame

local function button(text,x,w)
  local b = Instance.new('TextButton')
  b.Size = UDim2.new(0,w,0,32)
  b.Position = UDim2.new(1,x,0,9)
  b.BackgroundColor3 = Color3.fromRGB(82,49,151)
  b.TextColor3 = Color3.new(1,1,1)
  b.TextSize = 12
  b.Font = Enum.Font.GothamBold
  b.Text = text
  b.Parent = frame
  Instance.new('UICorner',b).CornerRadius=UDim.new(0,6)
  return b
end
local copy = button('SALIN',-169,76)
local close = button('TUTUP',-88,76)
local scroll = Instance.new('ScrollingFrame')
scroll.Position = UDim2.new(0,12,0,52)
scroll.Size = UDim2.new(1,-24,1,-63)
scroll.BackgroundColor3 = Color3.fromRGB(17,23,43)
scroll.BorderSizePixel = 0
scroll.ScrollBarThickness = 6
scroll.Parent = frame
Instance.new('UICorner',scroll).CornerRadius=UDim.new(0,8)
local output = Instance.new('TextLabel')
output.Position = UDim2.new(0,8,0,8)
output.Size = UDim2.new(1,-16,0,100)
output.BackgroundTransparency = 1
output.Font = Enum.Font.Code
output.TextSize = 13
output.TextColor3 = Color3.fromRGB(204,229,255)
output.TextWrapped = false
output.TextXAlignment = Enum.TextXAlignment.Left
output.TextYAlignment = Enum.TextYAlignment.Top
output.Parent = scroll

local lines={}
local function add(s) lines[#lines+1]=tostring(s) end
local function clean(t)
  t=tostring(t or '')
  t=t:gsub('[\r\n]',' ')
  if #t>130 then t=t:sub(1,127)..'...' end
  return t
end
local function valueOf(obj)
  if obj:IsA('TextLabel') or obj:IsA('TextButton') or obj:IsA('TextBox') then
    return clean(obj.Text)
  elseif obj:IsA('StringValue') or obj:IsA('IntValue') or obj:IsA('NumberValue') then
    return clean(obj.Value)
  end
  return nil
end
local function inspect(scope,maxTiles)
  if not scope then add('NOT FOUND: target GUI');return end
  add('GUI: '..scope:GetFullName())
  local tiles={}
  for _,obj in ipairs(scope:GetDescendants()) do
    if obj.Name=='Tile' and (obj:IsA('Frame') or obj:IsA('ImageLabel') or obj:IsA('ImageButton')) then
      tiles[#tiles+1]=obj
    end
  end
  add('TILES FOUND: '..#tiles)
  for i=1,math.min(#tiles,maxTiles) do
    local tile=tiles[i]
    add('-- TILE '..i..' | '..tile.ClassName..' | visible='..tostring(tile.Visible))
    local fields=0
    for _,sub in ipairs(tile:GetDescendants()) do
      local val=valueOf(sub)
      if val and val~='' and fields<14 then
        add('  '..sub.Name..' = '..val)
        fields=fields+1
      end
    end
    if fields==0 then add('  (no nonempty text/value fields)') end
    local attrs=tile:GetAttributes()
    for k,v in pairs(attrs) do add('  @'..tostring(k)..' = '..clean(v)) end
  end
end

add('KIMS V4 | READ ONLY | NO UPLOAD')
add('USER: @'..player.Name..' | DISPLAY: '..player.DisplayName..' | ID: '..tostring(player.UserId))
add('PLACE: '..tostring(game.PlaceId))
local bp=guiRoot:FindFirstChild('Backpack')
if bp then
  inspect(bp:FindFirstChild('Display'),50)
  local n=0
  for _,obj in ipairs(bp:GetDescendants()) do
    if obj.Name=='ItemName' and obj:IsA('TextLabel') then
      n=n+1
      if n<=45 then add('BACKPACK ITEMNAME '..n..' = '..clean(obj.Text)..' | parent='..obj.Parent.Name) end
    end
  end
  add('BACKPACK ITEMNAME COUNT: '..n)
else add('Backpack GUI not found') end
local inv=guiRoot:FindFirstChild('Inventory')
if inv then
  add('INVENTORY GUI: '..inv:GetFullName())
  local n=0
  for _,obj in ipairs(inv:GetDescendants()) do
    if obj:IsA('TextLabel') and (obj.Name=='ItemName' or obj.Name=='Name' or obj.Name=='Amount') and obj.Text~='' then
      n=n+1
      if n<=35 then add('INVENTORY UI TEXT '..n..' = '..clean(obj.Text)) end
    end
  end
  add('INVENTORY UI TEXT COUNT: '..n)
end
add('DONE. These are UI labels, not proof of catch history or complete inventory.')
local result=table.concat(lines,'\n')
output.Text=result
local textService=game:GetService('TextService')
local viewWidth=math.max(320,math.floor(workspace.CurrentCamera.ViewportSize.X*.75))
local textBounds=textService:GetTextSize(result,13,Enum.Font.Code,Vector2.new(viewWidth,100000))
local totalHeight=math.max(200,textBounds.Y+60,#lines*17)
output.Size=UDim2.new(1,-16,0,totalHeight)
scroll.CanvasSize=UDim2.new(0,0,0,totalHeight+20)
copy.MouseButton1Click:Connect(function()
  if type(setclipboard)=='function' then
    local ok=pcall(setclipboard,result)
    copy.Text=ok and 'TERSALIN!' or 'GAGAL'
  else
    copy.Text='NO CLIP'
    -- Executor has no clipboard API; screenshot or use an executor with setclipboard.
  end
end)
close.MouseButton1Click:Connect(function() sg:Destroy() end)
