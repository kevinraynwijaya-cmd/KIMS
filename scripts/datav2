-- KIMS TECH | PLAYERDATA SOURCE TRACER V16
-- Fish It / Delta Android | local metadata inspection only.
-- Does NOT run Zetsu, monitor HTTP, upload data, fire remotes, invoke game getters,
-- dump inventory contents, read credentials, or change inventory.
-- Requires ONLY module paths returned by getloadedmodules; cached require is normally
-- side-effect-free but this cannot be guaranteed across all executor/game environments.
-- Goal: find the module/function/table *paths* that may lead to player-owned data.

local Players = game:GetService('Players')
local UserInputService = game:GetService('UserInputService')
local player = Players.LocalPlayer
if not player then return end
local pg = player:WaitForChild('PlayerGui')
local old = pg:FindFirstChild('KIMSPlayerDataTracerV16')
if old then old:Destroy() end
local screen = Instance.new('ScreenGui')
screen.Name = 'KIMSPlayerDataTracerV16'
screen.ResetOnSpawn = false
screen.DisplayOrder = 999
screen.Parent = pg

local panel = Instance.new('Frame')
panel.Size = UDim2.new(.94,0,.68,0)
panel.Position = UDim2.new(.03,0,.16,0)
panel.Active = true
panel.BackgroundColor3 = Color3.fromRGB(13,20,37)
panel.BorderSizePixel = 0
panel.Parent = screen
Instance.new('UICorner',panel).CornerRadius = UDim.new(0,10)
local stroke = Instance.new('UIStroke',panel)
stroke.Color = Color3.fromRGB(116,91,229)
stroke.Thickness = 2
local title = Instance.new('TextLabel',panel)
title.Size = UDim2.new(.96,0,0,30)
title.Position = UDim2.new(.02,0,0,6)
title.BackgroundTransparency = 1
title.TextColor3 = Color3.fromRGB(214,203,255)
title.Font = Enum.Font.GothamBold
title.TextSize = 15
title.TextXAlignment = Enum.TextXAlignment.Left
title.Text = 'KIMS V16 | PLAYERDATA TRACE'
