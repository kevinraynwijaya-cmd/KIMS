-- ============================================================
-- KIMS COLORS
-- ============================================================

local C = {
    bg = Color3.fromRGB(13, 12, 25),
    panel = Color3.fromRGB(24, 21, 42),
    card = Color3.fromRGB(35, 29, 55),
    purple = Color3.fromRGB(150, 71, 255),
    cyan = Color3.fromRGB(36, 216, 240),
    orange = Color3.fromRGB(255, 158, 49),
    green = Color3.fromRGB(48, 216, 139),
    white = Color3.fromRGB(245, 241, 255),
    muted = Color3.fromRGB(167, 157, 187)
}

local function track(connection)
    table.insert(connections, connection)
    return connection
end

local function log(message, color)
    message = tostring(message)
    print("[KIMS V1.3] " .. message)

    table.insert(logs, message)
    if #logs > 30 then
        table.remove(logs, 1)
    end

    if footer then
        footer.Text = message
        footer.TextColor3 = color or C.cyan
    end
end

-- ============================================================
-- CONFIG
-- ============================================================

local CONFIG = {
    AutoFish = false,
    AutoCatch = false,
    AutoSell = false,
    AutoFavorite = false,
    GPUSaver = false,

    FishDelay = 0.9,
    CatchDelay = 0.2,
    SellDelay = 30,

    FavoriteRarity = "Mythic",
    TeleportLocation = "Sisyphus Statue"
}

local folder = "OptimizedAutoFish"
local configPath = folder .. "/config_" .. LP.UserId .. ".json"

local function saveConfig()
    if not writefile then return end

    pcall(function()
        if isfolder and makefolder and not isfolder(folder) then
            makefolder(folder)
        end
        writefile(configPath, Http:JSONEncode(CONFIG))
    end)
end

local function loadConfig()
    if not (isfile and readfile) then return end

    pcall(function()
        if not isfile(configPath) then return end
        local data = Http:JSONDecode(readfile(configPath))

        if type(data) ~= "table" then return end

        for key, default in pairs(CONFIG) do
            if type(data[key]) == type(default) then
                CONFIG[key] = data[key]
            end
        end
    end)
end

loadConfig()

-- Safety: never start automatic actions at startup
CONFIG.AutoFish = false
CONFIG.AutoCatch = false
CONFIG.AutoSell = false
CONFIG.AutoFavorite = false
CONFIG.GPUSaver = false

CONFIG.FishDelay = math.clamp(CONFIG.FishDelay, 0.1, 10)
CONFIG.CatchDelay = math.clamp(CONFIG.CatchDelay, 0.1, 10)
CONFIG.SellDelay = math.clamp(CONFIG.SellDelay, 10, 300)

local function setConfig(key, value)
    CONFIG[key] = value
    saveConfig()
    log(key .. " = " .. tostring(value))
end

