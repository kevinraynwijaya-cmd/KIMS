subtitlePage.Position = UDim2.fromOffset(221, 119)
subtitlePage.Size = UDim2.fromOffset(520, 22)

local scroll = make("ScrollingFrame", {
    Position = UDim2.fromOffset(214, 154),
    Size = UDim2.new(1, -227, 1, -202),
    BackgroundTransparency = 1,
    BorderSizePixel = 0,
    ScrollBarThickness = 3,
    ScrollBarImageColor3 = C.purple,
    CanvasSize = UDim2.fromOffset(0, 0)
}, window)

local layout = make("UIListLayout", {
    Padding = UDim.new(0, 9),
    SortOrder = Enum.SortOrder.LayoutOrder
}, scroll)

layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
    scroll.CanvasSize = UDim2.fromOffset(
        0, layout.AbsoluteContentSize.Y + 15
    )
end)

local status = label(window, "● ENGINE NOT YET VERIFIED", 11, C.orange)
status.Position = UDim2.new(0, 220, 1, -35)
status.Size = UDim2.new(1, -238, 0, 24)

local function setStatus(text, color)
    status.Text = "● " .. text
    status.TextColor3 = color or C.cyan
    print("[KIMS] " .. text)
end

local order = 0
local function addOrder(obj)
    order = order + 1
    obj.LayoutOrder = order
    return obj
end

local function section(text)
    local t = addOrder(label(scroll, text, 15, C.cyan))
    t.Font = Enum.Font.GothamBold
    t.Size = UDim2.new(1, -8, 0, 31)
end

local function info(text, accent)
    local t = addOrder(make("TextLabel", {
        Size = UDim2.new(1, -8, 0, 54),
        BackgroundColor3 = C.card,
        BorderSizePixel = 0,
        Text = "   " .. text,
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextColor3 = accent or C.muted,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true
    }, scroll))
    corner(t, 9)
    return t
end

local function button(text, callback, color)
    local b = addOrder(make("TextButton", {
        Size = UDim2.new(1, -8, 0, 42),
        BackgroundColor3 = color or C.purple,
        BorderSizePixel = 0,
        Text = text,
        Font = Enum.Font.GothamBold,
        TextSize = 13,
        TextColor3 = C.white
    }, scroll))
    corner(b, 9)
    b.Activated:Connect(callback)
    return b
end

local function toggle(text, initial, callback)
    local value = initial
    local row = addOrder(make("Frame", {
        Size = UDim2.new(1, -8, 0, 48),
        BackgroundColor3 = C.card,
        BorderSizePixel = 0
    }, scroll))
    corner(row, 9)

    local name = label(row, text, 12, C.white)
    name.Position = UDim2.fromOffset(13, 7)
    name.Size = UDim2.new(1, -105, 0, 34)

    local b = make("TextButton", {
        Position = UDim2.new(1, -83, 0.5, -15),
        Size = UDim2.fromOffset(70, 30),
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        TextColor3 = C.white
    }, row)
    corner(b, 8)

    local function draw()
        b.Text = value and "ON" or "OFF"
        b.BackgroundColor3 = value and C.purple or C.bg
    end

    draw()
    b.Activated:Connect(function()
        value = not value
        draw()
        callback(value)
    end)
end

local function numberInput(text, current, minimum, maximum, callback)
    local row = addOrder(make("Frame", {
        Size = UDim2.new(1, -8, 0, 47),
        BackgroundColor3 = C.card,
        BorderSizePixel = 0
    }, scroll))
    corner(row, 9)

    local name = label(row, text, 12, C.white)
    name.Position = UDim2.fromOffset(12, 7)
    name.Size = UDim2.new(1, -128, 0, 32)

    local input = make("TextBox", {
        Position = UDim2.new(1, -108, 0, 7),
        Size = UDim2.fromOffset(95, 33),
        Text = tostring(current),
        Font = Enum.Font.Gotham,
        TextSize = 13,
        TextColor3 = C.white,
        BackgroundColor3 = C.bg,
        ClearTextOnFocus = false
    }, row)
    corner(input, 7)

    input.FocusLost:Connect(function()
        local n = tonumber(input.Text)
        if n and n >= minimum and n <= maximum then
            callback(n)
            setStatus(text .. " = " .. tostring(n))
        else
            input.Text = tostring(current)
            setStatus("Invalid " .. text, C.orange)
        end
    end)
end

local function selector(text, options, initial, callback)
    local selected = initial
    local expanded = false

    local box = addOrder(make("Frame", {
        Size = UDim2.new(1, -8, 0, 47),
        BackgroundTransparency = 1,
        ClipsDescendants = true
    }, scroll))

    local pick = make("TextButton", {
        Size = UDim2.new(1, 0, 0, 43),
        BackgroundColor3 = C.card,
        TextColor3 = C.white,
        TextSize = 12,
        Font = Enum.Font.GothamBold,
        Text = text .. ": " .. selected .. "  ▼"
    }, box)
    corner(pick, 8)

    local choices = make("Frame", {
        Position = UDim2.fromOffset(0, 45),
        Size = UDim2.new(1, 0, 0, #options * 33),
        BackgroundTransparency = 1,
        Visible = false
    }, box)

    local function collapse()
        expanded = false
        choices.Visible = false
        box.Size = UDim2.new(1, -8, 0, 47)
    end

    for i, option in ipairs(options) do
        local optionButton = make("TextButton", {
            Position = UDim2.fromOffset(0, (i - 1) * 33),
            Size = UDim2.new(1, 0, 0, 31),
            BackgroundColor3 = C.panel,
            TextColor3 = C.white,
            Font = Enum.Font.Gotham,
            TextSize = 12,
            Text = option
        }, choices)
        corner(optionButton, 6)

        optionButton.Activated:Connect(function()
            selected = option
            pick.Text = text .. ": " .. selected .. "  ▼"
            collapse()
            callback(selected)
        end)
    end

    pick.Activated:Connect(function()
        expanded = not expanded
        choices.Visible = expanded
        box.Size = UDim2.new(
            1, -8, 0,
            expanded and (49 + #options * 33) or 47
        )
    end)
end

local function missing(text)
    local b = button("🔒 " .. text .. "  |  NO ENGINE", function()
        setStatus(text .. ": Engine not available", C.orange)
    end, C.orange)
    b.TextColor3 = C.bg
end

-- ENGINE CONTROLS
local function updateConfig(key, value)
    Config[key] = value
    saveConfig()
    setStatus(key .. " updated")
end

local function controlFishing(enabled)
    if enabled and not fishingActive then
        Config.AutoFish = true
        fishingActive = true
        task.spawn(fishingLoop)
    elseif not enabled then
        Config.AutoFish = false
        fishingActive = false
        pcall(function()
            Events.unequip:FireServer()
        end)
    end

    saveConfig()
    setStatus(
        enabled and "Auto Fish enabled (testing)"
            or "Auto Fish stopped",
        enabled and C.green or C.orange
    )
end

-- PAGE NAVIGATION
local pages = {
    {"Main", "⌂", true},
    {"Favorite", "★", true},
    {"Teleport", "◆", true},
    {"Shop", "▣", false},
    {"Automation", "⚡", true},
    {"Trade", "⇄", false},
    {"Webhook", "◈", false},
    {"Stats", "▥", false}
}

local activePage = "Teleport"
local navButtons = {}
local render

for _, entry in ipairs(pages) do
    local pageName, icon, ready = entry[1], entry[2], entry[3]

    local b = make("TextButton", {
        Size = UDim2.new(1, -3, 0, 44),
        BackgroundColor3 = C.card,
        Text = icon .. "  " .. pageName,
        TextSize = 13,
        Font = Enum.Font.GothamBold,
        TextColor3 = ready and C.white or C.orange,
        TextXAlignment = Enum.TextXAlignment.Left,
        BorderSizePixel = 0
    }, nav)
    corner(b, 9)

    make("UIPadding", {
        PaddingLeft = UDim.new(0, 12)
    }, b)

    navButtons[pageName] = {
        button = b,
        ready = ready
    }

    b.Activated:Connect(function()
        activePage = pageName
        render()
    end)
end

search:GetPropertyChangedSignal("Text"):Connect(function()
    local q = string.lower(search.Text)
    for name, data in pairs(navButtons) do
        data.button.Visible =
            string.find(string.lower(name), q, 1, true) ~= nil
    end
end)

-- PAGE CONTENT
render = function()
    for _, obj in ipairs(scroll:GetChildren()) do
        if obj ~= layout then obj:Destroy() end
    end
    order = 0
    scroll.CanvasPosition = Vector2.new(0, 0)

    for name, data in pairs(navButtons) do
        local selected = (name == activePage)
        data.button.BackgroundColor3 =
            selected and C.purple or C.card
        data.button.TextColor3 =
            selected and C.white or
            (data.ready and C.white or C.orange)
    end

    title.Text = activePage
    subtitlePage.Text =
        "KIMS FISH IT  •  " ..
        (navButtons[activePage].ready and
         "ENGINE AVAILABLE - UNVERIFIED" or
         "ENGINE MISSING / PARTIAL")

    if activePage == "Main" then
        section("KIMS ENGINE DASHBOARD")
        info("Player: " .. LocalPlayer.Name)
        info("Auto Fish: " ..
            (fishingActive and "RUNNING" or "STOPPED"))
        info("Fishing engine detected in source. Game compatibility is not verified.")

        section("Quick Controls")
        button("▶ START AUTO FISH", function()
            controlFishing(true)
        end)
        button("■ STOP AUTO FISH", function()
            controlFishing(false)
        end, C.card)

        section("Engine Information")
        info("Normal fishing, Blatant Mode, Auto Sell, Auto Favorite, Teleport and Anti-AFK.")

    elseif activePage == "Favorite" then
        section("AUTO FAVORITE")

        toggle("Auto Favorite Fish",
            Config.AutoFavorite, function(v)
                updateConfig("AutoFavorite", v)
            end)

        selector("Favorite Rarity",
            {"Mythic", "Secret"},
            Config.FavoriteRarity,
            function(v)
                updateConfig("FavoriteRarity", v)
            end)

        button("⭐ FAVORITE FISH NOW", function()
            task.spawn(function()
                local ok, err = pcall(autoFavoriteByRarity)
                setStatus(ok and
                    "Favorite routine executed; check log"
                    or tostring(err),
                    ok and C.cyan or C.orange)
            end)
        end)

        info("Engine only targets Mythic and Secret rarity.")

    elseif activePage == "Teleport" then
        section("TELEPORT TO ISLAND")

        local locations = {}
        for name in pairs(LOCATIONS) do
            table.insert(locations, name)
        end
        table.sort(locations)

        selector("Select Island", locations,
            Config.TeleportLocation,
            function(v)
                updateConfig("TeleportLocation", v)
            end)

        button("◆ TELEPORT", function()
            local ok, result = pcall(function()
                return Teleport.to(Config.TeleportLocation)
            end)
            setStatus(
                ok and result and
                "Teleport requested: " .. Config.TeleportLocation
                or "Teleport failed or unavailable",
                ok and result and C.cyan or C.orange
            )
        end)

        section("Additional Teleport")
        missing("Teleport to Player")
        missing("Saved Location")
        missing("Event Teleport")

    elseif activePage == "Automation" then
        section("AUTO FISHING")

        toggle("Auto Fish", fishingActive, function(v)
            controlFishing(v)
        end)

        toggle("Blatant Mode",
            Config.BlatantMode, function(v)
                updateConfig("BlatantMode", v)
            end)

        toggle("Auto Catch",
            Config.AutoCatch, function(v)
                updateConfig("AutoCatch", v)
            end)

        numberInput("Fish Delay (s)",
            Config.FishDelay, 0.1, 10,
            function(v) updateConfig("FishDelay", v) end)

        numberInput("Catch Delay (s)",
            Config.CatchDelay, 0.1, 10,
            function(v) updateConfig("CatchDelay", v) end)

        section("AUTO SELL")

        toggle("Auto Sell",
            Config.AutoSell, function(v)
                updateConfig("AutoSell", v)
            end)

        numberInput("Sell Delay (s)",
            Config.SellDelay, 10, 300,
            function(v) updateConfig("SellDelay", v) end)

        button("💰 SELL ALL NOW", function()
            task.spawn(function()
                local ok, err = pcall(simpleSell)
                setStatus(
                    ok and "Sell routine executed; verify inventory"
                       or tostring(err),
                    ok and C.cyan or C.orange
                )
            end)
        end)

        section("PERFORMANCE")

        toggle("GPU Saver",
            Config.GPUSaver, function(v)
                Config.GPUSaver = v
                if v then enableGPU()
                else disableGPU() end
                saveConfig()
                setStatus("GPU Saver: " .. tostring(v))
            end)

        info("Anti-AFK event listener is initialized by the original engine.")

    elseif activePage == "Shop" then
        section("SHOP SYSTEM")
        info("This source does not contain a shop engine.", C.orange)
        missing("Auto Buy Rod")
        missing("Auto Buy Bait")
        missing("Shop Inventory")

    elseif activePage == "Trade" then
        section("TRADE SYSTEM")
        info("No player trade engine is available.", C.orange)
        missing("Trade to Player")
        missing("Auto Accept Trade")
        missing("Trade Inventory")

    elseif activePage == "Webhook" then
        section("WEBHOOK SYSTEM")
        info("No Discord reporting engine is available.", C.orange)
        missing("Discord Webhook")
        missing("Rare Fish Notification")
        missing("Account Stats Report")

    elseif activePage == "Stats" then
        section("KIMS ACCOUNT STATS")
        info("Only inventory data access exists in this source. Full account statistics are unavailable.", C.orange)

        button("CHECK LOCAL INVENTORY", function()
            local ok, count = pcall(function()
                local inventory =
                    PlayerData:GetExpect("Inventory")
                return #(inventory.Items or {})
            end)
            setStatus(
                ok and ("Inventory entries: " .. count)
                   or "Inventory read failed",
                ok and C.cyan or C.orange
            )
        end, C.purple)

        missing("Account Level")
        missing("Coins / Balance")
        missing("Total Fish Caught")
        missing("Session Statistics")
        missing("Rare Fish Counter")
    end
end

render()
setStatus("KIMS UI loaded; engine not yet verified", C.orange)
print("[KIMS] Custom Neon UI V1 loaded.")
