local LP = Players.LocalPlayer
if not LP then
    error("[KIMS] LocalPlayer unavailable")
end

-- Clean up previous KIMS test instance
local env = (getgenv and getgenv()) or _G

if env.KIMS_FISH_TEST then
    local previous = env.KIMS_FISH_TEST
    if previous.stop then
        pcall(previous.stop)
    end
end

local S = {
    alive = true,
    fishing = false,
    fishToken = 0,
    busy = false,
    events = {},
    connections = {},
    data = nil,
    itemUtility = nil,
    lastError = "",
    statusCallback = nil,
    gui = nil,
    gpuGui = nil
}

env.KIMS_FISH_TEST = S

local C = {
    bg = Color3.fromRGB(13,12,25),
    panel = Color3.fromRGB(24,21,42),
    card = Color3.fromRGB(35,29,55),
    purple = Color3.fromRGB(150,71,255),
    cyan = Color3.fromRGB(36,216,240),
    orange = Color3.fromRGB(255,158,49),
    green = Color3.fromRGB(48,216,139),
    white = Color3.fromRGB(245,241,255),
    muted = Color3.fromRGB(167,157,187)
}

local function status(message, color)
    print("[KIMS] " .. tostring(message))
    if S.statusCallback then
        pcall(S.statusCallback, tostring(message), color)
    end
end

local function track(connection)
    table.insert(S.connections, connection)
    return connection
end

-- =========================================================
-- CONFIGURATION
-- =========================================================

local folder = "OptimizedAutoFish"
local path = folder .. "/config_" .. LP.UserId .. ".json"

local defaults = {
    AutoFish = false,
    AutoSell = false,
    AutoCatch = false,
    GPUSaver = false,
    BlatantMode = false,
    FishDelay = 0.9,
    CatchDelay = 0.2,
    SellDelay = 30,
    TeleportLocation = "Sisyphus Statue",
    AutoFavorite = true,
    FavoriteRarity = "Mythic"
}

local Config = {}

for key, value in pairs(defaults) do
    Config[key] = value
end

local function saveConfig()
    if not writefile then return end

    pcall(function()
        if makefolder and isfolder then
            if not isfolder(folder) then
                makefolder(folder)
            end
        end
        writefile(path, Http:JSONEncode(Config))
    end)
end

local function loadConfig()
    if not (readfile and isfile) then return end

    pcall(function()
        if not isfile(path) then return end
        local saved = Http:JSONDecode(readfile(path))

        if type(saved) ~= "table" then return end

        for key, default in pairs(defaults) do
            local value = saved[key]
            if type(value) == type(default) then
                Config[key] = value
            end
        end
    end)
end

loadConfig()

-- Never automatically start fishing on injection
Config.AutoFish = false

Config.FishDelay = math.clamp(
    Config.FishDelay, 0.1, 10
)
Config.CatchDelay = math.clamp(
    Config.CatchDelay, 0.1, 10
)
Config.SellDelay = math.clamp(
    Config.SellDelay, 10, 300
)

