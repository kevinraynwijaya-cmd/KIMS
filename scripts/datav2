 local b=Instance.new('TextButton',panel)
 b.Position=UDim2.new(x,0,0,43)
 b.Size=UDim2.new(w,0,0,35)
 b.Text=name; b.TextScaled=true; b.Font=Enum.Font.GothamBold
 b.TextColor3=Color3.new(1,1,1)
 b.BackgroundColor3=Color3.fromRGB(66,56,124)
 Instance.new('UICorner',b).CornerRadius=UDim.new(0,6)
 return b
end
local copyBtn=button('SALIN',.03,.27)
local miniBtn=button('MINI',.36,.27)
local closeBtn=button('TUTUP',.69,.27)
local status=Instance.new('TextLabel',panel)
status.Position=UDim2.new(.03,0,0,86)
status.Size=UDim2.new(.94,0,0,19)
status.BackgroundTransparency=1
status.TextColor3=Color3.fromRGB(109,226,170)
status.Font=Enum.Font.Code
status.TextSize=12
status.TextXAlignment=Enum.TextXAlignment.Left
status.Text='Otomatis memeriksa petunjuk sumber PlayerData...'
local sc=Instance.new('ScrollingFrame',panel)
sc.Position=UDim2.new(.025,0,0,112)
sc.Size=UDim2.new(.95,0,1,-121)
sc.BackgroundColor3=Color3.fromRGB(20,28,48)
