-- [1] Cek dulu apakah HttpGet jalan
local function safeHttpGet(url)
    local ok, res = pcall(function()
        if game.HttpGet then
            return game:HttpGet(url)
        elseif httpget then
            return httpget(url)
        else
            error("Executor tidak punya HttpGet")
        end
    end)
    if not ok then return nil, res end
    if not res or res == "" then return nil, "HttpGet kosong (diblokir executor?)" end
    return res
end

-- [2] Validasi dependency
local success, errorMsg = pcall(function()
    local s = { game = game, workspace = workspace, Players = game:GetService("Players"),
        ReplicatedStorage = game:GetService("ReplicatedStorage"),
        HttpService = game:GetService("HttpService") }
    for n, v in pairs(s) do if not v then error("Service missing: " .. n) end end
    if not game:GetService("Players").LocalPlayer then error("LocalPlayer not available") end
    return true
end)
if not success then error("❌ Dependency check failed: " .. tostring(errorMsg)) return end

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local VirtualUser = game:GetService("VirtualUser")
local TeleportService = game:GetService("TeleportService")
local LocalPlayer = Players.LocalPlayer

-- [3] Aktifkan Secure Mode SEBELUM load Rayfield
getgenv().SecureMode = true

-- ====================================================================
--                    CONFIG (sama seperti sebelumnya)
