output.TextXAlignment=Enum.TextXAlignment.Left
output.TextYAlignment=Enum.TextYAlignment.Top
output.TextWrapped=true
output.BackgroundTransparency=1
output.AutomaticSize=Enum.AutomaticSize.Y
output.Size=UDim2.new(1,-15,0,0)
output.Position=UDim2.new(0,7,0,5)
output.Parent=outputFrame

-- Drag the compact panel on both touch and mouse.
local UIS=game:GetService('UserInputService')
local dragging=false
local dragStart, panelStart, dragInput
local dragA=title.InputBegan:Connect(function(input)
    if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
        dragging=true; dragStart=input.Position; panelStart=panel.Position; dragInput=input
    end
end)
local dragB=UIS.InputChanged:Connect(function(input)
    if dragging and (input==dragInput or (dragInput and dragInput.UserInputType==Enum.UserInputType.MouseButton1 and input.UserInputType==Enum.UserInputType.MouseMovement)) then
        local delta=input.Position-dragStart
        panel.Position=UDim2.new(panelStart.X.Scale,panelStart.X.Offset+delta.X,panelStart.Y.Scale,panelStart.Y.Offset+delta.Y)
    end
end)
local dragC=UIS.InputEnded:Connect(function(input)
    if dragging and (input==dragInput or input.UserInputType==Enum.UserInputType.MouseButton1) then dragging=false end
end)

local CATEGORY_NAMES = {'Fish','Rods','Baits','Items','Charms','Emotes','Abilities','Pets'}
local MAP_PAGE = {Inventory2='Fish/Items',Rods2='Rods',Baits='Baits',Charms='Charms',Emotes='Emotes',Abilities='Abilities',Pets='Pets'}
local state = {
    running=true, closed=false, expanded=false, started=os.clock(),
    events=0, dropped=0, watchCount=0, recordCount=0,
    activePage='?', lastStatus=0, lastSnap=0,
    seenPages={}, categoryStats={}, samples={}, sampleSeen={}, firstItemPath={}, firstTileKeys={},
    lines={}, roots={}, connections={}, watched=setmetatable({}, {__mode='k'}),
    lastLog={}, root=nil, lastReport=''
}
for _,cat in ipairs(CATEGORY_NAMES) do
    state.categoryStats[cat]={events=0,samples=0,changes=0}
    state.samples[cat]={}
    state.sampleSeen[cat]={}
end
state.categoryStats['Fish/Items']={events=0,samples=0,changes=0}
state.categoryStats['Unknown']={events=0,samples=0,changes=0}

local function clean(value, maxLen)
    local text = tostring(value or '')
    text = text:gsub('[\r\n\t]',' '):gsub('%s+',' ')
    text = text:gsub('^%s+',''):gsub('%s+$','')
    local limit=maxLen or 80
    if #text>limit then text=text:sub(1,limit)..'...' end
    return text
end
local function keepLine(s)
    state.events=state.events+1
    state.lines[#state.lines+1]=string.format('[%03ds] %s',math.floor(os.clock()-state.started),s)
    if #state.lines>580 then
        table.remove(state.lines,1)
        state.dropped=state.dropped+1
    end
end
local function pathOf(node)
    local parts={}
    local n=node
    local limit=0
    while n and n~=pg and limit<15 do
        table.insert(parts,1,n.Name)
        n=n.Parent
        limit=limit+1
    end
    return table.concat(parts,'/')
end
local function catOf(node)
    local n=node
    for _=1,20 do
        if not n or n==pg then break end
        if n.Parent and n.Parent.Name=='Pages' then
            return MAP_PAGE[n.Name] or n.Name
        end
        n=n.Parent
    end
    return 'Unknown'
end
local function isPresent(node)
    local n=node
    while n and n~=pg do
        if n:IsA('ScreenGui') and not n.Enabled then return false end
        if n:IsA('GuiObject') and not n.Visible then return false end
        n=n.Parent
    end
    return n==pg
end
local function relevantText(node,s)
    if s=='' then return false end
    if node.Name=='ItemName' or node.Name=='Weight' or node.Name=='Quantity' or node.Name=='Count' then return true end
    if s:match('^%s*[%d,.]+%s*/%s*[%d,.]+%s*$') then return true end
    local lowered=s:lower()
    if #s<35 and (lowered=='fish' or lowered=='rods' or lowered=='baits' or lowered=='items' or lowered=='charms' or lowered=='emotes' or lowered=='abilities' or lowered=='pets') then return true end
    return false
end
local function observeSample(category,name)
    local sample=state.samples[category] or state.samples.Unknown
    local seen=state.sampleSeen[category] or state.sampleSeen.Unknown
    name=clean(name,70)
    if name=='' or seen[name] then return end
    if #sample<8 then
        sample[#sample+1]=name
        seen[name]=true
        local entry=state.categoryStats[category] or state.categoryStats.Unknown
        entry.samples=entry.samples+1
    end
end
local function logChange(category,kind,message,interval)
    local stats=state.categoryStats[category] or state.categoryStats.Unknown
    stats.events=stats.events+1
    if kind=='TEXT' or kind=='ATTR' then stats.changes=stats.changes+1 end
    local k=kind..'|'..message
    local now=os.clock()
    local gap=interval or 1
    if state.lastLog[k] and now-state.lastLog[k]<gap then return end
    state.lastLog[k]=now
    keepLine(kind..' '..category..' '..message)
end
local function refreshStatus(force)
    local now=os.clock()
    if not force and now-state.lastStatus<1 then return end
    state.lastStatus=now
    local secs=math.floor(now-state.started)
    status.Text=string.format('%s | %ds | %d events | %d watchers | page %s',state.running and 'REC ON' or 'STOPPED',secs,state.events,state.watchCount,state.activePage)
end
local function connected(signal,callback)
    local ok,c=pcall(function() return signal:Connect(callback) end)
    if ok and c then state.connections[#state.connections+1]=c end
end

local function visiblePages()
    local root=pg:FindFirstChild('Inventory')
    if not root then return nil,{} end
    local main=root:FindFirstChild('Main')
    local content=main and main:FindFirstChild('Content')
    local pages=content and content:FindFirstChild('Pages')
    if not pages then return root,{} end
    local shown={}
    for _,node in ipairs(pages:GetChildren()) do
        if node:IsA('GuiObject') and node.Visible and isPresent(node) then
            shown[#shown+1]=node
        end
    end
    return root,shown
end

local function snapshot(reason)
    if not state.running then return end
    local root, shown=visiblePages()
    if not root then
        if not state.roots.missing then
            state.roots.missing=true
            keepLine('WAIT PlayerGui.Inventory belum ada. Buka menu Inventory.')
        end
        refreshStatus(true)
        return
    end
    state.root=root
    if not state.roots.present then
        state.roots.present=true
        keepLine('ROOT PlayerGui/'..root.Name..' ['..root.ClassName..']')
    end
    local cats={}
    for _,page in ipairs(shown) do
        cats[#cats+1]=MAP_PAGE[page.Name] or page.Name
        if not state.seenPages[page.Name] then
            state.seenPages[page.Name]=true
            keepLine('PAGE FIRST VISIBLE: '..pathOf(page)..' -> '..cats[#cats])
        end
        local details=page:GetDescendants()
        local tiles, itemLabels, counterLabels=0,0,0
        for i,obj in ipairs(details) do
            if i>6500 then break end
            if obj.Name=='Tile' and obj:IsA('GuiObject') then
                tiles=tiles+1
                if not state.firstTileKeys[page.Name] and tiles<=25 then
                    local keys={}
                    local ok,attrs=pcall(function() return obj:GetAttributes() end)
                    if ok and attrs then
                        for k,_ in pairs(attrs) do
                            if #keys<12 then keys[#keys+1]=clean(k,40) end
                        end
                    end
                    if #keys>0 then
                        table.sort(keys)
                        state.firstTileKeys[page.Name]='PlayerGui/'..pathOf(obj)..' : '..table.concat(keys,',')
                    end
                end
            end
            if obj:IsA('TextLabel') or obj:IsA('TextButton') then
                local text=clean(obj.Text,80)
                if obj.Name=='ItemName' and text~='' then
                    if not state.firstItemPath[page.Name] then state.firstItemPath[page.Name]='PlayerGui/'..pathOf(obj) end
                    itemLabels=itemLabels+1
                    observeSample(catOf(obj),text)
                end
                if text:match('^%s*[%d,.]+%s*/%s*[%d,.]+%s*$') then
                    counterLabels=counterLabels+1
                    if counterLabels<=6 then logChange(catOf(obj),'COUNTER',pathOf(obj)..' = '..text,4) end
                end
            end
        end
        keepLine('SNAP '..reason..' '..page.Name..' tiles='..tiles..' itemLabels='..itemLabels..' pairCounters='..counterLabels)
    end
    local label=(#cats>0) and table.concat(cats,',') or '(no visible page)'
    if state.activePage~=label then
        keepLine('ACTIVE PAGE => '..label)
        state.activePage=label
    end
    refreshStatus(true)
end

local function isImportantPageNode(node)
    -- Avoid thousands of callbacks from individual tiles, which can freeze Android.
    if node.Parent and node.Parent.Name=='Pages' then return true end
    if node.Name=='Inventory' and node:IsA('ScrollingFrame') then return true end
    return false
end
local function isInterestingContainer(node)
    if isImportantPageNode(node) then return true end
    return node.Name=='Tile' and node:IsA('GuiObject')
end
local function attachGuiNode(node)
    if not state.running or state.watched[node] or state.watchCount>=9000 then return end
    state.watched[node]=true
    state.watchCount=state.watchCount+1
    if node:IsA('TextLabel') or node:IsA('TextButton') then
        connected(node:GetPropertyChangedSignal('Text'),function()
            if not state.running then return end
            local t=clean(node.Text,100)
            if not relevantText(node,t) then return end
            local cat=catOf(node)
            if node.Name=='ItemName' then observeSample(cat,t) end
            if node.Name=='ItemName' then
                local stat=state.categoryStats[cat] or state.categoryStats.Unknown
                if stat.changes>30 then stat.events=stat.events+1; return end
            end
            logChange(cat,'TEXT',pathOf(node)..' = '..t,0.1)
            refreshStatus(false)
        end)
    end
    if node:IsA('GuiObject') and isImportantPageNode(node) then
        connected(node:GetPropertyChangedSignal('Visible'),function()
            if not state.running then return end
            logChange(catOf(node),'VISIBLE',pathOf(node)..' = '..tostring(node.Visible),0.1)
            task.delay(.25,function()
                if state.running then snapshot('visibility') end
            end)
        end)
    end
    -- Observe category tab presses even when the game reuses a single page.
    -- This only listens to UI events; it never triggers a click itself.
    if node:IsA('GuiButton') and node.Name~='Tile' then
        local lower=node.Name:lower()
        if lower:find('tab',1,true) or lower:find('categor',1,true)
            or lower:find('fish',1,true) or lower:find('rod',1,true)
            or lower:find('bait',1,true) or lower:find('item',1,true)
            or lower:find('charm',1,true) or lower:find('emote',1,true)
            or lower:find('abilit',1,true) or lower:find('pet',1,true) then
            connected(node.Activated,function()
                if not state.running then return end
                logChange(catOf(node),'TAB-CLICK',pathOf(node),.2)
                task.delay(.35,function() if state.running then snapshot('tab-click') end end)
            end)
        end
    end
    if node:IsA('ScrollingFrame') then
        local lastScroll=0
        connected(node:GetPropertyChangedSignal('CanvasPosition'),function()
            if not state.running then return end
            local now=os.clock()
            if now-lastScroll<1.6 then return end
            lastScroll=now
            logChange(catOf(node),'SCROLL',pathOf(node)..' Y='..math.floor(node.CanvasPosition.Y),1.5)
        end)
    end
    if node.Name=='Tile' and node:IsA('GuiObject') then
        -- Only record attribute NAMES and types; never dump UUID or hidden payloads.
        connected(node.AttributeChanged,function(attribute)
            if not state.running then return end
            if attribute:match('^[%w_]+$') and #attribute<=45 then
                logChange(catOf(node),'ATTR',pathOf(node)..' key='..attribute,2)
            end
        end)
    end
end

local attaching=false
local function bindInventoryRoot(root)
    if not state.running or attaching or not root or state.roots.bound==root then return end
    attaching=true
    state.roots.bound=root
    if root:IsA('ScreenGui') then
        connected(root:GetPropertyChangedSignal('Enabled'),function()
            if state.running then
                logChange('Unknown','ROOT','Inventory Enabled='..tostring(root.Enabled),0.2)
                task.delay(.3,function() if state.running then snapshot('root enabled') end end)
            end
        end)
    end
    connected(root.DescendantAdded,function(node)
        if not state.running then return end
        attachGuiNode(node)
        local category=catOf(node)
        if isInterestingContainer(node) then
            logChange(category,'ADD',pathOf(node)..' ['..node.ClassName..']',.1)
        elseif node.Name=='ItemName' and (node:IsA('TextLabel') or node:IsA('TextButton')) then
            local value=clean(node.Text,70)
            if value~='' then observeSample(category,value) end
            local stats=state.categoryStats[category] or state.categoryStats.Unknown
            if stats.events<45 then logChange(category,'ITEM',pathOf(node)..' = '..value,.1) end
        end
        refreshStatus(false)
    end)
    connected(root.DescendantRemoving,function(node)
        if not state.running then return end
        if isInterestingContainer(node) then
            logChange(catOf(node),'REMOVE',pathOf(node),.1)
        end
    end)
    task.spawn(function()
        attachGuiNode(root)
        local all=root:GetDescendants()
        keepLine('WATCH GUI objects='..#all..' (max watcher 9000)')
        for i,obj in ipairs(all) do
            if not state.running then break end
            attachGuiNode(obj)
            if i%260==0 then task.wait() end
        end
        attaching=false
        if state.running then snapshot('start') end
    end)
end

local function findLocalStoragePaths()
    local found={}
    local names=''
    local count=0
    for _,child in ipairs(player:GetChildren()) do
        if child~=pg and child.Name~='Backpack' and child.Name~='PlayerScripts' and child.Name~='Character' then
            count=count+1
            if count<=32 then
                found[#found+1]='Player/'..clean(child.Name,45)..' ['..child.ClassName..']'
                if child:IsA('Folder') or child:IsA('Configuration') then
                    local descendants=child:GetDescendants()
                    found[#found+1]='  descendants='..#descendants
                    local shown=0
                    for _,sub in ipairs(descendants) do
                        if sub:IsA('ValueBase') and shown<9 then
                            shown=shown+1
                            found[#found+1]='  '..clean(sub.Name,45)..' ['..sub.ClassName..'] (value hidden)'
                        end
                    end
                end
            end
        end
    end
    return found
end
local function relatedModulePaths()
    local out={}
    local inventory=ReplicatedStorage:FindFirstChild('Controllers')
    local controller=inventory and inventory:FindFirstChild('InventoryController')
    if controller then
        out[#out+1]='ReplicatedStorage/Controllers/InventoryController ['..controller.ClassName..']'
        for _,child in ipairs(controller:GetChildren()) do
            if #out>=16 then break end
            out[#out+1]='  '..clean(child.Name,65)..' ['..child.ClassName..']'
        end
    end
    local shared=ReplicatedStorage:FindFirstChild('Shared')
    local mapping=shared and shared:FindFirstChild('InventoryMapping')
    if mapping then out[#out+1]='ReplicatedStorage/Shared/InventoryMapping ['..mapping.ClassName..']' end
    return out
end
local function makeReport()
    local report={}
    report[#report+1]='KIMS INVENTORY AUTO CAPTURE V12 | READ ONLY | NO UPLOAD'
    report[#report+1]='USER @'..player.Name..' | UserId='..tostring(player.UserId)
    report[#report+1]='PlaceId='..tostring(game.PlaceId)
    report[#report+1]='Duration='..math.floor(os.clock()-state.started)..'s | status='..(state.running and 'RECORDING' or 'STOPPED')
    report[#report+1]='GUI watchers='..state.watchCount..' | events='..state.events..' | old events discarded='..state.dropped
    report[#report+1]='Last active page='..state.activePage
    report[#report+1]='\n=== CATEGORY ACTIVITY (NOT OWNED ITEM COUNTS) ==='
    for _,cat in ipairs({'Fish/Items','Rods','Baits','Charms','Emotes','Abilities','Pets','Fish','Items','Unknown'}) do
        local data=state.categoryStats[cat]
        report[#report+1]=cat..': observed events='..(data and data.events or 0)..', text/attr changes='..(data and data.changes or 0)
        local samples=state.samples[cat]
        if samples and #samples>0 then report[#report+1]='  sample labels: '..table.concat(samples,' ; ') end
    end
    local seen={}
    for name,_ in pairs(state.seenPages) do seen[#seen+1]=name end
    table.sort(seen)
    report[#report+1]='Pages observed visible: '..(#seen>0 and table.concat(seen,', ') or '(none)')
    report[#report+1]='\n=== OBSERVED GUI SOURCE PATHS ==='
    for _,page in ipairs(seen) do
        report[#report+1]='PAGE '..page
        report[#report+1]='  first ItemName: '..(state.firstItemPath[page] or '(not found)')
        report[#report+1]='  tile attribute keys: '..(state.firstTileKeys[page] or '(not found)')
    end
    report[#report+1]='\n=== LOCAL PLAYER VALUE CONTAINERS (METADATA ONLY) ==='
    local found=findLocalStoragePaths()
    for _,s in ipairs(found) do report[#report+1]=s end
    report[#report+1]='\n=== INVENTORY-RELATED MODULE PATHS (METADATA ONLY) ==='
    for _,s in ipairs(relatedModulePaths()) do report[#report+1]=s end
    report[#report+1]='\n=== TIMELINE (MOST RECENT 580 EVENTS) ==='
    for _,s in ipairs(state.lines) do report[#report+1]=s end
    report[#report+1]='\nNOTE: GUI events and replicated paths DO NOT prove access to server storage or complete owned inventory.'
    report[#report+1]='NOTE: No remote hooks, no getgc, no HTTP, no data upload, no inventory modifications.'
    return table.concat(report,'\n')
end

local function stopRecorder()
    if not state.running then return end
    -- Capture the current page before disconnecting.
    snapshot('stop')
    state.running=false
    keepLine('STOP pressed. Monitoring disconnected.')
    for _,c in ipairs(state.connections) do pcall(function() c:Disconnect() end) end
    state.connections={}
    recBtn.Text='SELESAI'
    recBtn.BackgroundColor3=Color3.fromRGB(44,105,80)
    status.Text='STOPPED. Tekan SALIN lalu kirim hasilnya.'
    state.lastReport=makeReport()
    if state.expanded then output.Text=state.lastReport end
end

local refreshClock=0
connected(pg.ChildAdded,function(child)
    if state.running and child.Name=='Inventory' then
        bindInventoryRoot(child)
        logChange('Unknown','ROOT','Inventory appeared in PlayerGui',.5)
    end
end)
connected(pg.ChildRemoved,function(child)
    if state.running and child==state.root then
        state.roots.bound=nil
        keepLine('ROOT Inventory removed; waiting for replacement.')
    end
end)
connected(shutdownSignal.Event,stopRecorder)

recBtn.MouseButton1Click:Connect(function()
    if state.running then stopRecorder() end
end)
copyBtn.MouseButton1Click:Connect(function()
    local textData=state.running and makeReport() or state.lastReport
    if textData=='' then textData=makeReport() end
    local fn=(type(setclipboard)=='function' and setclipboard) or (type(toclipboard)=='function' and toclipboard)
    if not fn then
        copyBtn.Text='NO COPY'
        return
    end
    local ok=pcall(fn,textData)
    copyBtn.Text=ok and 'TERSALIN!' or 'GAGAL'
    task.delay(2,function()
        if screen.Parent then copyBtn.Text='SALIN' end
    end)
end)
previewBtn.MouseButton1Click:Connect(function()
    state.expanded=not state.expanded
    outputFrame.Visible=state.expanded
    panel.Size=state.expanded and UDim2.new(.90,0,.66,0) or UDim2.new(.90,0,0,116)
    previewBtn.Text=state.expanded and 'CIUT' or 'HASIL'
    if state.expanded then output.Text=state.running and makeReport() or state.lastReport end
end)
closeBtn.MouseButton1Click:Connect(function()
    stopRecorder()
    state.closed=true
    pcall(function() dragA:Disconnect() end)
    pcall(function() dragB:Disconnect() end)
    pcall(function() dragC:Disconnect() end)
    screen:Destroy()
end)

keepLine('REC auto ON. Buka semua kategori inventory secara manual; jangan klik record lagi.')
keepLine('Recorder memantau perubahan GUI, bukan isi storage server atau tabel Lua tersembunyi.')
local root=pg:FindFirstChild('Inventory')
if root then bindInventoryRoot(root) else snapshot('initial') end

-- Low-rate fallback for games that reuse the same GUI rather than adding new objects.
task.spawn(function()
    local lastActive=''
    while state.running and screen.Parent do
        task.wait(1.5)
        if not state.running then break end
        local inventory=pg:FindFirstChild('Inventory')
        if inventory and not state.roots.bound then bindInventoryRoot(inventory) end
        local _,pages=visiblePages()
        local names={}
        for _,page in ipairs(pages) do names[#names+1]=page.Name end
        local nowActive=table.concat(names,',')..'|'..(inventory and tostring(inventory.Enabled) or 'nil')
        if nowActive~=lastActive then
            lastActive=nowActive
            snapshot('page-change')
        end
        refreshStatus(false)
    end
end)
