-- Replace the CONTENTS of scripts/datav2 with this complete file.
-- Based on the owner's KIMS STAT AKUN V1. UI/lifecycle code is implemented
-- for KIMS using the readable hub patterns documented in PANDUAN_KIMS.txt.
-- Reads client-visible data. No external UI library or key service required.

local VERSION = "1.1.0"
local GLOBAL_KEY = "__KIMS_SCRIPT_APP_V1"
local ENV = _G
if type(getgenv) == "function" then
    local ok, value = pcall(getgenv)
    if ok and type(value) == "table" then ENV = value end
end

local previous = ENV[GLOBAL_KEY]
if type(previous) == "table" and previous.Alive and previous.Version == VERSION then
    if type(previous.Show) == "function" then pcall(previous.Show, previous) end
    print("[KIMS] Panel sudah aktif; panel yang sama dibuka kembali.")
    return previous
end
if type(previous) == "table" and previous.Alive and type(previous.Destroy) == "function" then
    pcall(previous.Destroy, previous)
end

local App = {Alive = true, Version = VERSION, LiveVersion = 1,
    Connections = {}, Logs = {}, Rows = {}, Inventory = {},
    RootKeys = {}, Source = "Menunggu scan", ModuleState = "Belum diperiksa",
    ChannelState = "Belum diperiksa", Busy = false, AutoRefresh = true,
    Interval = 5, LastScan = "Belum", Equipped = "Belum terbaca", Truncated = false,
    LiveEnabled = true, LiveFeed = {}, LiveEpoch = 0, LiveSeq = 0, LiveSignals = 0,
    LiveLastEvent = "Belum", LiveStatus = "Menunggu Data", LiveInventoryStatus = "Belum diperiksa"}
ENV[GLOBAL_KEY] = App

local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local Http = game:GetService("HttpService")
local UIS = game:GetService("UserInputService")
local Tween = game:GetService("TweenService")
local player = Players.LocalPlayer
local CONFIG_PATH = "KIMS_SCRIPT/settings_v1.json"
local clipboard = setclipboard or toclipboard or ENV.setclipboard or ENV.toclipboard
local readFile = readfile or ENV.readfile
local writeFile = writefile or ENV.writefile
local isFile = isfile or ENV.isfile
local makeFolder = makefolder or ENV.makefolder

local function clean(value, limit)
    local result = (value == nil and "" or tostring(value)):gsub("[%c]", " ")
    return result:sub(1, limit or 140)
end

local function disconnect(connection)
    if connection then pcall(function() connection:Disconnect() end) end
end

function App:Track(connection)
    self.Connections[#self.Connections + 1] = connection
    return connection
end

function App:Log(level, message)
    local line = os.date("%H:%M:%S") .. " [" .. level .. "] " .. clean(message, 240)
    self.Logs[#self.Logs + 1] = line
    if #self.Logs > 45 then table.remove(self.Logs, 1) end
    print("[KIMS] " .. line)
end

function App:Toast(message)
    if self.ToastLabel and self.Alive then
        self.ToastLabel.Text = clean(message, 200)
        self.ToastLabel.Visible = true
        self.ToastSerial = (self.ToastSerial or 0) + 1
        local serial = self.ToastSerial
        task.delay(4, function()
            if self.Alive and serial == self.ToastSerial then self.ToastLabel.Visible = false end
        end)
    end
end

function App:SaveSettings()
    if type(writeFile) ~= "function" or type(makeFolder) ~= "function" then
        return false, "Executor tidak menyediakan penyimpanan file."
    end
    local ok = pcall(function()
        pcall(makeFolder, "KIMS_SCRIPT")
        writeFile(CONFIG_PATH, Http:JSONEncode({Version = 1,
            AutoRefresh = self.AutoRefresh, Interval = self.Interval}))
    end)
    return ok, ok and "Preferensi tersimpan." or "Preferensi belum berhasil disimpan."
end

local function loadSettings()
    if type(readFile) ~= "function" or type(isFile) ~= "function" then return end
    local ok, cfg = pcall(function()
        if not isFile(CONFIG_PATH) then return nil end
        return Http:JSONDecode(readFile(CONFIG_PATH))
    end)
    if ok and type(cfg) == "table" then
        if type(cfg.AutoRefresh) == "boolean" then App.AutoRefresh = cfg.AutoRefresh end
        if cfg.Interval == 3 or cfg.Interval == 5 or cfg.Interval == 10 then App.Interval = cfg.Interval end
    end
end

local KEYWORDS = {"caught", "catch", "rarest", "stat", "level", "coin", "money",
    "fishcount", "fishcaught", "luck", "xp", "experience", "gem", "diamond"}
local PRIVATE = {password = true, cookie = true, roblosecurity = true,
    authorization = true, accesstoken = true, refreshtoken = true, apikey = true,
    scriptkey = true, webhook = true, webhookurl = true, email = true,
    phone = true, phonenumber = true, sessionid = true, token = true}

local function normalized(key) return tostring(key):lower():gsub("[^%w]", "") end
local function isPrivate(key) return PRIVATE[normalized(key)] == true end
local function isStat(key)
    local name = tostring(key):lower()
    for _, word in ipairs(KEYWORDS) do
        if name:find(word, 1, true) then return true end
    end
    return false
end

local function sortedKeys(tbl)
    local keys, truncated = {}, false
    for key in pairs(tbl) do
        if type(key) == "string" or type(key) == "number" then
            keys[#keys + 1] = key
            if #keys >= 500 then truncated = true; break end
        end
    end
    table.sort(keys, function(a, b) return tostring(a) < tostring(b) end)
    return keys, truncated
end

local function displayValue(value)
    if type(value) == "number" or type(value) == "boolean" then return tostring(value) end
    if type(value) == "string" then return "string (" .. #value .. " karakter)" end
    return typeof(value)
end

-- This builds a bounded report, never a full player-data dump.
local function collectStats(root)
    local rows, seen, budget, truncated = {}, {}, 0, false
    local function walk(tbl, prefix, depth, inherited)
        if depth > 3 or seen[tbl] then return end
        seen[tbl] = true
        local keys, capped = sortedKeys(tbl)
        local deferred = {}
        truncated = truncated or capped
        for _, key in ipairs(keys) do
            budget = budget + 1
            if budget > 1200 or #rows >= 150 then truncated = true; return end
            if not isPrivate(key) then
                local value, name = tbl[key], clean(key, 80)
                local path = prefix == "" and name or (prefix .. "." .. name)
                local candidate = isStat(name)
                if candidate or (inherited and (type(value) == "number" or type(value) == "boolean")) then
                    rows[#rows + 1] = {Path = path, Value = displayValue(value), Kind = typeof(value)}
                end
                local low = normalized(name)
                if type(value) == "table" and low ~= "inventory" and low ~= "items" then
                    deferred[#deferred + 1] = {value, path, inherited or candidate}
                end
            end
        end
        -- Root scalars (Coins, Level, etc.) must be read before a large mastery table.
        for _, child in ipairs(deferred) do walk(child[1], child[2], depth + 1, child[3]) end
    end
    walk(root, "", 0, false)
    table.sort(rows, function(a, b) return a.Path < b.Path end)
    return rows, truncated
end

local function entryCount(tbl)
    local n = 0
    for _ in pairs(tbl) do n = n + 1; if n >= 10000 then return "10000+" end end
    return tostring(n)
end

local function summarizeInventory(root)
    local result = {}
    local inventory = root.Inventory
    if type(inventory) ~= "table" then return result, "Inventory belum terbaca" end
    local keys, capped = sortedKeys(inventory)
    for _, key in ipairs(keys) do
        if #result >= 100 then capped = true; break end
        if not isPrivate(key) then
            local value = inventory[key]
            local summary = displayValue(value)
            if type(value) == "table" then
                local parts = {}
                for _, field in ipairs({"Name", "Id", "ID", "Type", "Rarity", "Variant", "Amount", "Quantity"}) do
                    local fieldValue = rawget(value, field)
                    if type(fieldValue) == "number" or type(fieldValue) == "boolean" or type(fieldValue) == "string" then
                        parts[#parts + 1] = field .. "=" .. clean(fieldValue, 48)
                    end
                end
                summary = #parts > 0 and table.concat(parts, " | ") or (entryCount(value) .. " entri di dalam tabel")
            end
            result[#result + 1] = {Path = "Inventory." .. clean(key, 90), Value = summary, Kind = typeof(value)}
        end
    end
    return result, "Inventory: " .. entryCount(inventory) .. " entri tingkat atas" .. (capped and " (tampilan dibatasi)" or "")
end

local function findModule()
    local packages = RS:FindFirstChild("Packages")
    local candidate = packages and packages:FindFirstChild("Replion", true)
    if candidate and candidate:IsA("ModuleScript") then return candidate end
    candidate = RS:FindFirstChild("Replion")
    if candidate and candidate:IsA("ModuleScript") then return candidate end
    return nil
end

local function rootFromData(data)
    if data.Destroyed then return nil end
    local ok, root = pcall(function() return data:Get() end)
    if ok and type(root) == "table" then return root end
    if type(data.Data) == "table" then return data.Data end
    return nil
end

-- Live observation uses fresh scalar snapshots, not references to mutable game tables.
local function masterySnapshot(root)
    local result, n = {}, 0
    if type(root.CaughtFishMastery) ~= "table" then return nil, "Mastery belum tersedia" end
    for name, record in pairs(root.CaughtFishMastery) do
        n = n + 1
        if n > 5000 then return nil, "Mastery melewati batas 5000 jenis; deteksi ditunda" end
        if type(name) == "string" and type(record) == "table" then
            local count = rawget(record, "Count")
            if type(count) == "number" and count == count and count >= 0 and count < math.huge then
                result[name] = count
            else result[name] = false end -- Known record, Count not supplied by the game.
        end
    end
    return result, "Mastery siap"
end

local function scalarField(record, names)
    if type(record) ~= "table" then return nil end
    for _, name in ipairs(names) do
        local value = rawget(record, name)
        if type(value) == "string" or type(value) == "number" then return clean(value, 90) end
    end
    return nil
end

local function isUUID(value)
    return type(value) == "string" and value:match("^%x%x%x%x%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%x%x%x%x%x%x%x%x$") ~= nil
end

local function inventorySnapshot(root)
    if type(root.Inventory) ~= "table" then return nil, "Inventory belum tersedia", {} end
    local items, visited, schema, budget, records, complete = {}, {}, {}, 0, 0, true
    local function walk(tbl, path, key, depth)
        if not complete or visited[tbl] or depth > 5 then return end
        visited[tbl] = true
        local identity = scalarField(tbl, {"UUID", "Uuid", "uuid", "UID", "uid"})
        if identity == "" then identity = nil end
        if not identity then
            local idValue = rawget(tbl, "Id") or rawget(tbl, "ID")
            if isUUID(idValue) then identity = idValue elseif isUUID(key) then identity = key end
        end
        if identity then
            records = records + 1
            if records > 2500 then complete = false; return end
            local meta = type(tbl.Metadata) == "table" and tbl.Metadata or {}
            items[identity] = {UUID = identity, Path = path,
                Name = scalarField(tbl, {"FishName", "Name", "ItemName"}),
                ItemId = scalarField(tbl, {"Id", "ID", "ItemId", "FishId"}),
                Variant = scalarField(tbl, {"Variant", "Mutation"}) or scalarField(meta, {"Variant", "Mutation"}),
                Rarity = scalarField(tbl, {"Rarity", "Tier"}) or scalarField(meta, {"Rarity", "Tier"}),
                Weight = scalarField(tbl, {"Weight"}) or scalarField(meta, {"Weight"})}
            if #schema < 4 then
                local fields = {}
                for field, value in pairs(tbl) do
                    if not isPrivate(field) and #fields < 16 then fields[#fields + 1] = clean(field, 30) .. ":" .. typeof(value) end
                end
                table.sort(fields)
                schema[#schema + 1] = path .. " {" .. table.concat(fields, ", ") .. "}"
            end
            return
        end
        for childKey, value in pairs(tbl) do
            budget = budget + 1
            if budget > 8000 then complete = false; return end
            if type(value) == "table" and not isPrivate(childKey) then
                if depth >= 5 then complete = false; return end
                walk(value, path .. "." .. clean(childKey, 60), childKey, depth + 1)
            end
        end
    end
    walk(root.Inventory, "Inventory", nil, 0)
    if not complete then return nil, "Inventory dibatasi; deteksi UUID ditunda", schema end
    return items, tostring(records) .. " record UUID siap", schema
end

local function pathInfo(path)
    if type(path) == "table" then
        local parts = {}
        for i, part in ipairs(path) do if i > 7 then break end; parts[#parts + 1] = clean(part, 60) end
        return tostring(path[1] or ""), table.concat(parts, ".")
    end
    if type(path) == "string" then return path:match("^([^%.]+)") or path, clean(path, 180) end
    return "", "Path tidak disertakan modul"
end

function App:AddLive(record)
    self.LiveBatchCount = (self.LiveBatchCount or 0) + 1
    if self.LiveBatchCount > 40 then
        self.LiveOmitted = (self.LiveOmitted or 0) + 1
        return
    end
    self.LiveSeq = self.LiveSeq + 1
    record.Seq = self.LiveSeq
    record.DelayMs = math.max(0, math.floor((os.clock() - record.ReceivedAt) * 1000 + 0.5))
    table.insert(self.LiveFeed, 1, record)
    if #self.LiveFeed > 40 then table.remove(self.LiveFeed) end
    self:Log("LIVE", record.Kind .. " | " .. record.Name .. " | " .. record.Source)
end

function App:ObserveLive(source, receivedAt, receivedTime, suppliedRoot)
    if not self.Alive or not self.LiveEnabled or self.LiveBusy then return end
    if self.LivePending and source ~= "EVENT" then return end
    self.LiveBusy = true
    self.LiveBatchCount = 0
    local ok, err = pcall(function()
        local root = suppliedRoot or (self.Data and rootFromData(self.Data))
        if type(root) ~= "table" then
            self.LiveCounts, self.LiveItems = nil, nil
            self.LiveStatus = "Menunggu Data"
            return
        end
        local counts, masteryState = masterySnapshot(root)
        local items, inventoryState, schema = inventorySnapshot(root)
        self.LiveInventoryStatus, self.LiveSchema = inventoryState, schema
        self.LiveMasteryStatus = masteryState
        local wasReady = self.LiveCounts ~= nil or self.LiveItems ~= nil
        local added = false
        if counts and self.LiveCounts then
            local names = {}
            for name in pairs(counts) do names[#names + 1] = name end
            table.sort(names)
            for _, name in ipairs(names) do
                local before, after = self.LiveCounts[name], counts[name]
                local oldCount = type(before) == "number" and before or nil
                local newCount = type(after) == "number" and after or nil
                local increase = oldCount ~= nil and newCount ~= nil and newCount > oldCount
                if before == nil or increase or (before == false and newCount ~= nil) then
                    self:AddLive({Kind = increase and "COUNT NAIK" or (before == nil and "MASTERY BARU" or "COUNT TERBACA"), Name = clean(name, 90),
                        Quantity = increase and (newCount - oldCount) or nil, Before = oldCount, After = newCount,
                        Source = source, ReceivedAt = receivedAt or os.clock(),
                        Time = receivedTime or os.date("%H:%M:%S"),
                        Path = "CaughtFishMastery." .. clean(name, 90) .. (newCount ~= nil and ".Count" or "")})
                    added = true
                end
            end
        end
        if items and self.LiveItems then
            local identities = {}
            for identity in pairs(items) do identities[#identities + 1] = identity end
            table.sort(identities)
            for _, identity in ipairs(identities) do
                if not self.LiveSeenItems[identity] then
                    local item = items[identity]
                    self:AddLive({Kind = "ITEM BARU", Name = item.Name or ("Item ID " .. (item.ItemId or "belum terbaca")),
                        UUID = identity, ItemId = item.ItemId, Variant = item.Variant,
                        Rarity = item.Rarity, Weight = item.Weight, Path = item.Path,
                        Source = source, ReceivedAt = receivedAt or os.clock(), Time = receivedTime or os.date("%H:%M:%S")})
                    added = true
                end
            end
        end
        self.LiveCounts, self.LiveItems = counts, items
        if items then
            self.LiveSeenItems = self.LiveSeenItems or {}
            for identity in pairs(items) do self.LiveSeenItems[identity] = true end
            local seen = 0
            for _ in pairs(self.LiveSeenItems) do seen = seen + 1 end
            if seen > 10000 then
                self.LiveSeenItems = {}
                for identity in pairs(items) do self.LiveSeenItems[identity] = true end
            end
        else self.LiveSeenItems = {} end
        local ready = counts ~= nil or items ~= nil
        self.LiveStatus = ready and "SIAP - pancing ikan untuk tes live" or "Data deteksi belum tersedia"
        if ready and not wasReady then
            self.LiveBaselineTime = os.date("%H:%M:%S")
            self:Log("LIVE", "Baseline terbentuk; koleksi awal tidak dimasukkan ke feed.")
        end
        self.LiveLastCheck = os.date("%H:%M:%S")
        if added then self.LiveLastChange = self.LiveLastCheck end
    end)
    self.LiveBusy = false
    if not ok then
        self.LiveStatus = "Ada kendala deteksi; salin hasil tes"
        self.LiveError = clean(err, 180)
    else self.LiveError = nil end
    if self.Render and self.Alive then self:Render() end
end

function App:ResetLive(clearFeed)
    self.LiveEpoch = self.LiveEpoch + 1
    self.LivePending, self.LivePendingMeta = false, nil
    self.LiveCounts, self.LiveItems, self.LiveSeenItems = nil, nil, {}
    self.LiveBaselineTime = nil
    self.LiveStatus = self.LiveEnabled and "Menunggu baseline" or "PAUSE"
    if clearFeed then
        self.LiveFeed, self.LiveSeq, self.LiveSignals, self.LiveOmitted = {}, 0, 0, 0
        self.LiveLastEvent, self.LiveLastChange = "Belum", nil
        self.LiveLastPath = nil
    end
    if self.LiveEnabled then self:ObserveLive("BASELINE", os.clock(), os.date("%H:%M:%S")) end
    if self.Render and self.Alive then self:Render() end
end

function App:QueueLive(path)
    if not self.Alive or not self.LiveEnabled then return end
    self.LiveSignals = self.LiveSignals + 1
    self.LiveLastEvent = os.date("%H:%M:%S")
    local first, text = pathInfo(path)
    self.LiveLastPath = text
    if first ~= "" and first ~= "Inventory" and first ~= "CaughtFishMastery" then return end
    if self.LivePending then return end
    self.LivePending = true
    local epoch, receivedAt, receivedTime = self.LiveEpoch, os.clock(), os.date("%H:%M:%S")
    task.delay(0.03, function()
        if not self.Alive or self.LiveEpoch ~= epoch or not self.LiveEnabled then return end
        self.LivePending = false
        self:ObserveLive("EVENT", receivedAt, receivedTime)
    end)
end

function App:LiveReport()
    local lines = {"KIMS LIVE TEST " .. VERSION, "Akun: " .. clean(player.Name),
        "Status: " .. (self.LiveEnabled and self.LiveStatus or "PAUSE"),
        "Listener: " .. (self.DataConnection and "EVENT DATA + POLL 0.5s" or "POLL 0.5s"),
        "Baseline: " .. (self.LiveBaselineTime or "Belum"),
        "Event Data diterima: " .. self.LiveSignals .. " | terakhir " .. self.LiveLastEvent,
        "Path event terakhir: " .. (self.LiveLastPath or "Belum"),
        "Mastery: " .. (self.LiveMasteryStatus or "Belum diperiksa"),
        "Inventory: " .. self.LiveInventoryStatus,
        "Perubahan tersimpan: " .. #self.LiveFeed .. " (maksimum 40)",
        "Perubahan dalam batch besar yang diringkas: " .. (self.LiveOmitted or 0),
        "COUNT NAIK adalah perubahan mastery. ITEM BARU adalah UUID baru; sumber tangkapan belum terkonfirmasi.",
        "MASTERY BARU / COUNT TERBACA menandai data yang baru terlihat, tanpa menganggapnya jumlah tangkapan baru.",
        "Jeda adalah waktu pemrosesan lokal dari callback, bukan latensi jaringan/server.", "--- PERUBAHAN LIVE ---"}
    for _, record in ipairs(self.LiveFeed) do
        lines[#lines + 1] = "[" .. record.Time .. "] " .. record.Kind .. " | " .. record.Name
            .. " | " .. record.Source .. " | proses lokal " .. record.DelayMs .. " ms"
        lines[#lines + 1] = "Path: " .. record.Path
        if record.Quantity then
            lines[#lines + 1] = "COUNT: " .. record.Before .. " -> " .. record.After .. " (delta +" .. record.Quantity .. ")"
        elseif record.After ~= nil then
            lines[#lines + 1] = "Count saat record pertama teramati: " .. record.After .. " (nilai sebelumnya belum diketahui)"
        elseif record.Kind ~= "ITEM BARU" then
            lines[#lines + 1] = "Record mastery baru; field Count belum disediakan game."
        end
        if record.UUID then
            lines[#lines + 1] = "UUID: " .. record.UUID .. " | ID: " .. (record.ItemId or "Belum terbaca")
            lines[#lines + 1] = "VARIANT: " .. (record.Variant or "Belum terbaca") .. " | Rarity: "
                .. (record.Rarity or "Belum terbaca") .. " | Weight: " .. (record.Weight or "Belum terbaca")
        end
    end
    if #self.LiveFeed == 0 then lines[#lines + 1] = "Belum ada kenaikan Count atau UUID baru setelah baseline." end
    lines[#lines + 1] = "--- CONTOH STRUKTUR INVENTORY (NAMA FIELD) ---"
    for _, line in ipairs(self.LiveSchema or {}) do lines[#lines + 1] = line end
    if self.LiveError then lines[#lines + 1] = "Kendala: " .. self.LiveError end
    return table.concat(lines, "\n")
end

function App:CopyLiveReport()
    if type(clipboard) == "function" and pcall(clipboard, self:LiveReport()) then
        self:Toast("Hasil tes live tersalin. Kirim setelah mencoba 2-3 tangkapan.")
        return true
    end
    self:Toast("Clipboard belum tersedia; laporan live ada di Diagnostik.")
    if self.SelectTab then self:SelectTab("DIAGNOSTIK") end
    return false
end

local function fallbackStats()
    local rows = {}
    local leaderstats = player:FindFirstChild("leaderstats")
    if leaderstats then
        for i, child in ipairs(leaderstats:GetChildren()) do
            if i > 100 then break end
            if child:IsA("ValueBase") and not isPrivate(child.Name) then
                rows[#rows + 1] = {Path = "leaderstats." .. clean(child.Name, 80), Value = displayValue(child.Value), Kind = typeof(child.Value)}
            end
        end
    end
    local ok, attrs = pcall(function() return player:GetAttributes() end)
    if ok and type(attrs) == "table" then
        for name, value in pairs(attrs) do
            if isStat(name) and not isPrivate(name) then
                rows[#rows + 1] = {Path = "Attributes." .. clean(name, 80), Value = displayValue(value), Kind = typeof(value)}
            end
        end
    end
    table.sort(rows, function(a, b) return a.Path < b.Path end)
    return rows
end

function App:AttachData(data)
    if self.Data == data then return end
    disconnect(self.DataConnection)
    self.DataConnection = nil
    self.Data = data
    self:ResetLive(false)
    if data and type(data.OnDataChange) == "function" then
        local ok, connection = pcall(function()
            return data:OnDataChange(function(_, path)
                -- Replion callbacks do not yield or scan the data synchronously.
                self.Dirty = true
                self:QueueLive(path)
            end)
        end)
        if ok then self.DataConnection = connection end
    end
end

function App:Scan(manual)
    if not self.Alive or self.Busy then return false end
    self.Busy = true
    local ok, problem = xpcall(function()
        local root = self.Data and rootFromData(self.Data)
        if not root then
            self:AttachData(nil)
            if not self.Replion then
                local module = findModule()
                self.ModuleState = module and "Ditemukan; membaca modul" or "Modul Replion belum ditemukan"
                if module then
                    self.ModulePath = module:GetFullName()
                    local requireOK, api = pcall(require, module)
                    if not self.Alive then return end
                    if requireOK and type(api) == "table" and type(api.Client) == "table" then
                        self.Replion = api
                        self.ModuleState = "Replion berhasil dibaca"
                        self.ModuleError = nil
                    else
                        self.ModuleState = "Require Replion belum berhasil"
                        self.ModuleError = requireOK and "Replion.Client belum tersedia pada modul ini" or clean(api, 180)
                    end
                end
            end
            if self.Replion then
                local getOK, data = pcall(function() return self.Replion.Client:GetReplion("Data") end)
                self.ChannelError = not getOK and clean(data, 180) or nil
                if getOK and data then
                    self:AttachData(data)
                    root = rootFromData(data)
                end
                self.ChannelState = root and "Channel Data terbaca" or "Channel Data belum tersedia"
            else self.ChannelState = "Menunggu Replion" end
        end
        if not self.Alive then return end
        if root then
            self.Source = "Replion / Data"
            self.ChannelState = "Channel Data terbaca"
            self.Rows, self.Truncated = collectStats(root)
            self.Inventory, self.InventoryState = summarizeInventory(root)
            self.InventoryAvailable = type(root.Inventory) == "table"
            self.Equipped = (type(root.EquippedId) == "number" or type(root.EquippedId) == "string")
                and clean(root.EquippedId, 100) or "Belum terbaca"
            self.RootKeys = {}
            local keys = sortedKeys(root)
            for _, key in ipairs(keys) do
                if not isPrivate(key) then
                    self.RootKeys[#self.RootKeys + 1] = clean(key, 70) .. " : " .. typeof(root[key])
                end
                if #self.RootKeys >= 200 then break end
            end
        else
            self.Rows = fallbackStats()
            self.Source = #self.Rows > 0 and "leaderstats / Attributes" or "Data belum tersedia"
            self.Inventory, self.RootKeys = {}, {}
            self.InventoryState, self.Equipped = "Inventory belum terbaca", "Belum terbaca"
            self.InventoryAvailable = false
            self.Truncated = false
        end
        self.LastScan, self.Dirty = os.date("%H:%M:%S"), false
        self.LastError = nil
        if manual or self.LastSource ~= self.Source then
            self:Log("SCAN", self.Source .. " | " .. #self.Rows .. " field kandidat stat")
        end
        self.LastSource = self.Source
    end, function(err) return clean(err, 180) end)
    self.Busy = false
    if not ok then
        self.LastError = problem
        self:Log("ERROR", problem)
        if manual then self:Toast("Scan gagal; buka tab Diagnostik.") end
    end
    if self.Alive and self.Render then self:Render() end
    return ok
end

function App:Report()
    local lines = {"KIMS SCRIPT " .. VERSION, "Akun: " .. clean(player.Name),
        "PlaceId: " .. tostring(game.PlaceId), "GameId: " .. tostring(game.GameId),
        "Sumber: " .. self.Source, "Modul: " .. self.ModuleState,
        "Path modul: " .. (self.ModulePath or "Belum ditemukan"),
        "Kendala modul: " .. (self.ModuleError or "Tidak ada"),
        "Kendala channel: " .. (self.ChannelError or "Tidak ada"),
        "Channel: " .. self.ChannelState, "Scan: " .. self.LastScan,
        "Inventory: " .. (self.InventoryState or "Belum diperiksa"),
        "EquippedId: " .. self.Equipped, "--- KANDIDAT STAT ---"}
    for _, row in ipairs(self.Rows) do lines[#lines + 1] = row.Path .. " = " .. row.Value end
    if #self.Rows == 0 then lines[#lines + 1] = "Belum ada field kandidat yang terbaca." end
    lines[#lines + 1] = "--- NAMA FIELD ROOT (TANPA NILAI) ---"
    for _, line in ipairs(self.RootKeys) do lines[#lines + 1] = line end
    lines[#lines + 1] = "--- LOG ---"
    for _, line in ipairs(self.Logs) do lines[#lines + 1] = line end
    if self.LastError then lines[#lines + 1] = "Error terakhir: " .. self.LastError end
    lines[#lines + 1] = "--- LAPORAN LIVE ---"
    lines[#lines + 1] = self:LiveReport()
    return table.concat(lines, "\n")
end

function App:CopyReport()
    if type(clipboard) == "function" then
        local ok = pcall(clipboard, self:Report())
        if ok then self:Toast("Laporan tersalin. Kirim hasilnya untuk cek data game."); return true end
    end
    self:Toast("Clipboard belum tersedia. Laporan bisa dipilih di tab Diagnostik.")
    if self.SelectTab then self:SelectTab("DIAGNOSTIK") end
    return false
end

function App:Destroy()
    if not self.Alive then return end
    self.Alive = false
    self.LiveEpoch = self.LiveEpoch + 1
    disconnect(self.DataConnection)
    for _, connection in ipairs(self.Connections) do disconnect(connection) end
    self.Connections = {}
    if self.Gui then pcall(function() self.Gui:Destroy() end) end
    if ENV[GLOBAL_KEY] == self then ENV[GLOBAL_KEY] = nil end
    self.Data, self.Replion = nil, nil
    print("[KIMS] Panel ditutup; koneksi dan pemantauan dihentikan.")
end

-- UI is appended below. Keeping data access and UI in one file makes datav2
-- independently uploadable without relying on external hub loaders.

local COLOR = {Background = Color3.fromRGB(15, 17, 23), Panel = Color3.fromRGB(23, 26, 34),
    Row = Color3.fromRGB(30, 34, 44), Gold = Color3.fromRGB(226, 192, 126),
    Text = Color3.fromRGB(237, 239, 245), Muted = Color3.fromRGB(155, 166, 185),
    Green = Color3.fromRGB(129, 211, 166), Red = Color3.fromRGB(245, 142, 142)}

local function create(className, props, parent)
    local object = Instance.new(className)
    for key, value in pairs(props) do object[key] = value end
    object.Parent = parent
    return object
end

local function round(object, radius)
    create("UICorner", {CornerRadius = UDim.new(0, radius or 10)}, object)
end

local function label(parent, text, position, size, muted, fontSize)
    return create("TextLabel", {BackgroundTransparency = 1, Text = text,
        Position = position, Size = size, Font = Enum.Font.Gotham,
        TextSize = fontSize or 13, TextColor3 = muted and COLOR.Muted or COLOR.Text,
        TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
        RichText = false}, parent)
end

local function button(parent, text, position, size, action)
    local b = create("TextButton", {BackgroundColor3 = COLOR.Row, BorderSizePixel = 0,
        Text = text, Position = position, Size = size, Font = Enum.Font.GothamMedium,
        TextSize = 12, TextColor3 = COLOR.Text, AutoButtonColor = true}, parent)
    round(b, 8)
    App:Track(b.Activated:Connect(function()
        if not App.Alive then return end
        local ok, err = pcall(action)
        if not ok then App:Log("ERROR", err); App:Toast("Aksi gagal; buka Diagnostik.") end
    end))
    return b
end

local function searchBox(parent, placeholder, y)
    local input = create("TextBox", {BackgroundColor3 = COLOR.Row, BorderSizePixel = 0,
        Position = UDim2.fromOffset(0, y), Size = UDim2.new(1, 0, 0, 32),
        PlaceholderText = placeholder, PlaceholderColor3 = COLOR.Muted, Text = "",
        TextColor3 = COLOR.Text, TextSize = 12, Font = Enum.Font.Gotham,
        ClearTextOnFocus = false, TextXAlignment = Enum.TextXAlignment.Left}, parent)
    round(input, 8)
    create("UIPadding", {PaddingLeft = UDim.new(0, 11), PaddingRight = UDim.new(0, 11)}, input)
    App:Track(input:GetPropertyChangedSignal("Text"):Connect(function()
        if App.Render then App:Render() end
    end))
    return input
end

local function listFrame(parent, y)
    local scroll = create("ScrollingFrame", {Position = UDim2.fromOffset(0, y),
        Size = UDim2.new(1, 0, 1, -y), BackgroundTransparency = 1, BorderSizePixel = 0,
        ScrollBarThickness = 3, ScrollBarImageColor3 = COLOR.Gold,
        CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y}, parent)
    create("UIListLayout", {Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder}, scroll)
    create("UIPadding", {PaddingRight = UDim.new(0, 8), PaddingBottom = UDim.new(0, 6)}, scroll)
    return scroll
end

local function renderList(scroll, rows, query, emptyText)
    query = tostring(query or ""):lower()
    local shown, signature = {}, {query, emptyText}
    for _, row in ipairs(rows) do
        if query == "" or (row.Path .. " " .. row.Value):lower():find(query, 1, true) then
            shown[#shown + 1] = row
            signature[#signature + 1] = row.Path .. "\0" .. row.Value
        end
    end
    local sig = table.concat(signature, "\1")
    if App.ListCache[scroll] == sig then return end
    App.ListCache[scroll] = sig
    local canvas = scroll.CanvasPosition
    for _, child in ipairs(scroll:GetChildren()) do
        if child:IsA("Frame") or child:IsA("TextLabel") then child:Destroy() end
    end
    if #shown == 0 then
        local message = label(scroll, query ~= "" and "Tidak ada hasil yang cocok." or emptyText,
            UDim2.new(), UDim2.new(1, -12, 0, 68), true, 13)
        message.TextWrapped = true
        message.TextTruncate = Enum.TextTruncate.None
        return
    end
    for index, row in ipairs(shown) do
        local frame = create("Frame", {Size = UDim2.new(1, 0, 0, 58),
            BackgroundColor3 = COLOR.Panel, BorderSizePixel = 0, LayoutOrder = index}, scroll)
        round(frame, 8)
        label(frame, row.Path, UDim2.fromOffset(12, 5), UDim2.new(1, -24, 0, 22), true, 11)
        local value = label(frame, row.Value, UDim2.fromOffset(12, 28), UDim2.new(1, -24, 0, 22), false, 13)
        value.TextColor3 = COLOR.Gold
    end
    scroll.CanvasPosition = canvas
end

local function renderLive()
    local signature = tostring(App.LiveSeq) .. ":" .. tostring(#App.LiveFeed) .. ":" .. tostring(App.LiveEnabled)
    if App.LiveListSignature == signature then return end
    App.LiveListSignature = signature
    for _, child in ipairs(App.LiveList:GetChildren()) do
        if child:IsA("Frame") or child:IsA("TextLabel") then child:Destroy() end
    end
    if #App.LiveFeed == 0 then
        local empty = label(App.LiveList,
            "Belum ada perubahan setelah baseline.\nTunggu status SIAP, lalu pancing 1 ikan.\nCOUNT NAIK dan ITEM BARU akan ditampilkan di sini.",
            UDim2.new(), UDim2.new(1, -12, 0, 100), true, 13)
        empty.TextWrapped, empty.TextTruncate = true, Enum.TextTruncate.None
        return
    end
    for index, record in ipairs(App.LiveFeed) do
        local frame = create("Frame", {Size = UDim2.new(1, 0, 0, 126), BackgroundColor3 = COLOR.Panel,
            BorderSizePixel = 0, LayoutOrder = index}, App.LiveList)
        round(frame, 9)
        local name = label(frame, record.Time .. "  " .. record.Name,
            UDim2.fromOffset(12, 6), UDim2.new(1, -24, 0, 22), false, 13)
        name.TextColor3 = COLOR.Gold
        local evidence = label(frame, record.Kind .. "  /  " .. record.Source,
            UDim2.fromOffset(12, 29), UDim2.new(1, -24, 0, 18), true, 10)
        evidence.TextColor3 = record.Source == "EVENT" and COLOR.Green or COLOR.Gold
        local details
        if record.Quantity then
            details = "Count " .. record.Before .. " -> " .. record.After .. "  (+" .. record.Quantity .. ")\nVARIANT / rarity / berat: belum terbaca dari mastery"
        elseif record.After ~= nil then
            details = "Record mastery baru terlihat. Count saat muncul: " .. record.After .. "\nNilai sebelumnya belum diketahui."
        elseif record.Kind ~= "ITEM BARU" then
            details = "Record mastery baru terlihat setelah baseline.\nField Count belum disediakan game."
        else
            details = "ID " .. (record.ItemId or "belum terbaca") .. " | VARIANT " .. (record.Variant or "belum terbaca")
                .. "\nRarity " .. (record.Rarity or "belum terbaca") .. " | Weight " .. (record.Weight or "belum terbaca")
        end
        local body = label(frame, details, UDim2.fromOffset(12, 48), UDim2.new(1, -24, 0, 49), false, 12)
        body.TextWrapped, body.TextTruncate, body.TextYAlignment = true, Enum.TextTruncate.None, Enum.TextYAlignment.Top
        label(frame, "Proses lokal " .. record.DelayMs .. " ms | " .. (record.UUID and "UUID baru; tangkapan belum terkonfirmasi" or "Perubahan data mastery"),
            UDim2.fromOffset(12, 101), UDim2.new(1, -24, 0, 17), true, 10)
    end
    App.LiveList.CanvasPosition = Vector2.new(0, 0)
end

local function attachDrag(handle, target, bubble)
    local dragging, touch, start, startPosition, moved = false, nil, nil, nil, false
    App:Track(handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging, touch, start, startPosition, moved = true, input, input.Position, target.Position, false
        end
    end))
    App:Track(UIS.InputChanged:Connect(function(input)
        if not dragging then return end
        if input ~= touch and not (touch.UserInputType == Enum.UserInputType.MouseButton1
            and input.UserInputType == Enum.UserInputType.MouseMovement) then return end
        local dx, dy = input.Position.X - start.X, input.Position.Y - start.Y
        if math.abs(dx) + math.abs(dy) > 5 then moved = true end
        local viewport = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(800, 600)
        local size = target.AbsoluteSize
        target.Position = UDim2.fromOffset(
            math.clamp(startPosition.X.Offset + dx, 4, math.max(4, viewport.X - size.X - 4)),
            math.clamp(startPosition.Y.Offset + dy, 4, math.max(4, viewport.Y - size.Y - 4)))
        if bubble and moved then App.IgnoreBubbleClickUntil = os.clock() + 0.25 end
    end))
    App:Track(UIS.InputEnded:Connect(function(input)
        if input == touch or input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end))
end

local function initialize()
    if not player then error("LocalPlayer belum tersedia; jalankan setelah masuk game.") end
    loadSettings()
    local gui = create("ScreenGui", {Name = "KIMS_SCRIPT_UI_V1", ResetOnSpawn = false,
        IgnoreGuiInset = true, DisplayOrder = 10000, ZIndexBehavior = Enum.ZIndexBehavior.Sibling})
    App.Gui, App.ListCache = gui, {}
    local parents = {}
    if type(gethui) == "function" then
        local ok, parent = pcall(gethui)
        if ok and parent then parents[#parents + 1] = parent end
    end
    local coreOK, coreGui = pcall(function() return game:GetService("CoreGui") end)
    if coreOK and coreGui then parents[#parents + 1] = coreGui end
    local playerGui = player:FindFirstChildOfClass("PlayerGui") or player:WaitForChild("PlayerGui", 5)
    if playerGui then parents[#parents + 1] = playerGui end
    for _, parent in ipairs(parents) do
        local ok = pcall(function() gui.Parent = parent end)
        if ok and gui.Parent then break end
    end
    if not gui.Parent then error("UI tidak bisa dipasang ke layar.") end

    local window = create("Frame", {Name = "Window", BackgroundColor3 = COLOR.Background,
        BorderSizePixel = 0, Active = true, ClipsDescendants = true,
        Size = UDim2.fromOffset(680, 500)}, gui)
