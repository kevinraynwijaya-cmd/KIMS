local toastToken = 0
local render
local function notify(msg)
    S.status = tostring(msg)
    print("[KIMS V3] " .. S.status)
    toastToken = toastToken + 1
    local id = toastToken
    Toast.Text = S.status
    Toast.Visible = true
    task.delay(4.5, function()
        if S.alive and id == toastToken then Toast.Visible = false end
    end)
end
local function hideUI()
    S.visible = false
    Main.Visible = false
    Floating.Visible = true
end
local function showUI()
    S.visible = true
    Main.Visible = true
    Floating.Visible = false
end
track(MinBtn.MouseButton1Click:Connect(hideUI))
track(CloseBtn.MouseButton1Click:Connect(hideUI))
track(Floating.MouseButton1Click:Connect(showUI))

-- Drag on PC and mobile by the header.
do
    local dragging, dragInput, dragStart, startPosition = false, nil, nil, nil
    track(Header.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then return end
        dragging = true
        dragInput = input
        dragStart = input.Position
        startPosition = Main.Position
    end))
    track(UIS.InputChanged:Connect(function(input)
        if not dragging or not dragStart or not startPosition then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement
            and input ~= dragInput then return end
        local d = input.Position - dragStart
        Main.Position = UDim2.new(startPosition.X.Scale, startPosition.X.Offset + d.X,
            startPosition.Y.Scale, startPosition.Y.Offset + d.Y)
    end))
    track(UIS.InputEnded:Connect(function(input)
        if input == dragInput or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end))
end

-- ========================= ENGINE (EXPERIMENTAL) =========================
local REMOTE_NAMES = {
    equip = "RE/EquipToolFromHotbar", charge = "RF/ChargeFishingRod",
    minigame = "RF/RequestFishingMinigameStarted",
    fishing = "RE/FishingCompleted", obtained = "RE/ObtainedNewFishNotification",
    sell = "RF/SellAllItems"
}
local remotes = {}
local function getNet()
    local packages = RS:FindFirstChild("Packages")
    local index = packages and packages:FindFirstChild("_Index")
    local package = index and index:FindFirstChild("sleitnick_net@0.2.0")
    if index and not package then
        for _, child in ipairs(index:GetChildren()) do
            if string.find(child.Name, "sleitnick_net", 1, true) then
                package = child
                break
            end
        end
    end
    return package and package:FindFirstChild("net") or nil
end
local function scanEngine()
    local net = getNet()
    local count = 0
    for key, path in pairs(REMOTE_NAMES) do
        remotes[key] = net and net:FindFirstChild(path) or nil
        if remotes[key] then count = count + 1 end
    end
    S.scanCount = count
    return count
end
local function checkEngine()
    local missing = {}
    for key, expected in pairs({equip="RemoteEvent", charge="RemoteFunction",
        minigame="RemoteFunction", fishing="RemoteEvent"}) do
        if not remotes[key] or not remotes[key]:IsA(expected) then
            table.insert(missing, key)
        end
    end
    return #missing == 0, table.concat(missing, ", ")
end
local function fire(key, ...)
    local r = remotes[key]
    if not r or not r:IsA("RemoteEvent") then return false, key .. " remote missing" end
    return pcall(function(...) r:FireServer(...) end, ...)
end
local function invoke(key, ...)
    local r = remotes[key]
    if not r or not r:IsA("RemoteFunction") then return false, key .. " remote missing" end
    local ok, result = pcall(function(...) return r:InvokeServer(...) end, ...)
    if not ok then return false, result end
    if result == false then return false, key .. " returned false" end
    return true, result
end
local function stopFishing()
    S.fishing = false
    S.token = S.token + 1
end
local function stillFishing(token)
    return S.alive and S.fishing and S.token == token
end
local function startFishing()
    if S.fishing then return true end
    scanEngine()
    local ready, missing = checkEngine()
    if not ready then
        notify("Auto Fish gagal: remote belum lengkap (" .. missing .. ")")
        return false
    end
    S.fishing = true
    S.token = S.token + 1
    local token = S.token
    task.spawn(function()
        local success, err = pcall(function()
            while stillFishing(token) do
                local ok, reason = fire("equip", 1)
                if not ok then error("Equip: " .. tostring(reason)) end
                task.wait(.12)
                if not stillFishing(token) then break end
                local chargeValue = 2
                local minigameValue = -1.25
                if S.protocol == "KIMS V1.3" then
                    local stampOK, serverStamp = pcall(function()
                        return workspace:GetServerTimeNow()
                    end)
                    chargeValue = stampOK and serverStamp or os.time()
                    minigameValue = 1.2854545116425
                end
                ok, reason = invoke("charge", chargeValue)
                if not ok then error("Charge: " .. tostring(reason)) end
                task.wait(.09)
                if not stillFishing(token) then break end
                ok, reason = invoke("minigame", minigameValue, 1)
                if not ok then error("Minigame: " .. tostring(reason)) end
                S.casts = S.casts + 1
                task.wait(S.fishDelay)
                if not stillFishing(token) then break end
                ok, reason = fire("fishing")
                if not ok then error("Reel: " .. tostring(reason)) end
                S.reels = S.reels + 1
                task.wait(S.catchDelay)
            end
        end)
        if token == S.token then
            S.fishing = false
            if not success then notify("Fishing berhenti: " .. tostring(err))
            else notify("Fishing stopped | reel requests: " .. tostring(S.reels)) end
            if render and S.activeTab == "FISHING" then render() end
        end
    end)
    notify("Auto Fish eksperimental ON; cek hasil tangkapan di game")
    return true
end

-- ====================== DISCORD / FISH EVENTS ==========================
local function executorRequest()
    if type(request) == "function" then return request end
    if type(http_request) == "function" then return http_request end
    if type(syn) == "table" and type(syn.request) == "function" then return syn.request end
    if type(http) == "table" and type(http.request) == "function" then return http.request end
    return nil
end
local function validWebhook(url)
    if type(url) ~= "string" then return false end
    return url:match("^https://discord%.com/api/webhooks/%d+/[%w_%-]+/?$") ~= nil
        or url:match("^https://discordapp%.com/api/webhooks/%d+/[%w_%-]+/?$") ~= nil
end
local function sendDiscord(embed)
    if not validWebhook(S.webhookURL) then return false, "URL webhook belum valid" end
    local req = executorRequest()
    if not req then return false, "HTTP request API tidak tersedia di executor" end
    local payload = {
        username = "KIMS TECH | FISH ALERT",
        allowed_mentions = {parse = {}},
        embeds = {embed}
    }
    local ok, result = pcall(function()
        return req({ Url = S.webhookURL, Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = Http:JSONEncode(payload) })
    end)
    if not ok then return false, tostring(result) end
    if type(result) ~= "table" then return false, "HTTP response tidak tersedia" end
    local status = tonumber(result.StatusCode or result.Status or result.status)
    if status and status >= 200 and status < 300 then
        S.webhookSent = S.webhookSent + 1
        return true, "HTTP " .. status
    end
    return false, "HTTP " .. tostring(status or result.StatusMessage or "unknown")
end
local RARITY_COLORS = {
    Common=9807270, Uncommon=5763719, Rare=3447003,
    Epic=10181046, Legendary=15844367, Mythic=11027200,
    Secret=16711680, Forgotten=16753920, Unknown=8421504
}
local function normalizeRarity(v)
    if v == nil then return "Unknown" end
    local l = tostring(v):lower()
    if l == "mythical" then return "Mythic" end
    for k in pairs(RARITY_COLORS) do if k:lower() == l then return k end end
    return "Unknown"
end
local ItemUtility, PlayerData
local function loadItemUtility()
    if ItemUtility then return ItemUtility end
    local shared = RS:FindFirstChild("Shared")
    local module = shared and shared:FindFirstChild("ItemUtility")
    if module and module:IsA("ModuleScript") then
        local ok, value = pcall(require, module)
        if ok then ItemUtility = value end
    end
    return ItemUtility
end
local function fishInfo(fishId, weightData, itemData)
    local inv = type(itemData) == "table" and itemData.InventoryItem or nil
    local meta = type(inv) == "table" and inv.Metadata or nil
    local id = fishId or (type(inv) == "table" and inv.Id)
    local name, rarity = "Fish ID " .. tostring(id or "?"), "Unknown"
    local util = loadItemUtility()
    if util and id then
        local ok, result = pcall(function() return util:GetItemData(id) end)
        if ok and type(result) == "table" then
            local data = type(result.Data) == "table" and result.Data or result
            name = tostring(data.Name or data.DisplayName or name)
            rarity = normalizeRarity(data.Rarity or data.Tier)
        end
    end
    local weight = (type(weightData) == "table" and weightData.Weight)
        or (type(meta) == "table" and meta.Weight)
    local variant = (type(weightData) == "table" and weightData.VariantId)
        or (type(meta) == "table" and meta.VariantId)
    return name, rarity, weight, variant
end
local function queueDiscord(embed)
    if #S.webhookQueue >= 25 then table.remove(S.webhookQueue, 1) end
    table.insert(S.webhookQueue, embed)
    if S.sending then return end
    S.sending = true
    task.spawn(function()
        while S.alive and S.autoAlerts and #S.webhookQueue > 0 do
            local delayS = math.max(0, 2.3 - (os.clock() - S.lastSentAt))
            if delayS > 0 then task.wait(delayS) end
            if not S.alive or not S.autoAlerts then break end
            local item = table.remove(S.webhookQueue, 1)
            S.lastSentAt = os.clock()
            local ok, why = sendDiscord(item)
            if not ok then notify("Webhook gagal: " .. tostring(why)) end
        end
        S.sending = false
    end)
end
local function onNewFish(id, weightData, itemData)
    if not S.alive or not S.autoAlerts then return end
    S.webhookEvents = S.webhookEvents + 1
    local fish, rarity, weight, variant = fishInfo(id, weightData, itemData)
    S.lastEvent = fish .. " | " .. rarity .. " | VariantId " .. tostring(variant or "-")
    if S.filters[rarity] ~= true then return end
    local key = table.concat({tostring(id),tostring(weight),tostring(variant)},":")
    local now = os.clock()
    if S.recentEvents[key] and now-S.recentEvents[key] < 3.5 then return end
    S.recentEvents[key] = now
    queueDiscord({
        title = "KIMS TECH | Fish Caught", color = RARITY_COLORS[rarity] or 8421504,
        fields = {
            {name="Player", value=tostring(Player.Name), inline=true},
            {name="Fish", value=tostring(fish), inline=true},
            {name="Rarity", value=tostring(rarity), inline=true},
            {name="Weight (raw)", value=tostring(weight or "N/A"), inline=true},
            {name="Variant ID", value=tostring(variant or "N/A"), inline=true},
            {name="Fish ID", value=tostring(id or "N/A"), inline=true}
        },
        footer = {text="KIMS TECH | Custom V3 Experimental"},
        timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ")
    })
end
local function stopAlerts()
    S.autoAlerts = false
    S.webhookQueue = {}
    if S.fishConnection then S.fishConnection:Disconnect() S.fishConnection = nil end
end
local function startAlerts()
    if not validWebhook(S.webhookURL) then notify("Isi Discord webhook URL dulu") return false end
    if not executorRequest() then notify("Executor tidak mendukung request HTTP") return false end
    scanEngine()
    if not remotes.obtained or not remotes.obtained:IsA("RemoteEvent") then
        notify("Fish obtained event belum ditemukan")
        return false
    end
    stopAlerts()
    S.autoAlerts = true
    S.fishConnection = remotes.obtained.OnClientEvent:Connect(onNewFish)
    notify("Fish Alerts ON | filter Secret/Forgotten (bisa diubah)")
    return true
end

-- ====================== READ ONLY INVENTORY ============================
local function inventoryScan()
    local ok, err = pcall(function()
        if not PlayerData then
            local packages = RS:FindFirstChild("Packages")
            local module = packages and packages:FindFirstChild("Replion")
            if not module then error("Replion module missing") end
            local replion = require(module)
            if not replion.Client then error("Replion Client missing") end
            PlayerData = replion.Client:WaitReplion("Data")
        end
        local inventory = PlayerData:GetExpect("Inventory")
        local items = inventory and inventory.Items
        if type(items) ~= "table" then error("Inventory.Items unavailable") end
        local count, byRarity = 0, {}
        for _, item in pairs(items) do
            if type(item) == "table" then
                count = count + 1
                local tier = "Unknown"
                local util = loadItemUtility()
                if util and item.Id then
                    local valid, result = pcall(function()
                        return util:GetItemData(item.Id)
                    end)
                    if valid and type(result) == "table" then
                        local data = type(result.Data) == "table" and result.Data or result
                        tier = normalizeRarity(data.Rarity or data.Tier)
                    end
                end
                byRarity[tier] = (byRarity[tier] or 0) + 1
            end
        end
        S.inventoryDetails = byRarity
        local parts = {}
        for k, v in pairs(byRarity) do table.insert(parts, k .. ": " .. v) end
        table.sort(parts)
        S.inventorySummary = "Items: " .. count .. " | " .. table.concat(parts, " | ")
    end)
    if not ok then
        S.inventorySummary = "Scan gagal: " .. tostring(err)
    end
    notify(S.inventorySummary)
    if S.activeTab == "INVENTORY" and render then render() end
end

