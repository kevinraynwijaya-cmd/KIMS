-- KIMS TECH | INVENTORY AUTO READER V13
-- Roblox Fish It / Delta Android | read-only client GUI recorder.
-- Starts recording immediately. Open all 8 inventory tabs once, then STOP > SALIN.
-- Identifies Fish vs Items by the actual tab pressed, not their shared Inventory2 page.
-- Counter evidence includes its source path; visible tile count is NEVER owned-item count.
-- No require/getgc/remotes/network/upload/auto-scroll or inventory mutation.

local Players = game:GetService('Players')
local HttpService = game:GetService('HttpService')
local UserInputService = game:GetService('UserInputService')
local player = Players.LocalPlayer
if not player then return end
local pg = player:WaitForChild('PlayerGui')

local prev = pg:FindFirstChild('KIMSInventoryV13')
if prev then
    local stop = prev:FindFirstChild('KIMS_Shutdown')
    if stop and stop:IsA('BindableEvent') then pcall(function() stop:Fire() end) end
    pcall(function() prev:Destroy() end)
end

local screen = Instance.new('ScreenGui')
screen.Name='KIMSInventoryV13'
screen.ResetOnSpawn=false
screen.DisplayOrder=990
screen.ZIndexBehavior=Enum.ZIndexBehavior.Sibling
screen.Parent=pg
local signal=Instance.new('BindableEvent')
signal.Name='KIMS_Shutdown'
signal.Parent=screen

