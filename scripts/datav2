-- KIMS Server Luck -> existing debug.php scanner
-- Sends TOP-LEVEL attributes / objects / values so the current
-- debug.php page can render them in the existing card.

local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")

local player = Players.LocalPlayer

local API_URL = "https://kims.asia/statakun/api/debug.php"
local API_KEY = "stat-kims2026"
local INTERVAL = 2

local function safe(fn, fallback)
    local ok, value = pcall(fn)
    if ok then
        return value
    end
    return fallback
end

local function parseMultiplier(value)
    if value == nil then return nil end

    local s = tostring(value):lower()

    local n =
        s:match("[x×]%s*(%d+)")
        or s:match("(%d+)%s*[x×]")
        or s:match("luckmultiplier[^%d]*(%d+)")

    n = tonumber(n)

    if n == 2 or n == 4 or n == 6 or n == 8 then
        return n
    end

    return nil
end

local function parseCountdown(value)
    if value == nil then return nil end

    local s = tostring(value)

    local h, m, sec =
        s:match("(%d+)%s*[hH]%s*(%d+)%s*[mM]%s*(%d+)%s*[sS]")

    if h then
        return tonumber(h) * 3600
            + tonumber(m) * 60
            + tonumber(sec)
    end

    h, m, sec = s:match("(%d+):(%d+):(%d+)")

    if h then
        return tonumber(h) * 3600
            + tonumber(m) * 60
            + tonumber(sec)
    end

    m, sec = s:match("(%d+)%s*[mM]%s*(%d+)%s*[sS]")

    if m then
        return tonumber(m) * 60 + tonumber(sec)
    end

    sec = s:match("(%d+)%s*[sS]")

    if sec then
        return tonumber(sec)
    end

    return nil
end

local function getText(obj)
    return safe(function()
        return obj.Text
    end, "")
end

local function getFullName(obj)
    return safe(function()
        return obj:GetFullName()
    end, "?")
end

local function addObject(list, path, className, text)
    table.insert(list, {
        path = tostring(path),
        className = tostring(className),
        text = tostring(text or "")
    })
end
