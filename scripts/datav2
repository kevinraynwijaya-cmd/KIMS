
local ok, err = pcall(function()
    local Players = game:GetService("Players")
    local player = Players.LocalPlayer
    local parent = player:WaitForChild("PlayerGui")

    local old = parent:FindFirstChild("KIMS_UI_TEST")
    if old then old:Destroy() end

    local gui = Instance.new("ScreenGui")
    gui.Name = "KIMS_UI_TEST"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.DisplayOrder = 99999
    gui.Parent = parent

    local frame = Instance.new("Frame")
    frame.AnchorPoint = Vector2.new(0.5, 0.5)
    frame.Position = UDim2.fromScale(0.5, 0.5)
    frame.Size = UDim2.fromOffset(360, 170)
    frame.BackgroundColor3 = Color3.fromRGB(20, 15, 35)
    frame.Parent = gui

    Instance.new("UICorner", frame).CornerRadius =
        UDim.new(0, 15)

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(155, 75, 255)
    stroke.Thickness = 2
    stroke.Parent = frame

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, 0, 0, 80)
    title.BackgroundTransparency = 1
    title.Text = "KIMS FISH IT\nUI TEST BERHASIL!"
    title.TextColor3 = Color3.fromRGB(60, 230, 255)
    title.TextSize = 22
    title.Font = Enum.Font.GothamBold
    title.Parent = frame

    local button = Instance.new("TextButton")
    button.Position = UDim2.fromOffset(45, 100)
    button.Size = UDim2.fromOffset(270, 45)
    button.Text = "TOMBOL TEST"
    button.TextColor3 = Color3.new(1, 1, 1)
    button.BackgroundColor3 = Color3.fromRGB(145, 65, 250)
    button.Font = Enum.Font.GothamBold
    button.TextSize = 16
    button.Parent = frame

    Instance.new("UICorner", button).CornerRadius =
        UDim.new(0, 9)

    button.Activated:Connect(function()
        title.Text = "KIMS\nTOMBOL BERFUNGSI!"
    end)

    print("[KIMS] UI TEST SUCCESS")
end)

if not ok then
    warn("[KIMS] UI TEST ERROR: " .. tostring(err))
end
