-- KIMS TECH | INVENTORY DATA TRACE V10
-- Single-run read-only audit for Fish It / Roblox client.
-- NO require(), no remote calls, no HTTP, no file writes, no item changes.
-- Does not claim that arbitrary cache tables represent owned inventory.
-- Created for manual execution in Delta Android. Open panel > LACAK > SALIN.

local Players = game:GetService('Players')
local ReplicatedStorage = game:GetService('ReplicatedStorage')
local player = Players.LocalPlayer
if not player then return end
local pg = player:WaitForChild('PlayerGui')
local old = pg:FindFirstChild('KIMSDataTraceV10')
if old then old:Destroy() end

local screen = Instance.new('ScreenGui')
screen.Name = 'KIMSDataTraceV10'
screen.ResetOnSpawn = false
screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screen.Parent = pg

local panel = Instance.new('Frame')
panel.Size = UDim2.new(.94,0,.76,0)
panel.Position = UDim2.new(.03,0,.11,0)
panel.BackgroundColor3 = Color3.fromRGB(12,17,34)
panel.BorderSizePixel = 0
panel.Parent = screen
Instance.new('UICorner',panel).CornerRadius = UDim.new(0,12)
local border = Instance.new('UIStroke',panel)
border.Thickness = 2
border.Color = Color3.fromRGB(108,91,225)

local function label(parent,s,pos,size,color)
    local t = Instance.new('TextLabel')
    t.BackgroundTransparency = 1
    t.Position = pos
    t.Size = size
    t.Text = s
    t.Font = Enum.Font.Code
    t.TextSize = 12
    t.TextColor3 = color or Color3.fromRGB(230,235,250)
    t.TextXAlignment = Enum.TextXAlignment.Left
    t.TextYAlignment = Enum.TextYAlignment.Top
    t.Parent = parent
    return t
end
local heading = label(panel,'KIMS V10 | TARGETED DATA TRACE',UDim2.new(.02,0,.012,0),UDim2.new(.96,0,0,27),Color3.fromRGB(190,180,255))
heading.Font = Enum.Font.GothamBold
heading.TextSize = 15
local function button(txt,x)
    local b = Instance.new('TextButton')
    b.Position = UDim2.new(x,0,0,39)
    b.Size = UDim2.new(.29,0,0,35)
    b.Text = txt
    b.Font = Enum.Font.GothamBold
    b.TextScaled = true
    b.TextColor3 = Color3.new(1,1,1)
    b.BackgroundColor3 = Color3.fromRGB(64,57,119)
    b.Parent = panel
    Instance.new('UICorner',b).CornerRadius = UDim.new(0,6)
    return b
end
local runBtn = button('LACAK',.02)
local copyBtn = button('SALIN',.35)
local closeBtn = button('TUTUP',.68)
local status = label(panel,'Siap. Tekan LACAK sekali.',UDim2.new(.02,0,0,83),UDim2.new(.96,0,0,20),Color3.fromRGB(110,226,165))
local sc = Instance.new('ScrollingFrame')
sc.Position = UDim2.new(.02,0,0,108)
sc.Size = UDim2.new(.96,0,1,-117)
sc.BackgroundColor3 = Color3.fromRGB(20,27,46)
sc.BorderSizePixel = 0
sc.ScrollBarThickness = 7
sc.AutomaticCanvasSize = Enum.AutomaticSize.Y
sc.Parent = panel
local out = label(sc,'',UDim2.new(0,7,0,7),UDim2.new(1,-23,0,0))
out.TextWrapped = true
out.AutomaticSize = Enum.AutomaticSize.Y

local lines = {}
local busy,done,closed = false,false,false
local MAX_GC = 330000
local MAX_CANDIDATES = 40
local MAX_KEYS = 550
local MAX_FUNCTIONS_ENV = 8500
local MAX_CONTROLLER_MATCHES = 16
local MAX_UPVALUES = 22
local CATEGORY_NAMES = {'Fish','Fishing Rods','Baits','Potions','Pets','Pet Eggs','Enchant Stones','Charms','Boats','Gears','Lanterns','Halos','Emotes'}

local function add(s)
    if #lines < 245 then lines[#lines+1] = tostring(s) end
end
local function redraw()
    if not closed then out.Text = table.concat(lines,'\n') end
end
local function short(s,maxlen)
    return tostring(s or ''):gsub('[\r\n]',' '):sub(1,maxlen or 100)
end
local function countTable(t,limit)
    if type(t) ~= 'table' then return 0,false end
    local n=0
    for _ in pairs(t) do
        n=n+1
        if n>=limit then return n,true end
    end
    return n,false
end
local function shape(t)
    if type(t)~='table' then return type(t) end
    local n,numVal,strVal,tblVal,otherVal,numKey,strKey,otherKey=0,0,0,0,0,0,0,0
    local digitKey=0
    for k,v in pairs(t) do
        n=n+1
        if type(k)=='number' then numKey=numKey+1
        elseif type(k)=='string' then
            strKey=strKey+1
            if #k<=22 and k:match('^%d+$') then digitKey=digitKey+1 end
        else otherKey=otherKey+1 end
        if type(v)=='number' then numVal=numVal+1
        elseif type(v)=='string' then strVal=strVal+1
        elseif type(v)=='table' then tblVal=tblVal+1
        else otherVal=otherVal+1 end
        if n>=MAX_KEYS then break end
    end
    local more=(n>=MAX_KEYS) and '+' or ''
    local r='N='..n..more..' K[num/str/digit/other]='..numKey..'/'..strKey..'/'..digitKey..'/'..otherKey
    r=r..' V[num/str/table/other]='..numVal..'/'..strVal..'/'..tblVal..'/'..otherVal
    return r
end
local function categoryCount(root)
    if type(root)~='table' then return 0 end
    local n=0
    for _,cat in ipairs(CATEGORY_NAMES) do
        if type(rawget(root,cat))=='table' then n=n+1 end
    end
    return n
end
local function categoryBrief(root)
    local result={}
    for _,cat in ipairs(CATEGORY_NAMES) do
        local t=rawget(root,cat)
        if type(t)=='table' then
            local n,more=countTable(t,MAX_KEYS)
            result[#result+1]=cat..'='..n..(more and '+' or '')
        end
    end
    return #result>0 and table.concat(result, ' | ') or '(no category tables)'
end
local function targetText(src)
    local s=tostring(src or ''):lower()
    return s:find('inventorycontroller',1,true) or s:find('inventorymapping',1,true)
end
local function moduleSource(fn)
    local names={}
    if type(debug)=='table' and type(debug.info)=='function' then
        local ok,r=pcall(debug.info,fn,'s')
        if ok and type(r)=='string' then names[#names+1]=r end
    end
    if type(debug)=='table' and type(debug.getinfo)=='function' then
        local ok,r=pcall(debug.getinfo,fn)
        if ok and type(r)=='table' then
            if type(r.source)=='string' then names[#names+1]=r.source end
            if type(r.short_src)=='string' then names[#names+1]=r.short_src end
        end
    end
    return table.concat(names,' | ')
end
local function envScript(fn)
    if type(getfenv)~='function' then return '' end
    local ok,env=pcall(getfenv,fn)
    if not ok or type(env)~='table' then return '' end
    local s=rawget(env,'script')
    if typeof(s)=='Instance' then
        local good,p=pcall(function() return s:GetFullName() end)
        if good then return tostring(p) end
    end
    return ''
end
local function getUpvaluesSafe(fn)
    if type(getupvalues)=='function' then
        local ok,vals=pcall(getupvalues,fn)
        if ok and type(vals)=='table' then return vals,'getupvalues' end
    end
    if type(debug)=='table' and type(debug.getupvalues)=='function' then
        local ok,vals=pcall(debug.getupvalues,fn)
        if ok and type(vals)=='table' then return vals,'debug.getupvalues' end
    end
    return nil,'not available'
end
local function describeUpvalues(fn,index,src)
    add('FUNCTION '..index..': '..short(src,105))
    local ups,how=getUpvaluesSafe(fn)
    if type(ups)~='table' then add('  upvalues='..how); return end
    local seen=0
    local tables=0
    local useful=0
    for k,v in pairs(ups) do
        seen=seen+1
        if seen>MAX_UPVALUES then break end
        if type(v)=='table' then
            tables=tables+1
            local c=categoryCount(v)
            local nested={}
            local checked=0
            if c==0 then
                for nk,nv in pairs(v) do
                    checked=checked+1
                    if checked>36 then break end
                    if type(nv)=='table' and categoryCount(nv)>0 then
                        nested[#nested+1]='category-map-'..tostring(#nested+1)
                    end
                    if #nested>=3 then break end
                end
            end
            if c>0 or #nested>0 then
                useful=useful+1
                add('  upvalue['..short(k,25)..'] categories='..c..' nested={'..table.concat(nested,',')..'}')
                if c>0 then add('    '..categoryBrief(v)) end
            end
        end
    end
    add('  upvalues checked='..math.min(seen,MAX_UPVALUES)..' | tables='..tables..' | category matches='..useful)
end
local function modules()
    local folders=ReplicatedStorage:FindFirstChild('Controllers')
    local inv=folders and folders:FindFirstChild('InventoryController')
    local shared=ReplicatedStorage:FindFirstChild('Shared')
    local mapping=shared and shared:FindFirstChild('InventoryMapping')
    add('InventoryController present='..tostring(inv~=nil)..' ['..(inv and inv.ClassName or '?')..']')
    add('InventoryMapping present='..tostring(mapping~=nil)..' ['..(mapping and mapping.ClassName or '?')..']')
    if type(getloadedmodules)=='function' then
        local ok,m=pcall(getloadedmodules)
        if ok and type(m)=='table' then
            local hits=0
            for _,mod in ipairs(m) do
                if typeof(mod)=='Instance' then
                    local s=mod:GetFullName()
                    if targetText(s) then
                        hits=hits+1
                        if hits<=10 then add('LOADED '..short(s,100)) end
                    end
                end
            end
            add('Loaded modules='..#m..' | target='..hits)
        else add('getloadedmodules() unavailable at runtime') end
    end
end

add('KIMS V10 | READ ONLY | NO UPLOAD')
add('USER @'..player.Name..' | ID='..tostring(player.UserId))
add('Goal: trace controller closures AND rank ALL category maps.')
add('No require, remotes, HTTP, clipboard until SALIN.')
add('Do not interpret keys/counts as owned inventory.')
redraw()

local function audit()
    add('')
    add('=== VERIFIED MODULE PATHS ===')
    modules()
    if type(getgc)~='function' then
        add('STOP: getgc unsupported in executor.')
        return
    end
    add('')
    add('=== ONE MEMORY SNAPSHOT ===')
    redraw()
    task.wait()
    local ok,objects=pcall(getgc,true)
    if not ok or type(objects)~='table' then add('ERROR: getgc(true) failed'); return end
    local total=#objects
    local limit=math.min(total,MAX_GC)
    add('GC objects='..total..' | inspection limit='..limit)
    local candidates={}
    local matchedFunctions={}
    local functionCount=0
    local envChecks=0
    local catHits=0
    for i=1,limit do
        if closed then return end
        local obj=objects[i]
        local typ=type(obj)
        if typ=='table' then
            local fish=rawget(obj,'Fish')
            local potions=rawget(obj,'Potions')
            if type(fish)=='table' and type(potions)=='table' then
                catHits=catHits+1
                if #candidates < MAX_CANDIDATES then
                    candidates[#candidates+1]={index=i,root=obj,score=categoryCount(obj)}
                end
            end
        elseif typ=='function' then
            functionCount=functionCount+1
            -- Lua closures may include ModuleScript paths in debug source or environment.
            -- These are METADATA reads; the function is never called.
            local src=moduleSource(obj)
            local match=targetText(src)
            if not match and envChecks<MAX_FUNCTIONS_ENV then
                envChecks=envChecks+1
                local env=envScript(obj)
                if targetText(env) then
                    match=true
                    src=env
                end
            end
            if match and #matchedFunctions<MAX_CONTROLLER_MATCHES then
                matchedFunctions[#matchedFunctions+1]={fn=obj,index=i,source=src}
            end
        end
        if i%850==0 then
            status.Text='LACAK '..i..'/'..limit
            task.wait()
        end
    end
    add('')
    add('=== ALL CATEGORY CANDIDATES ===')
    add('Candidates='..catHits..' | showing='..#candidates..' (not only first two)')
    for i,entry in ipairs(candidates) do
        add('C'..i..' GC#'..entry.index..' category tables='..entry.score..' | '..categoryBrief(entry.root))
        if type(rawget(entry.root,'Fish'))=='table' then
            add('  Fish '..shape(rawget(entry.root,'Fish')))
        end
        if i%5==0 then task.wait() end
    end
    if catHits>MAX_CANDIDATES then add('WARNING: extra candidates omitted from report') end
    add('')
    add('=== INVENTORY CONTROLLER CLOSURES ===')
    add('GC functions='..functionCount..' | env checks='..envChecks..' | target closures='..#matchedFunctions)
    for _,record in ipairs(matchedFunctions) do
        describeUpvalues(record.fn,record.index,record.source)
        task.wait()
    end
    if #matchedFunctions==0 then
        add('No controller closures mapped. Executor may not expose script origins.')
        add('This does NOT mean the game has no inventory cache.')
    end
    if total>limit then add('WARNING: GC inspection was capped') end
    add('')
    add('=== INTERPRETATION ===')
    add('Candidate maps are not verified owned items. SUM is intentionally omitted.')
    add('Next step depends on controller upvalue links, NOT arbitrary GC index.')
    add('Never send credentials or API keys in report.')
    objects=nil
    candidates=nil
    matchedFunctions=nil
end

runBtn.MouseButton1Click:Connect(function()
    if busy or done then return end
    busy=true
    done=true
    status.Text='Sedang memeriksa satu snapshot...'
    task.spawn(function()
        local ok,err=pcall(audit)
        if not ok then add('ERROR: '..short(err,180)) end
        if not closed then
            redraw()
            status.Text=ok and 'Selesai. Tekan SALIN.' or 'Audit error. Tekan SALIN.'
            busy=false
        end
    end)
end)
copyBtn.MouseButton1Click:Connect(function()
    local fn=(type(setclipboard)=='function' and setclipboard) or (type(toclipboard)=='function' and toclipboard)
    if not fn then status.Text='Clipboard tidak tersedia'; return end
    local ok=pcall(fn,table.concat(lines,'\n'))
    status.Text=ok and 'TERSALIN. Kirim hasilnya ke chat.' or 'Gagal menyalin'
end)
closeBtn.MouseButton1Click:Connect(function()
    closed=true
    screen:Destroy()
end)
