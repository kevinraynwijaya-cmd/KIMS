if not LP then
    warn("[KIMS] LocalPlayer unavailable")
    return
end

local PG = LP:WaitForChild("PlayerGui")
local ENV = (getgenv and getgenv()) or _G

-- Stop previous versions
pcall(function()
    if ENV.KIMS_V13_STOP then ENV.KIMS_V13_STOP() end
    if ENV.KIMS_STOP then ENV.KIMS_STOP() end
    if ENV.KIMS_FISH_TEST and ENV.KIMS_FISH_TEST.stop then
        ENV.KIMS_FISH_TEST.stop()
    end
end)

for _, name in ipairs({
    "KIMS_UI_TEST",
    "KIMS_FISH_IT",
    "KIMS_FISH_IT_V11",
    "KIMS_FISH_IT_V12",
    "KIMS_FISH_IT_V13"
}) do
    local old = PG:FindFirstChild(name)
    if old then old:Destroy() end
end

local alive = true
local fishing = false
local fishToken = 0
local remoteCount = 0
local events = {}
local connections = {}
