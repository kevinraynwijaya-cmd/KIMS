out.Position=UDim2.new(0,7,0,6)
out.Size=UDim2.new(1,-19,0,0)
out.AutomaticSize=Enum.AutomaticSize.Y
out.BackgroundTransparency=1
out.TextWrapped=true
out.TextXAlignment=Enum.TextXAlignment.Left
out.TextYAlignment=Enum.TextYAlignment.Top
out.TextColor3=Color3.fromRGB(225,234,250)
out.Font=Enum.Font.Code
out.TextSize=12

local cancelled=false
local busy=true
local lines={}
local function say(s)
 if #lines<260 then lines[#lines+1]=tostring(s) end
end
local function refresh()
 if screen.Parent then out.Text=table.concat(lines,'\n') end
end
local function clean(s,max)
 return tostring(s or ''):gsub('[\r\n\t]',' '):sub(1,max or 115)
end
local function safePath(obj)
 local ok,res=pcall(function() return obj:GetFullName() end)
 return ok and clean(res,145) or '(path unavailable)'
end
local function low(k)
 return type(k)=='string' and string.lower(k) or ''
end

-- Module ranking is STRICT. No arbitrary 'data' substring hits or unrelated GUI modules.
local exactRanks={
 ['ReplicatedStorage.Controllers.InventoryController']=97,
 ['ReplicatedStorage.Controllers.InventoryController.InventoryPagination']=80,
 ['ReplicatedStorage.Shared.InventoryMapping']=65,
 ['ReplicatedStorage.Controllers.InteractionController.Internal.InventoryUtility']=70,
 ['ReplicatedFirst.GAME.Runner.WaitForPlayerData']=100
}
local function moduleRank(p)
 if exactRanks[p] then return exactRanks[p] end
 local s=string.lower(p)
 if s:find('tilerender',1,true) or s:find('particles',1,true) or s:find('.items.',1,true) then return 0 end
 if s:find('playerdata',1,true) or s:find('clientdata',1,true) then return 94 end
 if s:find('datacontroller',1,true) or s:find('profilecontroller',1,true) then return 91 end
 if s:find('replicacontroller',1,true) or s:find('replica.',1,true) or s:find('replion',1,true) then return 89 end
 if s:find('profilemanager',1,true) or s:find('datamanager',1,true) then return 86 end
 if s:find('replicationcontroller',1,true) or s:find('statesync',1,true) then return 84 end
 if s:find('inventorystate',1,true) or s:find('inventorydata',1,true) then return 83 end
 if s:find('playerstate',1,true) or s:find('userstate',1,true) then return 82 end
 if s:find('inventorycontroller.inventoryfilter',1,true) then return 45 end
 return 0
end

local functionsOfInterest={
 get=true,getdata=true,getplayerdata=true,waitforplayerdata=true,
 getinventory=true,getitems=true,getstate=true,getprofile=true,
 getreplica=true,getreplion=true,observe=true,subscribe=true,
 getitem=true,getplayerprofile=true,getsave=true,getcacheddata=true,
 getitemdata=true,ondatachanged=true,inventorychanged=true
}
local collectionKeys={
 fish=true,fishes=true,inventory=true,inventories=true,items=true,
 rods=true,['fishing rods']=true,pets=true,baits=true,gears=true,
 potions=true,['enchant stones']=true,emotes=true,halos=true,
 lanterns=true,charms=true,boats=true
}
local stateKeys={
 data=true,playerdata=true,playerstate=true,profile=true,replica=true,
 replion=true,state=true,inventorydata=true,inventory=true,
 profiledata=true,savedata=true,save=true,owneditems=true,
 itemdata=true,items=true,collection=true,inventoryitems=true
}
local function showKey(k)
 local l=low(k)
 if stateKeys[l] or collectionKeys[l] or functionsOfInterest[l] then return clean(k,34) end
 return '[entry]'
end

local MAX_MODULES=20
local MAX_NODES=2300
local MAX_FUNCTION_UPVALUES=340
local MAX_TABLE_KEYS=16000
local MAX_RESULTS=22
local MAX_DEPTH=5
local CPU_SECONDS=19
local MAX_QUEUE=9500
local visited=setmetatable({},{__mode='k'})
local queue={}
local qi=1
local examined=0
local functionCount=0
local tableKeysChecked=0
local candidates={}
local getterNames={}
local seenHints={}
local baselineCount=0
local function enqueue(v,source,p,depth)
 local t=type(v)
 if (t=='table' or t=='function') and #queue<MAX_QUEUE and not visited[v] then
  queue[#queue+1]={v=v,source=source,path=p,depth=depth}
 end
end
local function upvaluesOf(fn)
 if type(getupvalues)=='function' then
  local ok,r=pcall(getupvalues,fn)
  if ok and type(r)=='table' then return r end
 end
 if type(debug)=='table' and type(debug.getupvalues)=='function' then
  local ok,r=pcall(debug.getupvalues,fn)
  if ok and type(r)=='table' then return r end
 end
 return nil
end
local function summarizeCollection(tbl)
 local n,tableValues,numberValues,stringValues,others=0,0,0,0,0
 for _,v in pairs(tbl) do
  n=n+1
  local t=type(v)
  if t=='table' then tableValues=tableValues+1
  elseif t=='number' then numberValues=numberValues+1
  elseif t=='string' then stringValues=stringValues+1
  else others=others+1 end
  if n>=6500 then break end
 end
 return n,tableValues,numberValues,stringValues,others,(n>=6500)
end
local function traverse(deadline)
 while qi<=#queue and examined<MAX_NODES and tableKeysChecked<MAX_TABLE_KEYS
       and not cancelled and os.clock()<deadline do
  local node=queue[qi]; qi=qi+1
  local v=node.v
  if not visited[v] then
   visited[v]=true
   examined=examined+1
   if type(v)=='function' then
    functionCount=functionCount+1
    if functionCount<=MAX_FUNCTION_UPVALUES and node.depth<MAX_DEPTH then
     local ups=upvaluesOf(v)
     if ups then
      local ct=0
      for k,uv in pairs(ups) do
       ct=ct+1
       if ct>16 then break end
       if type(uv)=='table' or type(uv)=='function' then
        local nm=low(k)
        local hint=(stateKeys[nm] and '/'..showKey(k)) or '/[upvalue]'
        enqueue(uv,node.source,node.path..hint,node.depth+1)
       end
      end
     end
    end
   else
    local cat={}
    local states={}
    local child=0
    for k,cv in pairs(v) do
     tableKeysChecked=tableKeysChecked+1
     child=child+1
     local lk=low(k)
     if collectionKeys[lk] and type(cv)=='table' then
      local n,t,nn,s,o,capped=summarizeCollection(cv)
      cat[#cat+1]={name=clean(k,32),n=n,t=t,num=nn,str=s,other=o,capped=capped}
     end
     if stateKeys[lk] then
      states[#states+1]=clean(k,32)..':'..type(cv)
     end
     if type(cv)=='function' and (functionsOfInterest[lk] or lk:find('inventory',1,true) or lk:find('playerdata',1,true)) then
      local hint=node.source..' '..clean(k,55)
      if not seenHints[hint] and #getterNames<28 then
       getterNames[#getterNames+1]=hint
       seenHints[hint]=true
      end
     end
     if child<=42 and node.depth<MAX_DEPTH then
      enqueue(cv,node.source,node.path..'/'..showKey(k),node.depth+1)
     end
     if child>=95 or tableKeysChecked>=MAX_TABLE_KEYS then break end
    end
    if (#cat>0 or #states>=2) and #candidates<MAX_RESULTS then
     local score=#cat*4+#states*2
     if node.source:lower():find('playerdata',1,true) then score=score+3 end
     if node.source:lower():find('waitforplayerdata',1,true) then score=score+3 end
     candidates[#candidates+1]={score=score,source=node.source,path=node.path,cat=cat,states=states}
    end
   end
  end
  if examined%55==0 then task.wait() end
 end
end

local function run()
 say('KIMS V16 | PLAYERDATA SOURCE TRACE | READ ONLY')
 say('PlaceId='..tostring(game.PlaceId))
 say('GOAL: locate client PlayerData / state / inventory source paths.')
 say('No Zetsu loader, no HTTP, no getgc, no remotes, no game getter calls.')
 say('Only metadata + counts; no item names, user data or credentials.')
 say('')
 say('=== LOADED PLAYERDATA / INVENTORY MODULES ===')
 if type(getloadedmodules)~='function' then
  say('getloadedmodules unavailable. Unable to inspect cached module exports.')
  return
 end
 local ok,mods=pcall(getloadedmodules)
 if not ok or type(mods)~='table' then
  say('getloadedmodules failed. No data source claimed.')
  return
 end
 baselineCount=#mods
 local matches={}
 for i,mod in ipairs(mods) do
  if typeof(mod)=='Instance' and mod:IsA('ModuleScript') then
   local p=safePath(mod)
   local score=moduleRank(p)
   if score>0 then matches[#matches+1]={obj=mod,path=p,score=score} end
  end
  if i%350==0 then task.wait() end
 end
 table.sort(matches,function(a,b)
  if a.score~=b.score then return a.score>b.score end
  return a.path<b.path
 end)
 say('Loaded='..baselineCount..' | targeted paths='..#matches)
 for i=1,math.min(#matches,32) do
  say('TARGET '..i..' score='..matches[i].score..' '..matches[i].path)
 end
 if #matches>32 then say('...more targeted paths omitted from text.') end
 refresh()
 local total=math.min(#matches,MAX_MODULES)
 local attempted,readable=0,0
 local deadline=os.clock()+CPU_SECONDS
 say('')
 say('=== CACHED EXPORT + UPVALUE MAP ===')
 for i=1,total do
  if cancelled or os.clock()>deadline then break end
  local target=matches[i]
  status.Text='Memeriksa modul '..i..'/'..total
  attempted=attempted+1
  -- Because this module is already in getloadedmodules(), require normally returns
  -- a cached export. Not guaranteed on every modified executor / game runtime.
  local okReq,export=pcall(require,target.obj)
  if not okReq then
   say('MODULE '..clean(target.path,90)..' => inaccessible')
  else
   readable=readable+1
   say('MODULE '..clean(target.path,95)..' => '..type(export))
   enqueue(export,target.path,'[export]',0)
  end
  if i%3==0 then refresh() end
  task.wait()
 end
 traverse(deadline)
 say('Modules read='..readable..'/'..attempted)
 say('Graph nodes='..examined..' | functions='..functionCount..' | fields checked='..tableKeysChecked)
 if qi<=#queue then say('LIMIT: remaining nodes unexamined (bounded).') end
 say('')
 say('=== POTENTIAL GETTERS (NAMES ONLY - NOT CALLED) ===')
 if #getterNames==0 then say('No named getters identified in inspected exports.') end
 table.sort(getterNames)
 for i=1,math.min(#getterNames,25) do say('GETTER '..getterNames[i]) end
 say('')
 say('=== CLIENT STATE / CATEGORY SHAPES ===')
 table.sort(candidates,function(a,b) return a.score>b.score end)
 if #candidates==0 then say('No candidate state table shape identified in bounded inspection.') end
 for i=1,math.min(#candidates,18) do
  local c=candidates[i]
  say('C'..i..' score='..c.score..' module='..clean(c.source,110))
  say('  path='..clean(c.path,130))
  if #c.states>0 then say('  keys='..table.concat(c.states,', ',1,math.min(#c.states,10))) end
  for j=1,math.min(#c.cat,9) do
   local d=c.cat[j]
   say('  '..d.name..': entries='..d.n..(d.capped and '+' or '')..' values[T/N/S/O]='..d.t..'/'..d.num..'/'..d.str..'/'..d.other)
  end
 end
 say('')
 say('=== AUDIT ===')
 say('Ownership NOT VERIFIED. Category counts are not inventory quantities.')
 say('A data-shaped table might be configuration, catalog, or GUI state.')
 say('V14 GUI counters remain the only verified totals; not read here.')
 say('Next analysis: link named getter/state path to owned-item record shape.')
 say('Never send Zetsu API keys, headers or raw request payloads.')
end

local function copyReport()
 if busy then status.Text='Tunggu proses selesai';return end
 local fn=(type(setclipboard)=='function' and setclipboard) or
          (type(toclipboard)=='function' and toclipboard)
 if not fn then status.Text='Clipboard tidak didukung';return end
 local ok=pcall(fn,table.concat(lines,'\n'))
 status.Text=ok and 'Laporan tersalin - kirim ke chat' or 'Gagal menyalin'
end
copyBtn.MouseButton1Click:Connect(copyReport)
local minimized=false
miniBtn.MouseButton1Click:Connect(function()
 minimized=not minimized
 if minimized then
  sc.Visible=false
  panel.Size=UDim2.new(.94,0,0,112)
  miniBtn.Text='BUKA'
 else
  panel.Size=UDim2.new(.94,0,.68,0)
  sc.Visible=true
  miniBtn.Text='MINI'
 end
end)
closeBtn.MouseButton1Click:Connect(function()
 cancelled=true
 screen:Destroy()
end)
-- Touch/mouse dragging.
do
 local dragging=false
 local startPos=nil
 local original=nil
 title.InputBegan:Connect(function(input)
  if input.UserInputType==Enum.UserInputType.Touch or input.UserInputType==Enum.UserInputType.MouseButton1 then
   dragging=true;startPos=input.Position;original=panel.Position
  end
 end)
 title.InputEnded:Connect(function(input)
  if input.UserInputType==Enum.UserInputType.Touch or input.UserInputType==Enum.UserInputType.MouseButton1 then dragging=false end
 end)
 UserInputService.InputChanged:Connect(function(input)
  if cancelled or not dragging or not startPos then return end
  if input.UserInputType==Enum.UserInputType.Touch or input.UserInputType==Enum.UserInputType.MouseMovement then
   local delta=input.Position-startPos
   panel.Position=UDim2.new(original.X.Scale,original.X.Offset+delta.X,original.Y.Scale,original.Y.Offset+delta.Y)
  end
 end)
end
refresh()
task.spawn(function()
 local success,err=pcall(run)
 busy=false
 if not cancelled then
  if not success then say('ERROR: '..clean(err,140)) end
  refresh()
  status.Text=success and 'SELESAI - tekan SALIN' or 'ERROR - tekan SALIN'
 end
end)
