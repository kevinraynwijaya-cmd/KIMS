    Name = "Scan Fish It Engine",
    Callback = function()
        local count = scanEngine()
        local ready, missing = engineReady()
        local event = remotes.obtained and remotes.obtained:IsA("RemoteEvent")
        notify("Remotes " .. count .. "/5 | Fishing: " ..
            (ready and "READY (untested)" or ("MISSING " .. missing)) ..
            " | Fish event: " .. (event and "FOUND" or "MISSING"), 9)
    end
})
