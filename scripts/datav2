-- KIMS TECH | INVENTORY SUMMARY V14
-- Purpose: read VERIFIED GUI counter paths found by V13. NOT a full inventory export.
-- Delta Android / Fish It. Read-only: no remote, no require, no getgc, no uploads.
-- Values come from current client UI; missing is never treated as zero.

local Players = game:GetService('Players')
local HttpService = game:GetService('HttpService')
local player = Players.LocalPlayer
if not player then return end
local pg = player:WaitForChild('PlayerGui')
local old = pg:FindFirstChild('KIMSInventorySummaryV14')
if old then old:Destroy() end

local screen = Instance.new('ScreenGui')
screen.Name='KIMSInventorySummaryV14'
screen.ResetOnSpawn=false
screen.DisplayOrder=999
screen.ZIndexBehavior=Enum.ZIndexBehavior.Sibling
screen.Parent=pg
local panel=Instance.new('Frame',screen)
panel.Size=UDim2.new(.90,0,0,315)
panel.Position=UDim2.new(.05,0,.11,0)
panel.BackgroundColor3=Color3.fromRGB(14,20,38)
panel.BorderSizePixel=0
Instance.new('UICorner',panel).CornerRadius=UDim.new(0,12)
local stroke=Instance.new('UIStroke',panel)
stroke.Color=Color3.fromRGB(113,93,235)
stroke.Thickness=2
local title=Instance.new('TextLabel',panel)
title.Size=UDim2.new(1,-20,0,28)
title.Position=UDim2.new(0,10,0,8)
title.BackgroundTransparency=1
title.Font=Enum.Font.GothamBold
title.TextSize=15
title.TextXAlignment=Enum.TextXAlignment.Left
title.TextColor3=Color3.fromRGB(193,187,255)
title.Text='KIMS INVENTORY SUMMARY V14'
local function mkbutton(caption,x,w)
 local b=Instance.new('TextButton',panel)
 b.Position=UDim2.new(x,0,0,42)
 b.Size=UDim2.new(w,0,0,34)
 b.Text=caption
 b.Font=Enum.Font.GothamBold
 b.TextScaled=true
 b.TextColor3=Color3.new(1,1,1)
 b.BackgroundColor3=Color3.fromRGB(72,61,131)
 Instance.new('UICorner',b).CornerRadius=UDim.new(0,6)
 return b
end
local readBtn=mkbutton('BACA',.025,.20)
local liveBtn=mkbutton('LIVE OFF',.24,.23)
local copyBtn=mkbutton('SALIN',.485,.22)
local jsonBtn=mkbutton('JSON',.72,.12)
local closeBtn=mkbutton('X',.855,.11)
local sc=Instance.new('ScrollingFrame',panel)
sc.Position=UDim2.new(.025,0,0,86)
sc.Size=UDim2.new(.95,0,1,-96)
sc.BackgroundColor3=Color3.fromRGB(22,30,52)
sc.BorderSizePixel=0
sc.ScrollBarThickness=5
sc.AutomaticCanvasSize=Enum.AutomaticSize.Y
Instance.new('UICorner',sc).CornerRadius=UDim.new(0,6)
local textLabel=Instance.new('TextLabel',sc)
textLabel.Position=UDim2.new(0,8,0,6)
textLabel.Size=UDim2.new(1,-18,0,0)
textLabel.AutomaticSize=Enum.AutomaticSize.Y
textLabel.BackgroundTransparency=1
textLabel.TextWrapped=true
textLabel.TextXAlignment=Enum.TextXAlignment.Left
textLabel.TextYAlignment=Enum.TextYAlignment.Top
textLabel.Font=Enum.Font.Code
textLabel.TextSize=13
textLabel.TextColor3=Color3.fromRGB(226,235,250)

local counterPaths={
 Fish={'Main','Top','Options','Fish','Label','BagSize'},
 Rods={'Main','Top','Options','Rods','Label','ItemSize'},
 Items={'Main','Top','Options','Inventory','Label','ItemSize'},
}
local categories={'Fish','Rods','Baits','Items','Charms','Emotes','Abilities','Pets'}
local result={}
local reads=0
local running=true
local live=false
local lastReport=''
local lastJson=''
local function exactPath(root,parts)
 local current=root
 for _,name in ipairs(parts) do
  if not current then return nil end
  current=current:FindFirstChild(name)
 end
 return current
end
local function numberText(s)
 local t=tostring(s or ''):gsub('[,.%s]','')
 return tonumber(t)
end
local function pair(s)
 s=tostring(s or '')
 local first,second=s:match('(%d[%d,.]*)%s*/%s*(%d[%d,.]*)')
 if not first then return nil,nil end
 local a,b=numberText(first),numberText(second)
 if not a or not b or b<=0 then return nil,nil end
 return a,b
end
local function labelAt(root,parts)
 local n=exactPath(root,parts)
 if n and (n:IsA('TextLabel') or n:IsA('TextButton') or n:IsA('TextBox')) then
  return tostring(n.Text or ''),n
 end
 return nil,nil
end
local function stat(name)
 local folder=player:FindFirstChild('leaderstats')
 local obj=folder and folder:FindFirstChild(name)
 if obj and obj:IsA('ValueBase') then return tostring(obj.Value) end
 return '?'
end
local function read()
 reads=reads+1
 local inv=pg:FindFirstChild('Inventory')
 local lines={'KIMS INVENTORY SUMMARY V14 | GUI ONLY',
  'USER @'..player.Name..' | UserId='..tostring(player.UserId),
  'SCAN '..reads..' | GUI '..((inv and inv.Enabled) and 'OPEN' or 'CLOSED/NOT LOADED'),
  'Counter dibaca dari path pasti V13, bukan jumlah Tile.',
  ''}
 local output={version='14',kind='gui_inventory_summary',userId=player.UserId,username=player.Name,placeId=game.PlaceId,scannedAt=os.time(),scan=reads,categories={}}
 for _,cat in ipairs(categories) do
  local path=counterPaths[cat]
  if path and inv then
   local raw,node=labelAt(inv,path)
   local qty,capacity=pair(raw)
   if qty then
    local currentStatus=inv.Enabled and 'gui_counter_visible' or 'gui_counter_cached'
    local rec={status=currentStatus,quantity=qty,capacity=capacity,text=raw,source='PlayerGui/Inventory/'..table.concat(path,'/')}
    output.categories[cat]=rec
    lines[#lines+1]=cat..': '..tostring(qty)..' / '..tostring(capacity)..(inv.Enabled and ' [GUI aktif]' or ' [CACHE GUI, bisa tertunda]')
    lines[#lines+1]='  '..rec.source
   else
    output.categories[cat]={status='not_available',source='PlayerGui/Inventory/'..table.concat(path,'/')}
    lines[#lines+1]=cat..': belum terbaca (BUKAN 0)'
   end
  else
   output.categories[cat]={status='not_available'}
   lines[#lines+1]=cat..': belum ada counter terverifikasi (BUKAN 0)'
  end
 end
 lines[#lines+1]=''
 lines[#lines+1]='--- ANGKA LAIN (BUKAN TOTAL INVENTORY) ---'
 if inv then
  local extras={
   {'Equipped Items',{'Main','Content','Pages','Inventory2','EquipLabel'}},
   {'Equipped Pets',{'Main','Content','Pages','Pets','EquipLabel'}},
   {'Charm Remaining',{'Main','Content','Pages','Charms','Main','Info','Display','Inner','Remaining'}}
  }
  output.extra={}
  for _,entry in ipairs(extras) do
   local value=labelAt(inv,entry[2])
   if value and value~='' then
    lines[#lines+1]=entry[1]..': '..value
    output.extra[entry[1]]=value
   end
  end
 end
 lines[#lines+1]='Caught LIFETIME: '..stat('Caught')
 lines[#lines+1]='Rarest Fish: '..stat('Rarest Fish')
 lines[#lines+1]=''
 lines[#lines+1]='Saat inventory ditutup, nilai GUI bisa tertunda.'
 lines[#lines+1]='Counter adalah snapshot GUI pada saat BACA.'
 lines[#lines+1]='Tidak mengekspor daftar item/ID individual.'
 lines[#lines+1]='READ ONLY: no upload, getgc, require, remotes.'
 lastReport=table.concat(lines,'\n')
 local ok,json=pcall(function() return HttpService:JSONEncode(output) end)
 lastJson=ok and json or '{}'
 textLabel.Text=lastReport
end
local function clipboard(value,btn,orig)
 local fn=(type(setclipboard)=='function' and setclipboard) or (type(toclipboard)=='function' and toclipboard)
 if not fn then btn.Text='NO COPY';return end
 local ok=pcall(function() fn(value) end)
 btn.Text=ok and 'TERSALIN' or 'GAGAL'
 task.delay(2,function() if btn.Parent then btn.Text=orig end end)
end
readBtn.MouseButton1Click:Connect(read)
liveBtn.MouseButton1Click:Connect(function()
 live=not live
 liveBtn.Text=live and 'LIVE ON' or 'LIVE OFF'
 if live then read() end
end)
copyBtn.MouseButton1Click:Connect(function() read();clipboard(lastReport,copyBtn,'SALIN') end)
jsonBtn.MouseButton1Click:Connect(function() read();clipboard(lastJson,jsonBtn,'JSON') end)
closeBtn.MouseButton1Click:Connect(function()
 running=false
 screen:Destroy()
end)
-- Simple optional drag by title (mouse/touch).
do
 local UIS=game:GetService('UserInputService')
 local dragging=false
 local startPos,initial
 title.Active=true
 title.InputBegan:Connect(function(input)
  if input.UserInputType==Enum.UserInputType.Touch or input.UserInputType==Enum.UserInputType.MouseButton1 then
   dragging=true;startPos=input.Position;initial=panel.Position
  end
 end)
 title.InputEnded:Connect(function(input)
  if input.UserInputType==Enum.UserInputType.Touch or input.UserInputType==Enum.UserInputType.MouseButton1 then dragging=false end
 end)
 UIS.InputChanged:Connect(function(input)
  if not running or not dragging or not startPos then return end
  if input.UserInputType~=Enum.UserInputType.Touch and input.UserInputType~=Enum.UserInputType.MouseMovement then return end
  local delta=input.Position-startPos
  panel.Position=UDim2.new(initial.X.Scale,initial.X.Offset+delta.X,initial.Y.Scale,initial.Y.Offset+delta.Y)
 end)
end
read()
task.spawn(function()
 while running and screen.Parent do
  task.wait(5)
  if running and live and screen.Parent then pcall(read) end
 end
end)
