-- ====================================================================
--         AUTO FISH V4.1 - CLEAN UI + EXTENDED ENGINES
--         GitHub Ready Version
-- ====================================================================

local success, errorMsg = pcall(function()
    local s = { game = game, workspace = workspace, Players = game:GetService("Players"),
        ReplicatedStorage = game:GetService("ReplicatedStorage"),
        HttpService = game:GetService("HttpService") }
    for n, v in pairs(s) do if not v then error("Service missing: " .. n) end end
    if not game:GetService("Players").LocalPlayer then error("LocalPlayer not available") end
    return true
end)
if not success then error("❌ Dependency check failed: " .. tostring(errorMsg)) return end

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local VirtualUser = game:GetService("VirtualUser")
local TeleportService = game:GetService("TeleportService")
local LocalPlayer = Players.LocalPlayer

-- ====================================================================
--                    CONFIG
-- ====================================================================
local CONFIG_FOLDER = "OptimizedAutoFish"
local CONFIG_FILE = CONFIG_FOLDER .. "/config_" .. LocalPlayer.UserId .. ".json"

local DefaultConfig = {
    AutoFish = false, AutoSell = false, AutoCatch = false,
    GPUSaver = false, BlatantMode = false, FishDelay = 0.9,
    CatchDelay = 0.2, SellDelay = 30, TeleportLocation = "Sisyphus Statue",
    AutoFavorite = true, FavoriteRarity = "Mythic",
    Fullbright = false, WalkSpeed = 16, JumpPower = 50
}
local Config = {}
for k, v in pairs(DefaultConfig) do Config[k] = v end

local LOCATIONS = {
    ["Spawn"] = CFrame.new(45.2788086, 252.562927, 2987.10913),
    ["Sisyphus Statue"] = CFrame.new(-3728.21606, -135.074417, -1012.12744),
    ["Coral Reefs"] = CFrame.new(-3114.78198, 1.32066584, 2237.52295),
    ["Esoteric Depths"] = CFrame.new(3248.37109, -1301.53027, 1403.82727),
    ["Crater Island"] = CFrame.new(1016.49072, 20.0919304, 5069.27295),
    ["Lost Isle"] = CFrame.new(-3618.15698, 240.836655, -1317.45801),
    ["Weather Machine"] = CFrame.new(-1488.51196, 83.1732635, 1876.30298),
    ["Tropical Grove"] = CFrame.new(-2095.34106, 197.199997, 3718.08008),
    ["Mount Hallow"] = CFrame.new(2136.62305, 78.9163895, 3272.50439),
    ["Treasure Room"] = CFrame.new(-3606.34985, -266.57373, -1580.97339),
    ["Kohana"] = CFrame.new(-663.904236, 3.04580712, 718.796875),
    ["Underground Cellar"] = CFrame.new(2109.52148, -94.1875076, -708.609131),
    ["Ancient Jungle"] = CFrame.new(1831.71362, 6.62499952, -299.279175),
    ["Sacred Temple"] = CFrame.new(1466.92151, -21.8750591, -622.835693)
}
local locationNames = {}
for name, _ in pairs(LOCATIONS) do table.insert(locationNames, name) end
table.sort(locationNames)

-- ====================================================================
--                    CONFIG SAVE/LOAD
-- ====================================================================
local function ensureFolder()
    if not isfolder or not makefolder then return false end
    if not isfolder(CONFIG_FOLDER) then pcall(function() makefolder(CONFIG_FOLDER) end) end
    return isfolder(CONFIG_FOLDER)
end
local function saveConfig()
    if not writefile or not ensureFolder() then return end
    pcall(function() writefile(CONFIG_FILE, HttpService:JSONEncode(Config)) end)
end
local function loadConfig()
    if not readfile or not isfile or not isfile(CONFIG_FILE) then return end
    pcall(function()
        local data = HttpService:JSONDecode(readfile(CONFIG_FILE))
        for k, v in pairs(data) do if DefaultConfig[k] ~= nil then Config[k] = v end end
    end)
end
loadConfig()

-- ====================================================================
--                    NETWORK EVENTS
-- ====================================================================
local Events = {}
do
    local net = ReplicatedStorage.Packages._Index["sleitnick_net@0.2.0"].net
    Events.fishing = net:WaitForChild("RE/FishingCompleted")
    Events.sell = net:WaitForChild("RF/SellAllItems")
    Events.charge = net:WaitForChild("RF/ChargeFishingRod")
    Events.minigame = net:WaitForChild("RF/RequestFishingMinigameStarted")
    Events.equip = net:WaitForChild("RE/EquipToolFromHotbar")
    Events.unequip = net:WaitForChild("RE/UnequipToolFromHotbar")
    Events.favorite = net:WaitForChild("RE/FavoriteItem")
end

-- ====================================================================
--                    MODULES & RARITY
-- ====================================================================
local ItemUtility = require(ReplicatedStorage.Shared.ItemUtility)
local Replion = require(ReplicatedStorage.Packages.Replion)
local PlayerData = Replion.Client:WaitReplion("Data")

local RarityTiers = { Common = 1, Uncommon = 2, Rare = 3, Epic = 4, Legendary = 5, Mythic = 6, Secret = 7 }
local function getRarityValue(r) return RarityTiers[r] or 0 end
local function getFishRarity(d) if not d or not d.Data then return "Common" end return d.Data.Rarity or "Common" end

-- ====================================================================
--                    TELEPORT (ISLAND)
-- ====================================================================
local function teleportTo(name)
    local cf = LOCATIONS[name]
    if not cf then return false end
    return pcall(function()
        local char = LocalPlayer.Character
        if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart")
        if root then root.CFrame = cf end
    end)
end

-- ====================================================================
--                    TELEPORT TO PLAYER
-- ====================================================================
local function teleportToPlayer(playerName)
    return pcall(function()
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr.Name == playerName and plr ~= LocalPlayer then
                local targetChar = plr.Character
                local myChar = LocalPlayer.Character
                if targetChar and myChar then
                    local tRoot = targetChar:FindFirstChild("HumanoidRootPart")
                    local mRoot = myChar:FindFirstChild("HumanoidRootPart")
                    if tRoot and mRoot then
                        mRoot.CFrame = tRoot.CFrame + Vector3.new(0, 3, 0)
                    end
                end
                return
            end
        end
    end)
end

-- ====================================================================
--                    SERVER HOP & REJOIN
-- ====================================================================
local function serverHop()
    pcall(function()
        local url = "https://games.roblox.com/v1/games/" .. game.PlaceId
            .. "/servers/Public?sortOrder=Asc&limit=100&excludeFullGames=true"
        local result = HttpService:JSONDecode(game:HttpGet(url))
        if result and result.data then
            for _, srv in ipairs(result.data) do
                if srv.id ~= game.JobId and srv.playing < srv.maxPlayers then
                    TeleportService:TeleportToPlaceInstance(game.PlaceId, srv.id, LocalPlayer)
                    return
                end
            end
        end
    end)
end

local function rejoin()
    pcall(function()
        TeleportService:Teleport(game.PlaceId, LocalPlayer)
    end)
end

-- ====================================================================
--                    GPU SAVER
-- ====================================================================
local gpuActive = false
local gpuGui = nil
local function enableGPU()
    if gpuActive then return end
    gpuActive = true
    pcall(function()
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
        game.Lighting.GlobalShadows = false
        game.Lighting.FogEnd = 1
        setfpscap(8)
    end)
    gpuGui = Instance.new("ScreenGui")
    gpuGui.ResetOnSpawn = false
    gpuGui.DisplayOrder = 999999
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1, 0, 1, 0)
    f.BackgroundColor3 = Color3.new(0.1, 0.1, 0.1)
    f.Parent = gpuGui
    local l = Instance.new("TextLabel")
    l.Size = UDim2.new(0, 400, 0, 80)
    l.Position = UDim2.new(0.5, -200, 0.5, -40)
    l.BackgroundTransparency = 1
    l.Text = "🟢 GPU SAVER ACTIVE"
    l.TextColor3 = Color3.new(0, 1, 0)
    l.TextSize = 28
    l.Font = Enum.Font.GothamBold
    l.Parent = f
    gpuGui.Parent = game.CoreGui
end
local function disableGPU()
    if not gpuActive then return end
    gpuActive = false
    pcall(function()
        settings().Rendering.QualityLevel = Enum.QualityLevel.Automatic
        game.Lighting.GlobalShadows = true
        game.Lighting.FogEnd = 100000
        setfpscap(0)
    end)
    if gpuGui then gpuGui:Destroy(); gpuGui = nil end
end

-- ====================================================================
--                    FULLBRIGHT
-- ====================================================================
local function setFullbright(state)
    if state then
        game.Lighting.Ambient = Color3.fromRGB(178, 178, 178)
        game.Lighting.OutdoorAmbient = Color3.fromRGB(178, 178, 178)
        game.Lighting.Brightness = 2
        game.Lighting.ClockTime = 12
        game.Lighting.FogEnd = 100000
    else
        game.Lighting.Ambient = Color3.fromRGB(70, 70, 70)
        game.Lighting.OutdoorAmbient = Color3.fromRGB(128, 128, 128)
        game.Lighting.Brightness = 1
    end
end

-- ====================================================================
--                    WALKSPEED & JUMPPOWER
-- ====================================================================
local function applySpeed(value)
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.WalkSpeed = value end
    end
end
local function applyJump(value)
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.UseJumpPower = true; hum.JumpPower = value end
    end
end

-- Anti-AFK
LocalPlayer.Idled:Connect(function()
    VirtualUser:CaptureController()
    VirtualUser:ClickButton2(Vector2.new())
end)

-- ====================================================================
--                    AUTO FAVORITE
-- ====================================================================
local favoritedItems = {}
local function isItemFavorited(uuid)
    local ok, res = pcall(function()
        for _, it in ipairs(PlayerData:GetExpect("Inventory").Items) do
            if it.UUID == uuid then return it.Favorited == true end
        end
        return false
    end)
    return ok and res or false
end
local function autoFavoriteByRarity()
    if not Config.AutoFavorite then return end
    local target = getRarityValue(Config.FavoriteRarity)
    if target < 6 then target = 6 end
    pcall(function()
        local items = PlayerData:GetExpect("Inventory").Items
        if not items or #items == 0 then return end
        for _, item in ipairs(items) do
            local data = ItemUtility:GetItemData(item.Id)
            if data and data.Data then
                if getRarityValue(getFishRarity(data)) >= target then
                    if not isItemFavorited(item.UUID) and not favoritedItems[item.UUID] then
                        Events.favorite:FireServer(item.UUID)
                        favoritedItems[item.UUID] = true
                        task.wait(0.3)
                    end
                end
            end
        end
    end)
end
task.spawn(function()
    while true do task.wait(10); if Config.AutoFavorite then autoFavoriteByRarity() end end
end)

-- ====================================================================
--                    FISHING LOGIC
-- ====================================================================
local isFishing = false
local fishingActive = false

local function castRod()
    pcall(function()
        Events.equip:FireServer(1)
        task.wait(0.05)
        Events.charge:InvokeServer(1755848498.4834)
        task.wait(0.02)
        Events.minigame:InvokeServer(1.2854545116425, 1)
    end)
end
local function reelIn() pcall(function() Events.fishing:FireServer() end) end

local function blatantLoop()
    while fishingActive and Config.BlatantMode do
        if not isFishing then
            isFishing = true
            pcall(function()
                Events.equip:FireServer(1)
                task.wait(0.01)
                task.spawn(function()
                    Events.charge:InvokeServer(1755848498.4834)
                    task.wait(0.01)
                    Events.minigame:InvokeServer(1.2854545116425, 1)
                end)
                task.wait(0.05)
                task.spawn(function()
                    Events.charge:InvokeServer(1755848498.4834)
                    task.wait(0.01)
                    Events.minigame:InvokeServer(1.2854545116425, 1)
                end)
            end)
            task.wait(Config.FishDelay)
            for _ = 1, 5 do pcall(function() Events.fishing:FireServer() end) task.wait(0.01) end
            task.wait(Config.CatchDelay * 0.5)
            isFishing = false
        else task.wait(0.01) end
    end
end

local function normalLoop()
    while fishingActive and not Config.BlatantMode do
        if not isFishing then
            isFishing = true
            castRod(); task.wait(Config.FishDelay)
            reelIn();  task.wait(Config.CatchDelay)
            isFishing = false
        else task.wait(0.1) end
    end
end

local function fishingLoop()
    while fishingActive do
        if Config.BlatantMode then blatantLoop() else normalLoop() end
        task.wait(0.1)
    end
end

task.spawn(function()
    while true do
        if Config.AutoCatch and not isFishing then pcall(function() Events.fishing:FireServer() end) end
        task.wait(Config.CatchDelay)
    end
end)

local function simpleSell() pcall(function() Events.sell:InvokeServer() end) end
task.spawn(function()
    while true do task.wait(Config.SellDelay); if Config.AutoSell then simpleSell() end end
end)

-- ====================================================================
--                    RAYFIELD UI
-- ====================================================================
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
    Name = "🎣 Auto Fish V4.1",
    LoadingTitle = "Auto Fish V4.1",
    LoadingSubtitle = "Clean UI + Extended Engines",
    ConfigurationSaving = { Enabled = false }
})

-- ============== TAB 1: MAIN ==============
local MainTab = Window:CreateTab("🏠 Main", nil)
MainTab:CreateSection("Auto Fishing")

MainTab:CreateToggle({Name = "⚡ Blatant Mode (3x Faster)", CurrentValue = Config.BlatantMode,
    Callback = function(v) Config.BlatantMode = v; saveConfig() end})

MainTab:CreateToggle({Name = "🤖 Auto Fish", CurrentValue = Config.AutoFish,
    Callback = function(v)
        Config.AutoFish = v; fishingActive = v
        if v then task.spawn(fishingLoop) else pcall(function() Events.unequip:FireServer() end) end
        saveConfig()
    end})

MainTab:CreateToggle({Name = "🎯 Auto Catch", CurrentValue = Config.AutoCatch,
    Callback = function(v) Config.AutoCatch = v; saveConfig() end})

MainTab:CreateInput({Name = "Fish Delay (s)", PlaceholderText = "0.9",
    CurrentValue = tostring(Config.FishDelay), RemoveTextAfterFocusLost = false,
    Callback = function(v) local n = tonumber(v); if n and n >= 0.1 and n <= 10 then Config.FishDelay = n; saveConfig() end end})

MainTab:CreateInput({Name = "Catch Delay (s)", PlaceholderText = "0.2",
    CurrentValue = tostring(Config.CatchDelay), RemoveTextAfterFocusLost = false,
    Callback = function(v) local n = tonumber(v); if n and n >= 0.1 and n <= 10 then Config.CatchDelay = n; saveConfig() end end})

MainTab:CreateSection("Auto Sell")
MainTab:CreateToggle({Name = "💰 Auto Sell (Keep Favorited)", CurrentValue = Config.AutoSell,
    Callback = function(v) Config.AutoSell = v; saveConfig() end})
MainTab:CreateInput({Name = "Sell Delay (s)", PlaceholderText = "30",
    CurrentValue = tostring(Config.SellDelay), RemoveTextAfterFocusLost = false,
    Callback = function(v) local n = tonumber(v); if n and n >= 10 and n <= 300 then Config.SellDelay = n; saveConfig() end end})
MainTab:CreateButton({Name = "💰 Sell All Now", Callback = function() simpleSell() end})

-- ============== TAB 2: FAVORITE ==============
local FavTab = Window:CreateTab("⭐ Favorite", nil)
FavTab:CreateSection("Auto Favorite Fish")
FavTab:CreateToggle({Name = "⭐ Auto Favorite", CurrentValue = Config.AutoFavorite,
    Callback = function(v) Config.AutoFavorite = v; saveConfig() end})
FavTab:CreateDropdown({Name = "Favorite Rarity", Options = { "Mythic", "Secret" },
    CurrentOption = { Config.FavoriteRarity },
    Callback = function(opt) Config.FavoriteRarity = opt; saveConfig() end})
FavTab:CreateButton({Name = "⭐ Favorite Now", Callback = function() autoFavoriteByRarity() end})

-- ============== TAB 3: TELEPORT ==============
local TPTab = Window:CreateTab("🌍 Teleport", nil)
TPTab:CreateSection("📍 Teleport to Island")
local currentIsland = Config.TeleportLocation
if not LOCATIONS[currentIsland] then currentIsland = locationNames[1] end
TPTab:CreateDropdown({Name = "Select Island", Options = locationNames,
    CurrentOption = { currentIsland },
    Callback = function(opt) Config.TeleportLocation = opt; saveConfig() end})
TPTab:CreateButton({Name = "🚀 Teleport to Island", Callback = function() teleportTo(Config.TeleportLocation) end})

TPTab:CreateSection("👤 Teleport to Player")
local function getPlayerList()
    local list = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then table.insert(list, plr.Name) end
    end
    return list
end
local selectedPlayer = getPlayerList()[1] or "None"
local playerDropdown
playerDropdown = TPTab:CreateDropdown({
    Name = "Select Player",
    Options = getPlayerList(),
    CurrentOption = { selectedPlayer },
    Callback = function(opt) selectedPlayer = opt end
})
TPTab:CreateButton({Name = "🎯 Teleport to Player",
    Callback = function() teleportToPlayer(selectedPlayer) end})
TPTab:CreateButton({Name = "🔄 Refresh Player List",
    Callback = function() playerDropdown:Refresh(getPlayerList()) end})

TPTab:CreateSection("🌐 Server")
TPTab:CreateButton({Name = "🌐 Server Hop", Callback = function() serverHop() end})
TPTab:CreateButton({Name = "🔁 Rejoin Server", Callback = function() rejoin() end})

-- ============== TAB 4: SETTINGS ==============
local SetTab = Window:CreateTab("⚙️ Settings", nil)
SetTab:CreateSection("Performance")

SetTab:CreateToggle({Name = "🖥️ GPU Saver Mode", CurrentValue = Config.GPUSaver,
    Callback = function(v) Config.GPUSaver = v; if v then enableGPU() else disableGPU() end; saveConfig() end})

SetTab:CreateToggle({Name = "💡 Fullbright", CurrentValue = Config.Fullbright,
    Callback = function(v) Config.Fullbright = v; setFullbright(v); saveConfig() end})

SetTab:CreateSection("Movement")

SetTab:CreateSlider({Name = "WalkSpeed", Range = { 16, 200 }, Increment = 1, Suffix = " studs",
    CurrentValue = Config.WalkSpeed,
    Callback = function(v) Config.WalkSpeed = v; applySpeed(v); saveConfig() end})

SetTab:CreateSlider({Name = "JumpPower", Range = { 50, 500 }, Increment = 5, Suffix = "",
    CurrentValue = Config.JumpPower,
    Callback = function(v) Config.JumpPower = v; applyJump(v); saveConfig() end})

SetTab:CreateSection("Info")
SetTab:CreateParagraph({Title = "Anti-AFK", Content = "Selalu aktif secara otomatis."})

