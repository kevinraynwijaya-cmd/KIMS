-- KIMS TECH | FISH REPLION LOCATOR V20
-- Read-only structural analysis of already-loaded client modules.
-- No getgc, remote calls, HTTP, Zetsu, gameplay getters, item actions or uploads.
-- All item values, IDs, UUIDs, channel contents and secrets are omitted from output.
local Players = game:GetService('Players')
local RS = game:GetService('ReplicatedStorage')
local UIS = game:GetService('UserInputService')
local player = Players.LocalPlayer
if not player then return end
local pg = player:WaitForChild('PlayerGui')
local old = pg:FindFirstChild('KIMSFishReplionV20')
if old then old:Destroy() end
local screen = Instance.new('ScreenGui')
screen.Name='KIMSFishReplionV20'; screen.ResetOnSpawn=false; screen.DisplayOrder=998; screen.Parent=pg
local pane=Instance.new('Frame',screen)
pane.Size=UDim2.new(.94,0,.69,0);pane.Position=UDim2.new(.03,0,.15,0)
pane.BackgroundColor3=Color3.fromRGB(13,19,36);pane.BorderSizePixel=0;pane.Active=true
Instance.new('UICorner',pane).CornerRadius=UDim.new(0,10)
local border=Instance.new('UIStroke',pane);border.Thickness=2;border.Color=Color3.fromRGB(107,91,224)
local heading=Instance.new('TextLabel',pane)
heading.Position=UDim2.new(.025,0,0,5);heading.Size=UDim2.new(.95,0,0,30)
heading.BackgroundTransparency=1;heading.Font=Enum.Font.GothamBold
heading.TextSize=15;heading.TextXAlignment=Enum.TextXAlignment.Left
heading.TextColor3=Color3.fromRGB(205,190,255)
heading.Text='KIMS V20 | FISH REPLION LOCATOR'
local function button(label,x,w)
 local b=Instance.new('TextButton',pane)
 b.Position=UDim2.new(x,0,0,42);b.Size=UDim2.new(w,0,0,33)
 b.BackgroundColor3=Color3.fromRGB(64,57,125);b.TextColor3=Color3.new(1,1,1)
 b.TextScaled=true;b.Font=Enum.Font.GothamBold;b.Text=label
 Instance.new('UICorner',b).CornerRadius=UDim.new(0,6)
 return b
end
local copyBtn=button('SALIN',.025,.27)
local miniBtn=button('MINI',.36,.27)
local closeBtn=button('TUTUP',.68,.29)
local status=Instance.new('TextLabel',pane)
status.Position=UDim2.new(.025,0,0,81);status.Size=UDim2.new(.95,0,0,23)
status.BackgroundTransparency=1;status.TextXAlignment=Enum.TextXAlignment.Left
status.Font=Enum.Font.Code;status.TextSize=12;status.TextColor3=Color3.fromRGB(112,231,168)
status.Text='Menganalisa struktur Replion...'
local sc=Instance.new('ScrollingFrame',pane)
sc.Position=UDim2.new(.025,0,0,109);sc.Size=UDim2.new(.95,0,1,-120)
sc.BackgroundColor3=Color3.fromRGB(21,27,47);sc.BorderSizePixel=0
sc.ScrollBarThickness=5;sc.AutomaticCanvasSize=Enum.AutomaticSize.Y
local content=Instance.new('TextLabel',sc)
content.Position=UDim2.new(0,7,0,6);content.Size=UDim2.new(1,-20,0,0)
content.AutomaticSize=Enum.AutomaticSize.Y;content.TextWrapped=true
content.TextXAlignment=Enum.TextXAlignment.Left;content.TextYAlignment=Enum.TextYAlignment.Top
content.Font=Enum.Font.Code;content.TextSize=12
content.TextColor3=Color3.fromRGB(225,234,252);content.BackgroundTransparency=1
local lines={};local finished=false;local cancel=false
local function out(s) if #lines<220 then lines[#lines+1]=tostring(s) end end
local function redraw() if screen.Parent then content.Text=table.concat(lines,'\n') end end
local function getUps(f)
 if type(getupvalues)=='function' then
  local ok,r=pcall(getupvalues,f)
  if ok and type(r)=='table' then return r end
 end
 if type(debug)=='table' and type(debug.getupvalues)=='function' then
  local ok,r=pcall(debug.getupvalues,f)
  if ok and type(r)=='table' then return r end
 end
 return nil
end
local function guiFish()
 local o=pg:FindFirstChild('Inventory')
 for _,k in ipairs({'Main','Top','Options','Fish','Label','BagSize'}) do
  o=o and o:FindFirstChild(k)
 end
 if o and (o:IsA('TextLabel') or o:IsA('TextButton')) then
  local s=tostring(o.Text or ''):gsub(',','')
  local n,cap=s:match('(%d+)%s*/%s*(%d+)')
  if n then return tonumber(n),tonumber(cap) end
 end
 return nil,nil
end
local function privateKey(s)
 s=s:lower()
 for _,word in ipairs({'token','secret','password','cookie','api_key','apikey','webhook','credential','session','auth'}) do
  if s:find(word,1,true) then return true end
 end
 return false
end
local function fishKey(s)
 s=s:lower()
 return s:find('fish',1,true) or s:find('inventory',1,true) or
  s:find('storage',1,true) or s:find('catch',1,true) or
  s:find('bag',1,true) or s:find('replion',1,true) or
  s:find('playerdata',1,true)
end
local function historyKey(s)
 s=s:lower()
 return s:find('mastery',1,true) or s:find('journal',1,true) or
        s:find('caught',1,true) or s:find('stat',1,true) or
        s:find('pity',1,true) or s:find('history',1,true)
end
local approvedKeys={
 Data=true,Inventory=true,Items=true,Fish=true,Fishes=true,
 FishInventory=true,FishStorage=true,FishBag=true,FishingData=true,
 Storage=true,Bag=true,Replions=true,Replion=true,Client=true,
 PlayerData=true,Registry=true,State=true,Channel=true,
 ['Fishing Rods']=true,Pets=true,Baits=true,InventoryController=true
}
local function safeKey(k)
 if type(k)=='string' and approvedKeys[k] and not privateKey(k) then return k end
 return '[entry]'
end
local function sampleCount(t,cap)
 local n=0
 for _ in pairs(t) do n=n+1;if n>=cap then break end end
 return n
end
local recordFields={Id=true,UUID=true,Weight=true,Mutation=true,Variant=true,
 Rarity=true,Quantity=true,Timestamp=true,Species=true,FishId=true,FishID=true,
 FishType=true,Size=true,Name=true,ItemId=true,ItemID=true,Type=true}
local function itemShape(t)
 local names={}
 for k,v in pairs(t) do
  if type(k)=='string' and recordFields[k] then names[#names+1]=k..':'..type(v) end
 end
 table.sort(names)
 return #names>0 and table.concat(names,',') or '(no recognized fields)'
end
local function isItemRecord(t)
 return type(t)=='table' and rawget(t,'UUID')~=nil and rawget(t,'Id')~=nil
end
local function categoryOverview(t)
 local arr={}
 for _,k in ipairs({'Fish','Fishes','FishInventory','FishStorage','Fishing Rods','Items','Pets','Baits'}) do
  local v=rawget(t,k)
  if type(v)=='table' then arr[#arr+1]=k..'='..sampleCount(v,5000) end
 end
 return #arr>0 and table.concat(arr,', ') or '(no known categories)'
end
local function probeTable(t,path,source,fishCounter,findings,seenCandidates,states)
 local data=rawget(t,'Data')
 if type(data)=='table' and (rawget(t,'Channel')~=nil or type(rawget(t,'Get'))=='function') then
  states.count=states.count+1
  if states.count<=14 then
   states.lines[#states.lines+1]='REPLION-LIKE '..source..'/'..path:sub(1,80)..' | Data '..categoryOverview(data)
  end
 end
 if seenCandidates[t] then return end
 local records,weighted,mutated,recordFirst,checked=0,0,0,nil,0
 local n=0
 for _,v in pairs(t) do
  n=n+1
  if type(v)=='table' and checked<24 then
   checked=checked+1
   if isItemRecord(v) then
    records=records+1
    if not recordFirst then recordFirst=v end
    if rawget(v,'Weight')~=nil or rawget(v,'FishWeight')~=nil or rawget(v,'Size')~=nil then
     weighted=weighted+1
    end
    if rawget(v,'Mutation')~=nil or rawget(v,'Variant')~=nil then mutated=mutated+1 end
   end
  end
  if n>=5000 then break end
 end
 local ownerPath=path:lower()
 local indicatesFish=(ownerPath:find('fish',1,true) or ownerPath:find('catch',1,true)) and
   not historyKey(ownerPath)
 local score=records*3+weighted*11+mutated*5
 if indicatesFish then score=score+20 end
 if fishCounter and n==fishCounter then score=score+13 end
 if records>=2 or indicatesFish then
  seenCandidates[t]=true
  findings[#findings+1]={score=score,path=path,source=source,n=n,records=records,
   weighted=weighted,mutated=mutated,shape=recordFirst and itemShape(recordFirst) or '(not an item list)',
   match=fishCounter and n==fishCounter or false,fish=indicatesFish}
 end
end
local function run()
 out('KIMS V20 | FISH REPLION LOCATOR | READ ONLY')
 out('PlaceId='..tostring(game.PlaceId))
 out('NO getgc, HTTP, remotes, Zetsu, game getters, raw item IDs or uploads.')
 local fishCounter,capacity=guiFish()
 out('Fish GUI count='..tostring(fishCounter or 'unavailable')..'/'..tostring(capacity or '?')..' (may be cached)')
 if type(getloadedmodules)~='function' then out('getloadedmodules unavailable.');return end
 local ok,loaded=pcall(getloadedmodules)
 if not ok or type(loaded)~='table' then out('Loaded modules unavailable.');return end
 local wanted={
  ['ReplicatedStorage.Packages.Replion']=true,
  ['ReplicatedStorage.Packages._Index.ytrev_replion@2.0.0-rc.3.replion.Client']=true,
  ['ReplicatedStorage.Controllers.InventoryController']=true,
  ['ReplicatedFirst.GAME.Runner.WaitForPlayerData']=true
 }
 local modules={};local matches={};local count=0
 for _,m in ipairs(loaded) do
  count=count+1
  if typeof(m)=='Instance' and m:IsA('ModuleScript') then
   local good,name=pcall(function()return m:GetFullName()end)
   if good then
    if wanted[name] then modules[#modules+1]={m=m,name=name} end
    if name:find('Controller',1,true) and (name:find('Fish',1,true) or name:find('Catch',1,true) or name:find('Storage',1,true)) then
     matches[#matches+1]=name
    end
   end
  end
  if count%500==0 then task.wait() end
 end
 out('Loaded modules='..count..' | exact targets='..#modules)
 table.sort(matches)
 out('=== FISH/CATCH CONTROLLER NAME CLUES ===')
 for i=1,math.min(#matches,12) do out('  '..matches[i]) end
 if #matches==0 then out('  No fish-named controllers in loaded modules') end
 local queue={};local head=1
 local function push(v,p,d,s)
  if (type(v)=='table' or type(v)=='function') and #queue<5500 then
   queue[#queue+1]={v=v,path=p,depth=d,source=s}
  end
 end
 for _,m in ipairs(modules) do
  local good,res=pcall(require,m.m)
  local short=m.name:match('([^%.]+)$') or m.name
  out('MODULE '..short..' export='..(good and type(res) or 'unavailable'))
  if good then push(res,'[export]',0,short) end
 end
 local visited=setmetatable({},{__mode='k'})
 local seenCandidates=setmetatable({},{__mode='k'})
 local findings={};local states={count=0,lines={}}
 local nodes,functions,fields=0,0,0
 local start=os.clock()
 while head<=#queue and nodes<2400 and fields<18000 and os.clock()-start<15 and not cancel do
  local entry=queue[head];head=head+1
  local obj=entry.v
  if not visited[obj] then
   visited[obj]=true;nodes=nodes+1
   if type(obj)=='function' then
    functions=functions+1
    if functions<=330 and entry.depth<8 then
     local ups=getUps(obj)
     if ups then
      local i=0
      for _,v in pairs(ups) do
       i=i+1
       if i<=15 then push(v,entry.path..'/[upvalue]',entry.depth+1,entry.source) end
       if i>=20 then break end
      end
     end
    end
   else
    probeTable(obj,entry.path,entry.source,fishCounter,findings,seenCandidates,states)
    if entry.depth<9 then
     local i=0
     local picked={}
     -- Named source containers come first even when large tables have unordered keys.
     for _,k in ipairs({'Data','Inventory','Fish','Fishes','FishInventory','FishStorage',
        'FishingData','PlayerData','Replions','Replion','Client','Registry','State','Items'}) do
      local v=rawget(obj,k)
      if type(v)=='table' or type(v)=='function' then
       picked[k]=true
       push(v,entry.path..'/'..k,entry.depth+1,entry.source)
      end
     end
     for k,v in pairs(obj) do
      i=i+1;fields=fields+1
      if (type(v)=='table' or type(v)=='function') and not picked[k] then
       local isRecord=type(v)=='table' and isItemRecord(v)
       -- Fish named branches prioritized, non-record branches sampled to avoid large inventories.
       local relevant=type(k)=='string' and fishKey(k) and not privateKey(k)
       if not isRecord and (relevant or i<=45) then
        local part=safeKey(k)
        -- Skip deeply nested history/mastery species tables; they are not owned fish.
        if not (type(k)=='string' and historyKey(k) and entry.depth>2) then
         push(v,entry.path..'/'..part,entry.depth+1,entry.source)
        end
       end
      end
      if i>=170 or fields>=18000 then break end
     end
    end
   end
   if nodes%65==0 then status.Text='Memeriksa '..nodes..' objek...';task.wait() end
  end
 end
 out('')
 out('=== REPLION DATA OBJECTS (STRUCTURE) ===')
 out('Replion-like objects='..states.count)
 for _,s in ipairs(states.lines) do out(s) end
 out('')
 out('=== ITEM RECORD LIST CANDIDATES ===')
 table.sort(findings,function(a,b) return a.score>b.score end)
 out('Candidates='..#findings..' | showing='..math.min(#findings,18))
 for i=1,math.min(#findings,18) do
  local r=findings[i]
  out('C'..i..' score='..r.score..' source='..r.source..' path='..r.path:sub(1,125))
  out('  entries='..r.n..' sampledUUID+Id='..r.records..' weightField='..r.weighted..
    ' mutationField='..r.mutated..' fishPath='..tostring(r.fish)..' matchGUI='..tostring(r.match))
  out('  record fields: '..r.shape)
 end
 if #findings==0 then out('No record-list candidates found within bounded graph.') end
 out('')
 out('=== AUDIT ===')
 out('graph nodes='..nodes..' functions='..functions..' fields='..fields..' timeLimit='..tostring(os.clock()-start>=15))
 out('Matching record count alone does not establish owned-fish inventory.')
 out('CaughtFishMastery and FishingJournal are NOT unsold fish lists.')
 out('No UUID values, item values, credentials, remote calls or uploads collected.')
end
copyBtn.MouseButton1Click:Connect(function()
 if not finished then status.Text='Tunggu SELESAI';return end
 local cb=type(setclipboard)=='function' and setclipboard or
    (type(toclipboard)=='function' and toclipboard)
 if not cb then status.Text='Clipboard unsupported';return end
 local ok=pcall(cb,table.concat(lines,'\n'))
 status.Text=ok and 'Laporan tersalin' or 'SALIN gagal'
end)
local mini=false
miniBtn.MouseButton1Click:Connect(function()
 mini=not mini;sc.Visible=not mini
 pane.Size=mini and UDim2.new(.94,0,0,114) or UDim2.new(.94,0,.69,0)
 miniBtn.Text=mini and 'BUKA' or 'MINI'
end)
closeBtn.MouseButton1Click:Connect(function()cancel=true;screen:Destroy()end)
do
 local dragging=false;local dragStart;local posStart
 heading.InputBegan:Connect(function(input)
  if input.UserInputType==Enum.UserInputType.Touch or input.UserInputType==Enum.UserInputType.MouseButton1 then
   dragging=true;dragStart=input.Position;posStart=pane.Position
  end
 end)
 heading.InputEnded:Connect(function(input)
  if input.UserInputType==Enum.UserInputType.Touch or input.UserInputType==Enum.UserInputType.MouseButton1 then dragging=false end
 end)
 UIS.InputChanged:Connect(function(input)
  if not dragging or not dragStart or cancel then return end
  if input.UserInputType==Enum.UserInputType.Touch or input.UserInputType==Enum.UserInputType.MouseMovement then
   local delta=input.Position-dragStart
   pane.Position=UDim2.new(posStart.X.Scale,posStart.X.Offset+delta.X,posStart.Y.Scale,posStart.Y.Offset+delta.Y)
  end
 end)
end
task.spawn(function()
 local ok,err=pcall(run)
 finished=true
 if not cancel then
  if not ok then out('ERROR: '..tostring(err):sub(1,120)) end
  redraw()
  status.Text=ok and 'SELESAI - tekan SALIN' or 'ERROR - tekan SALIN'
 end
end)
