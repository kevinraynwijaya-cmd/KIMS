    ["Sacred Temple"] = CFrame.new(1466.9215,-21.8751,-622.8357)
}

local function teleport(name)
    local destination = LOCATIONS[name]
    if not destination then
        return false,"Unknown location"
    end

    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")

    if not root then
        return false,"Character not ready"
    end

    local ok,err = pcall(function()
        root.CFrame = destination
    end)

    return ok,err
end

-- =====================================================
-- NETWORK ENGINE
-- =====================================================

local REMOTES = {
    fishing = "RE/FishingCompleted",
    sell = "RF/SellAllItems",
    charge = "RF/ChargeFishingRod",
    minigame = "RF/RequestFishingMinigameStarted",
    cancel = "RF/CancelFishingInputs",
    equip = "RE/EquipToolFromHotbar",
    unequip = "RE/UnequipToolFromHotbar",
    favorite = "RE/FavoriteItem"
}

local remoteCount = 0

local function scanEngine()
    local packages = RS:FindFirstChild("Packages")
    local index = packages and packages:FindFirstChild("_Index")
    local package = index and
        index:FindFirstChild("sleitnick_net@0.2.0")
    local net = package and package:FindFirstChild("net")

    remoteCount = 0

    for key,name in pairs(REMOTES) do
        local remote = net and net:FindFirstChild(name)
        events[key] = remote

        if remote then
            remoteCount = remoteCount + 1
        end
    end

    log("Network scan: "..remoteCount.."/8 found",
        remoteCount >= 4 and C.cyan or C.orange)

    return remoteCount
end

local function fishingReady()
    return events.fishing ~= nil
        and events.equip ~= nil
        and events.charge ~= nil
        and events.minigame ~= nil
end

local function invoke(key,...)
    local remote = events[key]

    if not remote or
        not remote:IsA("RemoteFunction") then
        return false,"Missing RemoteFunction: "..key
    end

    local ok,result = pcall(function(...)
        return remote:InvokeServer(...)
    end,...)

    return ok,result
end

local function fire(key,...)
    local remote = events[key]

    if not remote or
        not remote:IsA("RemoteEvent") then
        return false,"Missing RemoteEvent: "..key
    end

    local ok,err = pcall(function(...)
        remote:FireServer(...)
    end,...)

    return ok,err
end

-- =====================================================
-- FISHING ENGINE
-- =====================================================

local function cast()
    local ok,err = fire("equip",1)
    if not ok then return false,err end

    task.wait(0.05)

    ok,err = invoke("charge",1755848498.4834)
    if not ok then return false,err end

    task.wait(0.02)

    return invoke("minigame",1.2854545116425,1)
end

local function reel()
    return fire("fishing")
end

local function stopFishing()
    fishing = false
    fishToken = fishToken + 1
    CONFIG.AutoFish = false
    saveConfig()

    pcall(function()
        fire("unequip")
    end)

    log("Auto Fish stopped",C.orange)
end

local function fishingLoop(token)
    while alive and fishing and fishToken == token do
        if not fishingReady() then
            log("Fishing remotes missing",C.orange)
            break
        end

        local ok,err

        if CONFIG.BlatantMode then
            fire("equip",1)

            for i=1,2 do
                task.spawn(function()
                    if not alive or fishToken ~= token then return end
                    invoke("charge",1755848498.4834)
                    task.wait(0.01)

                    if alive and fishToken == token then
                        invoke("minigame",1.2854545116425,1)
                    end
                end)
                task.wait(0.05)
            end

            task.wait(CONFIG.FishDelay)

            for i=1,5 do
                if not fishing or fishToken ~= token then break end
                ok,err = reel()

                if not ok then
                    log("Reel error: "..tostring(err),C.orange)
                    break
                end

                task.wait(0.01)
            end

            task.wait(CONFIG.CatchDelay*0.5)
        else
            ok,err = cast()

            if not ok then
                log("Cast error: "..tostring(err),C.orange)
                break
            end

            task.wait(CONFIG.FishDelay)

            if not fishing or fishToken ~= token then break end

            ok,err = reel()

            if not ok then
                log("Reel error: "..tostring(err),C.orange)
                break
            end

            task.wait(CONFIG.CatchDelay)
        end
    end

    if fishToken == token then
        fishing = false
        CONFIG.AutoFish = false
        log("Fishing loop ended",C.orange)
    end
end

local function startFishing()
    if fishing then return true end

    scanEngine()

    if not fishingReady() then
        log("Auto Fish unavailable: required remotes missing",C.orange)
        return false
    end

    fishToken = fishToken + 1
    local token = fishToken

    fishing = true
    CONFIG.AutoFish = true
    saveConfig()

    task.spawn(function()
        local ok,err = pcall(fishingLoop,token)

        if not ok then
            fishing = false
            log("Fishing crash: "..tostring(err),C.orange)
        end
    end)

    log("Fishing requests started; catch not verified",C.green)
    return true
end

-- =====================================================
-- FAVORITE + INVENTORY
-- =====================================================

local rarityRank = {
    Common=1,Uncommon=2,Rare=3,Epic=4,
    Legendary=5,Mythic=6,Secret=7
}

local favoriteCache = {}

local function getItems()
    if not playerData then
        return nil,"PlayerData unavailable"
    end

    local ok,inventory = pcall(function()
        return playerData:GetExpect("Inventory")
    end)

    if not ok or type(inventory)~="table" or
        type(inventory.Items)~="table" then
        return nil,"Inventory unavailable"
    end

    return inventory.Items
end

local function favoriteNow()
    local items,err = getItems()
    if not items then return false,err end

    if not itemUtility then
        return false,"ItemUtility unavailable"
    end

    if not events.favorite then
        return false,"Favorite remote missing"
    end

    local threshold = rarityRank[CONFIG.FavoriteRarity] or 6
    local sent = 0

    for _,item in ipairs(items) do
        if not alive then break end

        if item.UUID and not item.Favorited and
            not favoriteCache[item.UUID] then

            local ok,data = pcall(function()
                return itemUtility:GetItemData(item.Id)
            end)

            local rarity = ok and data and data.Data
                and data.Data.Rarity

            if rarity and
                (rarityRank[rarity] or 0) >= threshold then

                local success = fire("favorite",item.UUID)

                if success then
                    favoriteCache[item.UUID] = true
                    sent = sent + 1
                    task.wait(0.3)
                end
            end
        end
    end

    return true,sent
end

local function sellAll()
    return invoke("sell")
end

-- =====================================================
-- UI HELPERS
-- =====================================================

local function new(class,parent,properties)
    local obj = Instance.new(class)

    for k,v in pairs(properties or {}) do
        obj[k] = v
    end

    obj.Parent = parent
    return obj
end

local function round(obj,r)
    new("UICorner",obj,{
        CornerRadius=UDim.new(0,r or 9)
    })
end

local function stroke(obj,color)
    new("UIStroke",obj,{
        Color=color or C.purple,
        Thickness=1.3,
        Transparency=0.25
    })
end

local function text(parent,value,size,color)
    return new("TextLabel",parent,{
        BackgroundTransparency=1,
        Text=tostring(value),
        TextColor3=color or C.white,
        Font=Enum.Font.Gotham,
        TextSize=size or 13,
        TextXAlignment=Enum.TextXAlignment.Left,
        TextWrapped=true
    })
end

