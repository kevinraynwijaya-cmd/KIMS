-- KIMS TECH | DATA HUNTER V8.1 - CANDIDATE INSPECTOR
-- Read-only diagnostic. No HTTP, no require, no remotes, no inventory changes.
-- Only reports structure/type/limited item-name keys. No arbitrary values or tokens.

local Players = game:GetService('Players')
local player = Players.LocalPlayer
if not player then return end
local pg = player:WaitForChild('PlayerGui')
local old = pg:FindFirstChild('KIMSInspectorV81')
if old then old:Destroy() end

local screen = Instance.new('ScreenGui')
screen.Name='KIMSInspectorV81'
screen.ResetOnSpawn=false
screen.ZIndexBehavior=Enum.ZIndexBehavior.Sibling
screen.Parent=pg
local panel = Instance.new('Frame')
panel.Size=UDim2.new(.94,0,.75,0)
panel.Position=UDim2.new(.03,0,.11,0)
panel.BackgroundColor3=Color3.fromRGB(12,17,34)
panel.BorderSizePixel=0
panel.Parent=screen
Instance.new('UICorner',panel).CornerRadius=UDim.new(0,12)
local border=Instance.new('UIStroke',panel)
border.Color=Color3.fromRGB(108,91,225)
border.Thickness=2
local function label(parent,s,pos,sz,col)
    local t=Instance.new('TextLabel')
    t.BackgroundTransparency=1
    t.Text=tostring(s)
    t.Position=pos
    t.Size=sz
    t.Font=Enum.Font.Code
    t.TextSize=12
    t.TextXAlignment=Enum.TextXAlignment.Left
    t.TextYAlignment=Enum.TextYAlignment.Top
    t.TextColor3=col or Color3.fromRGB(224,232,250)
    t.Parent=parent
    return t
end
local heading=label(panel,'KIMS V8.1 | CANDIDATE INSPECTOR',UDim2.new(.02,0,.012,0),UDim2.new(.95,0,0,26),Color3.fromRGB(190,180,255))
heading.Font=Enum.Font.GothamBold
heading.TextSize=15
local function btn(txt,x)
    local b=Instance.new('TextButton')
    b.Position=UDim2.new(x,0,0,39)
    b.Size=UDim2.new(.29,0,0,35)
    b.Text=txt
    b.Font=Enum.Font.GothamBold
    b.TextScaled=true
    b.BackgroundColor3=Color3.fromRGB(64,57,119)
    b.TextColor3=Color3.new(1,1,1)
    b.Parent=panel
    Instance.new('UICorner',b).CornerRadius=UDim.new(0,6)
    return b
end
local inspectBtn=btn('ANALISA',.02)
local copyBtn=btn('SALIN',.35)
local closeBtn=btn('TUTUP',.68)
local status=label(panel,'Siap. Klik ANALISA sekali.',UDim2.new(.02,0,0,84),UDim2.new(.96,0,0,21),Color3.fromRGB(110,226,165))
local scroll=Instance.new('ScrollingFrame')
scroll.Position=UDim2.new(.02,0,0,107)
scroll.Size=UDim2.new(.96,0,1,-116)
scroll.BackgroundColor3=Color3.fromRGB(20,27,46)
scroll.BorderSizePixel=0
scroll.ScrollBarThickness=6
scroll.AutomaticCanvasSize=Enum.AutomaticSize.Y
scroll.Parent=panel
local output=label(scroll,'',UDim2.new(0,6,0,6),UDim2.new(1,-20,0,0))
output.AutomaticSize=Enum.AutomaticSize.Y
output.TextWrapped=true
local lines={}
local busy=false
local closed=false
local function push(s)
    if #lines<115 then lines[#lines+1]=tostring(s) end
end
local function render()
    if not closed then output.Text=table.concat(lines,'\n') end
end
local function short(s)
    return tostring(s or ''):gsub('[\r\n|]',' '):sub(1,65)
end
local function boundedKeys(tbl, max)
    local count=0
    local samples={}
    for k,v in pairs(tbl) do
        count=count+1
        if #samples<5 then
            -- Only show key when clearly item-name-like and not long/secret.
            if type(k)=='string' and #k<=45 and not k:lower():find('key',1,true) and not k:lower():find('token',1,true) then
                samples[#samples+1]={key=k,typ=type(v),val=v}
            else
                samples[#samples+1]={key='('..type(k)..')',typ=type(v),val=v}
            end
        end
        if count>=max then break end
    end
    return count,samples
end
local function fieldsOnly(t, max)
    if type(t)~='table' then return '(non-table)' end
    local out={}
    local i=0
    for k,v in pairs(t) do
        i=i+1
        if #out<max then
            if type(k)=='string' and #k<40 and not k:lower():find('token',1,true) and not k:lower():find('key',1,true) then
                out[#out+1]=short(k)..':'..type(v)
            else
                out[#out+1]='['..type(k)..']:'..type(v)
            end
        end
        if i>=35 then break end
    end
    return #out>0 and table.concat(out,', ') or '(empty)'
end
push('KIMS V8.1 | READ ONLY | NO UPLOAD')
push('USER @'..player.Name..' | UserId='..tostring(player.UserId))
push('TARGET: tentukan apakah kandidat Fish/Potions/Baits/Pets = katalog atau inventory')
push('Hanya bentuk data, tidak mencetak token/API key maupun isi nilai pribadi.')
render()
local function inspect()
    if type(getgc)~='function' then
        push('Delta tidak menyediakan getgc.')
        return
    end
    push('')
    push('=== CANDIDATE STRUCTURE ===')
    render()
    task.wait()
    local ok, objects=pcall(getgc,true)
    if not ok or type(objects)~='table' then
        push('getgc(true) gagal.');return
    end
    push('GC total='..tostring(#objects)..' | range='..tostring(math.min(#objects,16000)))
    local found=0
    local checked=math.min(#objects,16000)
    for i=1,checked do
        local t=objects[i]
        if type(t)=='table' and type(rawget(t,'Fish'))=='table' and type(rawget(t,'Potions'))=='table' then
            found=found+1
            if found<=3 then
                push('')
                push('CANDIDATE '..found..' | gc index='..i..' | arrays='..tostring(#t))
                push('Root fields: '..fieldsOnly(t,12))
                for _,category in ipairs({'Fish','Rods','Baits','Pets','Potions','Stones'}) do
                    local child=rawget(t,category)
                    if type(child)=='table' then
                        local count,samples=boundedKeys(child,130)
                        push(category..': #array='..#child..', key sample count='..count..(count==130 and '+' or ''))
                        for j,item in ipairs(samples) do
                            local suffix=''
                            if item.typ=='table' then suffix=' {'..fieldsOnly(item.val,7)..'}' end
                            push('  '..j..'. '..short(item.key)..' -> '..item.typ..suffix)
                        end
                    elseif child~=nil then
                        push(category..': '..type(child))
                    end
                end
            end
        end
        if i%350==0 then
            status.Text='ANALISA '..i..'/'..checked
            task.wait()
            if closed then return end
        end
    end
    push('')
    push('Candidates found='..found..' (max 3 printed).')
    push('Interpretasi: Fish keys = nama spesies + value = definisi => kemungkinan katalog.')
    push('Untuk inventory akun, perlu instance/quantity atau item ID milik pemain.')
    objects=nil
end
inspectBtn.MouseButton1Click:Connect(function()
    if busy then return end
    busy=true
    status.Text='ANALISA berjalan...'
    task.spawn(function()
        local ok,err=pcall(inspect)
        if not ok then push('ERROR '..short(err)) end
        if not closed then
            busy=false
            status.Text=ok and 'Selesai. Klik SALIN.' or 'Error. Klik SALIN.'
            render()
        end
    end)
end)
copyBtn.MouseButton1Click:Connect(function()
    local fn=(type(setclipboard)=='function' and setclipboard) or (type(toclipboard)=='function' and toclipboard)
    if not fn then status.Text='Clipboard tidak tersedia';return end
    local ok=pcall(fn,table.concat(lines,'\n'))
    status.Text=ok and 'TERSALIN! Paste ke chat.' or 'Gagal menyalin'
end)
closeBtn.MouseButton1Click:Connect(function()
    closed=true
    screen:Destroy()
end)
