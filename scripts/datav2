local contentOrder = 0
local function rootPanel(height, bg)
    contentOrder = contentOrder + 1
    local p = new("Frame", Body, {
        BackgroundColor3 = bg or C.panel,
        BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, height),
        LayoutOrder = contentOrder
    })
    corner(p, 12); stroke(p, C.border, 1, .3)
    return p
end
local function titleBlock(title, desc)
    local p = rootPanel(desc and 66 or 46, C.bg)
    p.BackgroundTransparency = 1
    local a = label(p, title, 18, C.white, true)
    a.Position = UDim2.fromOffset(4, 2)
    a.Size = UDim2.new(1, -8, 0, 29)
    if desc then
        local d = label(p, desc, 11, C.muted)
        d.Position = UDim2.fromOffset(4, 31)
        d.Size = UDim2.new(1, -8, 0, 32)
    end
end
local function infoCard(head, body, highlight)
    local h = rootPanel(78)
    local t = label(h, head, 12, highlight and C.cyan or C.gold, true)
    t.Position = UDim2.fromOffset(13, 11)
    t.Size = UDim2.new(1, -26, 0, 21)
    local b = label(h, body, 12, C.white)
    b.Position = UDim2.fromOffset(13, 33)
    b.Size = UDim2.new(1, -26, 0, 35)
end
local function action(title, desc, callback, destructive)
    local p = rootPanel(67)
    local text = label(p, title, 13, destructive and C.red or C.white, true)
    text.Position = UDim2.fromOffset(12, 8)
    text.Size = UDim2.new(1, -100, 0, 23)
    local cap = label(p, desc, 10, C.muted)
    cap.Position = UDim2.fromOffset(12, 30)
    cap.Size = UDim2.new(1, -100, 0, 31)
    local btn = new("TextButton", p, {
        Text="RUN", Font=Enum.Font.GothamBold, TextSize=11, TextColor3=C.bg,
        BackgroundColor3=destructive and C.red or C.cyan,
        AnchorPoint=Vector2.new(1,.5), Position=UDim2.new(1,-12,.5,0),
        Size=UDim2.fromOffset(70,31), BorderSizePixel=0
    })
    corner(btn,8)
    btn.MouseButton1Click:Connect(function()
        local ok, err = pcall(callback)
        if not ok then notify("Error: "..tostring(err)) end
    end)
end
local function toggle(title, desc, current, cb)
    local p = rootPanel(68)
    local txt = label(p, title, 13, C.white, true)
    txt.Position = UDim2.fromOffset(12, 8)
    txt.Size = UDim2.new(1, -91, 0, 24)
    local sub = label(p, desc, 10, C.muted)
    sub.Position = UDim2.fromOffset(12, 31)
    sub.Size = UDim2.new(1, -94, 0, 31)
    local b = new("TextButton",p, {
        Text=current and "ON" or "OFF", Font=Enum.Font.GothamBold,
        TextSize=11, TextColor3=C.white,
        BackgroundColor3=current and C.green or C.raised2,
        AnchorPoint=Vector2.new(1,.5),
        Position=UDim2.new(1,-12,.5,0), Size=UDim2.fromOffset(66,31), BorderSizePixel=0
    })
    corner(b,10)
    b.MouseButton1Click:Connect(function()
        local ok, err = pcall(function() cb(not current) end)
        if not ok then notify("Toggle error: "..tostring(err)) end
        if render then render() end
    end)
end
local function stepper(title, key, step, minVal, maxVal)
    local p = rootPanel(62)
    local t = label(p, title, 12, C.white, true)
    t.Position = UDim2.fromOffset(11, 15)
    t.Size = UDim2.new(1, -132, 0, 32)
    local value = label(p, tostring(S[key]).."s", 12, C.cyan, true)
    value.TextXAlignment = Enum.TextXAlignment.Center
    value.AnchorPoint=Vector2.new(1,.5)
    value.Position=UDim2.new(1,-44,.5,0)
    value.Size=UDim2.fromOffset(54,32)
    for i,dir in ipairs({-1,1}) do
        local b = new("TextButton",p,{
            Text=dir==-1 and "−" or "+", Font=Enum.Font.GothamBold,
            TextSize=19, TextColor3=C.white, BackgroundColor3=C.raised2,
            Position=UDim2.new(1, dir==-1 and -131 or -40, .5, -16),
            Size=UDim2.fromOffset(33,32), BorderSizePixel=0
        })
        corner(b,8)
        b.MouseButton1Click:Connect(function()
            S[key] = math.floor(math.clamp(S[key]+step*dir,minVal,maxVal)*10+.5)/10
            if render then render() end
        end)
    end
end
local function secretInput(title, placeholder)
    local p = rootPanel(106)
    local t = label(p,title,12,C.white,true)
    t.Position=UDim2.fromOffset(12,7)
    t.Size=UDim2.new(1,-24,0,25)
    local field = new("TextBox",p,{
        Text="", PlaceholderText=placeholder,
        PlaceholderColor3=C.muted, TextColor3=C.white,
        BackgroundColor3=C.raised, Font=Enum.Font.Gotham,
        TextSize=12, TextXAlignment=Enum.TextXAlignment.Left,
        ClearTextOnFocus=false, TextTruncate=Enum.TextTruncate.AtEnd,
        Position=UDim2.fromOffset(12,34), Size=UDim2.new(1,-24,0,34),
        BorderSizePixel=0
    })
    corner(field,8)
    new("UIPadding",field,{PaddingLeft=UDim.new(0,9),PaddingRight=UDim.new(0,9)})
    local status = label(p, S.webhookURL~="" and "URL tersimpan dalam memori (tidak ditampilkan)" or "Belum ada URL", 10,C.muted)
    status.Position=UDim2.fromOffset(12,76)
    status.Size=UDim2.new(1,-24,0,20)
    field.FocusLost:Connect(function()
        local v = field.Text:match("^%s*(.-)%s*$")
        field.Text=""  -- never show the secret on screen after editing
        if v=="" then return end
        if validWebhook(v) then
            S.webhookURL=v
            notify("Webhook URL diterima untuk sesi ini")
        else
            notify("URL webhook Discord tidak valid")
        end
        if render then render() end
    end)
end

render = function()
    if not S.alive then return end
    for _, child in ipairs(Body:GetChildren()) do
        if child:IsA("GuiObject") then child:Destroy() end
    end
    contentOrder = 0
    Body.CanvasPosition = Vector2.new(0,0)
    for key,b in pairs(navButtons) do
        local on = S.activeTab == key
        b.BackgroundColor3 = on and C.purple or C.raised
        b.TextColor3 = on and C.white or C.muted
    end
    if S.activeTab == "HOME" then
        titleBlock("COMMAND CENTER", "KIMS TECH / Fish It / Custom engine diagnostics")
        infoCard("ENGINE STATUS", "Found "..S.scanCount.." / 6 remotes. Ditemukan bukan berarti accepted.", true)
        infoCard("FISHING STATUS", (S.fishing and "RUNNING" or "STOPPED").."  |  Cast "..S.casts.."  |  Reel "..S.reels)
        action("SCAN FISH IT ENGINE", "Periksa remote casting, reeling, sell dan event ikan", function()
            local n=scanEngine()
            local ready,missing=checkEngine()
            notify("Remotes "..n.."/6 | Fishing "..(ready and "found (UNVERIFIED)" or "missing: "..missing))
            render()
        end)
        action("SHOW LAST STATUS", "Lihat log ringkas terakhir", function() notify(S.status) end)
        infoCard("EXPERIMENTAL BUILD", "UI buatan KIMS. Tidak terhubung Rayfield. Gunakan test account.")

    elseif S.activeTab == "FISHING" then
        titleBlock("FISHING ENGINE", "Remote protocol from archived KIMS V1.3; not proven live")
        toggle("AUTO FISH", "Menjalankan satu cast lalu reel per siklus", S.fishing, function(v)
            if v then startFishing() else stopFishing();notify("Auto Fish OFF") end
        end)
        action("CAST PROTOCOL: "..S.protocol, "Ganti bila perlu untuk uji; tetap eksperimental", function()
            if S.fishing then stopFishing(); notify("Auto Fish OFF untuk ganti protocol") end
            S.protocol = S.protocol=="KIMS V1.3" and "Draa reference" or "KIMS V1.3"
            notify("Protocol: "..S.protocol)
            render()
        end)
        stepper("FISH DELAY", "fishDelay", .5, 1, 10)
        stepper("CATCH DELAY", "catchDelay", .1, .3, 5)
        action("STOP AUTO FISH", "Hentikan proses mancing langsung", function()
            stopFishing(); notify("Auto Fish stopped"); render()
        end,true)
        infoCard("CAUTION", "Reel request berhasil tidak membuktikan ikan tertangkap.")

    elseif S.activeTab == "TELEPORT" then
        titleBlock("LOCATION SAVER", "Lokasi tersimpan sementara selama sesi ini")
        action("SAVE CURRENT POSITION", "Simpan posisi karakter saat ini", function()
            local root=Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
            if not root then notify("Character root tidak ditemukan") return end
            S.savedPosition=root.CFrame; notify("Posisi berhasil disimpan")
        end)
        action("TELEPORT TO SAVED", "Kembali ke posisi yang tersimpan", function()
            local root=Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
            if not root or not S.savedPosition then notify("Simpan posisi dulu") return end
            local ok,err=pcall(function() root.CFrame=S.savedPosition end)
            notify(ok and "Teleport requested" or ("Teleport error: "..tostring(err)))
        end)
        infoCard("NOTE", "Game dapat mengoreksi posisi karakter dari server.")

    elseif S.activeTab == "WEBHOOK" then
        titleBlock("DISCORD FISH ALERT", "Kirim event ikan yang memenuhi filter rarity")
        secretInput("DISCORD WEBHOOK URL", "Tempel URL lalu tekan Enter / selesai")
        toggle("AUTO FISH ALERT", "Listen RE/ObtainedNewFishNotification", S.autoAlerts, function(v)
            if v then startAlerts() else stopAlerts(); notify("Fish Alert OFF") end
        end)
        toggle("FILTER SECRET", "Notifikasi rarity Secret", S.filters.Secret, function(v)
            S.filters.Secret=v
        end)
        toggle("FILTER FORGOTTEN", "Notifikasi rarity Forgotten", S.filters.Forgotten, function(v)
            S.filters.Forgotten=v
        end)
        toggle("FILTER UNKNOWN (DEBUG)", "Boleh kirim event tanpa rarity terbaca", S.filters.Unknown, function(v)
            S.filters.Unknown=v
        end)
        action("TEST DISCORD WEBHOOK", "Kirim pesan test tanpa harus menangkap ikan", function()
            task.spawn(function()
                local ok,reason=sendDiscord({
                    title="KIMS TECH | Webhook Test", color=65280,
                    description="KIMS SCRIPT CUSTOM V3: test manual (bukan ikan tertangkap).",
                    fields={{name="Player",value=tostring(Player.Name),inline=true}},
                    footer={text="KIMS TECH"},
                    timestamp=os.date("!%Y-%m-%dT%H:%M:%SZ")
                })
                notify(ok and ("Webhook sent: "..reason) or ("Webhook failed: "..reason))
            end)
        end)
        action("CHECK LAST FISH EVENT", "Event "..S.webhookEvents.." | Sent "..S.webhookSent, function()
            notify(S.lastEvent)
        end)
        action("CLEAR WEBHOOK URL", "Hapus URL dari memori dan matikan alert", function()
            stopAlerts(); S.webhookURL="";notify("Webhook dihapus dari memori");render()
        end,true)
        infoCard("PRIVACY", "Webhook URL hanya disimpan di RAM. Jangan upload URL ke GitHub.")

    elseif S.activeTab == "INVENTORY" then
        titleBlock("INVENTORY SCANNER", "Read-only; bukan auto sell atau auto trade")
        infoCard("LAST INVENTORY SCAN", S.inventorySummary, true)
        action("SCAN INVENTORY", "Baca daftar item melalui Replion bila tersedia", function()
            task.spawn(inventoryScan)
        end)
        action("SHOW SUMMARY IN CONSOLE", "Lihat data rarity dari scan terakhir", function()
            print("[KIMS V3 INVENTORY] "..S.inventorySummary)
            notify("Summary ditulis ke console")
        end)
        infoCard("NOTE", "Hasil bergantung pada struktur Inventory dan ItemUtility versi game.")

    elseif S.activeTab == "SETTINGS" then
        titleBlock("KIMS SETTINGS", "Tampilan mandiri • ringan • tidak butuh Rayfield")
        toggle("LOW GRAPHICS: SHADOWS", "Matikan bayangan (dipulihkan saat OFF)", S.lowGraphics, function(v)
            local ok,err=pcall(function()
                Lighting.GlobalShadows=v and false or S.originalShadows
            end)
            if ok then S.lowGraphics=v;notify("Shadows "..(v and "OFF" or "RESTORED"))
            else notify("Graphics error: "..tostring(err)) end
        end)
        action("MINIMIZE TO KIMS BUBBLE", "Sembunyikan window, tampilkan tombol K", hideUI)
        action("STOP ALL KIMS TASKS", "Matikan fishing, webhook dan GUI", function()
            ENV.KIMS_CUSTOM_V3_STOP()
        end,true)
        infoCard("ABOUT", "KIMS CUSTOM V3.0 / Powered by KIMS TECH / Experimental")
    end
end

ENV.KIMS_CUSTOM_V3_STOP = function()
    if not S.alive then return end
    S.alive=false
    stopFishing()
    stopAlerts()
    if S.lowGraphics then pcall(function() Lighting.GlobalShadows=S.originalShadows end) end
    for _,conn in ipairs(S.connections) do pcall(function() conn:Disconnect() end) end
    pcall(function() Screen:Destroy() end)
    print("[KIMS V3] All tasks stopped")
end

-- Dedicated STOP entrypoint and cleanup for repeated executes.
local ok, err = pcall(function()
    scanEngine()
    render()
end)
if not ok then
    warn("[KIMS V3] UI initialization failed: "..tostring(err))
    ENV.KIMS_CUSTOM_V3_STOP()
else
    notify("KIMS CUSTOM V3 loaded | Rayfield FREE")
end
