            UDim2.new(0.2, -12, 0, 30), function() App:SelectTab(tabName) end)
        App.TabButtons[name].TextSize = 10
        App.Pages[name] = create("Frame", {Name = "Page" .. index, Position = UDim2.fromOffset(18, 124),
            Size = UDim2.new(1, -36, 1, -188), BackgroundTransparency = 1, Visible = false}, window)
    end

    local livePage = App.Pages["TANGKAPAN LIVE"]
    App.LiveSummary = label(livePage, "Menunggu baseline...", UDim2.new(), UDim2.new(1, 0, 0, 22), false, 13)
    App.LiveEventLabel = label(livePage, "EVENT DATA / POLL 0.5s", UDim2.fromOffset(0, 23), UDim2.new(1, 0, 0, 18), true, 10)
    App.LiveToggle = button(livePage, "PANTAU: ON", UDim2.fromOffset(0, 50), UDim2.new(1 / 3, -5, 0, 30), function()
        App.LiveEnabled = not App.LiveEnabled
        App:ResetLive(false)
        App:Toast(App.LiveEnabled and "Pantauan aktif; data saat ini menjadi baseline baru." or "Pantauan live dijeda.")
    end)
    button(livePage, "RESET TES", UDim2.new(1 / 3, 2, 0, 50), UDim2.new(1 / 3, -5, 0, 30), function()
        App:ResetLive(true)
        App:Toast("Tes direset. Tunggu SIAP lalu pancing 1 ikan.")
    end)
