    warn("[KIMS HUB] LocalPlayer is unavailable. Run on the client.")
    return
end

local GLOBAL
pcall(function()
    if type(getgenv) == "function" then
        GLOBAL = getgenv()
    end
end)
if type(GLOBAL) ~= "table" then
    GLOBAL = _G
end

if GLOBAL.KIMS_FISHIT_HUB_V1 and type(GLOBAL.KIMS_FISHIT_HUB_V1.Destroy) == "function" then
    pcall(function()
        GLOBAL.KIMS_FISHIT_HUB_V1:Destroy()
    end)
end

local C = {
    base    = Color3.fromRGB(8, 10, 24),
    surface = Color3.fromRGB(17, 18, 40),
    panel   = Color3.fromRGB(24, 23, 51),
    panel2  = Color3.fromRGB(36, 28, 69),
    accent  = Color3.fromRGB(167, 81, 255),
    glow    = Color3.fromRGB(124, 55, 244),
    cyan    = Color3.fromRGB(100, 225, 250),
    white   = Color3.fromRGB(247, 246, 255),
    muted   = Color3.fromRGB(163, 162, 193),
    green   = Color3.fromRGB(79, 240, 158),
    amber   = Color3.fromRGB(255, 194, 108),
    border  = Color3.fromRGB(78, 58, 132),
}

local function new(className, props, parent)
    local obj = Instance.new(className)
    for key, value in pairs(props or {}) do
        obj[key] = value
    end
    obj.Parent = parent
    return obj
end

local function round(parent, px)
    return new("UICorner", {CornerRadius = UDim.new(0, px or 12)}, parent)
end

local function stroke(parent, color, thickness, transparency)
    return new("UIStroke", {
        Color = color or C.border,
        Thickness = thickness or 1,
        Transparency = transparency or 0.25,
    }, parent)
end

local function textLabel(parent, txt, size, bold, color, props)
    local defaults = {
        BackgroundTransparency = 1,
        Text = txt or "",
        TextColor3 = color or C.white,
        Font = bold and Enum.Font.GothamBold or Enum.Font.Gotham,
        TextSize = size or 14,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        TextTruncate = Enum.TextTruncate.AtEnd,
    }
    for key, value in pairs(props or {}) do
        defaults[key] = value
    end
    return new("TextLabel", defaults, parent)
end

local function textButton(parent, txt, props)
    local defaults = {
        BackgroundColor3 = C.panel,
        BorderSizePixel = 0,
        AutoButtonColor = true,
        Text = txt or "",
        TextColor3 = C.white,
        Font = Enum.Font.GothamBold,
        TextSize = 12,
    }
    for key, value in pairs(props or {}) do
        defaults[key] = value
    end
    return new("TextButton", defaults, parent)
end

local function attachLayout(frame, direction, padding)
    return new("UIListLayout", {
        SortOrder = Enum.SortOrder.LayoutOrder,
        FillDirection = direction or Enum.FillDirection.Vertical,
        Padding = UDim.new(0, padding or 8),
        HorizontalAlignment = Enum.HorizontalAlignment.Left,
    }, frame)
end

local function getGuiParent()
    if type(gethui) == "function" then
        local ok, location = pcall(gethui)
        if ok and location then
            return location
        end
    end
    local pg = player:WaitForChild("PlayerGui", 10)
    if pg then
        return pg
    end
    return game:GetService("CoreGui")
end

local state = {
    tab = "Fishing",
    previewToggles = {},
    choices = {
        fishingMode = "Precision",
        castMode = "Normal",
        rod = "Best Available",
        bait = "Best Available",
        rarity = "All Rarities",
        sellRarity = "Common",
        waypoint = "Slot 1",
        uiScale = "100%",
    },
    uiScale = 1,
    openedAt = os.clock(),
}

local screen = new("ScreenGui", {
    Name = "KIMS_FISHIT_HUB_V1",
    ResetOnSpawn = false,
    IgnoreGuiInset = true,
    ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    DisplayOrder = 998,
})

local okParent, parentError = pcall(function()
    screen.Parent = getGuiParent()
end)
if not okParent then
    local okFallback = pcall(function()
        screen.Parent = player:WaitForChild("PlayerGui")
    end)
    if not okFallback then
        warn("[KIMS HUB] Could not attach UI: " .. tostring(parentError))
        screen:Destroy()
        return
    end
end

local active = true
local connections = {}
local contentConnections = {}
local function trackContent(connection)
    contentConnections[#contentConnections + 1] = connection
    return connection
end
local function track(connection)
    connections[#connections + 1] = connection
    return connection
end

local app = {Gui = screen, State = state}
function app:Destroy()
    if not active then return end
    active = false
    for _, conn in ipairs(connections) do
        pcall(function() conn:Disconnect() end)
    end
    for _, conn in ipairs(contentConnections) do
        pcall(function() conn:Disconnect() end)
    end
    if screen then screen:Destroy() end
    if GLOBAL.KIMS_FISHIT_HUB_V1 == self then
        GLOBAL.KIMS_FISHIT_HUB_V1 = nil
    end
end
GLOBAL.KIMS_FISHIT_HUB_V1 = app

