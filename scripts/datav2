--[[
    KIMS - Luck Countdown Hunter v1

    PURPOSE:
    Find the real Server Luck countdown source.

    Known ground truth:
        Active multiplier = x8
        Remaining time    = 01h 01m 45s

    IMPORTANT:
        NextLuckCounter is ignored.

    Strategy:
        1. Find known Server Luck roots.
        2. Scan descendants once.
        3. Build candidate list.
        4. Read candidates every 1 second.
        5. Detect values that change.
        6. Detect countdown-like patterns.
        7. Detect values around known remaining time.
        8. Upload diagnostic data to the known-working API.
]]

local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")

local p = Players.LocalPlayer
local pg = p:WaitForChild("PlayerGui")

-- =========================================================
-- CONFIG
-- =========================================================

local SNAPSHOT_SECONDS = 20
local INTERVAL = 1

local KNOWN_HOURS = 1
local KNOWN_MINUTES = 1
local KNOWN_SECONDS = 45

local KNOWN_TOTAL_SECONDS =
    (KNOWN_HOURS * 3600)
    + (KNOWN_MINUTES * 60)
    + KNOWN_SECONDS

local MAX_CANDIDATES = 2000
local MAX_RECORDS = 5000
local MAX_CHANGES = 3000
local MAX_ERRORS = 300

local API_URL =
    "https://kims.asia/statakun/api/debug.php"

local API_KEY =
    "stat-kims2026"

-- =========================================================
-- STORAGE
-- =========================================================

local candidates = {}
local records = {}
local changes = {}
local errors = {}

local candidateMap = {}
local previous = {}

local counts = {
    candidates = 0,
    records = 0,
    changes = 0,
    errors = 0
}

-- =========================================================
-- HELPERS
-- =========================================================

local function str(v)
    local ok, result = pcall(function()
        return tostring(v)
    end)

    if ok then
        return result
    end

    return ""
end

local function lower(v)
    return string.lower(str(v))
end

local function ignored(path)
    local s = lower(path)

    return string.find(
        s,
        "nextluckcounter",
        1,
        true
    ) ~= nil
end

local function addError(stage, message)

    if counts.errors >= MAX_ERRORS then
        return
    end

    counts.errors += 1

    table.insert(errors, {
        stage = stage,
        message = str(message),
        timestamp = os.time()
    })
end

-- =========================================================
-- COUNTDOWN PARSER
-- =========================================================

local function parseCountdown(text)

    text = str(text)

    -- =============================================
    -- 01h 01m 45s
    -- =============================================

    local h, m, s =
        string.match(
            text,
            "(%d+)%s*[hH]%s*(%d+)%s*[mM]%s*(%d+)%s*[sS]"
        )

    if h and m and s then

        local total =
            tonumber(h) * 3600
            + tonumber(m) * 60
            + tonumber(s)

        return total, "HMS"

    end

    -- =============================================
    -- 01h 01m
    -- =============================================

    local h2, m2 =
        string.match(
            text,
            "(%d+)%s*[hH]%s*(%d+)%s*[mM]"
        )

    if h2 and m2 then

        local total =
            tonumber(h2) * 3600
            + tonumber(m2) * 60

        return total, "HM"

    end

    -- =============================================
    -- 01h
    -- =============================================

    local h3 =
        string.match(
            text,
            "(%d+)%s*[hH]"
        )

    if h3 then

        return tonumber(h3) * 3600, "H"

    end

    -- =============================================
    -- 01m 45s
    -- =============================================

    local m3, s3 =
        string.match(
            text,
            "(%d+)%s*[mM]%s*(%d+)%s*[sS]"
        )

    if m3 and s3 then

        return
            tonumber(m3) * 60
            + tonumber(s3),
            "MS"

    end

    -- =============================================
    -- MM:SS
    -- =============================================

    local mm, ss =
        string.match(
            text,
            "^(%d+):(%d%d)$"
        )

    if mm and ss then

        return
            tonumber(mm) * 60
            + tonumber(ss),
            "MMSS"

    end

    -- =============================================
    -- HH:MM:SS
    -- =============================================

    local hh, min, sec =
        string.match(
            text,
            "^(%d+):(%d%d):(%d%d)$"
        )

    if hh and min and sec then

        return
            tonumber(hh) * 3600
            + tonumber(min) * 60
            + tonumber(sec),
            "HHMMSS"

    end

    return nil, nil
end

-- =========================================================
-- NUMBER DETECTION
-- =========================================================

local function numericValue(value)

    if typeof(value) == "number" then
        return value
    end

    local n =
        tonumber(
            str(value)
        )

    return n
end

-- =========================================================
-- CANDIDATE KEYWORD
-- =========================================================

local function keywordCandidate(path, name, text)

    local combined =
        lower(path)
        .. " "
        .. lower(name)
        .. " "
        .. lower(text)

    local keywords = {

        "timer",
        "count",
        "counter",
        "countdown",

        "remaining",
        "remain",

        "duration",
        "time",
        "second",
        "seconds",

        "minute",
        "minutes",

        "hour",
        "hours",

        "luck",
        "multiplier",

        "base",
        "active",

        "server"

    }

    for _, word in ipairs(keywords) do

        if string.find(
            combined,
            word,
            1,
            true
        ) then

            return true
        end

    end

    return false
end

-- =========================================================
-- ADD CANDIDATE
-- =========================================================

local function addCandidate(
    instance,
    source,
    property,
    rawValue,
    reason
)

    if counts.candidates >= MAX_CANDIDATES then
        return
    end

    local path = ""

    pcall(function()
        path = instance:GetFullName()
    end)

    if path == "" then
        return
    end

    if ignored(path) then
        return
    end

    local key =
        source
        .. "|"
        .. path
        .. "|"
        .. property

    if candidateMap[key] then
        return
    end

    candidateMap[key] = true

    counts.candidates += 1

    local numeric =
        numericValue(rawValue)

    local parsedSeconds,
        parsedFormat =
        parseCountdown(rawValue)

    local distance = nil

    if parsedSeconds then
        distance =
            math.abs(
                parsedSeconds
                - KNOWN_TOTAL_SECONDS
            )
    elseif numeric then
        distance =
            math.abs(
                numeric
                - KNOWN_TOTAL_SECONDS
            )
    end

    table.insert(
        candidates,
        {
            index = counts.candidates,

            path = path,

            className =
                instance.ClassName,

            source = source,

            property = property,

            initialValue =
                str(rawValue),

            numericValue =
                numeric,

            parsedSeconds =
                parsedSeconds,

            parsedFormat =
                parsedFormat,

            distanceFromKnown =
                distance,

            reason =
                reason
        }
    )
end

-- =========================================================
-- SCAN ROOT
-- =========================================================

local function scanRoot(root, rootName)

    if not root then
        return
    end

    local ok, descendants =
        pcall(function()
            return root:GetDescendants()
        end)

    if not ok then

        addError(
            "GET_DESCENDANTS",
            rootName .. ": " .. str(descendants)
        )

        return
    end

    local list = {
        root
    }

    for _, obj in ipairs(descendants) do
        table.insert(
            list,
            obj
        )
    end

    for _, obj in ipairs(list) do

        local path = ""
        local className = ""

        pcall(function()

            path =
                obj:GetFullName()

            className =
                obj.ClassName

        end)

        if path ~= ""
            and not ignored(path)
        then

            -- =========================================
            -- TEXT
            -- =========================================

            if
                className == "TextLabel"
                or className == "TextButton"
                or className == "TextBox"
            then

                local text = ""

                pcall(function()
                    text = obj.Text
                end)

                local parsedSeconds =
                    parseCountdown(text)

                local keyword =
                    keywordCandidate(
                        path,
                        "",
                        text
                    )

                if
                    keyword
                    or parsedSeconds
                    or numericValue(text)
                then

                    addCandidate(
                        obj,
                        "TEXT",
                        "Text",
                        text,

                        parsedSeconds
                        and "COUNTDOWN_FORMAT"
                        or keyword
                        and "KEYWORD"
                        or "NUMERIC_TEXT"
                    )

                end

            end

            -- =========================================
            -- VALUE OBJECTS
            -- =========================================

            local isValue =

                className == "StringValue"
                or className == "IntValue"
                or className == "NumberValue"
                or className == "BoolValue"

            if isValue then

                local value = nil

                pcall(function()
                    value = obj.Value
                end)

                local keyword =
                    keywordCandidate(
                        path,
                        "",
                        value
                    )

                local parsedSeconds =
                    parseCountdown(value)

                if
                    keyword
                    or parsedSeconds
                    or numericValue(value)
                then

                    addCandidate(
                        obj,
                        "VALUE",
                        "Value",
                        value,

                        parsedSeconds
                        and "COUNTDOWN_FORMAT"
                        or keyword
                        and "KEYWORD"
                        or "NUMERIC_VALUE"
                    )

                end

            end

            -- =========================================
            -- ATTRIBUTES
            -- =========================================

            local attrs = {}

            pcall(function()
                attrs = obj:GetAttributes()
            end)

            for name, value in pairs(attrs) do

                -- Do NOT treat LuckMultiplier itself
                -- as a countdown candidate.
                local lname =
                    lower(name)

                local isMultiplier =
                    lname == "luckmultiplier"

                if not isMultiplier then

                    local keyword =
                        keywordCandidate(
                            path,
                            name,
                            value
                        )

                    local parsedSeconds =
                        parseCountdown(value)

                    if
                        keyword
                        or parsedSeconds
                        or numericValue(value)
                    then

                        addCandidate(
                            obj,
                            "ATTRIBUTE",
                            name,
                            value,

                            parsedSeconds
                            and "COUNTDOWN_FORMAT"
                            or keyword
                            and "KEYWORD"
                            or "NUMERIC_ATTRIBUTE"
                        )

                    end

                end

            end

        end

    end
end

-- =========================================================
-- FIND SERVER LUCK ROOTS
-- =========================================================

local mainLuck = nil
local altLuck = nil

pcall(function()

    mainLuck =
        pg
        :WaitForChild("Exclusive Store")
        .Main
        .Content
        .Frame
        .Items
        .SERVER_LUCK
        ["Server Luck"]

end)

pcall(function()

    altLuck =
        pg
        :WaitForChild("!!! Server Luck")
        .Frame
        ["Server Luck"]

end)

print("[KIMS] COUNTDOWN HUNTER START")
print("[KIMS] MAIN:", mainLuck ~= nil)
print("[KIMS] ALT:", altLuck ~= nil)

-- =========================================================
-- INITIAL SCAN
-- =========================================================

if mainLuck then
    scanRoot(
        mainLuck,
        "MAIN"
    )
end

if altLuck then
    scanRoot(
        altLuck,
        "ALT"
    )
end

-- =========================================================
-- EXPLICIT KNOWN TIMER OBJECTS
-- =========================================================

local function addKnownObject(
    obj,
    source,
    property
)

    if not obj then
        return
    end

    local value = ""

    pcall(function()

        if property == "Text" then
            value = obj.Text

        elseif property == "Value" then
            value = obj.Value
        end

    end)

    addCandidate(
        obj,
        source,
        property,
        value,
        "KNOWN_PATH"
    )
end

pcall(function()

    if mainLuck then

        local timer =
            mainLuck
            .Inside
            .Toggles
            .Timer

        addKnownObject(
            timer,
            "MAIN_KNOWN_TIMER",
            "Text"
        )

    end

end)

pcall(function()

    if mainLuck then

        local base =
            mainLuck
            .Content
            .Visual
            .BaseCounter

        addKnownObject(
            base,
            "MAIN_BASE_COUNTER",
            "Text"
        )

    end

end)

pcall(function()

    if altLuck then

        local timer =
            altLuck
            .Inside
            .Toggles
            .Timer

        addKnownObject(
            timer,
            "ALT_KNOWN_TIMER",
            "Text"
        )

    end

end)

-- =========================================================
-- SNAPSHOT READER
-- =========================================================

local function readCandidate(candidate)

    local instance = nil

    -- Re-resolve from PlayerGui using path
    -- where possible.

    local success, result =
        pcall(function()

            local current =
                pg

            local full =
                candidate.path

            -- Direct known objects are more reliable.
            if
                candidate.source
                == "MAIN_KNOWN_TIMER"
            then

                return
                    mainLuck
                    and mainLuck
                    .Inside
                    .Toggles
                    .Timer

            elseif
                candidate.source
                == "MAIN_BASE_COUNTER"
            then

                return
                    mainLuck
                    and mainLuck
                    .Content
                    .Visual
                    .BaseCounter

            elseif
                candidate.source
                == "ALT_KNOWN_TIMER"
            then

                return
                    altLuck
                    and altLuck
                    .Inside
                    .Toggles
                    .Timer

            end

            -- Search current descendants for exact path.
            if mainLuck then

                if
                    candidate.path
                    == mainLuck:GetFullName()
                then
                    return mainLuck
                end

                for _, obj in
                    ipairs(
                        mainLuck:GetDescendants()
                    )
                do

                    if
                        obj:GetFullName()
                        == full
                    then
                        return obj
                    end

                end

            end

            if altLuck then

                if
                    candidate.path
                    == altLuck:GetFullName()
                then
                    return altLuck
                end

                for _, obj in
                    ipairs(
                        altLuck:GetDescendants()
                    )
                do

                    if
                        obj:GetFullName()
                        == full
                    then
                        return obj
                    end

                end

            end

            return nil
        end)

    if not success then
        return nil
    end

    instance = result

    if not instance then
        return nil
    end

    local value = nil

    pcall(function()

        if candidate.property == "Text" then

            value =
                instance.Text

        elseif candidate.property == "Value" then

            value =
                instance.Value

        else

            value =
                instance:GetAttribute(
                    candidate.property
                )

        end

    end)

    return value
end

-- =========================================================
-- RECORD SNAPSHOT
-- =========================================================

local function recordCandidate(
    candidate,
    second
)

    local value =
        readCandidate(candidate)

    if value == nil then
        return
    end

    local text =
        str(value)

    local numeric =
        numericValue(value)

    local parsedSeconds,
        parsedFormat =
        parseCountdown(text)

    local key =
        candidate.path
        .. "|"
        .. candidate.property

    local old =
        previous[key]

    local changed =
        old ~= nil
        and old ~= text

    local countdownDelta = nil

    if old ~= nil then

        local oldSeconds =
            parseCountdown(old)

        if type(oldSeconds) == "number"
            and parsedSeconds
        then

            countdownDelta =
                parsedSeconds
                - oldSeconds

        end

    end

    if counts.records < MAX_RECORDS then

        counts.records += 1

        table.insert(
            records,
            {
                index =
                    counts.records,

                second =
                    second,

                timestamp =
                    os.time(),

                path =
                    candidate.path,

                className =
                    candidate.className,

                source =
                    candidate.source,

                property =
                    candidate.property,

                value =
                    text,

                numeric =
                    numeric,

                parsedSeconds =
                    parsedSeconds,

                parsedFormat =
                    parsedFormat,

                changed =
                    changed,

                countdownDelta =
                    countdownDelta,

                distanceFromKnown =
                    parsedSeconds
                    and math.abs(
                        parsedSeconds
                        - KNOWN_TOTAL_SECONDS
                    )
                    or numeric
                    and math.abs(
                        numeric
                        - KNOWN_TOTAL_SECONDS
                    )
                    or nil
            }
        )

    end

    -- =============================================
    -- CHANGE
    -- =============================================

    if changed
        and counts.changes < MAX_CHANGES
    then

        counts.changes += 1

        table.insert(
            changes,
            {
                index =
                    counts.changes,

                second =
                    second,

                timestamp =
                    os.time(),

                path =
                    candidate.path,

                className =
                    candidate.className,

                source =
                    candidate.source,

                property =
                    candidate.property,

                previous =
                    old,

                current =
                    text,

                countdownDelta =
                    countdownDelta,

                parsedSeconds =
                    parsedSeconds,

                distanceFromKnown =
                    parsedSeconds
                    and math.abs(
                        parsedSeconds
                        - KNOWN_TOTAL_SECONDS
                    )
                    or numeric
                    and math.abs(
                        numeric
                        - KNOWN_TOTAL_SECONDS
                    )
                    or nil
            }
        )

    end

    previous[key] =
        text
end

-- =========================================================
-- DYNAMIC SNAPSHOTS
-- =========================================================

print(
    "[KIMS] CANDIDATES:",
    #candidates
)

print(
    "[KIMS] WATCHING FOR",
    SNAPSHOT_SECONDS,
    "SECONDS"
)

for second = 0, SNAPSHOT_SECONDS do

    print(
        "[KIMS] SECOND:",
        second
    )

    for _, candidate in
        ipairs(candidates)
    do

        pcall(function()

            recordCandidate(
                candidate,
                second
            )

        end)

    end

    if second < SNAPSHOT_SECONDS then
        task.wait(INTERVAL)
    end

end

-- =========================================================
-- MULTIPLIER FINAL CHECK
-- =========================================================

local finalMultiplier = nil

pcall(function()

    if mainLuck then

        local display =
            mainLuck
            .GameLuckDisplayFrame

        finalMultiplier =
            display:GetAttribute(
                "LuckMultiplier"
            )

    end

end)

-- =========================================================
-- PAYLOAD
-- =========================================================

local payload = {

    version =
        "KIMS-LUCK-COUNTDOWN-HUNTER-V1",

    userId =
        p.UserId,

    username =
        p.Name,

    clientTimestamp =
        os.time(),

    knownState = {

        multiplier =
            8,

        remainingText =
            "01h 01m 45s",

        remainingSeconds =
            KNOWN_TOTAL_SECONDS

    },

    actualState = {

        finalMultiplier =
            finalMultiplier

    },

    config = {

        snapshotSeconds =
            SNAPSHOT_SECONDS,

        interval =
            INTERVAL,

        nextLuckCounterIgnored =
            true

    },

    summary = {

        mainFound =
            mainLuck ~= nil,

        altFound =
            altLuck ~= nil,

        candidateCount =
            #candidates,

        recordCount =
            #records,

        changeCount =
            #changes,

        errorCount =
            #errors

    },

    candidates =
        candidates,

    records =
        records,

    changes =
        changes,

    errors =
        errors,

    ping = true
}

-- =========================================================
-- ENCODE
-- =========================================================

local body = nil

local encodeOk,
    encodeError =
    pcall(function()

        body =
            HttpService:JSONEncode(
                payload
            )

    end)

if not encodeOk then

    warn(
        "[KIMS] JSON ERROR:",
        str(encodeError)
    )

    return
end

print(
    "[KIMS] JSON SIZE:",
    #body
)

-- =========================================================
-- UPLOAD
-- =========================================================

local ok, response =
    pcall(function()

        return HttpService:RequestAsync({

            Url =
                API_URL,

            Method =
                "POST",

            Headers = {

                ["Content-Type"] =
                    "application/json",

                ["Authorization"] =
                    "Bearer "
                    .. API_KEY

            },

            Body =
                body

        })

    end)

-- =========================================================
-- RESULT
-- =========================================================

if
    ok
    and response
    and response.Success
then

    print(
        "[KIMS] COUNTDOWN HUNTER UPLOAD OK"
    )

    print(
        "[KIMS] CANDIDATES:",
        #candidates
    )

    print(
        "[KIMS] RECORDS:",
        #records
    )

    print(
        "[KIMS] CHANGES:",
        #changes
    )

    print(
        "[KIMS] FINAL MULTIPLIER:",
        str(finalMultiplier)
    )

else

    warn(
        "[KIMS] COUNTDOWN HUNTER UPLOAD FAILED"
    )

    if response then

        warn(
            "[KIMS] HTTP:",
            response.StatusCode,
            response.StatusMessage
        )

        if response.Body then

            warn(
                "[KIMS] BODY:",
                response.Body
            )

        end

    else

        warn(
            "[KIMS] ERROR:",
            str(response)
        )

    end

end

print(
    "[KIMS] COUNTDOWN HUNTER FINISHED"
)
