local function track(conn)
    table.insert(S.connections, conn)
    return conn
end
local function new(class, parent, props)
    local o = Instance.new(class)
    for k, v in pairs(props or {}) do o[k] = v end
    o.Parent = parent
    return o
end
local function corner(obj, n)
    return new("UICorner", obj, { CornerRadius = UDim.new(0, n or 10) })
end
local function stroke(obj, color, thickness, transparency)
    return new("UIStroke", obj, {Color = color or C.border,
        Thickness = thickness or 1, Transparency = transparency or 0})
end
local function label(parent, txt, size, color, bold)
    return new("TextLabel", parent, {
        BackgroundTransparency = 1, Text = tostring(txt),
        Font = bold and Enum.Font.GothamBold or Enum.Font.Gotham,
        TextColor3 = color or C.white, TextSize = size or 13,
        TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
    })
end
local function gradient(parent)
    new("UIGradient", parent, {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, C.purple),
            ColorSequenceKeypoint.new(1, C.cyan)
        }), Rotation = 0
    })
end

