    if state then
        addObject(
            objects,
            "SERVER_LUCK.Active",
            "ServerLuck",
            state.multiplier
                and ("Multiplier: x" .. tostring(state.multiplier))
                or "Multiplier: Not detected"
        )

        addObject(
            objects,
            "SERVER_LUCK.Timer",
            "ServerLuckTimer",
            state.timerText ~= ""
                and ("Timer: " .. state.timerText)
                or "Timer: Not detected"
        )

        addObject(
            objects,
            "SERVER_LUCK.Source",
            "ServerLuckSource",
            state.source
        )

        if state.timerPath ~= "" then
            addObject(
                objects,
                state.timerPath,
                "TextLabel",
                state.timerText
            )
        end

        if state.multiplierPath ~= "" then
            addValue(
                values,
                state.multiplierPath,
                "LuckMultiplier",
                state.multiplier or "Unknown"
            )
        end

        if state.timerSeconds then
            addValue(
                values,
                "SERVER_LUCK.TimerSeconds",
                "CountdownSeconds",
                state.timerSeconds
            )
        end

        if state.multiplier then
            attributes["ActiveLuckMultiplier"] =
                "x" .. tostring(state.multiplier)
        end

        if state.timerText ~= "" then
            attributes["ActiveLuckTimer"] = state.timerText
        end

        if state.source ~= "" then
            attributes["ActiveLuckSource"] = state.source
        end
    else
        addObject(
            objects,
            "SERVER_LUCK",
            "ServerLuck",
            "Server Luck UI not found"
        )
    end

    local payload = {
        version = "LUCK-WEB-DEBUG-V2",
        userId = player.UserId,
        username = player.Name,
        clientTimestamp = os.time(),

        -- These MUST stay top-level for the current debug.php.
        attributes = attributes,
        objects = objects,
        values = values
    }

    pcall(function()
        HttpService:RequestAsync({
            Url = API_URL,
            Method = "POST",
            Headers = {
                ["Content-Type"] = "application/json",
                ["Authorization"] = "Bearer " .. API_KEY
            },
            Body = HttpService:JSONEncode(payload)
        })
    end)
end

local lastSignature = nil

local function scan()
    local state = getLuckState()

    local signature = HttpService:JSONEncode({
        multiplier = state and state.multiplier,
        timer = state and state.timerText,
        seconds = state and state.timerSeconds,
        source = state and state.source
    })

    -- First scan always sends.
    -- Later scans send whenever Luck state changes.
    if signature ~= lastSignature then
        lastSignature = signature
        send(state)
    end
end

scan()

task.spawn(function()
    while task.wait(INTERVAL) do
        scan()
    end
end)
