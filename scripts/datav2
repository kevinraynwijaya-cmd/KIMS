-- KIMS TECH | INVENTORY READER V9 - AUDIT FIX
-- Read-only. No remote calls, no HTTP requests, no require, no changes to inventory.
-- BACA once to inspect cached category tables. SALIN copies summary; DATA copies
-- whitelisted numeric item ID -> numeric quantity snapshot (if found).
-- IMPORTANT: cached table is NOT proven to represent player-owned inventory.

local Players = game:GetService('Players')
local HttpService = game:GetService('HttpService')
local player = Players.LocalPlayer
if not player then return end
local pg = player:WaitForChild('PlayerGui')
local old = pg:FindFirstChild('KIMSInventoryV9')
if old then old:Destroy() end

local screen = Instance.new('ScreenGui')
screen.Name = 'KIMSInventoryV9'
screen.ResetOnSpawn = false
screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screen.Parent = pg

local panel = Instance.new('Frame')
panel.Size = UDim2.new(.94,0,.77,0)
panel.Position = UDim2.new(.03,0,.10,0)
panel.BackgroundColor3 = Color3.fromRGB(12,17,34)
panel.BorderSizePixel = 0
panel.Parent = screen
Instance.new('UICorner',panel).CornerRadius = UDim.new(0,12)
local stroke = Instance.new('UIStroke',panel)
stroke.Color = Color3.fromRGB(108,91,225)
stroke.Thickness = 2

local function label(parent,txt,pos,size,color)
    local t = Instance.new('TextLabel')
    t.BackgroundTransparency = 1
    t.Position = pos
    t.Size = size
    t.Text = txt
    t.Font = Enum.Font.Code
    t.TextSize = 12
    t.TextColor3 = color or Color3.fromRGB(230,235,250)
    t.TextXAlignment = Enum.TextXAlignment.Left
    t.TextYAlignment = Enum.TextYAlignment.Top
    t.Parent = parent
    return t
end
local title = label(panel,'KIMS V9 | INVENTORY AUDIT FIX',UDim2.new(.02,0,.012,0),UDim2.new(.96,0,0,26),Color3.fromRGB(190,180,255))
title.Font = Enum.Font.GothamBold
 title.TextSize = 15
local function button(txt,x)
    local b = Instance.new('TextButton')
    b.Position = UDim2.new(x,0,0,39)
    b.Size = UDim2.new(.225,0,0,35)
    b.Text = txt
    b.Font = Enum.Font.GothamBold
    b.TextScaled = true
    b.TextColor3 = Color3.new(1,1,1)
    b.BackgroundColor3 = Color3.fromRGB(64,57,119)
    b.Parent = panel
    Instance.new('UICorner',b).CornerRadius = UDim.new(0,6)
    return b
end
local readBtn = button('BACA',.02)
local copyBtn = button('SALIN',.265)
local exportBtn = button('DATA',.51)
local closeBtn = button('TUTUP',.755)
local status = label(panel,'Siap. Tekan BACA sekali.',UDim2.new(.02,0,0,83),UDim2.new(.96,0,0,20),Color3.fromRGB(110,226,165))
local scroll = Instance.new('ScrollingFrame')
scroll.Size = UDim2.new(.96,0,1,-119)
scroll.Position = UDim2.new(.02,0,0,108)
scroll.BackgroundColor3 = Color3.fromRGB(20,27,46)
scroll.BorderSizePixel = 0
scroll.ScrollBarThickness = 6
scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
scroll.Parent = panel
local output = label(scroll,'',UDim2.new(0,6,0,6),UDim2.new(1,-22,0,0))
output.TextWrapped = true
output.AutomaticSize = Enum.AutomaticSize.Y

local categories = {
    'Fish','Fishing Rods','Baits','Potions','Pets','Pet Eggs',
    'Enchant Stones','Charms','Boats','Gears','Lanterns','Halos','Emotes'
}
local log = {}
local busy,done,closed = false,false,false
local exportText = nil
local MAX_GC = 16000
local MAX_CATEGORY_KEYS = 4000
local function push(s)
    if #log < 130 then log[#log+1] = tostring(s) end
end
local function render()
    if not closed then output.Text = table.concat(log,'\n') end
end
local function fmt(v)
    if type(v) ~= 'number' then return tostring(v) end
    if v == math.floor(v) and math.abs(v) < 1e14 then return string.format('%.0f',v) end
    return tostring(v)
end
local function finite(v)
    return type(v) == 'number' and v == v and v ~= math.huge and v ~= -math.huge
end
-- FIX V8.2: number keys AND digit-only string keys are accepted.
-- The V8.1 inspector explicitly printed digit-only string keys; numeric
-- keys would have appeared as '(number)' in that version.
local function itemKey(k)
    if type(k) == 'number' then
        if not finite(k) or k < 0 or k ~= math.floor(k) then return nil end
        return fmt(k),'number'
    end
    if type(k) == 'string' and #k <= 20 and k:match('^%d+$') then
        return k,'string'
    end
    return nil
end
local function inspectCategory(t)
    local r = {
        count=0, digitStrings=0, numberKeys=0, numeric=0,
        positive=0, zero=0, negative=0, fractions=0, other=0,
        sum=0, max=nil, truncated=false, samples={}, export={}
    }
    for k,v in pairs(t) do
        r.count = r.count + 1
        if r.count > MAX_CATEGORY_KEYS then
            r.truncated=true
            break
        end
        local id,kind = itemKey(k)
        if kind == 'string' then r.digitStrings = r.digitStrings + 1 end
        if kind == 'number' then r.numberKeys = r.numberKeys + 1 end
        if id and finite(v) then
            r.numeric=r.numeric+1
            r.sum=r.sum+v
            if v>0 then r.positive=r.positive+1
            elseif v==0 then r.zero=r.zero+1
            else r.negative=r.negative+1 end
            if v~=math.floor(v) then r.fractions=r.fractions+1 end
            if r.max==nil or v>r.max then r.max=v end
            if #r.samples<8 then r.samples[#r.samples+1]=id..'='..fmt(v) end
            -- Only export plausible nonnegative integer quantities.
            if v>=0 and v==math.floor(v) then r.export[id]=v end
        else
            r.other=r.other+1
        end
    end
    return r
end
local function summaryFor(t)
    local result = {}
    for _,cat in ipairs(categories) do
        local child=rawget(t,cat)
        if type(child)=='table' then result[cat]=inspectCategory(child) end
    end
    return result
end
local function reportSummary(summary,labelText)
    push(labelText)
    for _,cat in ipairs(categories) do
        local r = summary[cat]
        if r then
            push(cat..': IDs='..r.count..' numeric='..r.numeric..' sum='..fmt(r.sum)..' +='..r.positive..' zero='..r.zero..' other='..r.other)
            if cat=='Fish' then
                push('  Key string='..r.digitStrings..' | key number='..r.numberKeys..' | fractional='..r.fractions..' | negative='..r.negative)
                push('  Samples: '..(#r.samples>0 and table.concat(r.samples,', ') or '(none)'))
            end
            if r.truncated then push('  WARNING category truncated') end
        end
    end
end
local function makeExport(summary)
    local categoriesOut={}
    for _,cat in ipairs(categories) do
        local r=summary[cat]
        if r then categoriesOut[cat]=r.export end
    end
    local data={
        format='kims_inventory_candidate_v9',
        confirmed_owned_inventory=false,
        userId=player.UserId,
        placeId=game.PlaceId,
        categories=categoriesOut
    }
    local ok,json=pcall(function() return HttpService:JSONEncode(data) end)
    if ok and type(json)=='string' then return json end
    return nil
end

push('KIMS V9 | READ ONLY | NO UPLOAD')
push('USER @'..player.Name..' | ID='..player.UserId)
push('AUDIT: V8.2 ignored string-digit ID keys.')
push('Scan cache once. Output remains HYPOTHESIS until validated.')
push('BACA = scan | SALIN = report | DATA = numeric ID map JSON')
render()

local function run()
    if type(getgc)~='function' then
        push('ERROR: getgc not supported.')
        return
    end
    push('')
    push('=== CORRECTED CACHE CHECK ===')
    render()
    task.wait()
    local ok,objects=pcall(getgc,true)
    if not ok or type(objects)~='table' then push('ERROR: getgc(true) failed');return end
    local limit=math.min(#objects,MAX_GC)
    push('GC total='..#objects..' | inspected='..limit)
    local matched=0
    local first=nil
    local firstFish=nil
    local firstIndex=nil
    for i=1,limit do
        if closed then return end
        local t=objects[i]
        if type(t)=='table' and type(rawget(t,'Fish'))=='table' and type(rawget(t,'Potions'))=='table' then
            matched=matched+1
            if matched<=2 then
                local summary=summaryFor(t)
                reportSummary(summary,'CANDIDATE '..matched..' | gc index='..i)
                if matched==1 then
                    first=summary
                    firstFish=rawget(t,'Fish')
                    firstIndex=i
                    exportText=makeExport(summary)
                else
                    local f=summary.Fish
                    local a=first and first.Fish
                    if f and a then
                        push('COMPARE Fish: IDs '..(f.count==a.count and 'same' or 'different')..', SUM '..(f.sum==a.sum and 'same' or 'different'))
                    end
                    push('Shared Fish table='..tostring(rawequal(firstFish,rawget(t,'Fish'))))
                end
            end
        end
        if i%350==0 then
            status.Text='BACA '..i..'/'..limit
            task.wait()
        end
    end
    push('')
    push('Candidates='..matched..' | first index='..tostring(firstIndex or '?'))
    if first and first.Fish then
        local fish=first.Fish
        if fish.numeric>0 and fish.numeric==fish.count and fish.fractions==0 and fish.negative==0 and not fish.truncated then
            push('Fish resembles numeric quantity map (NOT confirmed owned items).')
        else
            push('Fish map INCONCLUSIVE; inspect types and counts.')
        end
        push('Baseline 213 (old snapshot): delta='..fmt(fish.sum-213)..'; inventory may have changed.')
    end
    push('Data exported only on DATA click; no automatic uploads.')
    push('CAUTION: matching 213 alone does not prove item ownership.')
    objects=nil
end

readBtn.MouseButton1Click:Connect(function()
    if busy or done then return end
    busy=true
    status.Text='Membaca satu kali...'
    task.spawn(function()
        local ok,err=pcall(run)
        if not ok then push('ERROR: '..tostring(err):sub(1,180)) end
        if not closed then
            done=true
            busy=false
            status.Text=ok and 'Selesai. SALIN hasil / DATA JSON.' or 'Ada error, SALIN laporan.'
            render()
        end
    end)
end)
local function clipboard(text)
    local fn=(type(setclipboard)=='function' and setclipboard) or (type(toclipboard)=='function' and toclipboard)
    if not fn then status.Text='Clipboard tidak tersedia';return end
    local ok=pcall(fn,text)
    status.Text=ok and 'TERSALIN! Paste ke chat.' or 'Gagal salin'
end
copyBtn.MouseButton1Click:Connect(function()
    clipboard(table.concat(log,'\n'))
end)
exportBtn.MouseButton1Click:Connect(function()
    if not done then status.Text='Tekan BACA dahulu';return end
    if not exportText then status.Text='Belum ada data ekspor';return end
    clipboard(exportText)
end)
closeBtn.MouseButton1Click:Connect(function()
    closed=true
    screen:Destroy()
end)
