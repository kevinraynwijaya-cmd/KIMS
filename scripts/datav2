
            return HttpService:RequestAsync({

                Url = API_URL,

                Method = "POST",

                Headers = {

                    ["Content-Type"] =
                        "application/json",

                    ["Authorization"] =
                        "Bearer " .. API_KEY
                },

                Body =
                    HttpService:JSONEncode(payload)
            })

        end)

    if ok
        and response
        and response.Success then

        print(
            "[KIMS] LUCK V6 UPLOAD OK"
        )

    else

        warn(
            "[KIMS] LUCK V6 UPLOAD FAILED"
        )

        if response then

            warn(
                "[KIMS] HTTP:",
                response.StatusCode,
                response.StatusMessage
            )

        else

            warn(
                "[KIMS] ERROR:",
                tostring(response)
            )

        end
    end
end

-- =========================================================
-- CHANGE DETECTION
-- =========================================================

local lastSignature = nil

local function scan()

    local state =
        getLuckState()

    local signature =
        HttpService:JSONEncode({

            multiplier =
                state and state.multiplier,

            timer =
                state and state.timerText,

            seconds =
                state and state.timerSeconds,

            source =
                state and state.source,

            timerPath =
                state and state.timerPath,

            multiplierPath =
                state and state.multiplierPath
        })

    -- First scan always sends.
    -- Later scans send only when the detected state changes.
    if signature ~= lastSignature then

        lastSignature =
            signature

        send(state)

    end
end

-- FIRST SCAN
scan()

-- CONTINUOUS STATE CHECK
task.spawn(function()

    while task.wait(INTERVAL) do
        scan()
    end

end)
