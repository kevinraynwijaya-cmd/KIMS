    {id = "Stats", icon = "S", caption = "Statistics"},
    {id = "Settings", icon = "*", caption = "Settings"},
}

local navButtons = {}
local tabOrder = 0
local function refreshNav()
    for tabId, button in pairs(navButtons) do
        local chosen = (tabId == state.tab)
        button.BackgroundColor3 = chosen and C.panel2 or C.surface
        button.TextColor3 = chosen and C.white or C.muted
        local outline = button:FindFirstChildOfClass("UIStroke")
        if outline then
            outline.Color = chosen and C.accent or C.border
            outline.Transparency = chosen and 0 or 1
        end
    end
end

local renderTab -- assigned below; closures can reference it
for _, spec in ipairs(tabs) do
    tabOrder = tabOrder + 1
    local button = textButton(nav, "  " .. spec.icon .. "    " .. spec.caption, {
        Name = "Tab_" .. spec.id,
        Size = UDim2.new(1, 0, 0, 39),
        BackgroundColor3 = C.surface,
        TextColor3 = C.muted,
        TextXAlignment = Enum.TextXAlignment.Left,
        LayoutOrder = tabOrder,
        TextSize = 12,
    })
    round(button, 9)
    stroke(button, C.border, 1, 1)
    navButtons[spec.id] = button
    track(button.MouseButton1Click:Connect(function()
        state.tab = spec.id
        refreshNav()
        renderTab()
    end))
end

local itemOrder = 0
local statsSessionValue = nil
local function attachContent(obj)
    itemOrder = itemOrder + 1
    obj.LayoutOrder = itemOrder
    return obj
end

local function card(height, color)
    local frame = new("Frame", {
        Size = UDim2.new(1, -2, 0, height),
        BackgroundColor3 = color or C.panel,
        BorderSizePixel = 0,
    }, content)
    round(frame, 11)
    stroke(frame, C.border, 1, 0.45)
    return attachContent(frame)
end

local function sectionTitle(title, hint)
    local holder = new("Frame", {
        Size = UDim2.new(1, -2, 0, hint and 46 or 29),
        BackgroundTransparency = 1,
    }, content)
    attachContent(holder)
    textLabel(holder, title, 17, true, C.white, {
        Position = UDim2.fromOffset(2, 0), Size = UDim2.new(1, -4, 0, 25),
    })
    if hint then
        textLabel(holder, hint, 11, false, C.muted, {
            Position = UDim2.fromOffset(2, 26), Size = UDim2.new(1, -4, 0, 17),
        })
    end
end

