local UIS = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")

local C = {
    bg = Color3.fromRGB(13, 12, 25),
    panel = Color3.fromRGB(24, 21, 42),
    card = Color3.fromRGB(35, 29, 55),
    purple = Color3.fromRGB(150, 71, 255),
    cyan = Color3.fromRGB(36, 216, 240),
    orange = Color3.fromRGB(255, 158, 49),
    green = Color3.fromRGB(48, 216, 139),
    white = Color3.fromRGB(245, 241, 255),
    muted = Color3.fromRGB(167, 157, 187)
}

local function make(kind, props, parent)
    local obj = Instance.new(kind)
    for k, v in pairs(props or {}) do
        obj[k] = v
    end
    obj.Parent = parent
    return obj
end

local function corner(obj, radius)
    make("UICorner", {
        CornerRadius = UDim.new(0, radius or 9)
    }, obj)
end

local function outline(obj, color)
    make("UIStroke", {
        Color = color or C.purple,
        Thickness = 1,
        Transparency = 0.35
    }, obj)
end

local function label(parent, text, size, color)
    return make("TextLabel", {
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = color or C.white,
        Font = Enum.Font.Gotham,
        TextSize = size or 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true
    }, parent)
end

-- GUI ROOT
local old = CoreGui:FindFirstChild("KIMS_FISH_IT")
if old then old:Destroy() end

local gui = make("ScreenGui", {
    Name = "KIMS_FISH_IT",
    ResetOnSpawn = false,
    IgnoreGuiInset = true,
    DisplayOrder = 1000000
}, nil)

local okParent = pcall(function()
    gui.Parent = CoreGui
end)

if not okParent then
    gui.Parent = LocalPlayer:WaitForChild("PlayerGui")
end

local window = make("Frame", {
    AnchorPoint = Vector2.new(0.5, 0.5),
    Position = UDim2.fromScale(0.5, 0.5),
    Size = UDim2.fromOffset(780, 500),
    BackgroundColor3 = C.bg,
    BorderSizePixel = 0,
    Active = true
}, gui)
corner(window, 16)
outline(window, C.purple)

local scale = make("UIScale", {Scale = 1}, window)

local function resizeUI()
    local camera = workspace.CurrentCamera
    if not camera then return end
    local v = camera.ViewportSize
    scale.Scale = math.min(
        1,
        math.max(0.4, (v.X - 20) / 780)
    )
    scale.Scale = math.min(
        scale.Scale,
        math.max(0.4, (v.Y - 20) / 500)
    )
end
resizeUI()

-- HEADER
local header = make("Frame", {
    Size = UDim2.new(1, 0, 0, 65),
    BackgroundColor3 = C.panel,
    BorderSizePixel = 0
}, window)
corner(header, 14)

local logo = label(header, "⚡ KIMS", 27, C.white)
logo.Font = Enum.Font.GothamBold
logo.Position = UDim2.fromOffset(18, 5)
