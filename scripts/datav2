TPTab:CreateSection("👤 Teleport to Player")
local function getPlayerList()
    local list = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then table.insert(list, plr.Name) end
    end
    return list
end
local selectedPlayer = getPlayerList()[1] or "None"
local playerDropdown
playerDropdown = TPTab:CreateDropdown({
    Name = "Select Player",
    Options = getPlayerList(),
    CurrentOption = { selectedPlayer },
    Callback = function(opt) selectedPlayer = opt end
})
TPTab:CreateButton({Name = "🎯 Teleport to Player",
    Callback = function() teleportToPlayer(selectedPlayer) end})
TPTab:CreateButton({Name = "🔄 Refresh Player List",
    Callback = function() playerDropdown:Refresh(getPlayerList()) end})

TPTab:CreateSection("🌐 Server")
TPTab:CreateButton({Name = "🌐 Server Hop", Callback = function() serverHop() end})
