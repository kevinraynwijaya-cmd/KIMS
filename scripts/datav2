local close=button('TUTUP',.75,.22)
local status=label(frame,UDim2.new(.03,0,0,80),UDim2.new(.94,0,0,26),'Siap')
local scroll=Instance.new('ScrollingFrame',frame)
scroll.Position=UDim2.new(.03,0,0,110); scroll.Size=UDim2.new(.94,0,1,-120)
scroll.BackgroundColor3=Color3.fromRGB(22,28,46); scroll.ScrollBarThickness=6
scroll.AutomaticCanvasSize=Enum.AutomaticSize.Y
local output=label(scroll,UDim2.new(0,7,0,5),UDim2.new(1,-20,0,0),'')
output.AutomaticSize=Enum.AutomaticSize.Y; output.TextWrapped=true
local alive=true
local busy=false
local report=''
local function clean(v)
 return tostring(v):gsub('%c',' '):sub(1,160)
end
local function inspect()
 if busy or not alive then return end
 busy=true; scan.Text='MEMBACA...'; status.Text='Menunggu Replion, maksimal 15 detik...'
 local lines={'KIMS REPLION INVENTORY PROBE','USER: @'..player.Name,
  'PlaceId: '..tostring(game.PlaceId),'Local snapshot; no upload or item changes.',''}
 local function add(s) lines[#lines+1]=s end
 local ok,err=pcall(function()
  local packages=RS:FindFirstChild('Packages')
  local module=packages and packages:FindFirstChild('Replion')
  if not module then error('ReplicatedStorage.Packages.Replion tidak ditemukan') end
  local Replion=require(module)
  if type(Replion)~='table' or not Replion.Client then error('Replion.Client tidak tersedia') end
  -- Isolate potentially yielding require/WaitReplion in this worker.
  local data=Replion.Client:WaitReplion('Data')
  if not alive or not busy then return end
  add('Replion Data: TERBACA')
  local inventory=data:GetExpect('Inventory')
  if type(inventory)~='table' then error('Inventory bukan table: '..type(inventory)) end
  add('Inventory: TERBACA')
  add('=== KATEGORI (maksimal 40) ===')
  local count=0
  for k,v in pairs(inventory) do
   count=count+1; if count>40 then add('[kategori dibatasi]');break end
   add(clean(k)..' : '..type(v))
  end
  local items=inventory.Items
  if type(items)~='table' then
   add('Inventory.Items: BELUM TERBACA (bukan berarti kosong)');return
  end
  local n=0;local samples={};local capped=false
  for _,item in pairs(items) do
   n=n+1
   if #samples<5 then samples[#samples+1]=item end
   if n>=20000 then capped=true;break end
   if n%500==0 then task.wait() end
  end
  add('');add('Inventory.Items: TERBACA')
  add('Jumlah entri: '..n..(capped and ' [batas scan 20000; total bisa lebih]' or ''))
  add('Jumlah entri belum tentu jumlah ikan/quantity.')
  -- Only expose inventory field values; truncate strings, never traverse other player data.
  local function fields(t,prefix,depth)
   local used=0
   for k,v in pairs(t) do
    used=used+1; if used>24 then add(prefix..'[field dibatasi]');break end
    local key=clean(k)
    if type(v)=='table' then
     add(prefix..key..' = [table]')
     if depth<2 then fields(v,prefix..'  ',depth+1) end
    elseif type(v)=='string' or type(v)=='number' or type(v)=='boolean' then
     add(prefix..key..' = '..clean(v))
    else add(prefix..key..' = ['..type(v)..']') end
   end
  end
  for i,item in ipairs(samples) do
   add('');add('=== CONTOH ITEM '..i..' ===')
   if type(item)=='table' then fields(item,'',0) else add('type='..type(item)..' value='..clean(item)) end
  end
  if n==0 then add('Items kosong pada snapshot ini; isi inventory belum terkonfirmasi.') end
 end)
 if not alive or not busy then return end
 if not ok then add('ERROR: '..clean(err)) end
 report=table.concat(lines,'\n'); output.Text=report
 status.Text='SELESAI - tekan SALIN HASIL';scan.Text='SCAN ULANG';busy=false
end
-- Each scan has its own generation so late workers cannot overwrite newer results.
local generation=0
local function start()
 if busy then return end
 generation=generation+1
 local id=generation
 task.spawn(inspect)
 task.delay(15,function()
  if alive and generation==id and busy then
   alive=false -- retire this UI's pending worker before allowing another execution
   report='KIMS REPLION INVENTORY PROBE\nTIMEOUT: Replion/module/data belum siap dalam 15 detik.\nBuka inventory, lalu jalankan ulang skrip. Ini bukan hasil inventory kosong.'
   output.Text=report; status.Text='TIMEOUT - SALIN atau jalankan ulang skrip'
   busy=false;scan.Text='JALANKAN ULANG SKRIP'
  end
 end)
end
scan.MouseButton1Click:Connect(start)
copy.MouseButton1Click:Connect(function()
 if busy then status.Text='Tunggu scan selesai';return end
 local fn=(type(setclipboard)=='function' and setclipboard) or (type(toclipboard)=='function' and toclipboard)
 if not fn then status.Text='Clipboard tidak didukung; screenshot hasil';return end
 local ok=pcall(fn,report);status.Text=ok and 'HASIL TERSALIN' or 'SALIN GAGAL'
end)
close.MouseButton1Click:Connect(function() alive=false;gui:Destroy() end)
gui.AncestryChanged:Connect(function() if not gui.Parent then alive=false end end)
start()
