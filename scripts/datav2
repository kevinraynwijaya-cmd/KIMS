-- KIMS TECH | REPLION SOURCE INSPECTOR V17
-- Fish It / Delta | Read-only, bounded, metadata-only inspection.
-- No Zetsu, getgc, HTTP, remote calls, item mutations or payload export.
-- Requires only module paths already loaded in this game session.

local Players=game:GetService('Players')
local UIS=game:GetService('UserInputService')
local plr=Players.LocalPlayer
if not plr then return end
local pg=plr:WaitForChild('PlayerGui')
local old=pg:FindFirstChild('KIMSReplionV17')
if old then old:Destroy() end
local screen=Instance.new('ScreenGui')
screen.Name='KIMSReplionV17'; screen.ResetOnSpawn=false
screen.DisplayOrder=999; screen.Parent=pg
local pane=Instance.new('Frame')
pane.Size=UDim2.new(.94,0,.68,0); pane.Position=UDim2.new(.03,0,.15,0)
pane.BackgroundColor3=Color3.fromRGB(13,19,36); pane.BorderSizePixel=0
pane.Active=true; pane.Parent=screen
Instance.new('UICorner',pane).CornerRadius=UDim.new(0,10)
local border=Instance.new('UIStroke',pane); border.Thickness=2
border.Color=Color3.fromRGB(107,91,224)
local headline=Instance.new('TextLabel',pane)
headline.Position=UDim2.new(.025,0,0,6); headline.Size=UDim2.new(.95,0,0,30)
headline.BackgroundTransparency=1; headline.Font=Enum.Font.GothamBold
headline.TextSize=14; headline.TextXAlignment=Enum.TextXAlignment.Left
headline.TextColor3=Color3.fromRGB(205,190,255)
headline.Text='KIMS V17 | REPLION SOURCE INSPECTOR'
local function btn(txt,x,w)
 local b=Instance.new('TextButton',pane)
 b.Position=UDim2.new(x,0,0,43); b.Size=UDim2.new(w,0,0,33)
 b.Text=txt; b.TextScaled=true; b.Font=Enum.Font.GothamBold
 b.TextColor3=Color3.new(1,1,1); b.BackgroundColor3=Color3.fromRGB(63,57,126)
 Instance.new('UICorner',b).CornerRadius=UDim.new(0,6)
 return b
end
local copyBtn=btn('SALIN',.025,.28)
local miniBtn=btn('MINI',.36,.27)
local closeBtn=btn('TUTUP',.68,.29)
local status=Instance.new('TextLabel',pane)
status.Position=UDim2.new(.03,0,0,83); status.Size=UDim2.new(.94,0,0,23)
status.BackgroundTransparency=1; status.TextXAlignment=Enum.TextXAlignment.Left
status.Font=Enum.Font.Code; status.TextSize=12
status.TextColor3=Color3.fromRGB(112,231,168)
status.Text='Membaca metadata objek Replion...'
local sc=Instance.new('ScrollingFrame',pane)
sc.Position=UDim2.new(.025,0,0,110); sc.Size=UDim2.new(.95,0,1,-120)
sc.BackgroundColor3=Color3.fromRGB(21,27,47); sc.BorderSizePixel=0
sc.ScrollBarThickness=5; sc.AutomaticCanvasSize=Enum.AutomaticSize.Y
local output=Instance.new('TextLabel',sc)
output.Position=UDim2.new(0,7,0,6); output.Size=UDim2.new(1,-20,0,0)
output.AutomaticSize=Enum.AutomaticSize.Y; output.TextWrapped=true
output.TextXAlignment=Enum.TextXAlignment.Left; output.TextYAlignment=Enum.TextYAlignment.Top
output.Font=Enum.Font.Code; output.TextSize=12
output.TextColor3=Color3.fromRGB(227,235,252)
output.BackgroundTransparency=1

local lines={}; local busy=true; local cancel=false
local function emit(s)
 if #lines<260 then lines[#lines+1]=tostring(s) end
end
local function show() if screen.Parent then output.Text=table.concat(lines,'\n') end end
local function safeCount(tbl,limit)
 local n,nt,ns,nn,no=0,0,0,0,0
 for _,v in pairs(tbl) do
  n=n+1
  local t=type(v)
  if t=='table' then nt=nt+1 elseif t=='number' then nn=nn+1
  elseif t=='string' then ns=ns+1 else no=no+1 end
  if n>=limit then break end
 end
 return n,nt,nn,ns,no,n>=limit
end
local categories={
 'Fish','Fishing Rods','Rods','Baits','Potions','Pets','Pet Eggs',
 'Gears','Lanterns','Halos','Emotes','Enchant Stones','Charms','Boats',
 'Items','Inventory','Inventories'
}
local function catSummary(t)
 local arr={}
 for _,name in ipairs(categories) do
  local v=rawget(t,name)
  if type(v)=='table' then
   local n,tt,nn,ss,oo,cap=safeCount(v,2000)
   arr[#arr+1]=name..'='..n..(cap and '+' or '')..'(T/N/S/O '..tt..'/'..nn..'/'..ss..'/'..oo..')'
  end
 end
 return arr
end
local function safeChannel(ch)
 if type(ch)~='string' then return '(type='..type(ch)..')' end
 local approved={Data=true,PlayerData=true,Inventory=true,Player=true,Stats=true,Profile=true,Fish=true,Items=true}
 if approved[ch] then return ch end
 return '(redacted string channel)'
end
local function upvaluesOf(fn)
 if type(getupvalues)=='function' then
  local ok,x=pcall(getupvalues,fn)
  if ok and type(x)=='table' then return x end
 end
 if type(debug)=='table' and type(debug.getupvalues)=='function' then
  local ok,x=pcall(debug.getupvalues,fn)
  if ok and type(x)=='table' then return x end
 end
 return nil
end
local targets={
 'ReplicatedStorage.Packages.Replion',
 'ReplicatedStorage.Packages._Index.ytrev_replion@2.0.0-rc.3.replion.Client',
 'ReplicatedStorage.Packages._Index.ytrev_replion@2.0.0-rc.3.replion.Client.ClientReplion',
 'ReplicatedStorage.Controllers.InventoryController'
}
local refs={}; local queue={}; local head=1
local visited=setmetatable({},{__mode='k'})
local inspected=0; local keys=0; local functions=0
local results={}; local uniqueChannels={}
local MAX_NODES=1650; local MAX_KEYS=11200; local MAX_DEPTH=6
local MAX_FUNCTION_UPS=210; local MAX_QUEUE=5400
local function enqueue(v,path,depth)
 if (type(v)=='table' or type(v)=='function') and #queue<MAX_QUEUE and not visited[v] then
  queue[#queue+1]={v=v,path=path,depth=depth}
 end
end
local function recordCandidate(path,t)
 local isData=type(rawget(t,'Data'))=='table'
 local isReplion=isData and (rawget(t,'Channel')~=nil or rawget(t,'Tags')~=nil or type(rawget(t,'Get'))=='function')
 local cats=catSummary(t)
 if isReplion or #cats>=2 then
  if #results>=38 then return end
  local data=isData and rawget(t,'Data') or nil
  local dataCats=data and catSummary(data) or {}
  local n=select(1,safeCount(t,250))
  local record={path=path,kind=isReplion and 'CLIENT-REPLION-LIKE' or 'CATEGORY-MAP',size=n,
                cats=cats,dataCats=dataCats,channel=safeChannel(rawget(t,'Channel'))}
  results[#results+1]=record
  if isReplion then uniqueChannels[record.channel]=true end
 end
end
local function run()
 emit('KIMS V17 | REPLION SOURCE INSPECTOR | READ ONLY')
 emit('PlaceId='..tostring(game.PlaceId))
 emit('Focus: already-loaded Replion client and replicated-state metadata.')
 emit('No Zetsu, HTTP, getgc, remote, item actions or raw account data.')
 emit('Channel values redacted except standard names. No item values printed.')
 emit('')
 emit('=== EXACT LOADED MODULES ===')
 if type(getloadedmodules)~='function' then
  emit('getloadedmodules unavailable: cannot safely locate cached exports.')
  return
 end
 local ok,loaded=pcall(getloadedmodules)
 if not ok or type(loaded)~='table' then emit('getloadedmodules failed');return end
 local count=0
 for _,m in ipairs(loaded) do
  if typeof(m)=='Instance' and m:IsA('ModuleScript') then
   local op,full=pcall(function() return m:GetFullName() end)
   if op then
    for _,target in ipairs(targets) do
     if full==target then refs[target]=m end
    end
   end
  end
  count=count+1
  if count%450==0 then task.wait() end
 end
 emit('Loaded modules='..count)
 local readable=0
 for _,target in ipairs(targets) do
  local module=refs[target]
  if module then
   -- Only already-loaded module instances; require should hit cache.
   local worked,ex=pcall(require,module)
   emit('MODULE '..target..' => '..(worked and type(ex) or 'unavailable'))
   if worked then
    readable=readable+1
    enqueue(ex, target=='ReplicatedStorage.Controllers.InventoryController' and 'InventoryController/[export]' or 'Replion/[export]',0)
    if type(ex)=='table' then
     local client=rawget(ex,'Client')
     if type(client)=='table' then
      emit('  Client export found; GetReplion='..type(rawget(client,'GetReplion')))
      enqueue(client,'Replion/Client',0)
     end
     if type(rawget(ex,'GetReplion'))=='function' then
      emit('  GetReplion function present (not called).')
     end
    end
   end
  else
   emit('MODULE '..target..' => not loaded')
  end
 end
 emit('Cached module exports read='..readable)
 show()
 local deadline=os.clock()+12
 emit('')
 emit('=== BOUNDED CLIENT STATE GRAPH ===')
 while head<=#queue and not cancel and inspected<MAX_NODES and keys<MAX_KEYS
      and os.clock()<deadline do
  local node=queue[head]; head=head+1
  local obj=node.v
  if not visited[obj] then
   visited[obj]=true; inspected=inspected+1
   if type(obj)=='function' then
    functions=functions+1
    if functions<=MAX_FUNCTION_UPS and node.depth<MAX_DEPTH then
     local ups=upvaluesOf(obj)
     if ups then
      local localN=0
      for _,v in pairs(ups) do
       localN=localN+1
       if localN>12 then break end
       enqueue(v,node.path..'/[upvalue]',node.depth+1)
      end
     end
    end
   else
    recordCandidate(node.path,obj)
    local processed=0
    for k,v in pairs(obj) do
     processed=processed+1;keys=keys+1
     local isImportant=(k=='Data' or k=='Replions' or k=='Replion' or k=='Inventory' or k=='Items'
         or k=='Client' or k=='State' or k=='Registry')
     local part=isImportant and tostring(k) or '[entry]'
     if node.depth<MAX_DEPTH and (processed<=34 or isImportant) then
      enqueue(v,node.path..'/'..part,node.depth+1)
     end
     if processed>=110 or keys>=MAX_KEYS then break end
    end
   end
   if inspected%40==0 then
    status.Text='Memeriksa '..inspected..' objek...'
    task.wait()
   end
  end
 end
 emit('Inspected='..inspected..' | fields='..keys..' | functions='..functions)
 emit('Candidates='..#results..' | graph bounded='..tostring(head<=#queue))
 if os.clock()>=deadline then emit('Time limit reached; report may be partial.') end
 emit('')
 emit('=== STATE / REPLION CANDIDATES ===')
 if #results==0 then emit('No Replion-shaped table located in bounded graph.') end
 table.sort(results,function(a,b)
  local sa=(a.kind=='CLIENT-REPLION-LIKE' and 10 or 0)+#a.cats+#a.dataCats
  local sb=(b.kind=='CLIENT-REPLION-LIKE' and 10 or 0)+#b.cats+#b.dataCats
  return sa>sb
 end)
 for i=1,math.min(#results,22) do
  local r=results[i]
  emit('C'..i..' '..r.kind..' path='..r.path:sub(1,116)..' | channel='..r.channel)
  if #r.cats>0 then
   for j=1,math.min(#r.cats,9) do emit('  '..r.cats[j]) end
  end
  if #r.dataCats>0 then
   emit('  [Data children]')
   for j=1,math.min(#r.dataCats,9) do emit('    '..r.dataCats[j]) end
  end
 end
 emit('')
 emit('=== INTERPRETATION ===')
 emit('Replion framework is confirmed; no candidate is yet verified as owned inventory.')
 emit('Fish category entries can be species/statistics, NOT fish quantity.')
 emit('A true item source needs record shape plus consistency with GUI counter.')
 emit('Do not use candidate totals to populate kims.asia/statakun.')
 emit('No sensitive strings, credentials, item details or payloads exported.')
end
copyBtn.MouseButton1Click:Connect(function()
 if busy then status.Text='Tunggu SELESAI dulu';return end
 local clip=type(setclipboard)=='function' and setclipboard or (type(toclipboard)=='function' and toclipboard)
 if not clip then status.Text='Clipboard unsupported';return end
 local ok=pcall(clip,table.concat(lines,'\n'))
 status.Text=ok and 'Laporan tersalin' or 'SALIN gagal'
end)
local mini=false
miniBtn.MouseButton1Click:Connect(function()
 mini=not mini
 sc.Visible=not mini
 pane.Size=mini and UDim2.new(.94,0,0,112) or UDim2.new(.94,0,.68,0)
 miniBtn.Text=mini and 'BUKA' or 'MINI'
end)
closeBtn.MouseButton1Click:Connect(function() cancel=true;screen:Destroy() end)
do
 local dragging=false;local start;local origin
 headline.InputBegan:Connect(function(x)
  if x.UserInputType==Enum.UserInputType.Touch or x.UserInputType==Enum.UserInputType.MouseButton1 then
   dragging=true;start=x.Position;origin=pane.Position
  end
 end)
 headline.InputEnded:Connect(function(x)
  if x.UserInputType==Enum.UserInputType.Touch or x.UserInputType==Enum.UserInputType.MouseButton1 then dragging=false end
 end)
 UIS.InputChanged:Connect(function(x)
  if cancel or not dragging or not start then return end
  if x.UserInputType==Enum.UserInputType.Touch or x.UserInputType==Enum.UserInputType.MouseMovement then
   local d=x.Position-start
   pane.Position=UDim2.new(origin.X.Scale,origin.X.Offset+d.X,origin.Y.Scale,origin.Y.Offset+d.Y)
  end
 end)
end
show()
task.spawn(function()
 local good,err=pcall(run)
 busy=false
 if not cancel then
  if not good then emit('ERROR: '..tostring(err):sub(1,130)) end
  show()
  status.Text=good and 'SELESAI - tekan SALIN' or 'ERROR - tekan SALIN'
 end
end)
