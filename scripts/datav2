-- KIMS FISH READER V5 | Inventory Source Probe
-- Read only. No HTTP requests, no uploads, no inventory edits.
local Players = game:GetService('Players')
local RS = game:GetService('ReplicatedStorage')
local player = Players.LocalPlayer
local gui = player:WaitForChild('PlayerGui')
local lines = {}
local function add(s) lines[#lines+1] = tostring(s) end
local function clean(s) s=tostring(s or ''):gsub('[\r\n]',' '); return #s>110 and s:sub(1,110)..'...' or s end
local function shortPath(obj)
    local ok,s=pcall(function() return obj:GetFullName() end)
    return ok and clean(s) or clean(obj.Name)
end
local words={'inventory','item','fish','data','profile','backpack','storage','caught','catch','rod','save','equipment'}
local function relevant(name)
    name=string.lower(name)
    for _,w in ipairs(words) do if string.find(name,w,1,true) then return true end end
    return false
end
local function listValues(root, title, cap)
    if not root then add(title..': missing'); return end
    local count,shown=0,0
    for _,v in ipairs(root:GetDescendants()) do
        if v:IsA('ValueBase') then
            count=count+1
            if shown<cap and (relevant(v.Name) or relevant(v.Parent and v.Parent.Name or '')) then
                shown=shown+1
                local ok,value=pcall(function() return v.Value end)
                add('VALUE '..shortPath(v)..' = '..(ok and clean(value) or '[unavailable]'))
            end
        end
    end
    add(title..' ValueBase total='..count..' relevant shown='..shown)
end
local function attrScan(obj,title)
    if not obj then return end
    local ok,t=pcall(function() return obj:GetAttributes() end)
    if not ok then return end
    local n=0
    for k,v in pairs(t) do
        n=n+1
        if relevant(k) then add('ATTR '..title..'.'..clean(k)..' = '..clean(v)) end
    end
    add(title..' attributes total='..n)
end
local function scanNamed(root,title,limit,depth)
    local count,shown=0,0
    if not root then return end
    for _,obj in ipairs(root:GetDescendants()) do
        if relevant(obj.Name) then
            count=count+1
            if shown<limit then
                local path=shortPath(obj)
                if not depth or #path<depth then
                    shown=shown+1
                    add('NODE ['..obj.ClassName..'] '..path)
                end
            end
        end
    end
    add(title..' matches='..count..' displayed='..shown)
end
local function scanGui()
    local inv=gui:FindFirstChild('Inventory')
    add('=== INVENTORY GUI (not hotbar) ===')
    if not inv then add('Inventory GUI not found'); return end
    add('Root '..shortPath(inv)..' Enabled='..tostring(inv.Enabled))
    local counts={Frame=0,ScrollingFrame=0,TextLabel=0,ImageButton=0}
    local shown=0
    for _,obj in ipairs(inv:GetDescendants()) do
        if counts[obj.ClassName]~=nil then counts[obj.ClassName]=counts[obj.ClassName]+1 end
        if obj:IsA('TextLabel') and obj.Visible and shown<45 then
            local txt=clean(obj.Text)
            if txt~='' and txt~='-' then
                shown=shown+1
                add('GUI TEXT '..shortPath(obj)..' => '..txt)
            end
        end
    end
    for k,n in pairs(counts) do add('Inventory GUI '..k..'='..n) end
    add('Visible text shown='..shown)
end
local function run()
    lines={}
    add('KIMS V5 | SOURCE PROBE | READ ONLY | NO UPLOAD')
    add('ACCOUNT @'..player.Name..' | Display='..player.DisplayName..' | UserId='..player.UserId)
    add('Place='..game.PlaceId)
    add('Please OPEN full Fish It Inventory before pressing RESCAN')
    add('=== PLAYER STATE ===')
    attrScan(player,'Player')
    attrScan(player.Character,'Character')
    listValues(player,'Player',35)
    add('=== PLAYER / CLIENT OBJECTS ===')
    scanNamed(player,'Player',55)
    add('=== REPLICATED ROOT NAMES (not player inventory) ===')
    local shown=0
    for _,child in ipairs(RS:GetChildren()) do
        if relevant(child.Name) and shown<45 then
            shown=shown+1
            add('RS ROOT ['..child.ClassName..'] '..clean(child.Name))
        end
    end
    scanGui()
    add('=== SUMMARY ===')
    add('ReplicatedStorage.Items is normally item definitions, NOT proof of account ownership.')
    add('This test checks client-visible state only; it does not retrieve server DataStore or catch history.')
    add('DONE')
end
local old=gui:FindFirstChild('KIMS_V5_SOURCE_PROBE')
if old then old:Destroy() end
local sg=Instance.new('ScreenGui')
sg.Name='KIMS_V5_SOURCE_PROBE'; sg.ResetOnSpawn=false; sg.IgnoreGuiInset=true
pcall(function() sg.Parent=game:GetService('CoreGui') end)
if not sg.Parent then sg.Parent=gui end
local bg=Instance.new('Frame',sg); bg.Size=UDim2.fromScale(.86,.72); bg.Position=UDim2.fromScale(.07,.13); bg.BackgroundColor3=Color3.fromRGB(13,17,32); bg.BorderSizePixel=0
Instance.new('UICorner',bg).CornerRadius=UDim.new(0,12)
local header=Instance.new('TextLabel',bg); header.Text='KIMS FISH READER V5 - INVENTORY SOURCE';header.TextColor3=Color3.fromRGB(170,214,255);header.Font=Enum.Font.GothamBold;header.TextSize=14;header.BackgroundTransparency=1;header.Size=UDim2.new(.60,0,0,40)
local function button(label,x,w,fn)
 local b=Instance.new('TextButton',bg);b.Text=label;b.Font=Enum.Font.GothamBold;b.TextSize=12;b.TextColor3=Color3.new(1,1,1);b.BackgroundColor3=Color3.fromRGB(75,52,126);b.Position=UDim2.new(x,0,0,5);b.Size=UDim2.new(w,0,0,31);Instance.new('UICorner',b).CornerRadius=UDim.new(0,7);b.MouseButton1Click:Connect(fn);return b
end
local scroll=Instance.new('ScrollingFrame',bg);scroll.Position=UDim2.new(0,12,0,46);scroll.Size=UDim2.new(1,-24,1,-58);scroll.ScrollBarThickness=5;scroll.BackgroundColor3=Color3.fromRGB(19,26,43);scroll.BorderSizePixel=0
local out=Instance.new('TextLabel',scroll);out.Position=UDim2.fromOffset(8,8);out.Size=UDim2.new(1,-18,0,300);out.BackgroundTransparency=1;out.Font=Enum.Font.Code;out.TextSize=12;out.TextXAlignment=Enum.TextXAlignment.Left;out.TextYAlignment=Enum.TextYAlignment.Top;out.TextColor3=Color3.fromRGB(226,237,249);out.TextWrapped=false
local function refresh()
 run()
 out.Text=table.concat(lines,'\n')
 local rows=#lines
 out.Size=UDim2.new(1,-18,0,math.max(300,rows*17))
 scroll.CanvasSize=UDim2.fromOffset(0,math.max(310,rows*17+15))
 scroll.CanvasPosition=Vector2.zero
end
button('SCAN ULANG',.61,.16,refresh)
local copyBtn
copyBtn=button('SALIN',.78,.12,function()
 if type(setclipboard)=='function' then
    local ok=pcall(setclipboard,table.concat(lines,'\n'))
    copyBtn.Text=ok and 'TERSALIN!' or 'GAGAL'
 else copyBtn.Text='TAK ADA CLIP' end
end)
button('X',.91,.075,function()sg:Destroy()end)
refresh()
