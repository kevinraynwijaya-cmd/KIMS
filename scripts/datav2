-- KIMS UNIVERSAL INVENTORY PROBE V7
-- Read only. No HTTP, uploads, RemoteEvent calls, auto scroll, or inventory modification.
-- Uses only visible Roblox Instance data. Designed for Delta Android GUI output.
local Players = game:GetService('Players')
local player = Players.LocalPlayer
local pg = player:WaitForChild('PlayerGui')
local old = pg:FindFirstChild('KIMSUniversalV7')
if old then old:Destroy() end
local screen = Instance.new('ScreenGui')
screen.Name='KIMSUniversalV7';screen.ResetOnSpawn=false
screen.ZIndexBehavior=Enum.ZIndexBehavior.Sibling;screen.Parent=pg
local main=Instance.new('Frame')
main.Size=UDim2.new(.94,0,.76,0);main.Position=UDim2.new(.03,0,.10,0)
main.BackgroundColor3=Color3.fromRGB(12,17,34);main.BorderSizePixel=0;main.Parent=screen
Instance.new('UICorner',main).CornerRadius=UDim.new(0,12)
local border=Instance.new('UIStroke',main);border.Color=Color3.fromRGB(108,91,225);border.Thickness=2
local function label(parent,text,pos,size,color)
 local t=Instance.new('TextLabel');t.BackgroundTransparency=1;t.Position=pos;t.Size=size
 t.Text=text;t.Font=Enum.Font.Code;t.TextSize=12;t.TextColor3=color or Color3.fromRGB(228,236,255)
 t.TextXAlignment=Enum.TextXAlignment.Left;t.TextYAlignment=Enum.TextYAlignment.Top;t.Parent=parent;return t
end
local title=label(main,'KIMS UNIVERSAL INVENTORY V7',UDim2.new(.02,0,.018,0),UDim2.new(.96,0,0,26),Color3.fromRGB(190,180,255))
title.Font=Enum.Font.GothamBold;title.TextSize=15
local function button(txt,x,width)
 local b=Instance.new('TextButton');b.Text=txt;b.Font=Enum.Font.GothamBold;b.TextScaled=true
 b.TextColor3=Color3.new(1,1,1);b.BackgroundColor3=Color3.fromRGB(64,57,119)
 b.Position=UDim2.new(x,0,0,39);b.Size=UDim2.new(width,0,0,34);b.Parent=main
 Instance.new('UICorner',b).CornerRadius=UDim.new(0,6);return b
end
local scanBtn=button('SCAN',.02,.22)
local copyBtn=button('SALIN',.26,.22)
local closeBtn=button('TUTUP',.50,.22)
local state=label(main,'Siap. Buka Inventory lalu tekan SCAN.',UDim2.new(.02,0,0,82),UDim2.new(.96,0,0,22),Color3.fromRGB(110,226,165))
local scroll=Instance.new('ScrollingFrame');scroll.Parent=main
scroll.Position=UDim2.new(.02,0,0,107);scroll.Size=UDim2.new(.96,0,1,-115)
scroll.BackgroundColor3=Color3.fromRGB(20,27,46);scroll.BorderSizePixel=0
scroll.ScrollBarThickness=6;scroll.AutomaticCanvasSize=Enum.AutomaticSize.Y
local out=label(scroll,'Press SCAN',UDim2.new(0,6,0,6),UDim2.new(1,-20,0,0))
out.AutomaticSize=Enum.AutomaticSize.Y;out.TextWrapped=true
local inv=pg:FindFirstChild('Inventory')
local report='';local scanCount=0;local busy=false
local function clean(s)
 return tostring(s or ''):gsub('[\r\n|]',' '):gsub('^%s+',''):gsub('%s+$',''):sub(1,100)
end
local function parentVisible(obj,root)
 local p=obj
 while p and p~=root do
  if p:IsA('GuiObject') and not p.Visible then return false end
  p=p.Parent
 end
 return true
end
local function attributeNames(obj)
 local attrs=obj:GetAttributes();local keys={}
 for k in pairs(attrs) do table.insert(keys,k) end
 table.sort(keys)
 if #keys>12 then
  local few={};for i=1,12 do few[i]=keys[i] end
  return table.concat(few,',')..' ... ('..#keys..')'
 end
 return table.concat(keys,',')
end
local function descendantsLimited(root,maxCount)
 local found={};local queue={root};local head=1
 while head<=#queue and #found<maxCount do
  local node=queue[head];head=head+1
  for _,ch in ipairs(node:GetChildren()) do
   if #found>=maxCount then break end
   found[#found+1]=ch
   if #queue<maxCount+1 then queue[#queue+1]=ch end
  end
 end
 return found,head<=#queue
end
local function shortPath(o)
 local s={};local n=o
 while n and n~=inv and #s<8 do table.insert(s,1,n.Name);n=n.Parent end
 return table.concat(s,'/')
end
local function scan()
 if busy then return end
 busy=true;scanBtn.Text='TUNGGU';scanCount=scanCount+1
 local lines={};local function add(s) lines[#lines+1]=s end
 add('KIMS V7 | READ ONLY | NO UPLOAD')
 add('USER @'..player.Name..' | DISPLAY '..player.DisplayName..' | ID '..tostring(player.UserId))
 add('PLACE '..tostring(game.PlaceId)..' | SCAN '..scanCount)
 local stats=player:FindFirstChild('leaderstats')
 if stats then
  for _,key in ipairs({'Caught','Rarest Fish'}) do
   local v=stats:FindFirstChild(key)
   if v and v:IsA('ValueBase') then add('STAT '..key..'='..tostring(v.Value)) end
  end
 end
 inv=pg:FindFirstChild('Inventory')
 if not inv then
  add('[ERROR] PlayerGui.Inventory tidak ditemukan. Buka menu Inventory Fish It.')
 else
  add('INVENTORY GUI enabled='..tostring(inv.Enabled))
  local nodes,truncated=descendantsLimited(inv,5500)
  local frames={}
  local pages={}
  for _,node in ipairs(nodes) do
   if node:IsA('ScrollingFrame') then frames[#frames+1]=node end
   if node.Name=='Pages' then
    for _,child in ipairs(node:GetChildren()) do
     if child:IsA('GuiObject') then pages[#pages+1]=child.Name end
    end
   end
  end
  add('GUI objects inspected='..#nodes..' | capped='..tostring(truncated))
  add('PAGES: '..table.concat(pages,', '))
  add('SCROLL FRAMES='..#frames..' (jumlah wadah, BUKAN jumlah item)')
  local frameLimit=math.min(#frames,14)
  for i=1,frameLimit do
   local frame=frames[i]
   local children=frame:GetChildren()
   local titleText=shortPath(frame)
   add('')
   add('['..i..'] '..titleText)
   add('  enabled/visible='..tostring(parentVisible(frame,inv))..' | direct children='..#children)
   add('  canvas Y='..math.floor(frame.CanvasSize.Y.Offset)..' | scroll Y='..math.floor(frame.CanvasPosition.Y))
   add('  attrs='..attributeNames(frame))
   local samples={};local nameCount=0;local inspected=0
   -- Probe a limited subtree. Never scan huge game-wide hierarchies.
   local fNodes=descendantsLimited(frame,1250)
   for _,n in ipairs(fNodes) do
    inspected=inspected+1
    if n:IsA('TextLabel') and n.Name=='ItemName' then
     local t=clean(n.Text)
     if t~='' and t~='ItemName' then
      nameCount=nameCount+1
      if #samples<5 then samples[#samples+1]=t end
     end
    end
   end
   add('  item labels='..nameCount..' | sample: '..(#samples>0 and table.concat(samples,' ; ') or '(belum terdeteksi)'))
   -- Structural sample of direct children and their attribute keys, no sensitive values.
   local distinct={};local keys={}
   for _,n in ipairs(children) do
    local key=n.ClassName..':'..n.Name
    if not distinct[key] then distinct[key]=true;keys[#keys+1]=key end
    if #keys>=8 then break end
   end
   add('  child types: '..table.concat(keys,' ; '))
  end
  if #frames>frameLimit then add('... '..(#frames-frameLimit)..' frame lainnya tidak diproses (batas keamanan)') end
  add('')
  add('NOTE: ini pemetaan GUI client, BUKAN dump database 213 ikan atau sumber inventory lengkap.')
  add('NOTE: tanpa ID item/quantity sumber, tile atau signature tidak boleh dianggap jumlah ikan.')
 end
 report=table.concat(lines,'\n');out.Text=report
 state.Text='SCAN '..scanCount..' selesai | '..#lines..' baris | '..#report..' karakter'
 scanBtn.Text='SCAN';busy=false
end
scanBtn.MouseButton1Click:Connect(function()
 local ok,err=pcall(scan)
 if not ok then busy=false;scanBtn.Text='SCAN';state.Text='SCAN ERROR: '..tostring(err):sub(1,110) end
end)
copyBtn.MouseButton1Click:Connect(function()
 local clipboard=(type(setclipboard)=='function' and setclipboard) or (type(toclipboard)=='function' and toclipboard)
 if not clipboard then copyBtn.Text='NO COPY';return end
 local ok=pcall(clipboard,report)
 copyBtn.Text=ok and 'TERSALIN' or 'GAGAL'
end)
closeBtn.MouseButton1Click:Connect(function() screen:Destroy() end)
out.Text='Buka menu INVENTORY Fish It dahulu.\nTekan SCAN untuk peta semua kategori yang tersedia.\nTidak perlu scroll ribuan ikan.\nTidak ada request atau perubahan data.'
